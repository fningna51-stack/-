        function Tab:AddPopup(title, content)
            local Container = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundTransparency = 1,
                Parent = Page
            })
            
            local shadow = Create("Frame", {
                Size = UDim2.new(1, 0, 1, 0),
                Position = UDim2.new(0, 0, 0, 3),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BackgroundTransparency = 0.5,
                BorderSizePixel = 0,
                ZIndex = 15,
                Parent = Container
            })
            Create("UICorner", {CornerRadius = UDim.new(0, Config.ButtonRadius), Parent = shadow})
            
            local Btn = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundColor3 = Config.Theme.Tertiary,
                Text = title,
                TextColor3 = Config.Theme.Text,
                Font = Config.Font,
                TextSize = 13,
                AutoButtonColor = false,
                ZIndex = 16,
                Parent = Container
            })
            Create("UICorner", {CornerRadius = UDim.new(0, Config.ButtonRadius), Parent = Btn})
            
            Btn.MouseEnter:Connect(function()
                Tween(Btn, 0.15, {BackgroundColor3 = Config.Theme.Accent})
                Tween(shadow, 0.15, {BackgroundTransparency = 0.6, Position = UDim2.new(0, 0, 0, 4)})
            end)
            Btn.MouseLeave:Connect(function()
                Tween(Btn, 0.15, {BackgroundColor3 = Config.Theme.Tertiary})
                Tween(shadow, 0.15, {BackgroundTransparency = 0.5, Position = UDim2.new(0, 0, 0, 3)})
            end)
            
            Btn.MouseButton1Click:Connect(function()
                local Overlay = Create("Frame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    BackgroundTransparency = 1,
                    ZIndex = 100,
                    Parent = ScreenGui
                })
                
                local Modal = Create("Frame", {
                    Size = UDim2.new(0, 300, 0, 0),
                    Position = UDim2.new(0.5, -150, 0.5, 0),
                    BackgroundColor3 = Config.Theme.Background,
                    BorderSizePixel = 0,
                    ZIndex = 101,
                    Parent = Overlay
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 14), Parent = Modal})
                Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = Modal})
                
                Create("TextLabel", {
                    Size = UDim2.new(1, -32, 0, 30),
                    Position = UDim2.new(0, 18, 0, 14),
                    BackgroundTransparency = 1,
                    Text = title,
                    TextColor3 = Config.Theme.Text,
                    Font = Config.FontBold,
                    TextSize = 15,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 102,
                    Parent = Modal
                })
                
                local ContentLabel = Create("TextLabel", {
                    Size = UDim2.new(1, -32, 0, 0),
                    Position = UDim2.new(0, 18, 0, 50),
                    BackgroundTransparency = 1,
                    Text = content,
                    TextColor3 = Config.Theme.TextDim,
                    Font = Config.Font,
                    TextSize = 13,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    ZIndex = 102,
                    Parent = Modal
                })
                
                local textBounds = TextService:GetTextSize(content, 13, Config.Font, Vector2.new(268, 1000))
                local contentHeight = textBounds.Y + 80
                ContentLabel.Size = UDim2.new(1, -32, 0, contentHeight - 60)
                
                local ConfirmBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 34),
                    Position = UDim2.new(1, -120, 1, -48),
                    BackgroundColor3 = Config.Theme.Accent,
                    Text = "确定",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.FontBold,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, Config.ButtonRadius), Parent = ConfirmBtn})
                
                local CancelBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 34),
                    Position = UDim2.new(1, -228, 1, -48),
                    BackgroundColor3 = Config.Theme.Tertiary,
                    Text = "取消",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.Font,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, Config.ButtonRadius), Parent = CancelBtn})
                
                Tween(Overlay, 0.2, {BackgroundTransparency = 0.55})
                Tween(Modal, 0.3, {Size = UDim2.new(0, 300, 0, contentHeight), Position = UDim2.new(0.5, -150, 0.5, -contentHeight/2)})
                
                local function Close()
                    Tween(Overlay, 0.2, {BackgroundTransparency = 1})
                    Tween(Modal, 0.2, {Size = UDim2.new(0, 300, 0, 0), Position = UDim2.new(0.5, -150, 0.5, 0)})
                    task.wait(0.2)
                    Overlay:Destroy()
                end
                
                ConfirmBtn.MouseButton1Click:Connect(Close)
                CancelBtn.MouseButton1Click:Connect(Close)
            end)
            
            task.wait()
            UpdateCanvas()
            return Btn
        end
        
        return Tab
    end
    
    function Window:Notify(title, text, duration)
        local NotifFrame = Create("Frame", {
            Size = UDim2.new(0, 280, 0, 0),
            Position = UDim2.new(1, -300, 1, -10),
            BackgroundColor3 = Config.Theme.Secondary,
            BorderSizePixel = 0,
            ZIndex = 50,
            Parent = ScreenGui
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = NotifFrame})
        Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = NotifFrame})
        
        Create("Frame", {
            Size = UDim2.new(0, 3, 1, -16),
            Position = UDim2.new(0, 8, 0, 8),
            BackgroundColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 51,
            Parent = NotifFrame
        })
        
        Create("TextLabel", {
            Size = UDim2.new(1, -30, 0, 20),
            Position = UDim2.new(0, 18, 0, 10),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Config.Theme.Text,
            Font = Config.FontBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 51,
            Parent = NotifFrame
        })
        
        Create("TextLabel", {
            Size = UDim2.new(1, -30, 0, 20),
            Position = UDim2.new(0, 18, 0, 30),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 51,
            Parent = NotifFrame
        })
        
        Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 56), Position = UDim2.new(1, -300, 1, -70)})
        
        task.delay(duration or 3, function()
            Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 0), Position = UDim2.new(1, -300, 1, -10)})
            task.wait(0.3)
            NotifFrame:Destroy()
        end)
    end
    
    function Window:Toggle()
        Main.Visible = not Main.Visible
    end
    
    function Window:SetBackground(assetId, transparency, color)
        Config.BackgroundImage = assetId or ""
        Config.BackgroundImageTransparency = transparency or 0.3
        Config.BackgroundImageColor = color or Color3.fromRGB(255, 255, 255)
        
        if assetId and assetId ~= "" then
            BgImage.Image = assetId
            BgImage.ImageTransparency = Config.BackgroundImageTransparency
            BgImage.ImageColor3 = Config.BackgroundImageColor
            BgImage.Visible = true
            TopBar.BackgroundTransparency = 0.25
            Sidebar.BackgroundTransparency = 0.2
        else
            BgImage.Visible = false
            TopBar.BackgroundTransparency = 0
            Sidebar.BackgroundTransparency = 0
        end
    end
    
    function Window:SetMinimizeIcon(assetId, color)
        Config.MinIconImage = assetId or ""
        Config.MinIconColor = color or Color3.fromRGB(255, 255, 255)
        MinIconImage.Image = Config.MinIconImage
        MinIconImage.ImageColor3 = Config.MinIconColor
        if minimized then
            if Config.MinIconImage ~= "" then
                MinIcon.Text = ""
                MinIconImage.Visible = true
            else
                MinIcon.Text = "W"
                MinIconImage.Visible = false
            end
        end
    end
    
    -- ============================================
    -- 动态更换标题图片标识
    -- ============================================
    function Window:SetTitleIcon(assetId, color, size)
        if assetId ~= nil then
            TitleIconImage.Image = assetId
            TitleIconShadow.Visible = assetId ~= ""
            TitleIconImage.Visible = assetId ~= ""
            winTitleIcon = assetId
        end
        if color then
            TitleIconImage.ImageColor3 = color
            winTitleIconColor = color
        end
        if size then
            TitleIconImage.Size = UDim2.new(0, size, 0, size)
            TitleIconImage.Position = UDim2.new(0, 18, 0.5, -size / 2)
            TitleIconShadow.Size = UDim2.new(0, size, 0, size)
            TitleIconShadow.Position = UDim2.new(0, 18, 0.5, -size / 2 + 2)
            winTitleIconSize = size
            -- 调整标题文字位置
            local newStartX = assetId ~= "" and (18 + size + 10) or 18
            TitleLabel.Position = UDim2.new(0, newStartX, 0, 0)
        end
    end
    
    -- 获取当前登录的卡密信息
    function Window:GetAuthInfo()
        return {
            Verified = AuthSystem.Verified,
            Key = AuthSystem.CurrentKey,
            Info = AuthSystem.CurrentInfo,
            Status = AuthSystem:GetStatus()
        }
    end
    
    -- 手动触发登出
    function Window:Logout()
        AuthSystem:Logout()
        Main.Visible = false
        ShadowLayer1.Visible = false
        ShadowLayer2.Visible = false
        GlowLayer1.Visible = false
        ShowAuthWindow()
    end
    
    function Window:Center()
        CenterWindow()
    end
    
    function Window:SetScrollConfig(speed, smooth, smoothTime)
        if speed then Config.ScrollSpeed = speed end
        if smooth ~= nil then Config.SmoothScroll = smooth end
        if smoothTime then Config.SmoothTime = smoothTime end
    end
    
    return Window
end

return WindUI