            Btn.MouseButton1Click:Connect(function()
                local Overlay = Create("Frame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    BackgroundTransparency = 1,
                    ZIndex = 100,
                    Parent = ScreenGui
                })

                local Modal = Create("Frame", {
                    Size = UDim2.new(0, 300, 0, 0),
                    Position = UDim2.new(0.5, -150, 0.5, 0),
                    BackgroundColor3 = Config.Theme.Background,
                    BorderSizePixel = 0,
                    ZIndex = 101,
                    Parent = Overlay
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Modal})
                Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = Modal})
                ApplyShadow(Modal)

                Create("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 30),
                    Position = UDim2.new(0, 12, 0, 10),
                    BackgroundTransparency = 1,
                    Text = title,
                    TextColor3 = Config.Theme.Text,
                    Font = Config.FontBold,
                    TextSize = 15,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 102,
                    Parent = Modal
                })

                local ContentLabel = Create("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 0),
                    Position = UDim2.new(0, 12, 0, 44),
                    BackgroundTransparency = 1,
                    Text = content,
                    TextColor3 = Config.Theme.TextDim,
                    Font = Config.Font,
                    TextSize = 13,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    ZIndex = 102,
                    Parent = Modal
                })

                local textBounds = TextService:GetTextSize(content, 13, Config.Font, Vector2.new(276, 1000))
                local contentHeight = textBounds.Y + 70
                ContentLabel.Size = UDim2.new(1, -24, 0, contentHeight - 50)

                local ConfirmBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 32),
                    Position = UDim2.new(1, -112, 1, -44),
                    BackgroundColor3 = Config.Theme.Accent,
                    Text = "确定",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.FontBold,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ConfirmBtn})

                local CancelBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 32),
                    Position = UDim2.new(1, -220, 1, -44),
                    BackgroundColor3 = Config.Theme.Tertiary,
                    Text = "取消",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.Font,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = CancelBtn})

                Tween(Overlay, 0.2, {BackgroundTransparency = 0.5})
                Tween(Modal, 0.3, {Size = UDim2.new(0, 300, 0, contentHeight), Position = UDim2.new(0.5, -150, 0.5, -contentHeight/2)})

                local function Close()
                    Tween(Overlay, 0.2, {BackgroundTransparency = 1})
                    Tween(Modal, 0.2, {Size = UDim2.new(0, 300, 0, 0), Position = UDim2.new(0.5, -150, 0.5, 0)})
                    task.wait(0.2)
                    Overlay:Destroy()
                end

                ConfirmBtn.MouseButton1Click:Connect(Close)
                CancelBtn.MouseButton1Click:Connect(Close)
            end)

            return Btn
        end

        return Tab
    end

    -- ============================================
    -- 通知（带进度条动画）
    -- ============================================
    function Window:Notify(title, text, duration)
        duration = duration or 3

        local NotifFrame = Create("Frame", {
            Size = UDim2.new(0, 280, 0, 0),
            Position = UDim2.new(1, -300, 1, -10),
            BackgroundColor3 = Config.Theme.Secondary,
            BorderSizePixel = 0,
            ZIndex = 200,
            Parent = ScreenGui
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = NotifFrame})
        Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = NotifFrame})
        ApplyShadow(NotifFrame)

        Create("Frame", {
            Size = UDim2.new(0, 3, 1, -12),
            Position = UDim2.new(0, 0, 0, 6),
            BackgroundColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 201,
            Parent = NotifFrame
        })

        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 14, 0, 8),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Config.Theme.Text,
            Font = Config.FontBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 201,
            Parent = NotifFrame
        })

        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 14, 0, 28),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 201,
            Parent = NotifFrame
        })

        local ProgressBg = Create("Frame", {
            Size = UDim2.new(1, -16, 0, 3),
            Position = UDim2.new(0, 8, 1, -6),
            BackgroundColor3 = Config.Theme.Tertiary,
            BorderSizePixel = 0,
            ZIndex = 201,
            Parent = NotifFrame
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ProgressBg})

        local ProgressFill = Create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 202,
            Parent = ProgressBg
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ProgressFill})

        Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 62), Position = UDim2.new(1, -300, 1, -74)}, Enum.EasingStyle.Back)

        local progressTween = TweenService:Create(ProgressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)})
        progressTween:Play()

        task.delay(duration, function()
            Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 0), Position = UDim2.new(1, -300, 1, -10)})
            task.wait(0.3)
            NotifFrame:Destroy()
        end)
    end

    -- 切换显示
    function Window:Toggle()
        Main.Visible = not Main.Visible
    end

    -- 设置背景图
    function Window:SetBackground(assetId, transparency, color)
        Config.BackgroundImage = assetId or ""
        Config.BackgroundImageTransparency = transparency or 0.3
        Config.BackgroundImageColor = color or Color3.fromRGB(255, 255, 255)

        if assetId and assetId ~= "" then
            BgImage.Image = assetId
            BgImage.ImageTransparency = Config.BackgroundImageTransparency
            BgImage.ImageColor3 = Config.BackgroundImageColor
            BgImage.Visible = true
            TopBar.BackgroundTransparency = 0.2
            Sidebar.BackgroundTransparency = 0.15
        else
            BgImage.Visible = false
            TopBar.BackgroundTransparency = 0
            Sidebar.BackgroundTransparency = 0
        end
    end

    -- 手动居中
    function Window:Center()
        CenterWindow()
    end

    -- 设置默认公告内容
    function Window:SetAnnouncement(annTitle, annContent, autoShow)
        Config.Announcement.Title = annTitle or Config.Announcement.Title
        Config.Announcement.Content = annContent or Config.Announcement.Content
        if autoShow ~= nil then
            Config.Announcement.AutoShow = autoShow
        end
    end

    -- 自动弹出公告
    if Config.Announcement.AutoShow then
        task.delay(Config.Announcement.AutoShowDelay, function()
            Window:ShowAnnouncement()
        end)
    end

    return Window
end

return WindUI