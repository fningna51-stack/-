                    TextColor3 = Config.Theme.TextDim,
                    Font = Config.Font,
                    TextSize = 13,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    ZIndex = 102,
                    Parent = Modal
                })
                
                local textBounds = TextService:GetTextSize(content, 13, Config.Font, Vector2.new(276, 1000))
                local contentHeight = textBounds.Y + 70
                ContentLabel.Size = UDim2.new(1, -24, 0, contentHeight - 50)
                
                local ConfirmBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 32),
                    Position = UDim2.new(1, -112, 1, -44),
                    BackgroundColor3 = Config.Theme.Accent,
                    Text = "确定",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.FontBold,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ConfirmBtn})
                
                local CancelBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 32),
                    Position = UDim2.new(1, -220, 1, -44),
                    BackgroundColor3 = Config.Theme.Tertiary,
                    Text = "取消",
                    TextColor3 = Config.Theme.Text,
                    Font = Config.Font,
                    TextSize = 13,
                    AutoButtonColor = false,
                    ZIndex = 102,
                    Parent = Modal
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = CancelBtn})
                
                Tween(Overlay, 0.2, {BackgroundTransparency = 0.5})
                Tween(Modal, 0.3, {Size = UDim2.new(0, 300, 0, contentHeight), Position = UDim2.new(0.5, -150, 0.5, -contentHeight/2)})
                
                local function Close()
                    Tween(Overlay, 0.2, {BackgroundTransparency = 1})
                    Tween(Modal, 0.2, {Size = UDim2.new(0, 300, 0, 0), Position = UDim2.new(0.5, -150, 0.5, 0)})
                    task.wait(0.2)
                    Overlay:Destroy()
                end
                
                ConfirmBtn.MouseButton1Click:Connect(Close)
                CancelBtn.MouseButton1Click:Connect(Close)
            end)
            
            return Btn
        end
        
        return Tab
    end
    
    -- 通知
    function Window:Notify(title, text, duration)
        local NotifFrame = Create("Frame", {
            Size = UDim2.new(0, 280, 0, 0),
            Position = UDim2.new(1, -300, 1, -10),
            BackgroundColor3 = Config.Theme.Secondary,
            BorderSizePixel = 0,
            Parent = ScreenGui
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = NotifFrame})
        Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = NotifFrame})
        
        Create("Frame", {
            Size = UDim2.new(0, 3, 1, -12),
            Position = UDim2.new(0, 0, 0, 6),
            BackgroundColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            Parent = NotifFrame
        })
        
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 14, 0, 8),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Config.Theme.Text,
            Font = Config.FontBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = NotifFrame
        })
        
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 14, 0, 28),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = NotifFrame
        })
        
        Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 56), Position = UDim2.new(1, -300, 1, -70)})
        
        task.delay(duration or 3, function()
            Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 0), Position = UDim2.new(1, -300, 1, -10)})
            task.wait(0.3)
            NotifFrame:Destroy()
        end)
    end
    
    -- 切换显示
    function Window:Toggle()
        Main.Visible = not Main.Visible
    end
    
    -- 设置背景图
    function Window:SetBackground(assetId, transparency, color)
        Config.BackgroundImage = assetId or ""
        Config.BackgroundImageTransparency = transparency or 0.3
        Config.BackgroundImageColor = color or Color3.fromRGB(255, 255, 255)
        
        if assetId and assetId ~= "" then
            BgImage.Image = assetId
            BgImage.ImageTransparency = Config.BackgroundImageTransparency
            BgImage.ImageColor3 = Config.BackgroundImageColor
            BgImage.Visible = true
            TopBar.BackgroundTransparency = 0.2
            Sidebar.BackgroundTransparency = 0.15
        else
            BgImage.Visible = false
            TopBar.BackgroundTransparency = 0
            Sidebar.BackgroundTransparency = 0
        end
    end
    
    -- ============================================
    -- 设置最小化图标 (图片ID)
    -- ============================================
    function Window:SetMinimizeIcon(assetId, color)
        Config.MinIconImage = assetId or ""
        Config.MinIconColor = color or Color3.fromRGB(255, 255, 255)
        
        MinIconImage.Image = Config.MinIconImage
        MinIconImage.ImageColor3 = Config.MinIconColor
        
        -- 如果当前是最小化状态, 立即更新显示
        if minimized then
            if Config.MinIconImage ~= "" then
                MinIcon.Text = ""
                MinIconImage.Visible = true
            else
                MinIcon.Text = "W"
                MinIconImage.Visible = false
            end
        end
    end
    
    -- 手动居中
    function Window:Center()
        CenterWindow()
    end
    
    return Window
end

return WindUI