            Position = UDim2.new(0, 14, 0, 28),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = NotifFrame
        })

        Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 56), Position = UDim2.new(1, -300, 1, -70)})

        task.delay(duration or 3, function()
            Tween(NotifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 0), Position = UDim2.new(1, -300, 1, -10)})
            task.wait(0.3)
            NotifFrame:Destroy()
        end)
    end

    function Window:Toggle()
        Main.Visible = not Main.Visible
    end

    function Window:SetBackground(assetId, transparency, color)
        Config.BackgroundImage = assetId or ""
        Config.BackgroundImageTransparency = transparency or 0.3
        Config.BackgroundImageColor = color or Color3.fromRGB(255, 255, 255)

        if assetId and assetId ~= "" then
            BgImage.Image = assetId
            BgImage.ImageTransparency = Config.BackgroundImageTransparency
            BgImage.ImageColor3 = Config.BackgroundImageColor
            BgImage.Visible = true
            TopBar.BackgroundTransparency = 0.2
            Sidebar.BackgroundTransparency = 0.15
        else
            BgImage.Visible = false
            TopBar.BackgroundTransparency = 0
            Sidebar.BackgroundTransparency = 0
        end
    end

    function Window:Center()
        Main.Position = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2)
    end

    return Window
