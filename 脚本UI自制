-- 工具函数
local function Create(className, props)
    local instance = Instance.new(className)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            instance[k] = v
        end
    end
    if props and props.Parent then
        instance.Parent = props.Parent
    end
    return instance
end

local function Tween(obj, time, props, style)
    local tween = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

-- 拖动功能
local function MakeDraggable(frame, handle, getLocked)
    handle = handle or frame
    local dragging, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if getLocked and getLocked() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ============================================
-- 阴影工具
-- ============================================
local function ApplyShadow(parentFrame)
    local shadowLayers = {
        {expand = 10, transparency = 0.92},
        {expand = 7,  transparency = 0.88},
        {expand = 4,  transparency = 0.82},
        {expand = 2,  transparency = 0.75},
    }

    for _, layer in ipairs(shadowLayers) do
        local shadow = Create("Frame", {
            Name = "Shadow",
            Size = UDim2.new(1, layer.expand * 2, 1, layer.expand * 2),
            Position = UDim2.new(0, -layer.expand, 0, -layer.expand),
            BackgroundColor3 = Config.Theme.Shadow,
            BackgroundTransparency = layer.transparency,
            BorderSizePixel = 0,
            ZIndex = -1,
            Parent = parentFrame
        })
        Create("UICorner", {
            CornerRadius = UDim.new(0, 16),
            Parent = shadow
        })
        local inner = Create("Frame", {
            Name = "Inner",
            Size = UDim2.new(1, -layer.expand * 2 + 4, 1, -layer.expand * 2 + 4),
            Position = UDim2.new(0, layer.expand - 2, 0, layer.expand - 2),
            BackgroundColor3 = Config.Theme.Shadow,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = -1,
            Parent = shadow
        })
        Create("UICorner", {
            CornerRadius = UDim.new(0, 14),
            Parent = inner
        })
    end
end

