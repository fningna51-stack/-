            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14),
            Parent = Page
        })
        
        local function UpdateCanvas()
            local layout = Page:FindFirstChildOfClass("UIListLayout")
            if layout then
                Page.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 24)
                PageScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 24)
            end
        end
        
        Page.ChildAdded:Connect(function()
            task.wait()
            UpdateCanvas()
        end)
        Page.ChildRemoved:Connect(function()
            task.wait()
            UpdateCanvas()
        end)
        
        local layout = Page:FindFirstChildOfClass("UIListLayout")
        if layout then
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
        end
        
        local scrollController = SetupSmoothScroll(PageScroll)
        Tab.ScrollController = scrollController
        
        PageScroll.MouseEnter:Connect(function()
            Tween(PageScroll, 0.15, {ScrollBarImageTransparency = 0.1})
        end)
        PageScroll.MouseLeave:Connect(function()
            Tween(PageScroll, 0.15, {ScrollBarImageTransparency = 0.3})
        end)
        
        local function SelectTab()
            if activeTab == Tab then return end
            
            for _, t in pairs(Tabs) do
                t.Scroll.Visible = false
                Tween(t.Label, 0.15, {TextColor3 = Config.Theme.TextDim})
                Tween(t.Icon, 0.15, {TextColor3 = Config.Theme.TextDim})
                Tween(t.Btn, 0.15, {BackgroundColor3 = Config.Theme.Secondary, BackgroundTransparency = 1})
                Tween(t.Indicator, 0.15, {Size = UDim2.new(0, 3, 0, 0)})
            end
            
            PageScroll.Visible = true
            Tween(TabLabel, 0.15, {TextColor3 = Config.Theme.Text})
            Tween(TabIcon, 0.15, {TextColor3 = Config.Theme.Accent})
            Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Tertiary, BackgroundTransparency = 0})
            Tween(Indicator, 0.2, {Size = UDim2.new(0, 3, 0, 16)})
            activeTab = Tab
            
            task.wait()
            scrollController.SetY(0)
        end
        
        TabBtn.MouseButton1Click:Connect(SelectTab)
        TabBtn.MouseEnter:Connect(function()
            if activeTab ~= Tab then
                Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Tertiary, BackgroundTransparency = 0.5})
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if activeTab ~= Tab then
                Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Secondary, BackgroundTransparency = 1})
            end
        end)
        
        Tab.Btn = TabBtn
        Tab.Label = TabLabel
        Tab.Icon = TabIcon
        Tab.Indicator = Indicator
        Tab.Page = Page
        Tab.Scroll = PageScroll
        Tab.UpdateCanvas = UpdateCanvas
        Tabs[#Tabs + 1] = Tab
        
        if #Tabs == 1 then
            SelectTab()
        end
        
