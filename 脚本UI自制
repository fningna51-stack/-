local AuthSystem = {
    -- 卡密列表 (可自行添加)
    Keys = {
        -- ["KEY-XXXX-XXXX-XXXX"] = { Expire = 0 (永久) 或 时间戳, Uses = -1 (无限) 或次数 },
        -- 示例:
        -- ["WIND-2024-PRO-0001"] = { Expire = 0, Uses = -1 },
        -- ["WIND-TRIAL-7DAY-01"] = { Expire = os.time() + 7 * 86400, Uses = -1 },
    },
    
    -- 已使用记录 (运行时缓存, 也可持久化)
    UsedKeys = {},
    
    -- 当前登录信息
    CurrentKey = nil,
    CurrentInfo = nil,
    
    -- 验证状态
    Verified = false,
    
    -- 是否启用验证 (关闭后直接跳过)
    Enabled = true,
    
    -- 回调
    OnSuccess = nil,
    OnFail = nil
}

-- 生成默认示例卡密 (仅用于演示)
if next(AuthSystem.Keys) == nil then
    AuthSystem.Keys["WIND-2024-PRO-0001"] = { Expire = 0, Uses = -1 }
    AuthSystem.Keys["WIND-2024-PRO-0002"] = { Expire = 0, Uses = -1 }
    AuthSystem.Keys["WIND-TRIAL-7DAY-01"] = { Expire = os.time() + 7 * 86400, Uses = 1 }
end

-- 验证卡密
function AuthSystem:Verify(key)
    if not key or key == "" then
        return false, "请输入卡密"
    end
    
    key = string.upper(string.gsub(key, "%s", ""))
    
    if not self.Keys[key] then
        return false, "卡密无效"
    end
    
    local info = self.Keys[key]
    
    -- 检查过期
    if info.Expire and info.Expire > 0 and os.time() > info.Expire then
        return false, "卡密已过期"
    end
    
    -- 检查使用次数
    if info.Uses and info.Uses >= 0 then
        local used = self.UsedKeys[key] or 0
        if used >= info.Uses then
            return false, "卡密已用尽"
        end
    end
    
    -- 记录使用
    self.UsedKeys[key] = (self.UsedKeys[key] or 0) + 1
    self.CurrentKey = key
    self.CurrentInfo = info
    self.Verified = true
    
    return true, "验证成功"
end

-- 登出
function AuthSystem:Logout()
    self.CurrentKey = nil
    self.CurrentInfo = nil
    self.Verified = false
end

-- 获取当前状态
function AuthSystem:GetStatus()
    if not self.Verified then
        return "未登录"
    end
    local info = self.CurrentInfo
    if info.Expire == 0 then
        return "永久卡密"
    else
        local remain = info.Expire - os.time()
        if remain <= 0 then
            return "已过期"
        end
        local days = math.floor(remain / 86400)
        return "剩余 " .. days .. " 天"
    end
end

-- 添加卡密
function AuthSystem:AddKey(key, expire, uses)
    self.Keys[string.upper(key)] = {
        Expire = expire or 0,
        Uses = uses or -1
    }
end

-- 移除卡密
function AuthSystem:RemoveKey(key)
    self.Keys[string.upper(key)] = nil
end

-- 外部引用
WindUI.AuthSystem = AuthSystem

-- 工具函数
local function Create(className, props)
    local instance = Instance.new(className)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            instance[k] = v
        end
    end
    if props and props.Parent then
        instance.Parent = props.Parent
    end
    return instance
end

local function Tween(obj, time, props, style)
    local tween = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

-- 拖动功能
local function MakeDraggable(frame, handle, getLocked)
    handle = handle or frame
    local dragging, dragStart, startPos
    
    handle.InputBegan:Connect(function(input)
        if getLocked and getLocked() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- 平滑滑动控制器
local function SetupSmoothScroll(scrollFrame)
    local targetY = 0
    local currentY = 0
    local isDragging = false
    local dragStartY = 0
    local dragStartCanvas = 0
    local lastInputTime = 0
    local velocity = 0
    
    local function GetMaxScroll()
        return math.max(0, scrollFrame.AbsoluteCanvasSize.Y - scrollFrame.AbsoluteWindowSize.Y)
    end
    
    local function SetCanvasY(y)
        y = math.clamp(y, 0, GetMaxScroll())
        scrollFrame.CanvasPosition = Vector2.new(0, y)
        currentY = y
        targetY = y
    end
    
    scrollFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if GetMaxScroll() <= 0 then return end
            local delta = -input.Position.Z * Config.ScrollSpeed
            targetY = math.clamp(targetY + delta, 0, GetMaxScroll())
            if not Config.SmoothScroll then SetCanvasY(targetY) end
        end
    end)
    
    RunService.RenderStepped:Connect(function(dt)
        if isDragging then return end
        if not Config.SmoothScroll then return end
        local diff = targetY - currentY
        if math.abs(diff) > 0.5 then
            currentY = currentY + diff * math.min(1, dt * (1 / Config.SmoothTime) * 4)
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        elseif math.abs(diff) > 0.01 then
            currentY = targetY
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        end
    end)
    
    scrollFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            dragStartY = input.Position.Y
            dragStartCanvas = scrollFrame.CanvasPosition.Y
            targetY = dragStartCanvas
            currentY = dragStartCanvas
            velocity = 0
            lastInputTime = tick()
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local deltaY = input.Position.Y - dragStartY
            local newY = math.clamp(dragStartCanvas - deltaY, 0, GetMaxScroll())
            local now = tick()
            local dt = now - lastInputTime
            if dt > 0 then velocity = (newY - currentY) / dt end
            lastInputTime = now
            currentY = newY
            targetY = newY
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
            if math.abs(velocity) > 30 then
                local momentum = velocity * 0.15
                targetY = math.clamp(currentY + momentum, 0, GetMaxScroll())
            end
        end
    end)
    
    return {
        SetY = function(y) SetCanvasY(y) end,
        GetY = function() return currentY end,
        ScrollTo = function(y) targetY = math.clamp(y, 0, GetMaxScroll()) end
    }
end

