-- 工具函数
local function Create(className, props)
    local instance = Instance.new(className)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            instance[k] = v
        end
    end
    if props and props.Parent then
        instance.Parent = props.Parent
    end
    return instance
end

local function Tween(obj, time, props, style)
    local tween = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

-- 拖动功能
local function MakeDraggable(frame, handle, getLocked)
    handle = handle or frame
    local dragging, dragStart, startPos
    
    handle.InputBegan:Connect(function(input)
        if getLocked and getLocked() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ============================================
-- 平滑滑动控制器 (核心)
-- ============================================
local function SetupSmoothScroll(scrollFrame)
    local targetY = 0
    local currentY = 0
    local isDragging = false
    local dragStartY = 0
    local dragStartCanvas = 0
    local lastInputTime = 0
    local velocity = 0
    local momentumConn = nil
    
    local function GetMaxScroll()
        return math.max(0, scrollFrame.AbsoluteCanvasSize.Y - scrollFrame.AbsoluteWindowSize.Y)
    end
    
    local function SetCanvasY(y)
        y = math.clamp(y, 0, GetMaxScroll())
        scrollFrame.CanvasPosition = Vector2.new(0, y)
        currentY = y
        targetY = y
    end
    
    -- 滚轮滚动 (平滑)
    scrollFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if GetMaxScroll() <= 0 then return end
            
            local delta = -input.Position.Z * Config.ScrollSpeed
            targetY = math.clamp(targetY + delta, 0, GetMaxScroll())
            
            if not Config.SmoothScroll then
                SetCanvasY(targetY)
            end
        end
    end)
    
    -- 平滑滚动更新
    RunService.RenderStepped:Connect(function(dt)
        if isDragging then return end
        if not Config.SmoothScroll then return end
        
        -- 阻尼平滑
        local diff = targetY - currentY
        if math.abs(diff) > 0.5 then
            currentY = currentY + diff * math.min(1, dt * (1 / Config.SmoothTime) * 4)
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        elseif math.abs(diff) > 0.01 then
            currentY = targetY
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        end
    end)
    
    -- 触摸 / 鼠标拖动滑动
    local dragInput
    scrollFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- 检查是否点在交互组件上, 是则不触发拖动滚动
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                -- 鼠标: 允许拖动空白区域
                isDragging = true
                dragStartY = input.Position.Y
                dragStartCanvas = scrollFrame.CanvasPosition.Y
                targetY = dragStartCanvas
                currentY = dragStartCanvas
                velocity = 0
                lastInputTime = tick()
            else
                -- 触摸: 直接拖动
                isDragging = true
                dragStartY = input.Position.Y
                dragStartCanvas = scrollFrame.CanvasPosition.Y
                targetY = dragStartCanvas
                currentY = dragStartCanvas
                velocity = 0
                lastInputTime = tick()
            end
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local deltaY = input.Position.Y - dragStartY
            local newY = math.clamp(dragStartCanvas - deltaY, 0, GetMaxScroll())
            
            -- 计算速度
            local now = tick()
            local dt = now - lastInputTime
            if dt > 0 then
                velocity = (newY - currentY) / dt
            end
            lastInputTime = now
            
            currentY = newY
            targetY = newY
            scrollFrame.CanvasPosition = Vector2.new(0, currentY)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
            
            -- 惯性滚动
            if math.abs(velocity) > 30 then
                local momentum = velocity * 0.15
                targetY = math.clamp(currentY + momentum, 0, GetMaxScroll())
            end
        end
    end)
    
    -- 阻止子组件上的滚轮冒泡
    scrollFrame.MouseEnter:Connect(function()
        -- 确保鼠标进入时, 滚轮响应正常
    end)
    
    return {
        SetY = function(y) SetCanvasY(y) end,
        GetY = function() return currentY end,
        ScrollTo = function(y) 
            targetY = math.clamp(y, 0, GetMaxScroll())
        end
    }
end

-- 阴影生成器
local function AddShadow(parent, radius, spread, transparency)
    if not Config.ShadowEnabled then return end
    
    local shadowContainer = Create("Frame", {
        Name = "Shadow",
        Size = UDim2.new(1, spread or 12, 1, spread or 12),
        Position = UDim2.new(0, -(spread or 12)/2, 0, -(spread or 12)/2),
        BackgroundTransparency = 1,
        ZIndex = -10,
        Parent = parent
    })
    
    local outer = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Config.Theme.Shadow,
        BackgroundTransparency = transparency or 0.75,
        BorderSizePixel = 0,
        ZIndex = -10,
        Parent = shadowContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, radius or 20), Parent = outer})
    
    local mid = Create("Frame", {
        Size = UDim2.new(1, -4, 1, -4),
        Position = UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = Config.Theme.Shadow,
        BackgroundTransparency = (transparency or 0.75) + 0.1,
        BorderSizePixel = 0,
        ZIndex = -9,
        Parent = shadowContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, radius or 20), Parent = mid})
    
    local inner = Create("Frame", {
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundColor3 = Config.Theme.Shadow,
        BackgroundTransparency = (transparency or 0.75) + 0.2,
        BorderSizePixel = 0,
        ZIndex = -8,
        Parent = shadowContainer
    })
    Create("UICorner", {CornerRadius = UDim.new(0, radius or 20), Parent = inner})
    
    return shadowContainer
end

