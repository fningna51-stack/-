        Size = UDim2.new(1, -8, 1, -16),
        Position = UDim2.new(0, 4, 0, 8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Config.Theme.Border,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 3,
        Parent = Sidebar
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabContainer
    })

    -- 内容区
    local Content = Create("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -140, 1, -45),
        Position = UDim2.new(0, 140, 0, 45),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = Main
    })

    local Tabs = {}
    local activeTab = nil

    -- 状态
    local minimized = false
    local normalPos = UDim2.new(0.5, -WINDOW_W / 2, 0.5, -WINDOW_H / 2)
    local squarePos = UDim2.new(0.5, -SQUARE_SIZE / 2, 0, 20)

    -- 拖动
    MakeDraggable(Main, TopBar, function() return minimized end)
    MakeDraggable(Main, Main, function() return not minimized end)

    -- 打开动画
    Main.Size = UDim2.new(0, WINDOW_W - 30, 0, WINDOW_H - 20)
    Main.BackgroundTransparency = 0.4
    task.wait()
    Tween(Main, 0.3, {Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H)})
    Tween(Main, 0.3, {BackgroundTransparency = 0})

    -- ============================================
    -- 通用确认弹窗 (放在字的下方)
    -- ============================================
    local function ShowConfirm(title, content, confirmText, cancelText, onConfirm, onCancel)
        local Overlay = Create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1,
            ZIndex = 200,
            Parent = ScreenGui
        })

        -- 计算文字高度
        local textBounds = TextService:GetTextSize(content, 13, Config.Font, Vector2.new(276, 1000))
        local contentH = math.max(textBounds.Y, 20)
        -- 标题30 + 间距 + 内容H + 按钮间距 + 按钮34 + 底部padding
        local modalH = 14 + 24 + 8 + contentH + 20 + 34 + 16

        local Modal = Create("Frame", {
            Size = UDim2.new(0, 300, 0, 0),
            Position = UDim2.new(0.5, -150, 0.5, 0),
            BackgroundColor3 = Config.Theme.Background,
            BorderSizePixel = 0,
            ZIndex = 201,
            Parent = Overlay
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Modal})
        Create("UIStroke", {Color = Config.Theme.Border, Thickness = 1, Parent = Modal})

        -- 标题
        Create("TextLabel", {
            Size = UDim2.new(1, -28, 0, 24),
            Position = UDim2.new(0, 14, 0, 14),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Config.Theme.Text,
            Font = Config.FontBold,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 202,
            Parent = Modal
        })

        -- 内容
        Create("TextLabel", {
            Size = UDim2.new(1, -28, 0, contentH),
            Position = UDim2.new(0, 14, 0, 46),
            BackgroundTransparency = 1,
            Text = content,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 202,
            Parent = Modal
        })

        -- 按钮放在内容下方
        local btnY = 46 + contentH + 20

        local ConfirmBtn = Create("TextButton", {
            Size = UDim2.new(1, -28, 0, 34),
            Position = UDim2.new(0, 14, 0, btnY),
            BackgroundColor3 = Config.Theme.Accent,
            Text = confirmText or "确定",
            TextColor3 = Config.Theme.Text,
            Font = Config.FontBold,
            TextSize = 13,
            AutoButtonColor = false,
            ZIndex = 202,
            Parent = Modal
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ConfirmBtn})

        local CancelBtn = Create("TextButton", {
            Size = UDim2.new(1, -28, 0, 34),
            Position = UDim2.new(0, 14, 0, btnY + 40),
            BackgroundColor3 = Config.Theme.Tertiary,
            Text = cancelText or "取消",
            TextColor3 = Config.Theme.Text,
            Font = Config.Font,
            TextSize = 13,
            AutoButtonColor = false,
            ZIndex = 202,
            Parent = Modal
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = CancelBtn})

        -- 记录总高度用于动画
        local totalH = btnY + 40 + 34 + 16

        Tween(Overlay, 0.2, {BackgroundTransparency = 0.5})
        Tween(Modal, 0.3, {
            Size = UDim2.new(0, 300, 0, totalH),
            Position = UDim2.new(0.5, -150, 0.5, -totalH / 2)
        })

        local function Close()
            Tween(Overlay, 0.2, {BackgroundTransparency = 1})
            Tween(Modal, 0.2, {Size = UDim2.new(0, 300, 0, 0), Position = UDim2.new(0.5, -150, 0.5, 0)})
            task.wait(0.2)
            Overlay:Destroy()
        end

        ConfirmBtn.MouseButton1Click:Connect(function()
            Close()
            if onConfirm then onConfirm() end
        end)
        CancelBtn.MouseButton1Click:Connect(function()
            Close()
            if onCancel then onCancel() end
        end)

        return Modal
    end

    -- ============================================
    -- 关闭按钮: 弹确认框
    -- ============================================
    CloseBtn.MouseButton1Click:Connect(function()
        ShowConfirm(
            "关闭界面",
            "关闭后需要重新加载脚本才能再次打开此界面，确定要关闭吗？",
            "确定关闭",
            "取消",
            function()
                Tween(Main, 0.2, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
                task.wait(0.2)
                ScreenGui:Destroy()
            end
        )
    end)

    -- ============================================
    -- 最小化
    -- ============================================
    local MinIcon = Create("TextLabel", {
        Name = "MinIcon",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "W",
        TextColor3 = Config.Theme.Text,
        Font = Config.FontBold,
        TextSize = 22,
        ZIndex = 10,
        Visible = false,
        Parent = Main
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = MinIcon})

    local squarePressTime = 0
    local squareMoved = false

    MinBtn.MouseButton1Click:Connect(function()
        if not minimized then
            minimized = true
            normalPos = Main.Position

            Content.Visible = false
            Sidebar.Visible = false
            TopBar.Visible = false
            BgImage.Visible = false
            MinIcon.Visible = true

            Tween(Main, 0.35, {
                Size = UDim2.new(0, SQUARE_SIZE, 0, SQUARE_SIZE),
                Position = squarePos,
                BackgroundColor3 = Config.Theme.Accent
            }, Enum.EasingStyle.Back)
        end
    end)

    Main.InputBegan:Connect(function(input)
        if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            squarePressTime = tick()
            squareMoved = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if minimized and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if squarePressTime > 0 and tick() - squarePressTime < 0.5 then
                squareMoved = true
            end
        end
    end)

    Main.InputEnded:Connect(function(input)
        if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            if not squareMoved and (tick() - squarePressTime) < 0.3 then
                minimized = false
                MinIcon.Visible = false

                Tween(Main, 0.35, {
                    Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H),
                    Position = normalPos,
                    BackgroundColor3 = Config.Theme.Background
                }, Enum.EasingStyle.Back)

                task.wait(0.1)
                Content.Visible = true
                Sidebar.Visible = true
                TopBar.Visible = true
                BgImage.Visible = Config.BackgroundImage ~= ""
            end
            squarePressTime = 0
            squareMoved = false
        end
    end)

    -- ============================================
    -- 添加标签页 (支持图片)
    -- ============================================
    function Window:AddTab(name, icon, imageId)
        local Tab = {}

        local TabBtn = Create("TextButton", {
            Name = name .. "Tab",
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Config.Theme.Secondary,
            BackgroundTransparency = Config.BackgroundImage ~= "" and 0.3 or 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 4,
            Parent = TabContainer
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = TabBtn})

        local IconLabel
        if imageId and imageId ~= "" then
            -- 用图片作为标签图标
            IconLabel = Create("ImageLabel", {
                Size = UDim2.new(0, 20, 0, 20),
                Position = UDim2.new(0, 8, 0.5, -10),
                BackgroundTransparency = 1,
                Image = imageId,
                ImageColor3 = Config.Theme.TextDim,
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 5,
                Parent = TabBtn
            })
        else
            IconLabel = Create("TextLabel", {
                Size = UDim2.new(0, 24, 1, 0),
                Position = UDim2.new(0, 6, 0, 0),
                BackgroundTransparency = 1,
                Text = icon or "●",
                TextColor3 = Config.Theme.TextDim,
                Font = Config.Font,
                TextSize = 14,
                ZIndex = 5,
                Parent = TabBtn
            })
        end

        local TabLabel = Create("TextLabel", {
            Size = UDim2.new(1, -34, 1, 0),
            Position = UDim2.new(0, 34, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Config.Theme.TextDim,
            Font = Config.Font,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 5,
            Parent = TabBtn
        })

        local Indicator = Create("Frame", {
            Size = UDim2.new(0, 3, 0, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 5,
            Parent = TabBtn
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = Indicator})

        local Page = Create("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Config.Theme.Border,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false,
            ZIndex = 3,
            Parent = Content
        })
        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Page
        })
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            Parent = Page
        })

        local function SetIconColor(c)
            if IconLabel.ClassName == "ImageLabel" then
                IconLabel.ImageColor3 = c
            else
                IconLabel.TextColor3 = c
            end
        end

        local function SelectTab()
            if activeTab == Tab then return end

            for _, t in pairs(Tabs) do
                t.Page.Visible = false
                Tween(t.Label, 0.15, {TextColor3 = Config.Theme.TextDim})
                Tween(t.Icon, 0.15, {TextColor3 = Config.Theme.TextDim, ImageColor3 = Config.Theme.TextDim})
                Tween(t.Btn, 0.15, {BackgroundColor3 = Config.Theme.Secondary, BackgroundTransparency = Config.BackgroundImage ~= "" and 0.3 or 0})
                Tween(t.Indicator, 0.15, {Size = UDim2.new(0, 3, 0, 0)})
            end

            Page.Visible = true
            Tween(TabLabel, 0.15, {TextColor3 = Config.Theme.Text})
            Tween(IconLabel, 0.15, {TextColor3 = Config.Theme.Accent, ImageColor3 = Config.Theme.Accent})
            Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Tertiary, BackgroundTransparency = Config.BackgroundImage ~= "" and 0.2 or 0})
            Tween(Indicator, 0.2, {Size = UDim2.new(0, 3, 0, 18)})
            activeTab = Tab
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)
        TabBtn.MouseEnter:Connect(function()
            if activeTab ~= Tab then
                Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Tertiary})
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if activeTab ~= Tab then
                Tween(TabBtn, 0.15, {BackgroundColor3 = Config.Theme.Secondary, BackgroundTransparency = Config.BackgroundImage ~= "" and 0.3 or 0})
            end
        end)

        Tab.Btn = TabBtn
        Tab.Label = TabLabel
        Tab.Icon = IconLabel
        Tab.Indicator = Indicator
        Tab.Page = Page
        Tabs[#Tabs + 1] = Tab

        if #Tabs == 1 then
            SelectTab()
        end

        -- ========== 组件 ==========

        function Tab:AddSection(text)
            local Section = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                Parent = Page
            })
            Create("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Config.Theme.TextDim,
                Font = Config.FontBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Section
            })
            return Section
        end

        function Tab:AddDivider()
            return Create("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = Config.Theme.Border,
                BorderSizePixel = 0,
                Parent = Page
            })
        end

        -- 开关
        function Tab:AddToggle(name, default, callback)
            local state = default or false
            local Toggle = {}

            local Frame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = Config.Theme.Secondary,
                BackgroundTransparency = Config.BackgroundImage ~= "" and 0.2 or 0,
                BorderSizePixel = 0,
                Parent = Page
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Frame})

            Create("TextLabel", {
                Size = UDim2.new(0, 200, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = name,
                TextColor3 = Config.Theme.Text,
                Font = Config.Font,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Frame
            })

            local Switch = Create("Frame", {
                Size = UDim2.new(0, 36, 0, 20),
                Position = UDim2.new(1, -48, 0.5, -10),
                BackgroundColor3 = state and Config.Theme.Accent or Config.Theme.Tertiary,
                BorderSizePixel = 0,
                Parent = Frame
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Switch})

            local Knob = Create("Frame", {
                Size = UDim2.new(0, 14, 0, 14),
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = Config.Theme.Text,
                BorderSizePixel = 0,
                Parent = Switch
            })
            Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})

            local Btn = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                Parent = Frame
            })

            function Toggle:Set(value)
                state = value
                Tween(Switch, 0.2, {BackgroundColor3 = state and Config.Theme.Accent or Config.Theme.Tertiary})
