			local origin = hrp.Position
			pcall(function()
				local held = char:GetAttribute("HoldingWeapon")
				if held then
					local weapon = char:FindFirstChild(held)
					if weapon then
						local fireFrom = weapon:FindFirstChild("FireFrom")
						if fireFrom then origin = fireFrom.Position end
					end
				end
			end)
			local isGuard = localPlayer:GetAttribute("IsGuard")
			local live = workspace:FindFirstChild("Live")
			local closest = nil
			local minDist = math.huge
			if live then
				for _, child in pairs(live:GetChildren()) do
					if child ~= char and not child:FindFirstChild("Dead") and not child:FindFirstChild("IFrame") then
						local humanoid = child:FindFirstChild("Humanoid")
						if not (humanoid and humanoid.Health <= 0) then
							local head = child:FindFirstChild("Head") or child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart", true)
							if head then
								local chrp = child:FindFirstChild("HumanoidRootPart")
								local isValid = false
								if child:FindFirstChild("Enemy") or string.match(string.lower(child.Name), "peabert") then
									isValid = true
								elseif isGuard then
									local canKill = child:FindFirstChild("GuardCanKill") or (chrp and chrp:FindFirstChild("GuardCanKillLockOn"))
									if canKill then isValid = true end
								else
									local plr = Players:GetPlayerFromCharacter(child)
									local attr = plr and plr ~= localPlayer and plr:GetAttribute("IsGuard") or child.Name:match("Rebel") or child.Name:match("Guard") or child:FindFirstChild("PlayerCanKill") or child:FindFirstChild("TypeOfGuard")
									if attr then isValid = true end
								end
								local guardType = isGuard and child:FindFirstChild("TypeOfGuard")
								if guardType then
									guardType = not (chrp and chrp:FindFirstChild("GuardCanKillLockOn"))
								end
								if guardType and not child:FindFirstChild("GuardCanKill") then
									isValid = false
								end
								if isValid then
									local dist = (head.Position - origin).Magnitude
									if dist < minDist and dist < 1000 then
										minDist = dist
										closest = head
									end
								end
							end
						end
					end
				end
			end
			if closest then
				targetPos = closest.Position
				args.CustomFireFrom = true
				args.spread = 0
			end
			return originalFiredGun(char, targetPos, args, ...)
		end
	end)
end

