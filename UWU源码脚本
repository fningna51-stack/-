			table.insert(_G.BandageConns, RunService.Heartbeat:Connect(function()
				if not _G.BandageHelperActive then return end
				if shared.IsInCutscene then shared.IsInCutscene = nil end
				local character = localPlayer.Character
				if not character then return end
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local hrp = character:FindFirstChild("HumanoidRootPart")
				for _, attr in ipairs(removeAttrs) do
					if character:GetAttribute(attr) ~= nil then character:SetAttribute(attr, nil) end
					if humanoid and humanoid:GetAttribute(attr) ~= nil then humanoid:SetAttribute(attr, nil) end
