LightsOutBox:AddToggle("dashAssistEnabled", {
	Text = "Dash Assist",
	Default = false,
	Tooltip = "Auto-aim during dash",
	Callback = function(v)
		tbl.dashAssistEnabled = v
		if v then
			local function setupDash(character)
				local humanoid = character:FindFirstChild("Humanoid")
				if not humanoid then return end
				local animator = humanoid:FindFirstChildOfClass("Animator")
				if not animator then return end
				table.insert(dashConns, animator.AnimationPlayed:Connect(function(anim)
					if not tbl.dashAssistEnabled then return end
					if anim.Animation and string.find(tostring(anim.Animation.AnimationId), "99157505926076", 1, true) then
						dashActive = true
						local h = character:FindFirstChild("Humanoid")
						if h then h.AutoRotate = false end
						anim.Stopped:Once(function()
							dashActive = false
							local h2 = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
							if h2 then h2.AutoRotate = true end
						end)
					end
				end))
			end
			if localPlayer.Character then setupDash(localPlayer.Character) end
			table.insert(dashConns, localPlayer.CharacterAdded:Connect(function(c)
				task.wait(0.5)
				if tbl.dashAssistEnabled then setupDash(c) end
			end))
			table.insert(dashConns, RunService.Heartbeat:Connect(function()
				if not tbl.dashAssistEnabled or not dashActive then return end
				if not isCurrentGame("LightsOut") then return end
				local character = localPlayer.Character
				character = character and character:FindFirstChild("HumanoidRootPart")
				if not character then return end
				local minDist = math.huge
				local target = nil
				for _, player in pairs(Players:GetPlayers()) do
					if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
						local dist = (player.Character.HumanoidRootPart.Position - character.Position).Magnitude
						if dist < minDist then minDist = dist; target = player end
					end
				end
				if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
					local pos = target.Character.HumanoidRootPart.Position
					character.CFrame = CFrame.lookAt(character.Position, Vector3.new(pos.X, character.Position.Y, pos.Z))
				end
			end))
		else
			dashActive = false
			for _, c in pairs(dashConns) do
				pcall(function() c:Disconnect() end)
			end
			table.clear(dashConns)
		end
	end,
})

