-- Tug of War
tbl.tugOfWarAutoPullEnabled = false
tbl.tugOfWarPullHelperEnabled = false
tbl2.tugOfWarAutoPullThread = nil

local function angleDiff(a, b)
	return math.abs((a - b + 180) % 360 - 180)
end

local function tugOfWarLogic()
	local flag3 = false
	if flag3 then return end
	flag3 = true
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then flag3 = false; return end
	local tugOfWarUIV2 = playerGui:WaitForChild("TugOfWarUIV2", 5)
	if not tugOfWarUIV2 then flag3 = false; return end
	local tugofWarRemake = tugOfWarUIV2:FindFirstChild("TugofWarRemake")
	if not tugofWarRemake then flag3 = false; return end
	local circleBase = tugofWarRemake:FindFirstChild("CircleBase")
	if not circleBase then flag3 = false; return end

	while true do
		if tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled then
			local attr = nil
			pcall(function()
				attr = localPlayer:GetAttribute("TugOfWarPhase")
			end)
			if attr == "QTE" then
				break
			else
				task.wait(0.1)
				continue
			end
		end
		break
	end

	if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then
		flag3 = false
		return
	end

	if not circleBase.Visible then
		local now = tick()
		while (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) and not circleBase.Visible and tick() - now < 10 do
			task.wait(0.1)
		end
	end

	if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then
		flag3 = false
		return
	end

	local arrow = circleBase:FindFirstChild("Arrow")
	if not arrow then flag3 = false; return end
	local medium = circleBase:FindFirstChild("Medium")
	if not medium then
		medium = circleBase:FindFirstChild("Small") or circleBase:FindFirstChild("Large")
	end
	if not medium then flag3 = false; return end

	local threshold = (localPlayer:GetAttribute("TugOfWarStrategy") or "Standard") == "Stall" and 14 or 18.2

	tbl3.lastPressTime = 0
	local n3 = 0.12
	local flag4 = false
	local connection2 = nil
	local connection3 = nil

	local function cleanup()
		if connection2 then connection2:Disconnect(); connection2 = nil end
		if connection3 then connection3:Disconnect(); connection3 = nil end
		flag3 = false
	end

	connection3 = localPlayer.ChildAdded:Connect(function(child)
		if child.Name == "QTEOver" then cleanup() end
	end)

	connection2 = RunService.RenderStepped:Connect(function()
		if not arrow or not arrow.Parent or not circleBase.Visible then cleanup(); return end
		if not (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) then cleanup(); return end
		if not isCurrentGame("TugOfWar") then cleanup(); return end

		local rotation = arrow.Rotation % 360
		local flag5 = angleDiff(medium.Rotation % 360, rotation) <= threshold

		if tbl.tugOfWarPullHelperEnabled then
			medium.Rotation = rotation
			flag5 = true
		end

		if tbl.tugOfWarAutoPullEnabled then
			if tbl.tugOfWarPullHelperEnabled then
				if tick() - (tbl3.lastPressTime or 0) > 0.25 then
					pressKey("space")
					tbl3.lastPressTime = tick()
				end
			else
				local flag6 = flag5 and not flag4
				if flag6 then
					flag6 = tick() - (tbl3.lastPressTime or 0) > n3
				end
				if flag6 then
					pressKey("space")
					tbl3.lastPressTime = tick()
				end
			end
		end
		flag4 = flag5
	end)

	task.spawn(function()
		while flag3 and (tbl.tugOfWarAutoPullEnabled or tbl.tugOfWarPullHelperEnabled) and isCurrentGame("TugOfWar") do
			task.wait(1)
		end
		cleanup()
	end)
end

-- Kill Hiders
tbl.killHidersEnabled = false
