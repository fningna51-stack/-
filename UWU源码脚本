					_G.CreatedSpikePlatforms = _G.CreatedSpikePlatforms or {}
					local function handleObject(obj)
						if not obj or not obj.Parent or obj.Name == "SafeSpikePlatform" then return end
						local name = string.lower(obj.Name)
						if string.find(name, "spike") or string.find(name, "kill") or string.find(name, "trap") or string.find(name, "hazard") then
							if _G.CreatedSpikePlatforms[obj] then return end
							local function createPlatform(cf, size)
								local part = Instance.new("Part")
								part.Name = "SafeSpikePlatform"
								part.Size = Vector3.new(size.X + 1, 0.5, size.Z + 1)
								part.CFrame = cf * CFrame.new(0, size.Y / 2 + 2.5, 0)
								part.Anchored = true
								part.CanCollide = true
								part.CanTouch = false
								part.Transparency = 1
								part.Material = Enum.Material.SmoothPlastic
								part.Parent = workspace
								_G.CreatedSpikePlatforms[obj] = part
								local conn = obj.Destroying:Connect(function()
									if part and part.Parent then part:Destroy() end
									_G.CreatedSpikePlatforms[obj] = nil
									if conn then conn:Disconnect() end
								end)
							end
							if obj:IsA("BasePart") then
								createPlatform(obj.CFrame, obj.Size)
							elseif obj:IsA("Model") then
								local box, size = obj:GetBoundingBox()
								if size.Magnitude > 0 then createPlatform(box, size) end
							end
						end
					end
					local function scanAll()
						local map = workspace:FindFirstChild("HideAndSeekMap") or workspace
						local count = 0
						for _, d in ipairs(map:GetDescendants()) do
							if _G.AntiSpikeThread then
								handleObject(d)
								count += 1
								if count % 500 == 0 then task.wait() end
								continue
							end
							break
						end
					end
					local conn = workspace.DescendantAdded:Connect(function(d)
						if _G.AntiSpikeEnabled and isCurrentGame("HideAndSeek") then handleObject(d) end
					end)
					local wasActive = false
					while _G.AntiSpikeThread do
						local active = _G.AntiSpikeEnabled and isCurrentGame("HideAndSeek")
						if active and not wasActive then
							scanAll()
						elseif not active and wasActive then
							if _G.CreatedSpikePlatforms then
								for _, p in pairs(_G.CreatedSpikePlatforms) do
									if p and p.Parent then p:Destroy() end
								end
								table.clear(_G.CreatedSpikePlatforms)
							end
						end
						task.wait(1)
						wasActive = active
					end
					conn:Disconnect()
				end)
			end
		else
			_G.AntiSpikeThread = false
			if _G.CreatedSpikePlatforms then
				for _, p in pairs(_G.CreatedSpikePlatforms) do
					if p and p.Parent then p:Destroy() end
				end
				table.clear(_G.CreatedSpikePlatforms)
			end
		end
	end,
})

-- Auto Dodge
tbl.autoDodgeEnabled = false
local dodgeConns = {}
local dodgeAnimIds = {
	"105341857343164", "88451099342711", "79649041083405", "73242877658272",
	"114928327045353", "135690448001690", "103355259844069", "125906547773381",
	"121147456137931", "96924216250322", "116839849594540", "104041807075625",
	"83057176809194", "103318207627541", "121473077508383", "94215646393565",
	"81533666958052",
}

local lastDodgeTime = 0

local function tryDodge(animTrack, attackerHrp)
	if not tbl.autoDodgeEnabled or not isCurrentGame("HideAndSeek") then return end
	if tick() - lastDodgeTime < 0.8 then return end
	if not animTrack.Animation then return end
	local animId = animTrack.Animation.AnimationId
	local matched = false
	for _, v5 in ipairs(dodgeAnimIds) do
		if string.find(animId, v5, 1, true) then
			matched = true
			break
		end
	end
	if not matched then return end
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not (hrp and attackerHrp) then return end
	local dist = (hrp.Position - attackerHrp.Position).Magnitude
	local predictedDist = (hrp.Position + hrp.Velocity * 0.7 - attackerHrp.Position + attackerHrp.Velocity * 0.7).Magnitude
	local diff = dist - predictedDist
	local facing = attackerHrp.CFrame.LookVector:Dot((hrp.Position - attackerHrp.Position).Unit)
	local range = 10
	local humanoid = attackerHrp.Parent and attackerHrp.Parent:FindFirstChild("Humanoid")
	if humanoid then
		local animator = humanoid:FindFirstChild("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if track.Animation then
					local id = track.Animation.AnimationId
					if string.find(id, "76367328603905") then range = 20; break
					elseif string.find(id, "71214385249268") then range = 14; break end
				end
			end
		end
	end
	if math.abs(hrp.Position.Y - attackerHrp.Position.Y) > 12 then return end
	local shouldDodge = false
	if dist <= 10 then shouldDodge = true end
	if not shouldDodge and predictedDist <= range and diff > -3 then shouldDodge = true end
	if not shouldDodge and dist <= 20 and diff > 2 then shouldDodge = true end
	if shouldDodge then
		if diff < -8 and dist > 8 then shouldDodge = false end
		if dist > 14 and facing < -0.4 then shouldDodge = false end
	end
	if not shouldDodge then return end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { character, attackerHrp.Parent }
	params.FilterType = Enum.RaycastFilterType.Exclude
	local hit = Workspace:Raycast(hrp.Position, attackerHrp.Position - hrp.Position, params)
	hit = hit and hit.Instance
	if hit then return end
	local dodge = localPlayer.Backpack:FindFirstChild("DODGE!") or character:FindFirstChild("DODGE!")
	if dodge then
		pcall(function()
			local args = { dodge }
			local buf = { buffer.create(0), args }
			ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UsedTool"):FireServer(unpack(buf))
			local slot = nil
			local playerGui = localPlayer:FindFirstChild("PlayerGui")
			if playerGui then
				for _, d in ipairs(playerGui:GetDescendants()) do
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text == "DODGE!" then
						if d.Parent then
							for _, c in ipairs(d.Parent:GetChildren()) do
								if c ~= d and (c:IsA("TextLabel") or c:IsA("TextButton")) then
									local t = string.upper(tostring(c.Text))
									if tonumber(t) or t == "E" or t == "T" or t == "Y" then
										slot = tostring(c.Text)
										break
									end
								end
							end
						end
						break
					end
				end
			end
			if not slot then
				local backpack = localPlayer:FindFirstChild("Backpack")
				if backpack then
					local idx = 1
					for _, c in ipairs(backpack:GetChildren()) do
						if c:IsA("Tool") then
							if c.Name == "DODGE!" then
								slot = tostring(idx)
								break
							else
								idx += 1
							end
						end
					end
				end
			end
			if slot then
				lastDodgeTime = tick()
				pressKey(tostring(slot))
				task.wait(0.05)
				pressKey(tostring(slot))
			end
		end)
	end
end

