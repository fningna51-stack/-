	Callback = function(v)
		if not pcall(function() return raknet and raknet.add_send_hook end) then
			notify("Combat", "Unsupported Executor")
			return
		end
		local function hook(packet)
			if packet.PacketId == 27 then
				local buf = packet.AsBuffer
				if buffer and buffer.writeu32 then
					buffer.writeu32(buf, 1, 4294967295)
					packet:SetData(buf)
				end
			end
		end
		if v then
			if not desyncHooked then
				pcall(function()
					raknet.add_send_hook(hook)
					desyncHooked = true
				end)
			end
		elseif desyncHooked then
			pcall(function()
				raknet.remove_send_hook(hook)
				desyncHooked = false
			end)
		end
	end,
})

