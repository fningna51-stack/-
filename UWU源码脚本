					local shouldRemove = _G.BandageHelperActive and (removeNames[d.Name] or string.find(string.lower(d.Name), "healing") or string.find(string.lower(d.Name), "bandage") or string.find(string.lower(d.Name), "sparks"))
					if shouldRemove then d:Destroy() end
				end))
			end
			if localPlayer.Character then setupChar(localPlayer.Character) end
