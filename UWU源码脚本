-- Fly
local flyState = { Enabled = false, Speed = 32, Connection = nil, BodyVelocity = nil }
local flyKeybind = Enum.KeyCode.U
local flyToggleRef = nil

local function stopFlyAnim(humanoid)
	if flyState.AnimTrack then
		pcall(function()
			flyState.AnimTrack:Stop(0)
			flyState.AnimTrack:AdjustWeight(0)
			flyState.AnimTrack:Destroy()
		end)
		flyState.AnimTrack = nil
	end
end

local function toggleFly(enabled)
	if enabled then
		if flyState.Enabled then return end
		flyState.Enabled = true
		local character = localPlayer.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not (humanoid and hrp) then return end
		humanoid.UseJumpPower = false
		humanoid.AutoRotate = false
		humanoid.PlatformStand = true
		if flyState.BodyVelocity then flyState.BodyVelocity:Destroy() end
		local bv = Instance.new("BodyVelocity")
		bv.Name = "FlyBodyVelocity"
		bv.MaxForce = Vector3.new(40000, 40000, 40000)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		flyState.BodyVelocity = bv
		flyState.Connection = RunService.Heartbeat:Connect(function()
			if not flyState.Enabled or not character or not character.Parent then
				toggleFly(false)
				return
			end
			hrp = character:FindFirstChild("HumanoidRootPart")
			humanoid = character:FindFirstChildOfClass("Humanoid")
			if not hrp or not bv or not humanoid or humanoid.Health <= 0 then
				toggleFly(false)
				return
			end
			local camera = workspace.CurrentCamera
			if not camera then return end
			local cf = camera.CFrame
			local dir = Vector3.zero
			local moving = false
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector; moving = true end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector; moving = true end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector; moving = true end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector; moving = true end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += cf.UpVector; moving = true end
			if not moving and humanoid.MoveDirection.Magnitude > 0.1 then
				dir = cf.LookVector * humanoid.MoveDirection.Z + cf.RightVector * humanoid.MoveDirection.X + cf.UpVector * humanoid.MoveDirection.Y
				moving = true
			end
			if moving and dir.Magnitude > 0 then
				bv.Velocity = dir.Unit * flyState.Speed
			else
				bv.Velocity = Vector3.zero
			end
		end)
	else
		if not flyState.Enabled then return end
		flyState.Enabled = false
		if flyState.Connection then
			flyState.Connection:Disconnect()
			flyState.Connection = nil
		end
		if flyState.BodyVelocity then
			flyState.BodyVelocity:Destroy()
			flyState.BodyVelocity = nil
		end
		local character = localPlayer.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				stopFlyAnim(humanoid)
				humanoid.UseJumpPower = true
				humanoid.AutoRotate = true
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.defer(function()
					if humanoid and humanoid.Health > 0 then
						humanoid:ChangeState(Enum.HumanoidStateType.Running)
					end
				end)
			end
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
			local animate = character:FindFirstChild("Animate")
			if animate and animate:IsA("LocalScript") then
				animate.Disabled = true
				task.delay(0.05, function()
					animate.Disabled = false
				end)
			end
		end
	end
end

