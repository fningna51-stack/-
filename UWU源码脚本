local function playRagebait(name)
	stopRagebait()
	local character = localPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	local animId
	if name == "Rage Emote 1" then animId = "rbxassetid://83396620848313"
	elseif name == "Rage Emote 2" then animId = "rbxassetid://111293910946685"
	elseif name == "Rage Emote 3" then animId = "rbxassetid://129390844140095"
	elseif name == "Rage Emote 4" then animId = "rbxassetid://72042024" end
	if animId then
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		pcall(function()
			ragebaitTrack = animator:LoadAnimation(anim)
			ragebaitTrack.Priority = Enum.AnimationPriority.Action4
			ragebaitTrack.Looped = true
			ragebaitTrack:Play(0.15)
			ragebaitPlaying = true
		end)
	end
