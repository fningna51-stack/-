				if not humanoid then return end
				local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
				table.insert(_G.BandageConns, animator.AnimationPlayed:Connect(function(anim)
					if _G.BandageHelperActive and anim.Animation and (string.find(anim.Animation.AnimationId, "75334524397463") or (anim.Animation.Name and string.find(string.lower(anim.Animation.Name), "bandage"))) then
						anim:Stop()
					end
