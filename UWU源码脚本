local phantomStepCount = 2
local phantomStepBusy = false

local function doPhantomStep()
	if not phantomStepActive or phantomStepCount <= 0 or phantomStepBusy then return end
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local humanoid = character:FindFirstChild("Humanoid")
	if humanoid and humanoid.Health <= 0 then return end
	-- check carried
	for _, part in ipairs(hrp:GetConnectedParts(true)) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= character and Players:GetPlayerFromCharacter(model) then return end
	end
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if track.Animation then
					local id = track.Animation.AnimationId
					local name = track.Animation.Name:lower()
					for _, match in ipairs(phantomStepAnimations) do
						if id == match then return end
					end
					if id:lower():match("carry") or name:match("carry") or name:match("carried") then return end
				end
			end
		end
	end
	phantomStepCount -= 1
	phantomStepBusy = true
	task.delay(0.2, function() phantomStepBusy = false end)
	task.delay(1.5, function()
		if phantomStepCount < 2 then phantomStepCount += 1 end
	end)
	local cf = hrp.CFrame
	local moveDir = humanoid.MoveDirection.Magnitude > 0.1 and humanoid.MoveDirection or cf.LookVector
	local params = RaycastParams.new()
	local filter = { character }
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			table.insert(filter, player.Character)
		end
	end
	params.FilterDescendantsInstances = filter
	params.FilterType = Enum.RaycastFilterType.Exclude
	local pos = cf.Position
	local distance = 11
	local hitPos = nil
	for i = 1, 15 do
		local hit = workspace:Raycast(pos, moveDir * distance, params)
		hitPos = nil
		if hit then
			if hit.Instance.CanCollide then
				hitPos = hit.Position
				break
			else
				table.insert(filter, hit.Instance)
				params.FilterDescendantsInstances = filter
				distance -= (hit.Position - pos).Magnitude
				pos = hit.Position + moveDir * 0.01
				hitPos = nil
				if not (distance <= 0) then
					hitPos = nil
					continue
				end
			end
		end
		break
	end
	local moveDist = 11
	if hitPos then
		moveDist = math.max(0, (hitPos - cf.Position).Magnitude - 1.5)
	end
	local targetCF = cf + moveDir * math.max(0, moveDist)
	-- effects
	local screenGui = Instance.new("ScreenGui")
	screenGui.IgnoreGuiInset = true
	pcall(function() screenGui.Parent = game:GetService("CoreGui") end)
	if not screenGui.Parent then screenGui.Parent = localPlayer:WaitForChild("PlayerGui") end
	local img = Instance.new("ImageLabel")
	img.Size = UDim2.new(1, 0, 1, 0)
	img.BackgroundTransparency = 1
	img.Image = "rbxassetid://17464258529"
	img.ImageColor3 = Color3.new(0, 0, 0)
	img.ImageTransparency = 1
	img.Parent = screenGui
	TweenService:Create(img, TweenInfo.new(0.05, Enum.EasingStyle.Sine), { ImageTransparency = 0.2 }):Play()
	local camera = workspace.CurrentCamera
	local fov = 70
	TweenService:Create(camera, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { FieldOfView = fov + 15 }):Play()
	local sound = Instance.new("Sound")
	local soundNum = phantomStepCount == 0 and (tbl3.phantomSoundNum == 2 and 1 or 2) or (math.random(1, 100) <= 30 and 2 or 1)
	tbl3.phantomSoundNum = soundNum
	sound.SoundId = getcustomasset and getcustomasset("UwUInk/" .. soundNum .. ".mp3") or ""
	sound.Volume = 2
	sound.Parent = game:GetService("SoundService")
	sound:Play()
	sound.Ended:Connect(function() sound:Destroy() end)
	-- fade character
	local savedTrans = {}
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 1 then
			savedTrans[d] = d.Transparency
			d.Transparency = 1
		elseif d:IsA("Decal") and d.Transparency < 1 then
			savedTrans[d] = d.Transparency
			d.Transparency = 1
		end
	end
	TweenService:Create(hrp, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = targetCF }):Play()
	task.delay(0.12, function()
		for k, v in pairs(savedTrans) do
			if k and k.Parent then k.Transparency = v end
		end
		local tween = TweenService:Create(img, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { ImageTransparency = 1 })
		tween:Play()
		tween.Completed:Connect(function() screenGui:Destroy() end)
		TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { FieldOfView = fov }):Play()
	end)
end

