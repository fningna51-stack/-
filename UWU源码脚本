				Name = "Closing Eyes",
				Accent = Color3.fromHex("#312d84"),
				Dialog = Color3.fromHex("#ffffff"),
				Outline = Color3.fromHex("#ffffff"),
				Text = Color3.fromHex("#ffffff"),
				Placeholder = Color3.fromHex("#c0c0c0"),
				Background = Color3.fromHex("#181438"),
				Button = Color3.fromHex("#3b378a"),
				Icon = Color3.fromHex("#ffffff"),
				Toggle = Color3.fromHex("#3b378a"),
				Checkbox = Color3.fromHex("#3b378a"),
			})
		end
	end)

	-- 版本警告
	if flag then
		task.wait(1)
		pcall(function()
			if v and v.Notify then
				v:Notify({
					Title = "Warning",
					Content = "GAME VERSION CHANGE DETECTED. Some features may be patched.",
					Duration = 10,
				})
			end
		end)
	end

	-- 活跃度心跳
	task.spawn(function()
		local HttpService2 = game:GetService("HttpService")
		local userName = HttpService2:UrlEncode(localPlayer.Name)
		local gameName = HttpService2:UrlEncode("Ink Game")
		while true do
			local url = "https://platinstudio.xyz" .. "/iwasactive?user=" .. userName .. "&game=" .. gameName
			pcall(function()
				game:HttpGetAsync(url)
			end)
			task.wait(25)
		end
	end)

	-- Phantom Hold 检测
	task.spawn(function()
		if _G.PH_Detector_Cleanup then
			pcall(_G.PH_Detector_Cleanup)
			_G.PH_Detector_Cleanup = nil
		end
		local grabAnimId = "71318091779666"
		local watched = {}
		local conns = {}
		local function detectGrab(model)
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("JointInstance") and d.Part1 and d.Part0 then
					local p1 = d.Part1.Parent
					local p0 = d.Part0.Parent
					if p1 and p1:IsA("Model") and p1:FindFirstChild("Humanoid") and p1 ~= model then return p1 end
					if p0 and p0:IsA("Model") and p0:FindFirstChild("Humanoid") and p0 ~= model then return p0 end
				end
			end
			return nil
		end
		-- 简略版检测，用于清理
		_G.PH_Detector_Cleanup = function()
			for _, c in ipairs(conns) do
				if c then c:Disconnect() end
			end
			table.clear(conns)
			table.clear(watched)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				task.spawn(function(character)
					if character:IsA("Model") then
						local humanoid = character:WaitForChild("Humanoid", 3)
						if humanoid then
							local animator = humanoid:WaitForChild("Animator", 3)
							if animator then
								table.insert(conns, animator.AnimationPlayed:Connect(function(anim)
									if anim.Animation and anim.Animation.AnimationId:match("%d+") == grabAnimId then
										task.delay(0.2, function()
											detectGrab(character)
										end)
									end
								end))
							end
						end
					end
				end, player.Character)
			end
		end
	end)

	notify("Uwu Hub", "Please Showcase My Script On Tiktok or Somewhere")
end

