local function isChokeOvercrowded()
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return false end
	local holder = playerGui:FindFirstChild("OtherUIHolder")
	if not holder then return false end
	local mingle = holder:FindFirstChild("Mingle")
	if not mingle then return false end
	local pir = mingle:FindFirstChild("PlayersInRoom")
	if pir and pir:IsA("TextLabel") then
		local a, b = string.match(pir.Text, "(%d+)%/(%d+)")
		if a and b then return tonumber(a) > tonumber(b) end
	end
	return false
end

local function setupAntiChoke(character)
	for _, c in ipairs(antiChokeConns) do if c then c:Disconnect() end end
	table.clear(antiChokeConns)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end
	local animator = humanoid:WaitForChild("Animator", 5)
	if not animator then return end
	table.insert(antiChokeConns, animator.AnimationPlayed:Connect(function(anim)
		if tbl.antiChokeEnabled and isCurrentGame("Mingle") then
			if string.find(anim.Animation and anim.Animation.AnimationId or "", "71318091779666") then
				if isChokeOvercrowded() then
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp then
						local cf = hrp.CFrame
						local stopped = false
						local teleported = false
						local conn = nil
						conn = anim.Stopped:Connect(function()
							stopped = true
							if teleported and hrp then
								hrp.CFrame = cf
								notify(" Auto Kick", "Choke Finished Teleporting Back")
							end
							if conn then conn:Disconnect() end
						end)
						if not stopped and hrp then
							teleported = true
							hrp.CFrame = CFrame.new(199, 54, -88)
							notify(" Grab Teleport", "Teleported away from the grab")
						end
					end
				end
			end
		end
	end))
end

