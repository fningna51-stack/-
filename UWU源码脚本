local function updateRoleHighlight(player)
	if not espRolesEnabled or player == localPlayer then return end
	local character = player.Character
	if not character then return end
	if espRoleHighlights[player] then
		espRoleHighlights[player]:Destroy()
		espRoleHighlights[player] = nil
	end
	local isHider = player:GetAttribute("IsHider")
	local isHunter = player:GetAttribute("IsHunter")
	if not isHider and not isHunter then return end
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	if isHider then
		highlight.FillColor = Color3.fromRGB(50, 255, 50)
		highlight.OutlineColor = Color3.fromRGB(30, 200, 30)
	elseif isHunter then
		highlight.FillColor = Color3.fromRGB(255, 50, 50)
		highlight.OutlineColor = Color3.fromRGB(200, 30, 30)
	end
	highlight.Adornee = character
	highlight.Parent = character
	espRoleHighlights[player] = highlight
end

local function cleanupEspRoles()
	for _, conn in pairs(espRoleConns) do
		if conn and conn.Connected then conn:Disconnect() end
	end
	table.clear(espRoleConns)
	for _, hl in pairs(espRoleHighlights) do
		if hl and hl.Parent then hl:Destroy() end
	end
	table.clear(espRoleHighlights)
end

local function setupRoleEsp(player)
	if player == localPlayer then return end
	table.insert(espRoleConns, player:GetAttributeChangedSignal("IsHider"):Connect(function()
		if espRolesEnabled then updateRoleHighlight(player) end
	end))
	table.insert(espRoleConns, player:GetAttributeChangedSignal("IsHunter"):Connect(function()
		if espRolesEnabled then updateRoleHighlight(player) end
	end))
	table.insert(espRoleConns, player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if espRolesEnabled then updateRoleHighlight(player) end
	end))
	updateRoleHighlight(player)
end

