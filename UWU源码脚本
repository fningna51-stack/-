-- ESP Powers
tbl.espPowersEnabled = false
local powerEspBillboards = {}
local powerEspConns = {}

local function updatePowerEsp(player)
	if not player or not player.Character then return end
	local head = player.Character:FindFirstChild("Head")
	local power = player:GetAttribute("_EquippedPower")
	if tbl.espPowersEnabled and head and power and power ~= "" and power ~= "None" and power ~= "Yok" then
		local text = tostring(power)
		local billboard = powerEspBillboards[player]
		if not billboard then
			billboard = Instance.new("BillboardGui")
			billboard.Name = "PowerESP"
			billboard.AlwaysOnTop = false
			billboard.Size = UDim2.new(0, 100, 0, 20)
			billboard.StudsOffset = Vector3.new(0, 1.5, 0)
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, 0, 1, 0)
			label.Text = text
			label.TextColor3 = Color3.new(1, 1, 1)
			label.Font = Enum.Font.Arcade
			label.TextSize = 10
			label.TextStrokeTransparency = 0.5
			label.Parent = billboard
			billboard.Parent = head
			powerEspBillboards[player] = billboard
		else
			if billboard.Parent ~= head then billboard.Parent = head end
			local label = billboard:FindFirstChildOfClass("TextLabel")
			if label then label.Text = text end
		end
	elseif powerEspBillboards[player] then
		powerEspBillboards[player]:Destroy()
		powerEspBillboards[player] = nil
	end
end

local function setupPowerEsp(player)
	if powerEspConns[player] then
		powerEspConns[player]:Disconnect()
	end
	powerEspConns[player] = player:GetAttributeChangedSignal("_EquippedPower"):Connect(function()
		updatePowerEsp(player)
	end)
	table.insert(powerEspConns, player.CharacterAdded:Connect(function()
		task.wait(1)
		if tbl.espPowersEnabled then updatePowerEsp(player) end
	end))
	updatePowerEsp(player)
end

local function cleanupPowerEsp()
	for k, c in pairs(powerEspConns) do
		if type(k) == "number" then
			if c then c:Disconnect() end
		elseif c then
			c:Disconnect()
		end
	end
	table.clear(powerEspConns)
	for _, b in pairs(powerEspBillboards) do
		if b then b:Destroy() end
	end
	table.clear(powerEspBillboards)
end

