-- Balloon Farm
tbl.autoPopBalloonsEnabled = false
local balloonPrompts = {}
local balloonHighlights = {}

local function isRedLight()
	if isCurrentGame("RedLightGreenLight") then
		local playerGui = localPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			local impactFrames = playerGui:FindFirstChild("ImpactFrames")
			if impactFrames then
				local trafficLightEmpty = impactFrames:FindFirstChild("TrafficLightEmpty")
				if trafficLightEmpty and trafficLightEmpty.Image == "rbxassetid://88400194373338" then
					return true
				end
			end
		end
	end
	return false
end

local function popBalloon(prompt)
	if isRedLight() then return end
	local character = localPlayer.Character
	character = character and character:FindFirstChild("HumanoidRootPart")
	if not character then return end
	local parent = prompt.Parent
	if not parent then return end
	local cFrame = character.CFrame
	character.CFrame = parent.CFrame
	task.wait(0.2)
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt, 1)
			fireproximityprompt(prompt, 0)
		end
	end)
	local parent2 = parent.Parent
	local timer = 0
	while parent2 and parent2.Parent and timer < 2 do
		if not isRedLight() then
			task.wait(0.1)
			timer += 0.1
			continue
		end
		break
	end
	local char2 = localPlayer.Character
	local hrp = char2 and char2:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.CFrame = cFrame end
end

local function highlightBalloon(prompt)
	local parent = prompt.Parent
	if not parent then return end
	local parent2 = parent.Parent
	if not parent2 then return end
	if balloonHighlights[prompt] then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "BalloonHighlight"
	highlight.FillColor = Color3.fromRGB(255, 105, 180)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = parent2
	balloonHighlights[prompt] = highlight
end

local function unhighlightBalloon(prompt)
	if balloonHighlights[prompt] then
		balloonHighlights[prompt]:Destroy()
		balloonHighlights[prompt] = nil
	end
end

local function onBalloonPrompt(descendant)
	if descendant:IsA("ProximityPrompt") and descendant.Name == "BalloonProximityPrompt" then
		balloonPrompts[descendant] = true
		if tbl.balloonESPEnabled then highlightBalloon(descendant) end
	end
end

for _, descendant in pairs(workspace:GetDescendants()) do
	onBalloonPrompt(descendant)
end

workspace.DescendantAdded:Connect(onBalloonPrompt)

workspace.DescendantRemoving:Connect(function(descendant)
	if balloonPrompts[descendant] then
		balloonPrompts[descendant] = nil
		unhighlightBalloon(descendant)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		if tbl.autoPopBalloonsEnabled and isCurrentGame("HideAndSeek") then
			for prompt in pairs(balloonPrompts) do
				if isRedLight() then break end
				if prompt and prompt.Parent and prompt.Enabled then
					local character = localPlayer.Character
					character = character and character:FindFirstChild("HumanoidRootPart")
					local parent = prompt.Parent
					if character and parent then
						if math.abs(character.Position.Y - parent.Position.Y) <= 20 then
							popBalloon(prompt)
						end
					end
				elseif not prompt or not prompt.Parent then
					balloonPrompts[prompt] = nil
					unhighlightBalloon(prompt)
				end
			end
		end
	end
end)

