local function findNearestRebelTarget()
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil, nil end
	local live = workspace:FindFirstChild("Live")
	local minDist = math.huge
	local result = nil
	if live then
		for _, child in pairs(live:GetChildren()) do
			if child.Name:match("Rebel") or child.Name:match("Guard") then
				local chrp = child:FindFirstChild("HumanoidRootPart")
				local humanoid = child:FindFirstChild("Humanoid")
				if chrp and humanoid and humanoid.Health > 0 then
					local dist = (hrp.Position - chrp.Position).Magnitude
					if dist < minDist then minDist = dist; result = child end
				end
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player:GetAttribute("IsGuard") == true then
			local char = player.Character
			if char then
				local chrp = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChild("Humanoid")
				if chrp and humanoid and humanoid.Health > 0 then
					local dist = (hrp.Position - chrp.Position).Magnitude
					if dist < minDist then minDist = dist; result = char end
				end
			end
		end
	end
	return result, result and result:FindFirstChild("HumanoidRootPart")
end

local function getGunTool()
	local character = localPlayer.Character
	if not character then return nil end
	local tool = character:FindFirstChildOfClass("Tool")
	if tool and (tool:FindFirstChild("GunScript") or tool:FindFirstChild("Client") or tool.Name == "MP5" or tool.Name == "Revolver") then
		return tool
	end
	local backpack = localPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in pairs(backpack:GetChildren()) do
			if child.Name == "MP5" or child.Name == "Revolver" or child:FindFirstChild("GunScript") then
				child.Parent = character
				task.wait(0.1)
				return child
			end
		end
	end
	return nil
end

