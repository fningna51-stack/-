-- Ultra Instinct (Visual)
PowerOptionsBox:AddToggle("visualUltraInstinctEnabled", {
	Text = "Visual Ultra Instinct",
	Default = false,
	Tooltip = "Visual Ultra Instinct effect",
	Callback = function(v)
		if v then
			pcall(function()
				if getgenv()._UI_CLEANUP then getgenv()._UI_CLEANUP() end
			end)
			local Players2 = game:GetService("Players")
			local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
			local localPlayer2 = Players2.LocalPlayer
			local SharedFunctions, Effects, UIDodgeCLIENTEFFECTS
			pcall(function()
				SharedFunctions = require(ReplicatedStorage2.Modules.SharedFunctions)
				Effects = require(ReplicatedStorage2.Modules.Effects)
				UIDodgeCLIENTEFFECTS = require(ReplicatedStorage2.Modules.AbilityEffectsModules.UIDodgeCLIENTEFFECTS)
			end)
			local dodgeSounds = { "rbxassetid://109819027147829", "rbxassetid://92129593029820", "rbxassetid://119518089922771", "rbxassetid://133278063201532", "rbxassetid://114251651938052" }
			local dodgeAnims = { "rbxassetid://117886505329162", "rbxassetid://72808867502440", "rbxassetid://94169703055500", "rbxassetid://94537387793682", "rbxassetid://82454268128485" }
			local animIndex = 1
			local busy = false
			local dodgeCount = 10
			local maxDodges = 10
			local loadedAnims = {}
			local running = true
			local intValue = Instance.new("IntValue")
			intValue.Value = dodgeCount
			intValue:SetAttribute("MaxDodges", 10)

			local function loadAnims(humanoid)
				loadedAnims = {}
				local animator = humanoid:FindFirstChildOfClass("Animator")
				if not animator then animator = Instance.new("Animator"); animator.Parent = humanoid end
				for _, animId in ipairs(dodgeAnims) do
					local anim = Instance.new("Animation")
					anim.AnimationId = animId
					local track = animator:LoadAnimation(anim)
					track.Priority = Enum.AnimationPriority.Action4
					table.insert(loadedAnims, track)
				end
			end

			local function cleanupChar(char)
				if not char then return end
				for _, d in ipairs(char:GetDescendants()) do
					if d:IsA("ParticleEmitter") or d:IsA("Highlight") then
						if d.Name:find("UI_") or d.Name:find("Permanent_") or d.Name == "Highlight" then
							pcall(function() d:Destroy() end)
						end
					elseif d:IsA("Attachment") then
						if d.Name:find("UI_") or d.Name:find("Permanent_") then
							pcall(function() d:Destroy() end)
						end
					end
				end
			end

			local function updateDisplay()
				pcall(function()
					intValue.Value = dodgeCount
					if Effects and Effects.UltraInstinctDisplayDodge then
						Effects.UltraInstinctDisplayDodge({ Obj = intValue })
					end
				end)
			end

			local function equipEffect(char)
				if not char then return end
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				if SharedFunctions and SharedFunctions.PlaySound then
					pcall(function() SharedFunctions.PlaySound(hrp, "rbxassetid://121690585734302", 7) end)
				end
				if UIDodgeCLIENTEFFECTS then
					pcall(function() UIDodgeCLIENTEFFECTS({ ModuleName = "UIDodge", Character = char, initial = true }) end)
				end
				pcall(function()
					local uiDodge = ReplicatedStorage2.Effects.SetupParts.CustomEffectsFolders:FindFirstChild("UIDodge")
					if uiDodge then
						for _, partName in ipairs({ "Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }) do
							local bodyPart = char:FindFirstChild(partName)
							local effectPart = uiDodge:FindFirstChild(partName)
							if bodyPart and effectPart then
								for _, child in ipairs(effectPart:GetChildren()) do
									if child:IsA("ParticleEmitter") then
										local clone = child:Clone()
										clone.Parent = bodyPart
										clone:Emit(clone:GetAttribute("EmitCount") or 15)
										task.delay(2.5, function()
											if clone and clone.Parent then clone:Destroy() end
										end)
									end
								end
							end
						end
					end
				end)
			end

			local function doDodge()
				local char = localPlayer2.Character
				if not char then return end
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if not humanoid or not hrp or humanoid.Health <= 0 then return end
				if busy then return end
				busy = true
				local idx = animIndex
				animIndex = animIndex % #dodgeAnims + 1
				if dodgeCount > 0 then dodgeCount -= 1 else dodgeCount = maxDodges end
				updateDisplay()
				pcall(function()
					local soundId = dodgeSounds[idx] or "rbxassetid://109819027147829"
					if SharedFunctions and SharedFunctions.PlaySound then
						SharedFunctions.PlaySound(hrp, soundId, 7)
					end
				end)
				if #loadedAnims == 0 then loadAnims(humanoid) end
				local track = loadedAnims[idx]
				if track then track:Play(0.01, 1, 1.45) end
				if UIDodgeCLIENTEFFECTS then
					pcall(function() UIDodgeCLIENTEFFECTS({ ModuleName = "UIDodge", Character = char, dodgenumber = idx }) end)
				end
				local dir = humanoid.MoveDirection
				if dir.Magnitude < 0.1 then dir = -hrp.CFrame.LookVector end
				local force = dir * 68 + Vector3.new(0, 4, 0)
				hrp.AssemblyLinearVelocity = Vector3.new(force.X, hrp.AssemblyLinearVelocity.Y, force.Z)
				task.delay(0.25, function() busy = false end)
			end

			local function createTool()
				local backpack = localPlayer2:FindFirstChild("Backpack")
				if not backpack then return end
				local existing = backpack:FindFirstChild("Ultra Instinct") or (localPlayer2.Character and localPlayer2.Character:FindFirstChild("Ultra Instinct"))
				if existing then existing:Destroy() end
				local tool = Instance.new("Tool")
				tool.Name = "Ultra Instinct"
				tool.RequiresHandle = false
				tool.CanBeDropped = false
				tool.ToolTip = "Ultra Instinct"
				tool.Equipped:Connect(function()
					if localPlayer2.Character then
						equipEffect(localPlayer2.Character)
						doDodge()
					end
				end)
				tool.Activated:Connect(doDodge)
				tool.Parent = backpack
				task.spawn(function()
					local playerGui = localPlayer2:FindFirstChild("PlayerGui")
					playerGui = playerGui and playerGui:FindFirstChild("Hotbar")
					if playerGui then
						for _, d in ipairs(playerGui:GetDescendants()) do
							if d:IsA("TextButton") then
								local toolName = d:FindFirstChild("ToolName", true)
								if toolName and toolName.Text == "Ultra Instinct" then
									d.MouseButton1Click:Connect(function()
										if localPlayer2.Character then equipEffect(localPlayer2.Character) end
										doDodge()
									end)
								end
							end
						end
					end
				end)
			end

			if localPlayer2.Character then
				cleanupChar(localPlayer2.Character)
				local humanoid = localPlayer2.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then loadAnims(humanoid) end
				equipEffect(localPlayer2.Character)
			end
			createTool()
			updateDisplay()
			task.spawn(function()
				local timer = 0
				while running do
					task.wait(0.5)
					timer += 0.5
					if timer >= 4.5 then
						timer = 0
						if dodgeCount < maxDodges then
							dodgeCount += 1
							updateDisplay()
						end
					end
				end
			end)
			local charConn = localPlayer2.CharacterAdded:Connect(function(char)
				cleanupChar(char)
				local humanoid = char:WaitForChild("Humanoid", 5)
				if humanoid then loadAnims(humanoid) end
				task.wait(0.5)
				equipEffect(char)
				createTool()
				updateDisplay()
			end)
			getgenv()._UI_CLEANUP = function()
				running = false
				pcall(function() charConn:Disconnect() end)
				if localPlayer2.Character then cleanupChar(localPlayer2.Character) end
				local backpack = localPlayer2:FindFirstChild("Backpack")
				if backpack then
					local tool = backpack:FindFirstChild("Ultra Instinct")
					if tool then tool:Destroy() end
				end
				if localPlayer2.Character then
					local tool = localPlayer2.Character:FindFirstChild("Ultra Instinct")
					if tool then tool:Destroy() end
				end
				pcall(function() intValue:Destroy() end)
			end
		else
			pcall(function()
				if getgenv()._UI_CLEANUP then
					getgenv()._UI_CLEANUP()
					getgenv()._UI_CLEANUP = nil
				end
			end)
		end
	end,
})

-- Lightning God Awakening (Visual)
PowerOptionsBox:AddToggle("lightningGodAwakeningEnabled", {
	Text = "Lightning God Awakening",
	Default = false,
	Tooltip = "Visual Lightning God Awakening effect",
	Callback = function(v)
		if v then
			pcall(function()
				if getgenv()._LightningGodCleaner then pcall(getgenv()._LightningGodCleaner) end
			end)
			local Players2 = game:GetService("Players")
			local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
			local localPlayer2 = Players2.LocalPlayer
			local camera = workspace.CurrentCamera
			local active = false
			local animTrack = nil
			local interruptFolder = nil
			local camConn = nil

			local function cleanup()
				active = false
				if camConn then camConn:Disconnect(); camConn = nil end
				if camera then
					camera.CameraType = Enum.CameraType.Custom
					camera.FieldOfView = 70
				end
				if animTrack then animTrack:Stop(0.2); animTrack = nil end
				if interruptFolder then interruptFolder:Destroy(); interruptFolder = nil end
				local char = localPlayer2.Character
				if char then
					local hrp = char:FindFirstChild("HumanoidRootPart")
					if hrp then hrp.Anchored = false end
					local humanoid = char:FindFirstChild("Humanoid")
					if humanoid then humanoid.AutoRotate = true end
					for _, child in ipairs(char:GetChildren()) do
						if child.Name == "LightningGodInterrupt" or child.Name:find("LightningGod") or child.Name == "eyes" or child.Name == "LingeringAura" then
							child:Destroy()
						end
					end
				end
			end

			local function runCamera(root)
				local module = ReplicatedStorage2:FindFirstChild("CustomCameraModules") and ReplicatedStorage2.CustomCameraModules:FindFirstChild("LightningAwakening")
				if not module then return end
				local frames, fovs
				pcall(function()
					local data = require(module)()
					if data then
						frames = data.Frames
						fovs = data.FOV
					end
				end)
				if not frames or not fovs then return end
				camera.CameraType = Enum.CameraType.Scriptable
				local idx = 1
				if camConn then camConn:Disconnect() end
				camConn = RunService.RenderStepped:Connect(function(dt)
					if not active or not root or not root.Parent then
						if camConn then camConn:Disconnect(); camConn = nil end
						camera.CameraType = Enum.CameraType.Custom
						camera.FieldOfView = 70
						return
					end
					idx += dt * 60
					local frameIdx = math.floor(idx)
					if #frames < frameIdx then
						if camConn then camConn:Disconnect(); camConn = nil end
						camera.CameraType = Enum.CameraType.Custom
						TweenService:Create(camera, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = 70 }):Play()
						return
					end
					local f = frames[frameIdx]
					local fov = fovs[frameIdx]
					if f then
						camera.CFrame = root.CFrame * CFrame.new(0, 1.2, 0) * CFrame.new(f[1], f[2], f[3], f[4], f[5], f[6], f[7], f[8], f[9], f[10], f[11], f[12])
						if fov then camera.FieldOfView = fov end
					end
				end)
			end

			local function activate()
				if active then return end
				local char = localPlayer2.Character
				if not char or not char.Parent then return end
				local humanoid = char:FindFirstChild("Humanoid")
				local hrp = char:FindFirstChild("HumanoidRootPart")
				local animator = humanoid:FindFirstChild("Animator")
				if not humanoid or not hrp or not animator or humanoid.Health <= 0 then return end
				cleanup()
				active = true
				humanoid.Health = humanoid.MaxHealth
				hrp.Anchored = true
				humanoid.AutoRotate = false
				local awakenAnim = ReplicatedStorage2:FindFirstChild("Animations") and ReplicatedStorage2.Animations:FindFirstChild("Abilities") and ReplicatedStorage2.Animations.Abilities:FindFirstChild("LightningGodAwakening")
				if awakenAnim then
					animTrack = animator:LoadAnimation(awakenAnim)
					animTrack.Priority = Enum.AnimationPriority.Action4
					animTrack:Play(0.1)
				end
				runCamera(hrp)
				local folder = Instance.new("Folder")
				folder.Name = "LightningGodInterrupt"
				folder.Parent = char
				interruptFolder = folder
				local effectModule = ReplicatedStorage2:FindFirstChild("Modules") and ReplicatedStorage2.Modules:FindFirstChild("AbilityEffectsModules") and ReplicatedStorage2.Modules.AbilityEffectsModules:FindFirstChild("LIGHTNINGGODAWAKENINGCLIENTEFFECTS")
				local duration = animTrack and animTrack.Length or 4.3
				if effectModule then
					local mod = require(effectModule)
					task.spawn(function()
						mod({ ModuleName = "LIGHTNINGGODAWAKENING", Character = char, InterruptedFolder = folder, TimeLength = duration })
					end)
				end
				task.delay(duration, function()
					if not active then return end
					cleanup()
				end)
			end

			local function createTool()
				local backpack = localPlayer2:FindFirstChild("Backpack")
				if not backpack then return end
				for _, child in ipairs(backpack:GetChildren()) do
					if child.Name == "Awakening" or child.Name == "⚡ Lightning God Awakening" or child.Name == "Lightning God Awakening" then
						child:Destroy()
					end
				end
				local char = localPlayer2.Character
				if char then
					for _, child in ipairs(char:GetChildren()) do
						if child:IsA("Tool") and (child.Name == "Awakening" or child.Name == "⚡ Lightning God Awakening" or child.Name == "Lightning God Awakening") then
							child:Destroy()
						end
					end
				end
				local tool = Instance.new("Tool")
				tool.Name = "Awakening"
				tool.RequiresHandle = false
				tool.CanBeDropped = false
				tool.Equipped:Connect(activate)
				tool.Activated:Connect(activate)
				tool.Parent = backpack
			end

			local inputConn = UserInputService.InputBegan:Connect(function(input, gp)
				if gp then return end
				if input.KeyCode == Enum.KeyCode.G then activate() end
			end)
			local charConn = localPlayer2.CharacterAdded:Connect(function()
				task.wait(0.5)
				cleanup()
				createTool()
			end)
			local playerGui = localPlayer2:FindFirstChild("PlayerGui")
			if playerGui then
				for _, name in ipairs({ "LightningAwakeningGui", "LightningGodGui", "SoundDumpGui", "CodeDumpGui", "DeepSoundDumpGui" }) do
					local gui = playerGui:FindFirstChild(name)
					if gui then gui:Destroy() end
				end
			end
			if localPlayer2.Character then createTool() end
			getgenv()._LightningGodCleaner = function()
				pcall(cleanup)
				pcall(function() inputConn:Disconnect() end)
				pcall(function() charConn:Disconnect() end)
				pcall(function()
					local backpack = localPlayer2:FindFirstChild("Backpack")
					if backpack then
						for _, child in ipairs(backpack:GetChildren()) do
							if child.Name == "Awakening" or child.Name == "⚡ Lightning God Awakening" or child.Name == "Lightning God Awakening" then
								child:Destroy()
							end
						end
					end
				end)
				pcall(function()
					local gui = localPlayer2:FindFirstChild("PlayerGui")
					if gui then
						for _, name in ipairs({ "LightningAwakeningGui", "LightningGodGui", "SoundDumpGui", "CodeDumpGui", "DeepSoundDumpGui" }) do
							local g = gui:FindFirstChild(name)
							if g then g:Destroy() end
						end
					end
				end)
			end
		else
			pcall(function()
				if getgenv()._LightningGodCleaner then
					pcall(getgenv()._LightningGodCleaner)
					getgenv()._LightningGodCleaner = nil
				end
			end)
		end
	end,
})

