-- Auto Close Door
local autoCloseConns = nil
local autoCloseFlag = false

local function findPlayerRoom()
	local character = localPlayer.Character
	character = character and character:FindFirstChild("HumanoidRootPart")
	local map = workspace:FindFirstChild("MingleMap")
	map = map and map:FindFirstChild("AllMingleDoors")
	if not character or not map then return nil end
	local pos = character.Position
	for _, child in pairs(map:GetChildren()) do
		local check = child:FindFirstChild("InsideRoomRayCheck")
		if check then
			local rel = check.CFrame:PointToObjectSpace(pos)
			if math.abs(rel.X) <= 10 and math.abs(rel.Z) <= 12 and math.abs(rel.Y) <= 10 then
				return child
			end
		end
	end
	return nil
end

local function closeDoor(door)
	if not door or autoCloseFlag then return end
	autoCloseFlag = true
	local handle = door:FindFirstChild("DoorHandleOtherSide") or door:FindFirstChild("DoorHandle")
	local prompt = handle and handle:FindFirstChild("CloseDoorPrompt")
	if prompt and fireproximityprompt then
		pcall(function()
			prompt.HoldDuration = 0
			prompt.RequiresLineOfSight = false
			prompt.MaxActivationDistance = 9999
			fireproximityprompt(prompt, 0)
		end)
	end
	local bd = door:FindFirstChild("OpenOrCloseBD")
	if bd and bd:IsA("BindableEvent") then
		pcall(function() bd:Fire("Close") end)
	end
	task.delay(4, function() autoCloseFlag = false end)
end

