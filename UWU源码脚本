local currentEmoteTrack = nil
local currentEmoteSound = nil
local emotePlaying = false
local selectedEmote = emotes[1].Name

local function stopEmote()
	if currentEmoteTrack then
		pcall(function() currentEmoteTrack:Stop() end)
		currentEmoteTrack = nil
	end
	if currentEmoteSound then
		pcall(function() currentEmoteSound:Stop() end)
		pcall(function() currentEmoteSound:Destroy() end)
		currentEmoteSound = nil
	end
	emotePlaying = false
end

local function playEmote(emote)
	stopEmote()
	local character = localPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local anim = Instance.new("Animation")
	anim.AnimationId = emote.AnimId
	currentEmoteTrack = humanoid:LoadAnimation(anim)
	currentEmoteTrack:Play()
	if emote.SoundId then
		local sound = Instance.new("Sound")
		sound.SoundId = emote.SoundId
		sound.Volume = emote.Volume or 5
		sound.Looped = true
		sound.Parent = game:GetService("SoundService")
		sound:Play()
		currentEmoteSound = sound
	end
	emotePlaying = true
	notify("Emote", "Playing: " .. emote.Name)
end

