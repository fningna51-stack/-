-- Throw Pole AIM
tbl.throwPoleAimEnabled = false
local throwPoleConns = {}
local throwPoleActive = false

local function findNearestPlayerHrp()
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local minDist = math.huge
	local result = nil
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local chrp = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChild("Humanoid")
			if chrp and humanoid and humanoid.Health > 0 then
				local dist = (chrp.Position - hrp.Position).Magnitude
				if dist < minDist then minDist = dist; result = chrp end
			end
		end
	end
	return result
end

local function setupThrowPole(character)
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	table.insert(throwPoleConns, animator.AnimationPlayed:Connect(function(anim)
		if not tbl.throwPoleAimEnabled then return end
		if anim.Animation and anim.Animation.AnimationId and string.find(tostring(anim.Animation.AnimationId), "112950478995075") then
			throwPoleActive = true
			local h = character:FindFirstChild("Humanoid")
			if h then h.AutoRotate = false end
			anim.Stopped:Once(function()
				throwPoleActive = false
				local h2 = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
				if h2 then h2.AutoRotate = true end
			end)
		end
	end))
end

