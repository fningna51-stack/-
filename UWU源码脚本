UtilitiesBox:AddToggle("autoStealBandagesEnabled", {
	Text = "Auto Steal Bandages",
	Default = false,
	Tooltip = "Automatically pick up dropped bandages",
	Callback = function(v)
		tbl.autoStealBandagesEnabled = v
		if v then
			if tbl2.stealThread then return end
			tbl2.stealThread = true
			task.spawn(function()
				local function hasBandage()
					local character = localPlayer.Character
					if character and character:FindFirstChild("Bandage") then return true end
					local backpack = localPlayer:FindFirstChild("Backpack")
					if backpack and backpack:FindFirstChild("Bandage") then return true end
					return false
				end
				local function isRedLight()
					if isCurrentGame("RedLightGreenLight") then
						local playerGui = localPlayer:FindFirstChild("PlayerGui")
						if playerGui then
							local impactFrames = playerGui:FindFirstChild("ImpactFrames")
							if impactFrames then
								local tle = impactFrames:FindFirstChild("TrafficLightEmpty")
								if tle and tle.Image == "rbxassetid://88400194373338" then return true end
							end
						end
					end
					return false
				end
				local function findBandage()
					local function check(parent)
						for _, child in ipairs(parent:GetChildren()) do
							if child.Name == "DroppedBandage" then
								local bp = child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)) or (child:IsA("BasePart") and child)
								if bp then return child, bp end
							end
						end
						return nil, nil
					end
					local a, b = check(workspace)
					if a then return a, b end
					local effects = workspace:FindFirstChild("Effects")
					if effects then
						local c, d = check(effects)
						if c then return c, d end
					end
					local live = workspace:FindFirstChild("Live")
					if live then
						local c, d = check(live)
						if c then return c, d end
					end
					return nil, nil
				end
				while tbl.autoStealBandagesEnabled and tbl2.stealThread do
					if not hasBandage() and not isRedLight() then
						local bandage, part = findBandage()
						if bandage and part then
							local character = localPlayer.Character
							local hrp = character and character:FindFirstChild("HumanoidRootPart")
							if hrp then
								local savedCF = hrp.CFrame
								local targetCF = part.CFrame
								hrp.CFrame = targetCF
								local timer = 0
								while tbl.autoStealBandagesEnabled and not hasBandage() and bandage and bandage.Parent and timer < 10 do
									if not isRedLight() then
										hrp.CFrame = targetCF
										if typeof(firetouchinterest) == "function" then
											pcall(function()
												firetouchinterest(hrp, part, 0)
												task.wait(0.05)
												firetouchinterest(hrp, part, 1)
											end)
										end
										task.wait(0.1)
										timer += 1
										continue
									end
									break
								end
								if character and character:FindFirstChild("HumanoidRootPart") then
									character.HumanoidRootPart.CFrame = savedCF
								end
								task.wait(0.5)
							end
						end
					end
					task.wait(0.5)
				end
				tbl2.stealThread = nil
			end)
		end
	end,
})

