end)

local function checkGlassPiece(piece)
	if not piece:IsA("Model") or not piece.PrimaryPart then return end
	local primary = piece.PrimaryPart
	local isExploit = primary:GetAttribute("exploitingisevil")
	if tbl.glassBridgeESPEnabled and not glassEspHighlights[piece] then
		local hl = Instance.new("Highlight")
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.OutlineColor = Color3.new(1, 1, 1)
		if isExploit then
			hl.FillColor = Color3.fromRGB(255, 50, 50)
			hl.Name = "BreakableHighlight"
		else
			hl.FillColor = Color3.fromRGB(50, 255, 50)
			hl.Name = "SafeHighlight"
		end
		hl.Adornee = piece
		hl.Parent = piece
		glassEspHighlights[piece] = hl
	end
	local shouldCreate = tbl.fakeGlassEnabled
	if not tbl.fakeGlassEnabled then shouldCreate = isExploit end
	if shouldCreate and not fakeGlassParts[piece] then
		local part = Instance.new("Part")
		part.Size = primary.Size
		part.CFrame = primary.CFrame * CFrame.new(0, 1, 0)
		part.Anchored = true
		part.CanCollide = true
		part.Transparency = 0.5
		part.Color = Color3.fromRGB(50, 255, 50)
		part.Material = Enum.Material.Glass
		pcall(function() part.CollisionGroup = "FakeGlass" end)
		part.Parent = Workspace
		fakeGlassParts[piece] = part
	end
end

local function clearGlassBridgeHelpers()
	for _, v5 in pairs(glassEspHighlights) do if v5 and v5.Parent then v5:Destroy() end end
	table.clear(glassEspHighlights)
	for _, v5 in pairs(fakeGlassParts) do if v5 and v5.Parent then v5:Destroy() end end
	table.clear(fakeGlassParts)
end

local function startGlassBridgeLoop()
	if glassLoopThread then return end
	glassLoopThread = task.spawn(function()
		while tbl.glassBridgeESPEnabled or tbl.fakeGlassEnabled do
			if Workspace:GetAttribute("GLASSBRIDGEOVER") then clearGlassBridgeHelpers() end
			local character = localPlayer.Character
			if character then
				local humanoid = character:FindFirstChild("Humanoid")
				if humanoid and humanoid.Health <= 0 then clearGlassBridgeHelpers() end
			end
			local bridge = Workspace:FindFirstChild("GlassBridge")
			if bridge then
				local holder = bridge:FindFirstChild("GlassHolder")
				if holder then
					for _, child in ipairs(holder:GetChildren()) do
						for _, piece in ipairs(child:GetChildren()) do
							checkGlassPiece(piece)
						end
					end
				end
			end
			task.wait(2)
		end
		glassLoopThread = nil
	end)
end

