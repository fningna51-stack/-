-- CamLock
local camLockEnabled = false
local camLockTarget = nil
local camLockSearchThread = nil
local camLockBound = false

local function findClosestPlayer()
	local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local minDist = math.huge
	local result = nil
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local chrp = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChild("Humanoid")
			if chrp and humanoid and humanoid.Health > 0 then
				local dist = (hrp.Position - chrp.Position).Magnitude
				if dist < minDist then minDist = dist; result = player end
			end
		end
	end
	return result
end

