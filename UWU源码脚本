local function setMovement(enabled)
	local character = localPlayer.Character
	if character then
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = enabled and 16 or 0
			humanoid.JumpPower = enabled and 50 or 0
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp and not enabled then
			hrp.Velocity = Vector3.zero
		end
	end
end

local function isInSafeZone(pos, v1, v2)
	return pos.X >= math.min(v1.X, v2.X) and pos.X <= math.max(v1.X, v2.X) and pos.Z >= math.min(v1.Z, v2.Z) and pos.Z <= math.max(v1.Z, v2.Z)
end

local function isInStartZone()
	local character = localPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
	local pos = character.HumanoidRootPart.Position
	local v5 = isInSafeZone(pos, Vector3.new(-216, 0, 83), Vector3.new(103, 0, 168))
	local v6 = isInSafeZone(pos, Vector3.new(103, 0, 168), Vector3.new(116, 0, 82))
	local v7 = isInSafeZone(pos, Vector3.new(115, 0, -578), Vector3.new(-215, 0, -516))
	return v5 or v6 or v7
end

