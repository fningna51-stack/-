-- 在 parent 里建一套「左右两个独立滚动区」，返回表。
-- 和主标签页一样：两列各滚各的，不联动。
local function buildScroller(win, parent, index, withBackBar)
    local frame = new("Frame", {
        Name = "Page_" .. index,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 2,
    }, parent)

    local topInset = 0
    local navBar = nil
    if withBackBar then
        navBar = new("Frame", {
            BackgroundColor3 = win:Color("Background"),
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 36),
            ZIndex = WobsinsUI.Layers.Content + 3,
        }, frame)
        win:_bind(navBar, "BackgroundColor3", "Background")
        topInset = 36
    end

    local function makeColumn(name)
        local scroll = new("ScrollingFrame", {
            Name = name,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, topInset),
            Size = UDim2.new(1, 0, 1, -topInset),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = win:Color("Outline"),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BorderSizePixel = 0,
            ZIndex = WobsinsUI.Layers.Content + 2,
        }, frame)

        -- 这两个属性是新版才有的，老执行器没有也不会让整页崩掉
        pcall(function()
            scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scroll.ElasticBehavior = Enum.ElasticBehavior.Never
        end)

        local holder = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = WobsinsUI.Layers.Content + 2,
        }, scroll)
        U.padding(holder, 12, 12, 12, 12)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, CARD_GAP),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, holder)

        holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, holder.AbsoluteSize.Y + 4)
        end)
        return scroll, holder
    end

    local scroll1, col1 = makeColumn("ScrollLeft")
    local scroll2, col2 = makeColumn("ScrollRight")
    scroll2.Visible = false

    return {
        Frame = frame,
        NavBar = navBar,
        Scroll = scroll1,
        Scroll2 = scroll2,
        Col1 = col1,
        Col2 = col2,
    }
end

L.Internal.buildScroller = buildScroller

