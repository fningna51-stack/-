    local stroke = U.stroke(bg, self:Color("Outline"), 1, self.Glass and 0.5 or 0.55)
    self:_bind(bg, "BackgroundColor3", "SurfaceAlt")
    self:_onTheme(function()
        stroke.Color = self:Color("Outline")
        bg.BackgroundTransparency = self.Glass and 0.35 or 0
    end)

    local icon = U.icon(bg, "search", 12, self:Color("Muted"), WobsinsUI.Layers.HeaderItem + 1)
    if icon then
        icon.Position = UDim2.fromOffset(9, math.floor((height - 12) / 2))
    end
    self:_onTheme(function()
        U.tint(icon, self:Color("Muted"))
    end)

    local box = new("TextBox", {
