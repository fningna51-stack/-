    -- 底部分隔线
    local divider = new("Frame", {
        BackgroundColor3 = self:Color("OutlineSoft"),
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        ZIndex = WobsinsUI.Layers.Header - 1,
    }, header)
    self:_bind(divider, "BackgroundColor3", "OutlineSoft")

    -- Logo
    local logo = new("Frame", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.fromOffset(14, 10),
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, header)
    U.corner(logo, 6)
    self:_bind(logo, "BackgroundColor3", "SurfaceAlt")

    local logoIcon = U.icon(logo, self.Icon, 14, self:Color("Text"), WobsinsUI.Layers.HeaderItem + 1)
    if logoIcon then
        logoIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        logoIcon.Position = UDim2.fromScale(0.5, 0.5)
        if logoIcon:IsA("TextLabel") and U.isImage(self.Icon) then
            logoIcon.TextColor3 = Color3.new(1, 1, 1)
        end
    end

    -- 标题 / 副标题（右侧要留出搜索框 + 最小化 + 关闭按钮的位置）
    -- 只有显式 FloatSwitch = true 才用药丸开关的槽位，默认走「—」收起成小条
    local showSwitch = config.FloatSwitch == true
    local searchWidth = 236
    if self.Width < 700 or self.ThemeTable.SearchInSidebar then
        searchWidth = 0
    end
    -- 关闭按钮 26 + 开关槽位（4 + 46 + 8）或旧的「—」按钮 26 + 10
    local rightCluster = 14 + 26 + 4 + (showSwitch and 4 + 46 + 8 or 26 + 10)
        + (searchWidth > 0 and searchWidth + 10 or 0)
    local titleWidth = -(48 + rightCluster + 12)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(48, 12),
        Size = UDim2.new(1, titleWidth, 0, 15),
        Font = Enum.Font.GothamMedium,
        Text = self.Title,
        TextColor3 = self:Color("Text"),
        TextSize = 13.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, header)
    self:_bind(title, "TextColor3", "Text")
    self.TitleLabel = title

    local author = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(48, 26),
        Size = UDim2.new(1, titleWidth, 0, 13),
        Font = Enum.Font.Gotham,
        Text = self.Author,
        TextColor3 = self:Color("Muted"),
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Visible = self.Author ~= "",
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, header)
    self:_bind(author, "TextColor3", "Muted")

    -- 右侧按钮：关闭脚本（带确认）+ 最小化。
    -- 点「—」把整窗收成 23_shell 里那条小胶囊，再点小条展开。
    local buttonSize = 26
    local rightX = -14

    local close = self:_headerButton(header, "close", UDim2.new(1, rightX - buttonSize, 0, 9), buttonSize, function()
        self:RequestClose()
    end, "Danger")
    U.tooltip(close, "关闭脚本")

    rightX = rightX - buttonSize - 4

    if showSwitch then
        -- 只留槽位（4 + 46 + 8），真正的开关是挂在 ScreenGui 上的常驻控件
        rightX = rightX - 4 - 46 - 8
    else
        local minimize = self:_headerButton(header, "minus", UDim2.new(1, rightX - buttonSize, 0, 9), buttonSize, function()
            self:Minimize()
        end, "SubText")
        U.tooltip(minimize, "最小化")
        rightX = rightX - buttonSize - 10
    end

    -- 搜索框（放标题栏还是侧栏，由主题决定）
    if searchWidth > 0 then
        self:_buildSearchBox(header, searchWidth, 26, UDim2.new(1, rightX - searchWidth, 0, 9), 7, 11)
    end

    -- 标题栏整条都能拖：空白处、标题、副标题都算。
    -- 按钮 / 搜索框是子控件，命中它们时 InputBegan 不会冒泡到这里，不会误拖。
    self:_makeDraggable(header)
    self:_makeDraggable(title)
    self:_makeDraggable(author)
end

function Window:_buildSearchBox(parent, width, height, position, radius, textSize)
    local bg = new("Frame", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        BackgroundTransparency = self.Glass and 0.35 or 0,
        Size = UDim2.fromOffset(width, height),
        Position = position,
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, parent)
    U.corner(bg, radius or 5)
    local stroke = U.stroke(bg, self:Color("Outline"), 1, self.Glass and 0.5 or 0.55)
    self:_bind(bg, "BackgroundColor3", "SurfaceAlt")
    self:_onTheme(function()
        stroke.Color = self:Color("Outline")
        bg.BackgroundTransparency = self.Glass and 0.35 or 0
    end)

    local icon = U.icon(bg, "search", 12, self:Color("Muted"), WobsinsUI.Layers.HeaderItem + 1)
    if icon then
        icon.Position = UDim2.fromOffset(9, math.floor((height - 12) / 2))
    end
    self:_onTheme(function()
        U.tint(icon, self:Color("Muted"))
    end)

    local box = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(28, 0),
        Size = UDim2.new(1, -36, 1, 0),
        Font = Enum.Font.Gotham,
        PlaceholderText = WobsinsUI:t("search"),
        PlaceholderColor3 = self:Color("Muted"),
        Text = "",
        TextColor3 = self:Color("Text"),
        TextSize = textSize or 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = WobsinsUI.Layers.HeaderItem + 1,
    }, bg)
    self.SearchBox = box
    self:_bind(box, "TextColor3", "Text")
    WobsinsUI:BindText(box, "search", "PlaceholderText")

    box:GetPropertyChangedSignal("Text"):Connect(function()
        self:_search(box.Text)
    end)

    return box
end

function Window:_headerButton(parent, icon, position, size, callback, colorKey)
    local btn = new("TextButton", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(size, size),
        Position = position,
        Text = "",
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, parent)
    U.corner(btn, 4)

    local ic = U.icon(btn, icon, 12, self:Color(colorKey or "SubText"), WobsinsUI.Layers.HeaderItem + 1)
    if ic then
        ic.AnchorPoint = Vector2.new(0.5, 0.5)
        ic.Position = UDim2.fromScale(0.5, 0.5)
    end

    local function paintHover(state)
        U.tween(btn, 0.12, { BackgroundTransparency = state and 0 or 1 })
        U.tween(btn, 0.12, { BackgroundColor3 = state and self:Color("SurfaceHover") or self:Color("SurfaceAlt") })
        if ic then
            U.tint(ic, state and self:Color("Text") or self:Color(colorKey or "SubText"))
        end
    end

    btn.MouseEnter:Connect(function()
        paintHover(true)
    end)
    btn.MouseLeave:Connect(function()
        paintHover(false)
    end)
    btn.Activated:Connect(function()
        if callback then
            safeCall(callback)
        end
    end)

    return btn
end

