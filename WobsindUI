function Window:Tab(config)
    -- 没有手动分组时丢进一个默认分组（不显示标题）
    local section = self.DefaultSection
    if not section then
        section = self:Section({ Title = "" })
        self.DefaultSection = section
    end
    return self:_newTab(config or {}, section)
end

function Window:_newTab(config, section)
    local index = #self.Tabs + 1

    -- 一旦有真实标签页，先撤掉“空窗口”提示卡，
    -- 否则它会和第一张卡片重叠在一起，看起来像整页没内容。
    if self._placeholderCard then
        self._placeholderCard:Destroy()
        self._placeholderCard = nil
        self._placeholder = nil
    end

    local tab = setmetatable({
        Window = self,
        Section = section,
        Index = index,
        Title = config.Title or ("标签 " .. index),
        Icon = config.Icon,
        Desc = config.Desc or "",
        Locked = config.Locked == true,
        Cards = {},
        Elements = {},
        MatchCount = 0,
        _cardCount = 0,
        _colFlip = false,
    }, Tab)

    -- 侧栏按钮
    local parent = section.TabsHolder or section.Container
    local pill = self.ThemeTable.Pill == true
    local rowH = pill and 34 or 32
    local button = new("TextButton", {
        BackgroundColor3 = self:Color("SurfaceHover"),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, rowH),
        Text = "",
        LayoutOrder = index,
        ZIndex = WobsinsUI.Layers.Sidebar + 2,
    }, parent)
    U.corner(button, pill and 8 or 6)
    tab.SideButton = button
    self:_bind(button, "BackgroundColor3", "SurfaceHover")

    -- 选中态左侧竖条：所有主题都有，比只靠背景色好认
    local bar = new("Frame", {
        BackgroundColor3 = self:Color("Accent"),
        Size = UDim2.new(0, 2, 0, 18),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundTransparency = 1,
        ZIndex = WobsinsUI.Layers.Sidebar + 4,
    }, button)
    U.corner(bar, 1)
    tab.SideBar = bar
    self:_bind(bar, "BackgroundColor3", "Accent")

    local iconX = pill and 11 or 10
    if tab.Icon then
        local icon = U.icon(button, tab.Icon, 14, self:Color("Muted"), WobsinsUI.Layers.Sidebar + 3)
        if icon then
            icon.Position = UDim2.fromOffset(iconX, 0)
            icon.Size = UDim2.fromOffset(14, rowH)
            icon.AnchorPoint = Vector2.new(0, 0)
        end
        tab.IconObj = icon
    end

    local labelX = tab.Icon and (iconX + 22) or (pill and 12 or 11)
    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(labelX, 0),
        Size = UDim2.new(1, -labelX - 8, 1, 0),
        Font = Enum.Font.Gotham,
        Text = tab.Title,
        TextColor3 = self:Color("SubText"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.Sidebar + 3,
    }, button)
    tab.SideLabel = label
    self:_bind(label, "TextColor3", "SubText")

    -- 徽标（可选）
    if config.Badge then
        local badge = new("TextLabel", {
            BackgroundColor3 = self:Color("Accent"),
            BackgroundTransparency = 0.85,
            Size = UDim2.fromOffset(18, 14),
            Position = UDim2.new(1, -24, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Font = Enum.Font.GothamBold,
            Text = tostring(config.Badge),
            TextColor3 = self:Color("Accent"),
            TextSize = 9,
            ZIndex = WobsinsUI.Layers.Sidebar + 4,
        }, button)
        U.corner(badge, 3)
    end

    U.hover(button, function()
        if self.ActiveTab ~= tab then
            U.tween(button, 0.12, { BackgroundTransparency = 0.62 })
            U.tween(label, 0.12, { TextColor3 = self:Color("Text") })
        end
    end, function()
        if self.ActiveTab ~= tab then
            self:_paintTab(tab, false)
        end
    end)

    button.Activated:Connect(function()
        if tab.Locked then
            WobsinsUI:Notify({
                Title = "未解锁",
                Content = tab.Title .. " 暂不可用。",
                Icon = "lock",
                Duration = 3,
                Window = self,
            })
            return
        end
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    self:_buildPage(tab)

    -- 第一个标签页自动选中，保证一打开就能看到内容
    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function Window:_buildPage(tab)
    local content = self.Content

    local page = new("Frame", {
        Name = "Page_" .. tab.Index,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 1,
    }, content)
    tab.Page = page

    -- 左右两列各用一个独立的 ScrollingFrame。
    -- 之前是「一个滚动条套两列」，左边滑到底右边跟着走；
    -- 分成两个之后，基础设置和快捷操作可以各自滚到自己的位置。
    local function makeColumn(name, layoutOrder)
        local scroll = new("ScrollingFrame", {
            Name = name,
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = self:Color("Outline"),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BorderSizePixel = 0,
            ZIndex = WobsinsUI.Layers.Content + 1,
        }, page)

        -- 这两个属性是新版才有的，老执行器没有也不会让整页崩掉
        pcall(function()
            scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scroll.ElasticBehavior = Enum.ElasticBehavior.Never
        end)

        local holder = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = WobsinsUI.Layers.Content + 1,
        }, scroll)
        U.padding(holder, 12, 12, 12, 12)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, CARD_GAP),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, holder)

        scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, holder.AbsoluteSize.Y + 4)
        end)
        holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, holder.AbsoluteSize.Y + 4)
        end)

        return scroll, holder
    end

    local scroll1, holder1 = makeColumn("ScrollLeft", 1)
    local scroll2, holder2 = makeColumn("ScrollRight", 2)

    tab.Scroll = scroll1
    tab.Scroll2 = scroll2
    tab.Holder = holder1
    tab.Col1 = holder1
    tab.Col2 = holder2

    local empty = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 0, 40),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Font = Enum.Font.Gotham,
        Text = WobsinsUI:t("noMatch"),
        TextColor3 = self:Color("Muted"),
        TextSize = 11.5,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 2,
    }, page)
    tab.Empty = empty
    self:_bind(empty, "TextColor3", "Muted")

    -- 卡片区为空时的提示：有标签页但一张卡都没有，屏幕上会是一块空面板
    local hint = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 0, 40),
        Position = UDim2.fromScale(0.5, 0.32),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Font = Enum.Font.Gotham,
        Text = "这个页面还没有添加卡片\nTab:Card({ Title = \"设置\" })",
        TextColor3 = self:Color("Muted"),
        TextSize = 10.5,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 2,
    }, page)
    tab.EmptyHint = hint
    self:_bind(hint, "TextColor3", "Muted")

    U.delay(0.8, function()
        if tab.Window and not tab.Window.Destroyed and #tab.Cards == 0 then
            hint.Visible = true
        end
    end)

    local function refreshCanvas()
        scroll1.CanvasSize = UDim2.new(0, 0, 0, holder1.AbsoluteSize.Y + 4)
        if scroll2.Visible then
            scroll2.CanvasSize = UDim2.new(0, 0, 0, holder2.AbsoluteSize.Y + 4)
        end
        scroll1.ScrollBarImageColor3 = self:Color("Outline")
        scroll2.ScrollBarImageColor3 = self:Color("Outline")
    end

    tab._refreshCanvas = refreshCanvas
    tab:_applyColumns()

    self.Pages[tab.Index] = page
end

function Tab:_applyColumns()
    local double = self.Window.Layout == "Double" and self.Window.Width >= 560
    if double then
        self.Scroll.Size = UDim2.new(0.5, -4, 1, 0)
        self.Scroll.Position = UDim2.fromOffset(0, 0)
        self.Scroll2.Size = UDim2.new(0.5, -4, 1, 0)
        self.Scroll2.Position = UDim2.new(0.5, 4, 0, 0)
        self.Scroll2.Visible = true
    else
        self.Scroll.Size = UDim2.fromScale(1, 1)
        self.Scroll.Position = UDim2.fromOffset(0, 0)
        self.Scroll2.Visible = false
    end
    if self._refreshCanvas then
        self._refreshCanvas()
    end
end

function Tab:_targetColumn(column)
    if self.Window.Layout ~= "Double" then
        return self.Col1
    end
    if column == 2 then
        return self.Col2
    end
    if column == 1 then
        return self.Col1
    end
    -- 自动交替：第一张进左列，第二张进右列
    self._colFlip = not self._colFlip
    return self._colFlip and self.Col1 or self.Col2
end

-- 窗口尺寸 / 侧栏宽度变过之后重新决定列数（窄屏退回单列）
function Window:_relayoutColumns()
    for _, tab in ipairs(self.Tabs or {}) do
        if tab._applyColumns then
            tab:_applyColumns()
        end
        for _, page in ipairs(tab.Pages or {}) do
            if page._applyColumns then
                page:_applyColumns()
            end
        end
    end
end

--//----------------------------------------------------------------------------
--// 10.2 选中态
--//----------------------------------------------------------------------------

-- 选中态：左侧竖条 + 更亮的底 + 加粗文字 + 强调色图标，四层叠在一起，
-- 扫一眼就知道现在停在哪一页（只靠背景色差在小屏上几乎看不出来）。
function Window:_paintTab(tab, active)
    if not tab.SideButton then
        return
    end
    local pill = self.ThemeTable and self.ThemeTable.Pill
    U.tween(tab.SideButton, 0.14, {
        BackgroundColor3 = self:Color("SurfaceHover"),
        BackgroundTransparency = active and (pill and 0.2 or 0) or 1,
    })
    if tab.SideBar then
        U.tween(tab.SideBar, 0.14, {
            BackgroundTransparency = active and 0 or 1,
            Size = UDim2.new(0, 2, 0, active and 18 or 10),
        })
    end
    if tab.SideLabel then
        tab.SideLabel.Font = active and Enum.Font.GothamBold or Enum.Font.Gotham
        U.tween(tab.SideLabel, 0.14, {
            TextColor3 = self:Color(active and "Text" or "SubText"),
        })
    end
    if tab.IconObj then
        U.tint(tab.IconObj, self:Color(active and "Accent" or "Muted"))
    end
end


function Window:SelectTab(target)
    local tab = target
    if type(target) == "number" then
        tab = self.Tabs[target]
    elseif type(target) == "string" then
        for _, item in ipairs(self.Tabs) do
            if item.Title == target then
                tab = item
                break
            end
        end
    end
    if not tab or not tab.Page then
        return
    end

    for _, item in ipairs(self.Tabs) do
        item.Page.Visible = (item == tab)
    end
    self.ActiveTab = tab

    for _, item in ipairs(self.Tabs) do
        self:_paintTab(item, item == tab)
    end

    if self.SearchBox and self.SearchBox.Text ~= "" then
        tab:_filter(self.SearchBox.Text)
    end

    -- 切标签页时回到该页的主页（子页面不保持打开）
    if tab.Home then
        tab:Home()
    end

    self:_emit("TabChanged", tab)

    return tab
end

--//----------------------------------------------------------------------------
--// 10.3 搜索
--//----------------------------------------------------------------------------

function Window:_search(query)
    query = (query or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local tab = self.ActiveTab
    if not tab then
        return
    end
    tab:_filter(query)
end

function Tab:_filter(query)
    query = query or ""
    local lower = string.lower(query)
    local matched = 0

    for _, card in ipairs(self.Cards) do
        local cardMatch = false
        if query ~= "" and card.Title and card.Title ~= "" then
            cardMatch = string.find(string.lower(card.Title), lower, 1, true) ~= nil
        end

        local visibleInside = 0
        for _, element in ipairs(card.Elements) do
            local hit = (query == "") or cardMatch
            if not hit then
                local haystack = string.lower(tostring(element._search or ""))
                hit = string.find(haystack, lower, 1, true) ~= nil
            end
            element:SetVisible(hit)
            if hit then
                visibleInside = visibleInside + 1
            end
        end

        if #card.Elements == 0 then
            card.Frame.Visible = (query == "")
        else
            card.Frame.Visible = (query == "") or visibleInside > 0
        end
        matched = matched + visibleInside
    end

    self.MatchCount = matched
    self.Empty.Visible = (query ~= "") and matched == 0
    if query ~= "" then
        self.Empty.Text = string.format("没有找到 “%s”", query)
    end

    if self._refreshCanvas then
        self._refreshCanvas()
    end

    return matched
end

function Tab:SetSearch(text)
    if self.Window.SearchBox then
        self.Window.SearchBox.Text = text
    end
end

