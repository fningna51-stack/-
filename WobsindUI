--//============================================================================
--
--   win:Palette()            -- 打开命令面板
--   win:AddCommand({ Name = "重载配置", Hint = "Ctrl+R", Run = function() end })
--
-- 默认会收录所有标签页里的元素，选中后自动切页 + 滚动定位 + 高亮闪一下。

--//----------------------------------------------------------------------------
