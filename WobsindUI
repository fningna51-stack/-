-- 隐藏窗口 = 收起成小条，保证屏幕上始终有入口（以前只把 Stage 藏了，
-- 没挂悬浮按钮的配置收起来就再也找不回来）。
function Window:Close()
    if not self.Visible or not self.Stage then
        return
    end
    self:SetMinimized(true)
    for _, callback in ipairs(self.CloseCallbacks) do
        safeCall(callback)
    end
end

function Window:Open()
    if self.Visible or not self.Stage then
        return
    end
    self.Visible = true
    self.Stage.Visible = true
    -- 从悬浮按钮回来时，如果之前是小胶囊状态，先展开成完整窗口
    if self.Minimized then
        self:SetMinimized(false)
    end
    if self.Scale then
        local base = self.ScaleValue or 1
        self.Scale.Scale = base * 0.96
        U.tween(self.Scale, 0.2, { Scale = base }, Enum.EasingStyle.Back)
    end
    if self.OpenButton and self.OpenButton.Frame then
        self.OpenButton.Frame.Visible = false
    end
    if self._paintSwitch then
        self:_paintSwitch()
    end
    return self
end

function Window:Toggle()
    if self.Visible then
        self:Close()
    else
        self:Open()
    end
end

--//----------------------------------------------------------------------------
--// 17.2 背景图 / 悬浮按钮
--//----------------------------------------------------------------------------

-- 背景图。三种写法都吃：
--   win:SetBackgroundImage(123887383447725)              -- 纯数字资源 id
--   win:SetBackgroundImage("rbxassetid://123887383447725")
--   win:SetBackgroundImage("https://.../a.png")
-- 传 nil / "" 就是关掉。
function Window:SetBackgroundImage(imageId, transparency, dim)
    if not self.Main then
        return self
    end

    local source = nil
    if typeof(imageId) == "number" then
        source = "rbxassetid://" .. tostring(math.floor(imageId))
    elseif type(imageId) == "string" and imageId ~= "" then
        if tonumber(imageId) then
            source = "rbxassetid://" .. imageId
        else
            source = imageId
        end
    end

    if self.Minimized then
        -- 收起来时先把参数记下，展开后再真正建图
        self._pendingBackground = source
        self._hasPendingBg = true
        return self
    end

    if source then
        if not self.BgImage then
            local art = new("ImageLabel", {
                Name = "BackgroundArt",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                ScaleType = Enum.ScaleType.Crop,
                ZIndex = WobsinsUI.Layers.Art,
            }, self.Main)
            U.corner(art, self.Radius or 6)
            self.BgImage = art

            local veil = new("Frame", {
                Name = "BackgroundVeil",
                BackgroundColor3 = self:Color("Background"),
                BackgroundTransparency = 0.5,
                Size = UDim2.fromScale(1, 1),
                ZIndex = WobsinsUI.Layers.Veil,
            }, self.Main)
            U.corner(veil, self.Radius or 6)
            self:_bind(veil, "BackgroundColor3", "Background")
            self.Veil = veil
        end

        self.BgImage.Image = source
        self.BgImage.ImageTransparency = transparency or 0.12
        self.BgImage.Visible = self.Visible ~= false
        self.BackgroundSource = source

        if self.Veil then
            -- dim 越大蒙版越浓，文字越清楚。
            -- 目的不是「把图压黑」，而是让图透出来又不影响读字，所以默认偏轻。
            local strength = dim
            if strength == nil then
                local light = self.ThemeTable and self.ThemeTable.Mode == "Light"
                strength = light and 0.34 or 0.45
            end
            self.BackgroundDim = strength
            self.Veil.BackgroundTransparency = U.clamp(1 - strength, 0.02, 0.98)
            self.Veil.Visible = true
        end

        if self.MainStroke then
            self.MainStroke.Transparency = math.min(self.MainStroke.Transparency, 0.4)
        end
    else
        if self.BgImage then
            self.BgImage:Destroy()
            self.BgImage = nil
        end
        if self.Veil then
            self.Veil:Destroy()
            self.Veil = nil
        end
        self.BackgroundSource = nil
    end

    if self.Main then
        U.tween(self.Main, 0.18, { BackgroundTransparency = self:_baseAlpha() })
    end
    -- 卡片 / 侧栏 / 蒙版一起刷新，否则会只剩一块黑底压着图
    self:_applyGlass()
    return self
end

-- 只调蒙版浓度，不换图：0 = 图很淡，0.9 = 几乎看不清图
function Window:SetBackgroundDim(value)
    self.BackgroundDim = U.clamp(value or 0, 0, 0.95)
    if self.Veil then
        U.tween(self.Veil, 0.16, { BackgroundTransparency = U.clamp(1 - self.BackgroundDim, 0.02, 0.98) })
    end
    return self
end

function Window:EditOpenButton(config)
    config = config or {}
    if self.OpenButton and self.OpenButton.Frame then
        self.OpenButton.Frame:Destroy()
    end

    local size = config.Size or 42
    local screen = self.Root

    local btn = new("TextButton", {
        BackgroundColor3 = self:Color("Surface"),
        AutoButtonColor = false,
        Size = UDim2.fromOffset(size, size),
        Position = config.Position or UDim2.new(0, 16, 1, -16 - size),
        Text = "",
        Visible = not self.Visible,
        ZIndex = WobsinsUI.Layers.Watermark,
    }, screen)
    U.corner(btn, size / 2)
    U.stroke(btn, self:Color(config.StrokeColor and U.color(config.StrokeColor) or "Outline"), 1, 0.2)
    self:_bind(btn, "BackgroundColor3", "Surface")

    local icon = U.icon(btn, config.Icon or self.Icon, math.floor(size * 0.4), self:Color("Text"), WobsinsUI.Layers.Watermark + 1)
    if icon then
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.Position = UDim2.fromScale(0.5, 0.5)
    end

    btn.Activated:Connect(function()
        self:Open()
    end)
    U.hover(btn, function()
        U.tween(btn, 0.12, { BackgroundColor3 = self:Color("SurfaceHover") })
    end, function()
        U.tween(btn, 0.12, { BackgroundColor3 = self:Color("Surface") })
    end)

    -- 拖动悬浮按钮
    local dragging, startPos, startPointer = false, nil, nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = btn.Position
            startPointer = input.Position
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - startPointer
                btn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    self.OpenButton = { Frame = btn, Icon = icon }
    return self
end

