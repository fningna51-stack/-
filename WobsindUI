    }, screen)
    U.corner(panel, 8)
    U.stroke(panel, theme.Danger, 1, 0.2)
    U.padding(panel, 16, 14, 16, 14)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 20),
        Font = Enum.Font.GothamMedium,
        Text = "WobsinsUI 构建出错",
        TextColor3 = theme.Danger,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = self.Layers.ModalCard + 1,
    }, panel)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 26),
        Size = UDim2.new(1, 0, 1, -54),
        Font = Enum.Font.Code,
        Text = tostring(message),
        TextColor3 = theme.SubText,
        TextSize = 9.5,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = self.Layers.ModalCard + 1,
    }, panel)

    local close = new("TextButton", {
        BackgroundColor3 = theme.SurfaceAlt,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(72, 24),
        Position = UDim2.new(1, -72, 1, -24),
        Text = "",
        ZIndex = self.Layers.ModalCard + 1,
    }, panel)
    U.corner(close, 4)
    new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = "关闭",
        TextColor3 = theme.Text,
        TextSize = 11,
        ZIndex = self.Layers.ModalCard + 2,
    }, close)
    close.Activated:Connect(function()
        panel:Destroy()
    end)

    return panel
end

--//----------------------------------------------------------------------------
--// 9.2 创建窗口
--//----------------------------------------------------------------------------

function WobsinsUI:CreateWindow(config)
    config = config or {}
    local ok, result = xpcall(function()
        return self:_createWindow(config)
    end, function(err)
        return tostring(err) .. "\n" .. tostring(debug.traceback())
    end)

    if not ok then
        logWarn("[WobsinsUI] CreateWindow 失败:\n" .. tostring(result))
        return self:_errorWindow(result)
    end
    return result
end

function WobsinsUI:_createWindow(config)
    local screen = self:_screen()
    local vp = self:_viewport()

    local themeName = config.Theme or self.CurrentTheme
    if not Themes[themeName] then
        themeName = "Graphite"
    end
    local theme = Themes[themeName]

    -- 尺寸：窗口永远不超过视口，手机上直接铺满可用区域
    local width = 880
    local height = 560
    if typeof(config.Size) == "UDim2" then
        if config.Size.X.Offset > 0 then
            width = config.Size.X.Offset
        end
        if config.Size.Y.Offset > 0 then
            height = config.Size.Y.Offset
        end
    end
    width = math.floor(math.min(width, vp.X - 20))
    height = math.floor(math.min(height, vp.Y - 20))
    width = math.max(width, 360)
    height = math.max(height, 300)

    local sidebarWidth = config.SideBarWidth or 168
    if width < 620 then
        sidebarWidth = 132
    end
    sidebarWidth = math.floor(math.min(sidebarWidth, width * 0.36))

    local win = setmetatable({
        Config = config,
        Title = config.Title or "WobsinsUI",
        Author = config.Author or "",
        Icon = config.Icon or "bolt",
        Folder = config.Folder or "WobsinsUI",
        Theme = themeName,
        -- 每个窗口一份副本，切主题时原地改，闭包里的引用才不会失效
        ThemeTable = (L.cloneTheme and L.cloneTheme(theme)) or theme,
        Bindings = {},
        RawBindings = {},
        ThemeHooks = {},
        Tabs = {},
        Sections = {},
        Elements = {},
        CloseCallbacks = {},
        Destroyed = false,
        Visible = true,
        Minimized = false,
        Locked = false,
        Width = width,
        Height = height,
        SidebarWidth = sidebarWidth,
        HeaderHeight = HEADER_HEIGHT,
        FooterHeight = FOOTER_HEIGHT,
        Transparency = config.Transparent == true or self.Transparency,
        Glass = theme.Glass == true,
        Radius = theme.Radius or 6,
        ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift,
        OpenButton = nil,
        ActiveTab = nil,
        ScaleValue = 1,
        PageCount = 0,
    }, Window)

    win:_buildShell(config)
    win:_buildHeader(config)
    win:_buildSidebar(config)
    win:_buildContent(config)
    win:_buildFooter(config)
    win:_buildOpenButton(config)

    table.insert(self.Windows, win)

    -- 空窗口也必须有可见内容：给用户 1 秒时间挂标签页，仍然为空才补提示卡片
    U.delay(1, function()
        if win.Destroyed or not win.Content then
            return
        end
        if #win.Tabs == 0 and not win._placeholder then
            win._placeholder = true
            win:_buildPlaceholder()
        elseif not win.ActiveTab and #win.Tabs > 0 then
            win:SelectTab(1)
        end
    end)

    -- 开关键
    if S.UserInputService then
        S.UserInputService.InputBegan:Connect(function(input, processed)
            if processed or win.Destroyed then
                return
            end
            if input.KeyCode == win.ToggleKey then
                -- 快捷键面板打开时，开关键先收面板，不要直接把窗口关了
                if win._hotkeyPanelOpen and win._hotkeyPanel then
                    win._hotkeyPanel:Close()
                    return
                end
                -- 最小化状态下按开关键：先展开，而不是直接藏起来
                if win.Visible and win.Minimized then
                    win:SetMinimized(false)
                    return
                end
                if win.Visible then
                    win:Close()
                else
                    win:Open()
                end
            end
        end)
    end

    return win
end

--//----------------------------------------------------------------------------
--// 9.3 外壳（Stage / 阴影 / 主体）
--//----------------------------------------------------------------------------

function Window:_buildShell(config)
    local screen = self.Root or WobsinsUI:_screen()
    self.Root = screen

    local stage = new("Frame", {
        Name = "WobsinsStage",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(self.Width, self.Height),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = WobsinsUI.Layers.Main,
    }, screen)
    self.Stage = stage
    self.Scale = new("UIScale", { Scale = 1 }, stage)

    -- 阴影单独一层，比主体低 5 级，永远不会盖住内容
    local shadow = new("Frame", {
        Name = "Shadow",
        BackgroundColor3 = self:Color("Shadow"),
        BackgroundTransparency = 0.55,
        Size = UDim2.new(1, 4, 1, 10),
        Position = UDim2.fromOffset(-2, 6),
        ZIndex = WobsinsUI.Layers.Shadow,
    }, stage)
    U.corner(shadow, (self.Radius or 6) + 2)
    self.Shadow = shadow
    self:_bind(shadow, "BackgroundColor3", "Shadow")

    local main = new("Frame", {
        Name = "Main",
        BackgroundColor3 = self:Color("Background"),
        BackgroundTransparency = self.ThemeTable.Alpha or 0,
        Size = UDim2.fromScale(1, 1),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Main,
    }, stage)
    self.Main = main
    self:_bind(main, "BackgroundColor3", "Background")
    self:_onTheme(function()
        main.BackgroundTransparency = self:_baseAlpha()
    end)
    self.Corner = U.corner(main, self.Radius or 6)

    -- 描边永远是 1px 冷灰。玻璃主题稍微透一点，不用强调色描边 ——
    -- 那圈彩边正是「AI 生成 UI」最典型的痕迹。
    local outline = U.stroke(main, self:Color("Outline"), 1, self.Glass and 0.35 or 0.45)
    self.MainStroke = outline
    self:_onTheme(function()
        outline.Color = self:Color("Outline")
        outline.Transparency = self.Glass and 0.35 or 0.45
    end)

    -- 背景图（可选）：图本身只是最底一层，上面压一层同色蒙版保证文字可读
    if config.Background ~= nil and config.Background ~= "" then
        self:SetBackgroundImage(config.Background, config.BackgroundTransparency, config.BackgroundDim)
    end
end

-- 主体底色透明度：没图时按主题走，有图时让开给图片
function Window:_baseAlpha()
    local alpha = (self.ThemeTable and self.ThemeTable.Alpha) or 0
    if self.BgImage then
        alpha = math.max(alpha, 0.32)
    end
    return alpha
end

function Window:_makeDraggable(handle)
    local dragging = false
    local startAbs = nil
    local startPointer = nil

    -- Stage 的锚点在中心、Position 用 0.5 缩放，所以不能直接改 Offset。
    -- 统一按「左上角绝对坐标」算，再换算回 Position，拖动时顺手夹在屏幕内，
    -- 免得手一滑把窗口甩到屏幕外找不回来。
    local function placeAt(left, top)
        local vp = WobsinsUI:_viewport()
        local size = self.Stage.AbsoluteSize
        local maxLeft = math.max(4, vp.X - size.X - 4)
        local maxTop = math.max(4, vp.Y - size.Y - 4)
        left = U.clamp(left, 4, maxLeft)
        top = U.clamp(top, 4, maxTop)
        self.Stage.Position = UDim2.new(
            0.5, left + size.X / 2 - vp.X * 0.5,
            0.5, top + size.Y / 2 - vp.Y * 0.5
        )
        return left, top
    end

    self._placeStageAt = placeAt

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        -- 点在输入框上时不拖动
        if S.UserInputService and S.UserInputService:GetFocusedTextBox() then
            return
        end
        dragging = true
        self._dragDistance = 0
        startAbs = self.Stage.AbsolutePosition
        startPointer = input.Position
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - startPointer
            self._dragDistance = math.max(self._dragDistance or 0, math.abs(delta.X) + math.abs(delta.Y))
            placeAt(startAbs.X + delta.X, startAbs.Y + delta.Y)
        end)
    end
end

