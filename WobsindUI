--//----------------------------------------------------------------------------
--// 19.1 拖拽时把窗口约束在屏幕内
--//----------------------------------------------------------------------------
--
-- 原来的实现可以让窗口被拖到屏幕外，手机上拖一次就再也找不回来了。

local _makeDraggableRaw = Window._makeDraggable

function Window:_makeDraggable(handle)
    local dragging = false
    local startPos = nil
    local startPointer = nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if S.UserInputService:GetFocusedTextBox() then
            return
        end
        dragging = true
        -- 记录本次按压移动了多少：最小化胶囊靠它区分「拖」和「点」
        self._dragDistance = 0
        startPos = self.Stage.Position
        startPointer = input.Position
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging or not self.Stage then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local delta = input.Position - startPointer
            self._dragDistance = (self._dragDistance or 0) + math.abs(delta.X) + math.abs(delta.Y)

            local vp = WobsinsUI:_viewport()
            -- 用「当前」尺寸而不是创建时的尺寸：最小化成胶囊后照着 880x560
            -- 算边界，胶囊会被弹回屏幕中间。
            local size = self.Stage.AbsoluteSize
            local w, h = size.X, size.Y
            if w <= 0 or h <= 0 then
                w, h = self.Width, self.Height
            end

            -- 允许拖出边界，但至少留 96px 在屏幕里
            local minX = -(vp.X + w) / 2 + 96
            local maxX = (vp.X + w) / 2 - 96
            local minY = -(vp.Y + h) / 2 + 40
            local maxY = (vp.Y + h) / 2 - 40

            local x = U.clamp(startPos.X.Offset + delta.X, minX, maxX)
            local y = U.clamp(startPos.Y.Offset + delta.Y, minY, maxY)

            self.Stage.Position = UDim2.new(startPos.X.Scale, x, startPos.Y.Scale, y)

            -- 最小化胶囊的坐标跟着改，恢复时才知道它现在在哪
            if self.Minimized then
                self._minBarLeft = self.Stage.AbsolutePosition.X
                self._minBarTop = self.Stage.AbsolutePosition.Y
            end
        end)
    end
end

