-- 把十六进制字符串转成 Color3，同时补齐默认键
local THEME_DEFAULTS = {
    Background = "#0A0A0B", BackgroundAlt = "#0D0D0F",
    Surface = "#111112", SurfaceAlt = "#161617", SurfaceHover = "#1D1D1F",
    Outline = "#242427", OutlineSoft = "#19191B",
    Text = "#EBEBED", SubText = "#9A9AA1", Muted = "#6C6C73",
    Accent = "#FFFFFF", Accent2 = "#EDEDEF", OnAccent = "#0A0A0B",
    Danger = "#E5636F", Success = "#5FBF8F", Warning = "#D9A85C",
    Shadow = "#000000",
}

local COLOR_KEYS = {
    "Background", "BackgroundAlt", "Surface", "SurfaceAlt", "SurfaceHover",
    "Outline", "OutlineSoft", "Text", "SubText", "Muted",
    "Accent", "Accent2", "OnAccent", "Danger", "Success", "Warning", "Shadow",
}

local Themes = {}

-- 每个窗口都拿一份自己的主题副本。
-- 组件里普遍是 `local theme = win.ThemeTable` 先存起来、切主题时再读，
-- 如果这里换成「指向新表」，那些闭包会一直读旧表，切主题就成了半截子活。
local function cloneTheme(source)
    local copy = {}
    for key, value in pairs(source or {}) do
        copy[key] = value
    end
    return copy
end

local function buildTheme(name, data)
    local theme = { Name = name }
    for _, key in ipairs(COLOR_KEYS) do
        theme[key] = U.color(data[key] or THEME_DEFAULTS[key])
    end
    theme.Mode = data.Mode or "Dark"
    theme.Radius = data.Radius or 6
    theme.Glass = data.Glass == true

    -- 玻璃类主题的附加参数（普通主题保持 0 / false，行为不变）
    theme.Alpha = data.Alpha or 0            -- 窗口底色透明度
    theme.CardAlpha = data.CardAlpha or 0    -- 卡片底色透明度
    theme.Pill = data.Pill == true           -- 侧栏用胶囊按钮
    theme.Glow = data.Glow == true           -- 外圈发光
    theme.SearchInSidebar = data.SearchInSidebar == true
    theme.LineAlpha = data.LineAlpha or 0    -- 分隔线透明度
    return theme
end

for name, data in pairs(RAW_THEMES) do
    Themes[name] = buildTheme(name, data)
end

WobsinsUI.Themes = Themes
WobsinsUI.CurrentTheme = "Ink"
WobsinsUI.ThemeTable = cloneTheme(Themes.Ink)
L.cloneTheme = cloneTheme

function WobsinsUI:GetThemes()
    return Themes
end

function WobsinsUI:GetCurrentTheme()
    return self.CurrentTheme
end

function WobsinsUI:GetTheme(name)
    return Themes[name or self.CurrentTheme] or Themes.Ink
end

-- 自定义主题：以某个内置主题为底，覆盖任意颜色键
function WobsinsUI:AddTheme(config)
    if type(config) ~= "table" or not config.Name then
        return nil
    end

    local base = Themes[config.BasedOn or self.CurrentTheme] or Themes.Graphite
    local theme = { Name = config.Name, Mode = base.Mode, Radius = base.Radius, Glass = base.Glass }
    for _, key in ipairs(COLOR_KEYS) do
        theme[key] = base[key]
    end

    for _, key in ipairs(COLOR_KEYS) do
        if config[key] ~= nil then
            theme[key] = U.color(config[key], base[key])
        end
    end
    if config.Radius then
        theme.Radius = config.Radius
    end
    if config.Glass ~= nil then
        theme.Glass = config.Glass == true
    end
    if config.Mode then
        theme.Mode = config.Mode
    end

    Themes[config.Name] = theme
    return theme
end

function WobsinsUI:RemoveTheme(name)
    if name == "Graphite" then
        return false
    end
    Themes[name] = nil
    return true
end

-- 全局切换：影响所有窗口，且保留每个窗口自己的玻璃 / 圆角设置
function WobsinsUI:SetTheme(name)
    if not Themes[name] then
        name = "Ink"
    end
    self.CurrentTheme = name
    self.ThemeTable = cloneTheme(Themes[name])
    for _, window in ipairs(self.Windows or {}) do
        window.Theme = name
        window:_applyTheme(true)
    end
    return name
end

function WobsinsUI:SetTransparency(state)
    self.Transparency = state and true or false
    for _, window in ipairs(self.Windows or {}) do
        window.Transparency = self.Transparency
        window:_applyTransparency()
    end
end

WobsinsUI.Transparency = false

--//============================================================================
--// 7. 窗口级主题绑定
--//============================================================================
--
-- 元素创建时用 win:_bind(inst, "TextColor3", "Text") 登记，
-- 之后切主题只需要 _applyTheme 遍历一次，不用每个组件自己写 onTheme。

function WobsinsUI:_bind(inst, prop, key)
    if not inst then
        return
    end
    inst[prop] = self:Color(key)
    table.insert(self.Bindings, { inst = inst, prop = prop, key = key })
end

-- 非颜色绑定（比如透明度、描边粗细）
function WobsinsUI:_bindRaw(inst, prop, value)
    if not inst then
        return
    end
    inst[prop] = value
    table.insert(self.RawBindings, { inst = inst, prop = prop, value = value })
end

-- 主题变化时执行的自定义钩子
function WobsinsUI:_onTheme(fn)
    table.insert(self.ThemeHooks, fn)
    safeCall(fn)
end

-- 冻结一个部件的当前颜色，避免主题切换时被覆盖（比如头像底色）
function WobsinsUI:_freeze(inst, prop)
    if not inst then
        return
    end
    for index, binding in ipairs(self.Bindings) do
        if binding.inst == inst and binding.prop == prop then
            table.remove(self.Bindings, index)
            return
        end
    end
end

function WobsinsUI:_applyTheme(rebuildRadius)
    local nextTheme = Themes[self.Theme] or Themes.Ink
    if not self.ThemeTable or self.ThemeTable == nextTheme then
        self.ThemeTable = cloneTheme(nextTheme)
    else
        -- 原地更新：组件里抓住的表引用继续有效
        for key, value in pairs(nextTheme) do
            self.ThemeTable[key] = value
        end
    end
    self.Glass = self.ThemeTable.Glass == true
    self.Radius = self.ThemeTable.Radius or 6

    for _, binding in ipairs(self.Bindings) do
        if binding.inst and binding.inst.Parent ~= nil then
            binding.inst[binding.prop] = self:Color(binding.key)
        end
    end

    for _, hook in ipairs(self.ThemeHooks) do
        safeCall(hook)
    end

    if rebuildRadius then
        if self.Corner then
            self.Corner.CornerRadius = UDim.new(0, self.Radius)
        end
        if self.MainStroke then
            self.MainStroke.Transparency = self.Glass and 0.08 or 0.55
        end
        if self.OnRadius then
            safeCall(self.OnRadius)
        end
    end
end

function WobsinsUI:Color(key)
    local theme = self.ThemeTable or Themes[self.Theme] or Themes.Graphite
    local value = theme[key]
    if typeof(value) == "Color3" then
        return value
    end
    return Color3.new(1, 1, 1)
end

