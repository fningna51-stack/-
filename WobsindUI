--//----------------------------------------------------------------------------
--// 19.1 拖拽
--//----------------------------------------------------------------------------
--
-- 拖动逻辑收进 04_window（Stage 现在是左上角锚点 + 像素坐标，边界直接夹在
-- 屏幕里）。这里以前还有一套按「中心锚点」算的旧实现，会把窗口算飞，删掉。

--//----------------------------------------------------------------------------
--// 19.2 右下角缩放手柄
--//----------------------------------------------------------------------------

function Window:AddResizeGrip(config)
    if self.ResizeGrip or not self.Main then
        return self
    end
    config = config or {}

    local size = 14
    local grip = new("TextButton", {
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromOffset(size, size),
        Position = UDim2.new(1, -size - 2, 1, -size - 2),
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, self.Main)
    self.ResizeGrip = grip

    local glyph = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        Text = "◢",
        TextColor3 = self:Color("Muted"),
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom,
        ZIndex = WobsinsUI.Layers.HeaderItem + 1,
    }, grip)
    self:_bind(glyph, "TextColor3", "Muted")

    local resizing = false
    local startSize = nil
    local startPointer = nil

    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            startSize = Vector2.new(self.Width, self.Height)
            startPointer = input.Position
        end
    end)

    grip.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not resizing then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - startPointer
            local vp = WobsinsUI:_viewport()
            -- 鼠标位移是屏幕像素，设计尺寸要除回缩放倍数
            local k = self.ScaleValue or 1
            local w = U.clamp(startSize.X + delta.X / k, config.MinWidth or 420, vp.X / k - 12)
            local h = U.clamp(startSize.Y + delta.Y / k, config.MinHeight or 300, vp.Y / k - 12)
            self:Resize(w, h)
            if self.SidebarWidth > w * 0.36 then
                self.SidebarWidth = math.floor(w * 0.36)
                if self.Sidebar then
                    self.Sidebar.Size = UDim2.fromOffset(self.SidebarWidth, h - HEADER_HEIGHT - FOOTER_HEIGHT)
                end
            end
        end)
    end

    return self
end

--//----------------------------------------------------------------------------
--// 19.3 位置
--//----------------------------------------------------------------------------

function Window:Center()
    self:_centerStage()
    return self
end

function Window:SetPosition(x, y)
    self:_placeStageAt(tonumber(x) or 0, tonumber(y) or 0)
    return self
end

function Window:SetSidebarWidth(width)
    local vp = WobsinsUI:_viewport()
    self.SidebarWidth = math.floor(U.clamp(width or 168, 110, math.min(280, self.Width * 0.4)))
    if self.Sidebar then
        self.Sidebar.Size = UDim2.fromOffset(self.SidebarWidth, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self.Content then
        self.Content.Position = UDim2.fromOffset(self.SidebarWidth + 1, HEADER_HEIGHT)
        self.Content.Size = UDim2.new(1, -(self.SidebarWidth + 1), 0, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self._relayoutColumns then
        self:_relayoutColumns()
    end
    return self
end

