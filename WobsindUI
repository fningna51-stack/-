local _createWindowRaw = WobsinsUI._createWindow

function WobsinsUI:_createWindow(config)
    local win = _createWindowRaw(self, config)

    if win and not win.Destroyed then
        win.ConfigManager = setmetatable({
            Window = win,
            Configs = {},
        }, ConfigManager)

        -- 悬浮按钮的初始可见性跟随窗口状态
        if win.OpenButton and win.OpenButton.Frame then
            win.OpenButton.Frame.Visible = not win.Visible
        end

        -- 主题首次应用（圆角 / 描边 / 透明度）
        win:_applyTheme(true)
