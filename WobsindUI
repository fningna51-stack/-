            }, row)

            item.Read = true
        end

        WobsinsUI.UnreadNotify = 0
        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#history * 49, 1))
        return nil
    end

    function self_:Open()
        self_:Paint()
        overlay.Visible = true
        self.Opened = true
        win:FocusNotifyCenter(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Opened = false
        win:FocusNotifyCenter(false)
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self_:Close()
        end
        return self_:Open()
    end

    function self_:Refresh()
        if self.Opened then
            self_:Paint()
        end
        return self
    end

    overlay.Activated:Connect(function()
        self_:Close()
    end)
    close.Activated:Connect(function()
        self_:Close()
    end)
    clear.Activated:Connect(function()
        WobsinsUI:ClearNotifications()
        self_:Paint()
    end)

    self._notifyCenter = self_
    WobsinsUI:OnNotify(function()
        if self.Opened then
            self_:Paint()
        end
    end)

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

function Window:FocusNotifyCenter(state)
