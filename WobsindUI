buildKeybind = function(card, cfg)
    local win = card.Window
    local row, top, title, host = rowBase(card, cfg)
    local t = win.ThemeTable
    local current = cfg.Value or "None"
    local listening = false

    local pill = new("TextButton", {
        BackgroundColor3 = t.Background,
        BackgroundTransparency = 0,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromOffset(58, 20),
        LayoutOrder = 1,
        ZIndex = 7,
    }, host)
    corner(pill, 4)
    local pillStroke = stroke(pill, t.Outline, 1, 0.45)

    local pillLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = current,
        TextColor3 = t.Text,
        TextSize = 10,
        ZIndex = 8,
    }, pill)

    local element = { Type = "Keybind", Value = current }

    local function setKey(key, silent)
        current = key
        element.Value = key
        pillLabel.Text = key
        if not silent and cfg.Callback then
            task.spawn(cfg.Callback, key)
        end
    end

    element.SetValue = function(a, b)
        setKey(tostring(argValue(a, b) or "None"), true)
    end
    element.GetValue = function()
        return current
    end

    pill.Activated:Connect(function()
        if listening then
            return
        end
        listening = true
        pillLabel.Text = "按任意键…"
        tween(pillStroke, 0.15, { Transparency = 0, Color = win:Color("Accent") })
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            if processed and input.KeyCode == Enum.KeyCode.Unknown then
                return
            end
            conn:Disconnect()
            listening = false
            tween(pillStroke, 0.15, { Transparency = 0.45, Color = win:Color("Outline") })
            local name = input.KeyCode.Name
            if name == "Unknown" then
                name = "None"
            end
            setKey(name, false)
        end)
    end)

    win:_onTheme(function()
        pill.BackgroundColor3 = win:Color("SurfaceAlt")
        pillStroke.Color = win:Color("Outline")
        pillLabel.TextColor3 = win:Color("Text")
    end)

    return finish(card, element, cfg, row, "按键绑定 keybind")
end

--// Dropdown -----------------------------------------------------------------
buildDropdown = function(card, cfg)
    local win = card.Window
    local row, top, title, host = rowBase(card, cfg)
    local t = win.ThemeTable
    local values = cfg.Values or {}
    local multi = cfg.Multi == true
    local selected
    local element = { Type = "Dropdown", Values = values }

    if multi then
        selected = {}
        local startValues = cfg.Value
        if type(startValues) == "table" then
            for _, value in ipairs(startValues) do
                selected[value] = true
            end
        elseif type(startValues) == "string" then
            selected[startValues] = true
        end
    else
        selected = cfg.Value
        if selected == nil and not cfg.AllowNone then
            selected = values[1]
        end
    end

    local valueLabel = miniText(host, "", win, 96, "SubText")
    local chevron = createIcon(host, "chevron-down", 11, win:Color("Placeholder"))
    if chevron then
        chevron.LayoutOrder = 2
        chevron.ZIndex = 7
    end
    padding(host, 0, 2, 0, 0)

    local panel = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 3,
        Visible = false,
        ZIndex = 8,
    }, row)
    padding(panel, 2, 0, 2, 0)

    local panelScroll = new("ScrollingFrame", {
        BackgroundColor3 = t.Background,
        BackgroundTransparency = 0,
        Size = UDim2.new(1, 0, 0, math.min(#values * 26, 168)),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageTransparency = 0.5,
        BorderSizePixel = 0,
        ZIndex = 9,
    }, panel)
    corner(panelScroll, 4)
    padding(panelScroll, 3, 3, 3, 3)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, panelScroll)

    local optionFrames = {}

    local function selectedCount()
        local count = 0
        for _, _ in pairs(selected) do
            count = count + 1
        end
        return count
    end

    local function readValue()
        if multi then
            local out = {}
            for _, value in ipairs(values) do
                if selected[value] then
                    table.insert(out, value)
                end
            end
            return out
        end
        return selected
    end

    local function valueText()
        if multi then
            local parts = {}
            for _, value in ipairs(values) do
                if selected[value] then
                    table.insert(parts, value)
                end
            end
            if #parts == 0 then
                return cfg.Placeholder or "未选择"
            end
            return table.concat(parts, ", ")
        end
        return selected or cfg.Placeholder or "未选择"
    end

    local function paint()
        valueLabel.Text = valueText()
        for value, option in pairs(optionFrames) do
            local isOn = multi and selected[value] or (not multi and selected == value)
            tween(option.Bg, 0.12, { BackgroundTransparency = isOn and 0.86 or 1 })
            option.Check.Visible = isOn and true or false
            option.Label.TextColor3 = isOn and win:Color("Accent") or win:Color("Text")
        end
    end

    local function notify()
        element.Value = readValue()
        paint()
        if cfg.Callback then
            task.spawn(cfg.Callback, element.Value)
        end
    end

    local function buildOptions()
        for _, option in pairs(optionFrames) do
            option.Frame:Destroy()
        end
        optionFrames = {}
        panelScroll.Size = UDim2.new(1, 0, 0, math.min(#values * 28, 170))

        for index, value in ipairs(values) do
            local opt = new("TextButton", {
                BackgroundColor3 = win:Color("Accent"),
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Text = "",
                Size = UDim2.new(1, 0, 0, 26),
                LayoutOrder = index,
                ZIndex = 10,
            }, panelScroll)
            corner(opt, 7)

            local label = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -30, 1, 0),
                Font = Enum.Font.GothamMedium,
                Text = tostring(value),
                TextColor3 = win:Color("Text"),
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 11,
            }, opt)

            local check = createIcon(opt, "check", 12, win:Color("Accent"))
            if check then
                check.AnchorPoint = Vector2.new(1, 0.5)
                check.Position = UDim2.new(1, -8, 0.5, 0)
                check.ZIndex = 11
                check.Visible = false
            end

            opt.MouseEnter:Connect(function()
                if not (multi and selected[value] or (not multi and selected == value)) then
                    tween(opt, 0.12, { BackgroundTransparency = 0.95 })
                end
            end)
            opt.MouseLeave:Connect(function()
                local isOn = multi and selected[value] or (not multi and selected == value)
                if not isOn then
                    tween(opt, 0.12, { BackgroundTransparency = 1 })
                end
            end)

            opt.Activated:Connect(function()
                if multi then
                    if selected[value] then
                        selected[value] = nil
                    else
                        selected[value] = true
                    end
                    if not cfg.AllowNone and selectedCount() == 0 then
                        selected[value] = true
                    end
                    notify()
                else
                    selected = value
                    notify()
                    panel.Visible = false
                end
            end)

            optionFrames[value] = { Frame = opt, Bg = opt, Label = label, Check = check }
        end
        paint()
    end

    local function setOpen(state)
        panel.Visible = state
        if chevron then
            tween(chevron, 0.2, { Rotation = state and 180 or 0 })
        end
        if state then
            panel.Size = UDim2.new(1, 0, 0, 0)
            panel.AutomaticSize = Enum.AutomaticSize.Y
        end
    end

    row.Activated:Connect(function()
        setOpen(not panel.Visible)
    end)

    element.Refresh = function(newValues)
        values = newValues or {}
        element.Values = values
        if multi then
            for value, _ in pairs(selected) do
                local exists = false
                for _, v in ipairs(values) do
                    if v == value then
                        exists = true
                        break
                    end
                end
                if not exists then
                    selected[value] = nil
                end
            end
        end
        buildOptions()
    end

    element.Select = function(a, b)
        local value = argValue(a, b)
        if multi then
            selected = {}
            if type(value) == "table" then
                for _, v in ipairs(value) do
                    selected[v] = true
                end
            elseif value ~= nil then
                selected[value] = true
            end
        else
            selected = value
        end
        element.Value = readValue()
        paint()
    end

    element.SetValue = element.Select
    element.GetValue = function()
        return element.Value
    end
    element.SetOpen = setOpen

    buildOptions()
    element.Value = readValue()

    win:_onTheme(function()
        panelScroll.BackgroundColor3 = win:Color("Background")
        for _, option in pairs(optionFrames) do
            option.Bg.BackgroundColor3 = win:Color("Accent")
            option.Label.TextColor3 = (multi and selected[option.Label.Text] or selected == option.Label.Text)
                and win:Color("Accent") or win:Color("Text")
            if option.Check then
                if option.Check:IsA("TextLabel") then
                    option.Check.TextColor3 = win:Color("Accent")
                else
                    option.Check.ImageColor3 = win:Color("Accent")
                end
            end
        end
        if chevron then
            if chevron:IsA("TextLabel") then
                chevron.TextColor3 = win:Color("Placeholder")
            else
                chevron.ImageColor3 = win:Color("Placeholder")
            end
        end
        valueLabel.TextColor3 = win:Color("SubText")
    end)

    return finish(card, element, cfg, row, "下拉 dropdown option select")
end

