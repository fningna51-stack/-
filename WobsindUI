-- 逐个挂到 Card 上，调用形式 Card:Toggle({...})
local ELEMENT_TYPES = {
    "Toggle", "Slider", "Dropdown", "Input", "Keybind", "Colorpicker",
    "Button", "Paragraph", "Divider", "Label", "Code", "Space", "Textbox",
    "Checkbox", "Radio", "Progress", "Image", "PlayerList", "Console", "Tag",
}
L.ELEMENT_TYPES = ELEMENT_TYPES

local function mountCard(kind)
    local key = kind == "Textbox" and "Input" or kind
    Card[kind] = function(self, config)
        local builder = Build[key]
        if not builder then
            logWarn("[WobsinsUI] 组件未实现: " .. tostring(key))
            return nil
        end
        local ok, result = pcall(builder, self, config or {})
        if not ok then
            logWarn("[WobsinsUI] 构建 " .. kind .. " 失败: " .. tostring(result))
            if _G.__WOBSINS_DEBUG then
                error(result, 0)
            end
            -- 出错也要留一行可见的提示，避免整张卡片消失
            local row = I.row(self, { Title = "组件加载失败", Desc = tostring(result), NoHover = true }, 0)
            local label = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(6, 0),
                Size = UDim2.new(1, -12, 0, 15),
                Font = Enum.Font.Gotham,
                Text = kind .. " 构建失败：" .. tostring(result),
                TextColor3 = self.Window:Color("Danger"),
                TextSize = 9.5,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, row)
            return nil
        end
        return result
    end
end

-- 标签页上直接写元素时，自动塞进一张无标题卡片
function Tab:_implicitCard()
    local last = self.Cards[#self.Cards]
    if last and last.Title == "" and last.Implicit then
        return last
    end
    local card = self:Card({ Title = "" })
    card.Implicit = true
    return card
end

local function mountTab(kind)
    Tab[kind] = function(self, config)
        local card = self:_implicitCard()
        local method = card[kind]
        if method then
            return method(card, config)
        end
        return nil
    end
end

for _, kind in ipairs(ELEMENT_TYPES) do
    mountCard(kind)
    mountTab(kind)
end

-- 后续模块（16 之后）用它登记新组件，Card / Tab / Page 三处自动打通
function L.RegisterElement(kind)
    if not kind then
        return
    end
    table.insert(ELEMENT_TYPES, kind)
    mountCard(kind)
    mountTab(kind)
    if L.Page and L.Page.register then
        L.Page.register(kind)
    end
end

