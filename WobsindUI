    return element
end

--// Toggle -------------------------------------------------------------------
buildToggle = function(card, cfg)
    local win = card.Window
    local row, top, title, host = rowBase(card, cfg)
    local t = win.ThemeTable
    local state = cfg.Value == true

    local track = new("Frame", {
        Size = UDim2.fromOffset(26, 14),
        BackgroundColor3 = t.Outline,
        BackgroundTransparency = 0,
        LayoutOrder = 1,
        ZIndex = 7,
    }, host)
    corner(track, 7)
    local trackStroke = stroke(track, t.Outline, 1, 0.6)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8,
    }, track)
    corner(knob, 5)

    local element = {
        Type = "Toggle",
        Value = state,
        Callback = cfg.Callback,
    }

    local function render(animate)
        local target = state and UDim2.fromOffset(14, 2) or UDim2.fromOffset(2, 2)
        local onColor = win:Color("Accent")
        local offColor = win:Color("Outline")
        local knobOn = win:Color("Background")
        local knobOff = win:Color("SubText")
        if animate then
            tween(knob, 0.16, { Position = target }, Enum.EasingStyle.Quad)
            tween(track, 0.16, { BackgroundColor3 = state and onColor or offColor })
            tween(knob, 0.16, { BackgroundColor3 = state and knobOn or knobOff })
            tween(trackStroke, 0.16, { Transparency = state and 0.35 or 0.6 })
        else
            knob.Position = target
            track.BackgroundColor3 = state and onColor or offColor
            knob.BackgroundColor3 = state and knobOn or knobOff
            trackStroke.Transparency = state and 0.35 or 0.6
        end
    end

    local function set(value, silent)
        state = value and true or false
        element.Value = state
        render(true)
        if not silent and cfg.Callback then
            task.spawn(cfg.Callback, state)
        end
    end

    element.SetValue = function(a, b)
        set(argValue(a, b), true)
    end
    element.GetValue = function()
        return state
    end
    element.Set = set

    row.Activated:Connect(function()
        set(not state, false)
    end)

    render(false)

    win:_onTheme(function()
        render(false)
        trackStroke.Color = win:Color("Outline")
    end)

    return finish(card, element, cfg, row, "开关 toggle switch")
end

--// Slider -------------------------------------------------------------------
buildSlider = function(card, cfg)
    local win = card.Window
    local row, top, title, host = rowBase(card, cfg)
    local t = win.ThemeTable

    local valueCfg = cfg.Value or {}
    local minValue = valueCfg.Min or 0
    local maxValue = valueCfg.Max or 100
    local step = cfg.Step or 1
    local current = valueCfg.Default or minValue

    local valueLabel = miniText(host, prettyNumber(current), win, nil, "SubText")

    local railHolder = new("TextButton", {
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.new(1, 0, 0, 12),
        LayoutOrder = 3,
        ZIndex = 5,
    }, row)

    local rail = new("Frame", {
        BackgroundColor3 = t.Outline,
        BackgroundTransparency = 0.1,
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 0.5, -1.5),
        ZIndex = 6,
    }, railHolder)
    corner(rail, 2)

    local fill = new("Frame", {
        BackgroundColor3 = t.Accent,
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = 7,
    }, rail)
    corner(fill, 2)

    local knob = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        ZIndex = 8,
    }, rail)
    corner(knob, 5)
    local knobStroke = stroke(knob, t.Background, 1, 0.3)

    local alpha = 0
    local element = { Type = "Slider", Value = current }

    local function paint()
        alpha = (maxValue == minValue) and 0 or clamp((current - minValue) / (maxValue - minValue), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = prettyNumber(current)
    end

    local function apply(value, silent)
        value = clamp(value, minValue, maxValue)
        if step and step > 0 then
            value = clamp(round(value, step), minValue, maxValue)
        end
        local changed = value ~= current
        current = value
        element.Value = current
        paint()
        if changed and not silent and cfg.Callback then
            task.spawn(cfg.Callback, current)
        end
    end

    element.SetValue = function(a, b)
        apply(argValue(a, b), true)
    end
    element.GetValue = function()
        return current
    end
    element.Set = apply

    local dragging = false
    local function fromMouse(x)
        local abs = railHolder.AbsolutePosition.X
        local width = railHolder.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local percent = clamp((x - abs) / width, 0, 1)
        apply(minValue + (maxValue - minValue) * percent, false)
    end

    railHolder.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromMouse(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            fromMouse(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    paint()
    win:_onTheme(function()
        rail.BackgroundColor3 = win:Color("Outline")
        fill.BackgroundColor3 = win:Color("Accent")
        knob.BackgroundColor3 = win:Color("Text")
        knobStroke.Color = win:Color("Background")
    end)

    return finish(card, element, cfg, row, "滑块 slider")
end

