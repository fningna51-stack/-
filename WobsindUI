    btn.MouseLeave:Connect(function()
        tween(btn, 0.15, { BackgroundTransparency = 1 })
        if ic then
            if ic:IsA("TextLabel") then
                tween(ic, 0.15, { TextColor3 = win:Color(colorKey or "SubText") })
            else
                tween(ic, 0.15, { ImageColor3 = win:Color(colorKey or "SubText") })
            end
        end
    end)
    btn.Activated:Connect(callback)

    win:_onTheme(function()
        btn.BackgroundColor3 = win:Color("SurfaceAlt")
        if ic then
            if ic:IsA("TextLabel") then
                ic.TextColor3 = btn.BackgroundTransparency >= 1 and win:Color(colorKey or "SubText") or win:Color("Text")
            else
                ic.ImageColor3 = btn.BackgroundTransparency >= 1 and win:Color(colorKey or "SubText") or win:Color("Text")
            end
        end
    end)

    return btn
end


