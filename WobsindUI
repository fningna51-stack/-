--// 14.3 Keybind
--//----------------------------------------------------------------------------

function Build.Keybind(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local key = config.Value or "None"
    local capturing = false

    local row, top, title, desc, control = I.row(card, config, 76)

    local pill = new("TextButton", {
        BackgroundColor3 = theme.SurfaceAlt,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    U.corner(pill, 4)
    local pillStroke = U.stroke(pill, theme.Outline, 1, 0.5)
    win:_bind(pill, "BackgroundColor3", "SurfaceAlt")

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = tostring(key),
        TextColor3 = theme.SubText,
        TextSize = 10,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, pill)
    win:_bind(label, "TextColor3", "SubText")

    local element = {
        Type = "Keybind",
        Frame = row,
        Value = key,
        Callback = config.Callback,
    }

    function element.GetValue()
        return key
    end

    local function stopCapture()
        capturing = false
        label.Text = tostring(key)
        label.TextColor3 = win:Color("SubText")
        pillStroke.Color = win:Color("Outline")
    end

    local function startCapture()
        if element.Locked then
            return
        end
        capturing = true
        label.Text = "按下按键…"
        label.TextColor3 = win:Color("Accent")
        pillStroke.Color = win:Color("Accent")
    end

    pill.Activated:Connect(function()
        if capturing then
            stopCapture()
        else
            startCapture()
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputBegan:Connect(function(input, processed)
            if not capturing then
                return
            end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    stopCapture()
                    return
                end
                key = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2 then
                key = input.UserInputType == Enum.UserInputType.MouseButton1 and "Mouse1" or "Mouse2"
            else
                return
            end
            element.Value = key
            stopCapture()
            if config.Callback then
                safeCall(config.Callback, key)
            end
        end)
    end

    I.setter(element, function(value)
        key = tostring(value or "None")
        element.Value = key
        label.Text = key
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
        if not visible then
            capturing = false
        end
    end

    return I.finish(card, element, config)
end

--//============================================================================
--// 15. Colorpicker
--//============================================================================
--
-- 结构：色块 → 展开面板（饱和度/明度方块 + 色相条 + Hex 输入）
-- 面板放在行内部，靠 AutomaticSize 把卡片撑高，不会被裁掉。

function Build.Colorpicker(card, config)
    local win = card.Window
    local theme = win.ThemeTable

    local color = U.color(config.Default or config.Value or "#FFFFFF")
    local h, s, v = color:ToHSV()

    local row, top, title, desc, control = I.row(card, config, 34)

    local swatch = new("TextButton", {
        BackgroundColor3 = color,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    U.corner(swatch, 5)
    U.stroke(swatch, theme.Outline, 1, 0.3)

    local element = {
        Type = "Colorpicker",
        Frame = row,
        Value = color,
        Callback = config.Callback,
    }

    -- 展开面板
    local panel = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        Visible = false,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, panel)
    U.padding(panel, 0, 4, 0, 2)

    -- 饱和度 / 明度
    local sv = new("TextButton", {
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.new(1, 0, 0, 90),
        ClipsDescendants = true,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, panel)
    U.corner(sv, 4)

    new("UIGradient", {
        Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, sv)

    local svDark = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, sv)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
    }, svDark)

    local cursor = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(s, 0, 1 - v, 0),
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, sv)
    U.corner(cursor, 5)
    U.stroke(cursor, Color3.new(1, 1, 1), 1.5, 0)

    -- 色相条
    local hue = new("TextButton", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.new(1, 0, 0, 12),
        ClipsDescendants = true,
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, panel)
    U.corner(hue, 4)

    new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
        }),
    }, hue)

    local hueCursor = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 3, 1, 2),
        Position = UDim2.new(h, 0, 0, 0),
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, hue)
    U.corner(hueCursor, 1)
    U.stroke(hueCursor, Color3.new(1, 1, 1), 1.5, 0)

    -- Hex 输入
    local hexRow = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24),
        LayoutOrder = 3,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, panel)

    local hexBox = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.new(1, -70, 1, 0),
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, hexRow)
    U.corner(hexBox, 4)
    U.stroke(hexBox, theme.Outline, 1, 0.45)

    local hexInput = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -16, 1, 0),
        Font = Enum.Font.Code,
        Text = "#" .. color:ToHex(),
        TextColor3 = theme.Text,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, hexBox)
    win:_bind(hexInput, "TextColor3", "Text")

    local apply = new("TextButton", {
        BackgroundColor3 = theme.SurfaceAlt,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(62, 24),
        Position = UDim2.new(1, -62, 0, 0),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, hexRow)
    U.corner(apply, 4)
    U.stroke(apply, theme.Outline, 1, 0.45)

    local applyLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = "应用",
        TextColor3 = theme.Text,
        TextSize = 10,
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, apply)
    win:_bind(applyLabel, "TextColor3", "Text")

    local function currentColor()
        return Color3.fromHSV(h, s, v)
    end

    local function paint(fire)
        color = currentColor()
        element.Value = color

        swatch.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0, 0)
        if hexInput.Text ~= "#" .. color:ToHex() then
            hexInput.Text = "#" .. color:ToHex()
        end

        if fire and config.Callback then
            safeCall(config.Callback, color)
        end
    end

    local function updateSV(input)
        local abs = sv.AbsolutePosition
        local size = sv.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then
            return
        end
        s = U.clamp((input.Position.X - abs.X) / size.X, 0, 1)
        v = 1 - U.clamp((input.Position.Y - abs.Y) / size.Y, 0, 1)
        paint(true)
    end

    local function updateHue(input)
        local abs = hue.AbsolutePosition
        local size = hue.AbsoluteSize
        if size.X <= 0 then
            return
        end
        h = U.clamp((input.Position.X - abs.X) / size.X, 0, 1)
        paint(true)
    end

    local draggingSV = false
    local draggingHue = false

    sv.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            updateSV(input)
        end
    end)
    sv.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
        end
    end)

    hue.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            updateHue(input)
        end
    end)
    hue.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            if draggingSV then
                updateSV(input)
            elseif draggingHue then
                updateHue(input)
            end
        end)
    end

    local function applyHex()
        local text = tostring(hexInput.Text or ""):gsub("#", "")
        if #text == 6 and text:match("^%x+$") then
            local parsed = U.color("#" .. text)
            h, s, v = parsed:ToHSV()
            paint(true)
        else
            hexInput.Text = "#" .. currentColor():ToHex()
        end
    end

    hexInput.FocusLost:Connect(applyHex)
    apply.Activated:Connect(applyHex)

    local function setPanelOpen(state)
        panel.Visible = state and true or false
    end

    swatch.Activated:Connect(function()
        setPanelOpen(not panel.Visible)
    end)

    function element.GetValue()
        return currentColor()
    end

    I.setter(element, function(value)
        local parsed = U.color(value, currentColor())
        h, s, v = parsed:ToHSV()
        paint(false)
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    win:_onTheme(function()
        hexInput.TextColor3 = win:Color("Text")
        applyLabel.TextColor3 = win:Color("Text")
    end)

    paint(false)

    return I.finish(card, element, config)
end

--//============================================================================
--// 16. 配置保存
--//============================================================================
--
-- 用法：
--   local cfg = Window.ConfigManager:CreateConfig("main")
--   cfg:Register("autoFarm", toggleElement)
--   cfg:Save()   /   cfg:Load()
--
-- 存盘位置：<Folder>/configs/<name>.json，不支持文件系统时静默失败并返回 false。

L.ConfigManager = {}
L.ConfigManager.__index = L.ConfigManager

local ConfigManager = L.ConfigManager

function ConfigManager.new(window)
    return setmetatable({
        Window = window,
        Configs = {},
    }, ConfigManager)
end

L.Config = {}
L.Config.__index = L.Config
local Config = L.Config

local function encodeValue(element)
    if type(element.GetValue) ~= "function" then
        return nil
    end

    if element.Type == "Colorpicker" then
        local color = element.GetValue()
        if typeof(color) ~= "Color3" then
            return nil
        end
        return { math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5) }
    elseif element.Type == "Slider" then
        return tonumber(element.GetValue()) or 0
    elseif element.Type == "Toggle" then
        return element.GetValue() == true
    elseif element.Type == "Dropdown" then
        local value = element.GetValue()
        if type(value) == "table" then
            local copy = {}
            for index, item in ipairs(value) do
                copy[index] = item
            end
            return copy
        end
        return tostring(value or "")
    else
        return tostring(element.GetValue() or "")
    end
end

local function decodeValue(element, value)
    if element.Type == "Colorpicker" then
        if type(value) == "table" and value[1] then
            return Color3.fromRGB(value[1], value[2], value[3])
        end
        return nil
    elseif element.Type == "Slider" then
        local number = tonumber(value)
        if number then
            return number
        end
        return nil
    elseif element.Type == "Toggle" then
        return value == true
    elseif element.Type == "Dropdown" then
        return value
    end
    if value == nil then
        return nil
    end
    return tostring(value)
end

function ConfigManager:CreateConfig(name)
    local config = setmetatable({
        Manager = self,
        Window = self.Window,
        Name = name or "default",
        Entries = {},
        Dirty = false,
    }, Config)
    self.Configs[config.Name] = config
    return config
end

function Config:Register(key, element)
    if key == nil or element == nil then
        return self
    end
    self.Entries[tostring(key)] = element
    return self
end

function Config:Unregister(key)
    self.Entries[tostring(key)] = nil
    return self
end

function Config:_path()
    local folder = self.Window.Folder or "WobsinsUI"
    return folder .. "/configs/" .. self.Name .. ".json"
end

function Config:Save()
    local data = {}
    for key, element in pairs(self.Entries) do
        if element and element.Type then
            local encoded = encodeValue(element)
            if encoded ~= nil then
                data[key] = encoded
            end
        end
    end

    local okJson, json = pcall(function()
        return S.HttpService:JSONEncode(data)
    end)
    if not okJson or not json then
        return false
    end

    local ok = pcall(function()
        local folder = self.Window.Folder or "WobsinsUI"
        local configFolder = folder .. "/configs"
        if makefolder and not (isfolder and isfolder(configFolder)) then
            pcall(makefolder, folder)
            pcall(makefolder, configFolder)
        end
        writefile(self:_path(), json)
    end)

    self.Dirty = not ok
    return ok
end

function Config:Load()
    local path = self:_path()
    local raw = nil

    local okRead = pcall(function()
        if isfile and isfile(path) then
            raw = readfile(path)
        end
    end)
    if not okRead or not raw or raw == "" then
        return false
    end

    local okJson, data = pcall(function()
        return S.HttpService:JSONDecode(raw)
    end)
    if not okJson or type(data) ~= "table" then
        return false
    end

    for key, element in pairs(self.Entries) do
        local stored = data[key]
        if stored ~= nil and element and element.SetValue then
            local decoded = decodeValue(element, stored)
            if decoded ~= nil then
                pcall(function()
                    if element.SetSilent then
                        element:SetSilent(decoded)
                    else
                        element.SetValue(decoded)
                    end
                end)
            end
        end
    end

    return true
end

function Config:Delete()
    local ok = pcall(function()
        if delfile then
            delfile(self:_path())
        end
    end)
    return ok
end

function Config:Exists()
    local exists = false
    pcall(function()
        if isfile then
            exists = isfile(self:_path()) == true
        end
    end)
    return exists
end

