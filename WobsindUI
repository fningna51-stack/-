function Build.Paragraph(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local avatarSize = config.ImageSize or 32

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.padding(holder, 6, 6, 6, 6)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    local top = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)

    local textX = 0

    if config.Image and config.Image ~= "" then
        local avatar = new("Frame", {
            BackgroundColor3 = theme.SurfaceAlt,
            Size = UDim2.fromOffset(avatarSize, avatarSize),
            ZIndex = WobsinsUI.Layers.RowItem,
        }, top)
        U.corner(avatar, 7)

        if U.isImage(config.Image) then
            local image = new("ImageLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Image = config.Image,
                ScaleType = Enum.ScaleType.Crop,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, avatar)
            U.corner(image, 7)
        else
            local icon = U.icon(avatar, config.Image, math.floor(avatarSize * 0.5), theme.Accent, WobsinsUI.Layers.RowItem + 1)
            if icon then
                icon.AnchorPoint = Vector2.new(0.5, 0.5)
                icon.Position = UDim2.fromScale(0.5, 0.5)
            end
        end
        textX = avatarSize + 10
    end

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(textX, 0),
        Size = UDim2.new(1, -textX, 0, 15),
        Font = Enum.Font.GothamMedium,
        Text = config.Title or "标题",
        TextColor3 = theme.Text,
        TextSize = 11.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, top)
    win:_bind(title, "TextColor3", "Text")

    local desc = nil
    if config.Desc and config.Desc ~= "" then
        desc = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(textX, 17),
            Size = UDim2.new(1, -textX, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = config.Desc,
            TextColor3 = theme.SubText,
            TextSize = 9.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, top)
        win:_bind(desc, "TextColor3", "SubText")
    end

    local element = {
        Type = "Paragraph",
        Frame = holder,
    }

    -- 按钮行
    if config.Buttons and #config.Buttons > 0 then
        local row = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 24),
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.RowItem,
        }, holder)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, row)

        for index, info in ipairs(config.Buttons) do
            local primary = info.Variant == "Primary"
            local btn = new("TextButton", {
                BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
                AutoButtonColor = false,
                Size = UDim2.fromOffset(info.Width or 72, 24),
                Text = "",
                LayoutOrder = index,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, row)
            U.corner(btn, 4)
            U.stroke(btn, theme.Outline, 1, primary and 1 or 0.4)

            local label = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Font = Enum.Font.GothamMedium,
                Text = info.Title or "按钮",
                TextColor3 = primary and theme.OnAccent or theme.Text,
                TextSize = 10,
                ZIndex = WobsinsUI.Layers.RowItem + 2,
            }, btn)

            btn.MouseEnter:Connect(function()
                U.tween(btn, 0.12, {
                    BackgroundColor3 = primary and U.mix(theme.Accent, theme.Text, 0.12) or theme.SurfaceHover,
                })
            end)
            btn.MouseLeave:Connect(function()
                U.tween(btn, 0.12, {
                    BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
                })
            end)
            btn.Activated:Connect(function()
                if info.Callback then
                    safeCall(info.Callback)
                end
            end)
        end
    end

    return I.finish(card, element, config)
end

