--//----------------------------------------------------------------------------
--// 12.1 Button
--//----------------------------------------------------------------------------

function Build.Button(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local variant = config.Variant or "Secondary"
    local height = config.Height or 28

    local locked = config.Locked == true

    local btn = new("TextButton", {
        BackgroundColor3 = theme.SurfaceAlt,
        BackgroundTransparency = 0,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, height),
        Text = "",
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.corner(btn, 4)
    U.stroke(btn, theme.Outline, 1, variant == "Ghost" and 0.4 or 0.9)

    -- 中央内容：图标 + 文字整体居中。
    -- 这里不用 AutomaticSize + 列表布局 —— 那个写法在不同执行器上算出来的
    -- 宽度不一致，图标会飘到按钮外面。改成先估文字宽度，再用 0.5 锚点手工摆，
    -- 结果稳定，也不会因为字体差异而偏。
    local iconSize = 12
    local gap = 7
    local textSize = config.TextSize or 12
    local title = config.Title or "按钮"
    if locked then
        title = title .. "  ·  未解锁"
    end
    local textWidth = U.textWidth(title, textSize)
    local totalWidth = textWidth + (config.Icon and (iconSize + gap) or 0)
    local startX = -totalWidth / 2

    local iconObj = nil
    if config.Icon then
        iconObj = U.icon(btn, config.Icon, iconSize, (variant == "Primary") and theme.OnAccent or theme.Text, WobsinsUI.Layers.RowItem + 1)
        if iconObj then
            iconObj.AnchorPoint = Vector2.new(0, 0.5)
            iconObj.Position = UDim2.new(0.5, startX, 0.5, 0)
            iconObj.Size = UDim2.fromOffset(iconSize, iconSize)
        end
    end

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0.5, startX + (config.Icon and (iconSize + gap) or 0), 0.5, 0),
        Size = UDim2.fromOffset(math.ceil(textWidth) + 2, height),
        Font = Enum.Font.GothamMedium,
        Text = title,
        TextColor3 = (variant == "Primary") and theme.OnAccent or theme.Text,
        TextSize = textSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, btn)

    local element = {
        Type = "Button",
        Frame = btn,
        Value = config.Title,
    }

    local function paint()
        local on = (variant == "Primary")
        local base = on and theme.Accent or (variant == "Ghost" and theme.Background or theme.SurfaceAlt)
        local textColor = on and theme.OnAccent or theme.Text
        btn.BackgroundColor3 = base
        btn.BackgroundTransparency = (variant == "Ghost") and 0.72 or 0
        label.TextColor3 = textColor
        if iconObj then
            U.tint(iconObj, textColor)
        end
    end
    paint()

    win:_onTheme(paint)

    if locked then
        btn.BackgroundTransparency = 1
        U.tween(btn, 0.1, { BackgroundTransparency = 1 })
        label.TextColor3 = theme.Muted
        if iconObj then
            U.tint(iconObj, theme.Muted)
        end
    end

    btn.MouseEnter:Connect(function()
        if locked then
            return
        end
        if variant == "Primary" then
            U.tween(btn, 0.12, { BackgroundColor3 = U.mix(theme.Accent, theme.Text, 0.12) })
        elseif variant == "Ghost" then
            U.tween(btn, 0.12, { BackgroundTransparency = 0.92 })
        else
            U.tween(btn, 0.12, { BackgroundColor3 = theme.SurfaceHover })
        end
    end)
    btn.MouseLeave:Connect(function()
        if locked then
            return
        end
        paint()
    end)
    btn.MouseButton1Down:Connect(function()
        if locked then
            return
        end
        U.tween(btn, 0.08, { BackgroundTransparency = (variant == "Ghost") and 0.9 or 0.12 })
    end)
    btn.MouseButton1Up:Connect(function()
        if locked then
            return
        end
        paint()
    end)

    btn.Activated:Connect(function()
        if locked then
            WobsinsUI:Notify({
                Title = "不可用",
                Content = "该功能暂未开放。",
                Icon = "lock",
                Duration = 3,
                Window = win,
            })
            return
        end
        if config.Callback then
            safeCall(config.Callback)
        end
        if config.Notify ~= false then
            pcall(function()
                win:Toast(config.Title or "操作", "已执行", config.Icon or "check", 1.5)
            end)
        end
    end)

    U.ripple(btn, theme.Text)

    element.SetEnabled = function(state)
        locked = not state
        if state then
            label.Text = config.Title or "按钮"
            paint()
        else
            label.Text = (config.Title or "按钮") .. "  ·  未解锁"
            btn.BackgroundTransparency = 1
            label.TextColor3 = theme.Muted
        end
    end

    return I.finish(card, element, config)
end

