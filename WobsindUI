    --//--------------------------------------------------------------------

    function self_:Paint()
        local stale = {}
        for _, child in ipairs(list._children) do
            if child.ClassName ~= "UIListLayout" then
                table.insert(stale, child)
            end
        end
        for _, child in ipairs(stale) do
            child:Destroy()
        end

        local count = 0
        for _, entry in ipairs(self.Filtered) do
            count = count + 1
            local active = (count == self.Index)

            local row = new("TextButton", {
                BackgroundColor3 = active and self.Window:Color("SurfaceAlt") or self.Window:Color("Surface"),
                BackgroundTransparency = active and 0.1 or 1,
                AutoButtonColor = false,
                Text = "",
                Size = UDim2.new(1, 0, 0, 36),
                LayoutOrder = count,
                ZIndex = WobsinsUI.Layers.Modal + 3,
            }, list)

            local badge = new("TextLabel", {
                BackgroundColor3 = self.Window:Color("SurfaceAlt"),
                BackgroundTransparency = 0.2,
                Position = UDim2.fromOffset(10, 9),
                Size = UDim2.fromOffset(18, 18),
                Font = Enum.Font.GothamBold,
                Text = string.upper(string.sub(tostring(entry.Kind or "?"), 1, 1)),
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 8.5,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)
            U.corner(badge, 4)

            local name = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(36, 3),
                Size = UDim2.new(1, -110, 0, 16),
                Font = Enum.Font.Gotham,
                Text = tostring(entry.Title),
                TextColor3 = active and self.Window:Color("Text") or self.Window:Color("SubText"),
                TextSize = 10.5,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)

            local where = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(36, 18),
                Size = UDim2.new(1, -60, 0, 14),
                Font = Enum.Font.Gotham,
                Text = tostring(entry.Where or ""),
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 8.5,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)

            row.Activated:Connect(function()
                self.Index = count
                self_:Commit()
            end)

            if active then
                self._activeRow = row
            end
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(count * 37, 1))

        if count == 0 then
            local empty = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 60),
                Font = Enum.Font.Gotham,
                Text = "没有匹配项",
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 10.5,
                ZIndex = WobsinsUI.Layers.Modal + 3,
            }, list)
        end
    end

    function self_:Filter(text)
        local query = string.lower(tostring(text or ""))
        self.Filtered = {}
        for _, entry in ipairs(self.Entries) do
            local haystack = string.lower(tostring(entry.Title) .. " " .. tostring(entry.Where))
            if query == "" or string.find(haystack, query, 1, true) then
                table.insert(self.Filtered, entry)
            end
        end
        self.Index = math.min(self.Index, math.max(#self.Filtered, 1))
        self_:Paint()
    end

    function self_:Move(delta)
        if #self.Filtered == 0 then
            return
        end
        self.Index = self.Index + delta
        if self.Index < 1 then
            self.Index = 1
        end
        if self.Index > #self.Filtered then
            self.Index = #self.Filtered
        end
        self_:Paint()

        local row = self._activeRow
        if row and scroll then
            local offset = (self.Index - 1) * 37
            local height = scroll.AbsoluteSize.Y
            if offset < scroll.CanvasPosition.Y then
                scroll.CanvasPosition = Vector2.new(0, offset)
            elseif offset + 37 > scroll.CanvasPosition.Y + height then
                scroll.CanvasPosition = Vector2.new(0, offset + 37 - height)
            end
        end
    end

    function self_:Commit()
        local entry = self.Filtered[self.Index]
        if not entry then
            return
        end

        self:Close()

        if entry.Run then
            safeCall(entry.Run)
            return
        end

        if entry.Tab then
            win:SelectTab(entry.Tab)
        end
        if entry.Page and entry.Page.Open then
            entry.Page:Open()
        end
        if entry.Tab and entry.Element then
            U.delay(0.05, function()
                entry.Tab:ScrollTo(entry.Element)
                entry.Tab:Flash(entry.Element, entry.Title)
            end)
        end
    end

    function self_:Open()
        self.Entries = paletteEntries(win)
        self.Index = 1
        input.Text = ""
        self.Filtered = self.Entries
        self_:Paint()
        overlay.Visible = true
        self.Opened = true
        win:FocusPalette(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Opened = false
        win:FocusPalette(false)
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self_:Close()
        end
        return self_:Open()
    end

    input:GetPropertyChangedSignal("Text"):Connect(function()
        if not self_.Opened then
            return
        end
        self_.Index = 1
        self_:Filter(input.Text)
    end)

    overlay.Activated:Connect(function()
        self_:Close()
    end)

    if S.UserInputService then
        S.UserInputService.InputBegan:Connect(function(inputObject, processed)
            if processed then
                return
            end

            if not self_.Opened then
                return
            end

            local key = inputObject.KeyCode
            if key == Enum.KeyCode.Down or key == Enum.KeyCode.Tab then
                self_:Move(1)
            elseif key == Enum.KeyCode.Up then
                self_:Move(-1)
            elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.KeypadEnter then
                self_:Commit()
            elseif key == Enum.KeyCode.Escape then
                self_:Close()
            end
        end)
    end

    self._palette = self_

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

function Window:FocusPalette(state)
    self._paletteOpen = state and true or false
    return self
end

