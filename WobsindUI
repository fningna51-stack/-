-- 创建图标：name 可以是内置名称、字形、rbxassetid://、http 图片
function U.icon(parent, name, size, color, zIndex)
    if not name or name == "" then
        return nil
    end
    size = size or 14
    color = color or Color3.new(1, 1, 1)

    if U.isImage(name) then
        local img = new("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(size, size),
            Image = name,
            ImageColor3 = color,
            ScaleType = Enum.ScaleType.Fit,
            ZIndex = zIndex or 2,
        }, parent)
        return img
    end

    local key = string.lower(tostring(name))
    local glyph = WobsinsUI.Icons[name] or WobsinsUI.Icons[key]

    -- 未登记的名字绝不能把原文当图标画出来（"paintbrush" 会被缩成一团乱码），
    -- 用一个字母色块兜底，看起来仍然是有意设计过的。
    if not glyph then
        local tile = new("Frame", {
            BackgroundColor3 = color,
            BackgroundTransparency = 0.86,
            Size = UDim2.fromOffset(size, size),
            ZIndex = zIndex or 2,
        }, parent)
        U.corner(tile, math.max(2, math.floor(size * 0.28)))

        new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBold,
            Text = string.upper(string.sub(key, 1, 1)),
            TextColor3 = color,
            TextSize = math.max(7, math.floor(size * 0.66)),
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = (zIndex or 2) + 1,
        }, tile)

        return tile
    end

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        Font = Enum.Font.GothamBold,
        Text = glyph,
        TextColor3 = color,
        TextSize = size,
        TextScaled = true,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = zIndex or 2,
    }, parent)
    new("UITextSizeConstraint", {
        MaxTextSize = math.max(size, 8),
        MinTextSize = 1,
    }, label)
    return label
end

-- 换图标颜色（文字 / 图片两种类型）
function U.tint(obj, color)
    if not obj then
        return
    end
    if obj:IsA("TextLabel") then
        obj.TextColor3 = color
    elseif obj:IsA("ImageLabel") then
        obj.ImageColor3 = color
    end
end

