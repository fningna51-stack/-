--// Config manager ------------------------------------------------------------
local ConfigManager = {}
ConfigManager.__index = ConfigManager

local function ensureFolder(path)
    if not (isfolder and makefolder) then
        return false
    end
    local current = ""
    for _, segment in ipairs(split(path, "/")) do
        if segment ~= "" then
            current = (current == "") and segment or (current .. "/" .. segment)
            if not isfolder(current) then
                local ok = pcall(makefolder, current)
                if not ok then
                    return false
                end
            end
        end
    end
    return true
end

local function encodeElement(element)
    if not element or not element.GetValue then
        return nil
    end
    local value = element.GetValue()
    if element.Type == "Colorpicker" and typeof(value) == "Color3" then
        return value:ToHex()
    end
    if element.Type == "Slider" then
        return tonumber(value) or 0
    end
    if element.Type == "Toggle" then
        return value == true
    end
    return value
end

local function decodeElement(element, value)
    if element.Type == "Colorpicker" then
        local ok, color = pcall(function()
            return Color3.fromHex(tostring(value))
        end)
        if ok then
            element.SetValue(color)
        end
        return
    end
    if element.Type == "Slider" then
        element.SetValue(tonumber(value) or 0)
        return
    end
    if element.Type == "Toggle" then
        element.SetValue(value == true)
        return
    end
    if element.SetValue then
        element.SetValue(value)
    end
end

local function createConfigManager(window)
    local manager = setmetatable({
        Window = window,
        Configs = {},
        Folder = window.Folder .. "/configs",
    }, ConfigManager)

    function manager:CreateConfig(name)
        name = name or "default"
        local config = {
            Name = name,
            Folder = self.Folder,
            Window = window,
            Elements = {},
        }

        function config:Register(elementName, element)
            if not elementName or not element then
                return self
            end
            self.Elements[elementName] = element
            return self
        end

        function config:Save()
            if not (writefile and HttpService) then
                warn("[WobsinsUI] this executor does not support file writing")
                return false
            end
            local data = {}
            for elementName, element in pairs(self.Elements) do
                local ok, encoded = pcall(encodeElement, element)
                if ok then
                    data[elementName] = encoded
                end
            end
            ensureFolder(self.Folder)
            local ok = pcall(function()
                writefile(self.Folder .. "/" .. self.Name .. ".json", HttpService:JSONEncode(data))
            end)
            if ok then
                WobsinsUI:Notify({
                    Title = "已保存",
                    Content = "配置 " .. self.Name .. " 已保存到本地。",
                    Icon = "save",
                    Duration = 3,
                    Window = window,
                })
            end
            return ok
        end

        function config:Load()
            if not (isfile and readfile and HttpService) then
                return false
            end
            local path = self.Folder .. "/" .. self.Name .. ".json"
            if not isfile(path) then
                return false
            end
            local ok, decoded = pcall(function()
                return HttpService:JSONDecode(readfile(path))
            end)
            if not ok or type(decoded) ~= "table" then
                return false
            end
            for elementName, value in pairs(decoded) do
                local element = self.Elements[elementName]
                if element then
                    pcall(decodeElement, element, value)
                end
            end
            return true
        end

        function config:Delete()
            if isfile and delfile then
                pcall(delfile, self.Folder .. "/" .. self.Name .. ".json")
            end
        end

        self.Configs[name] = config
        return config
    end

    function manager:AllConfigs()
        local out = {}
        for name, config in pairs(self.Configs) do
            local data = {}
            for elementName, element in pairs(config.Elements) do
                local ok, encoded = pcall(encodeElement, element)
                if ok then
                    data[elementName] = encoded
                end
            end
            out[name] = data
        end
        return out
    end

    return manager
end

--// Window extras -------------------------------------------------------------
function Window:Notify(config)
    config = config or {}
    config.Window = self
    return WobsinsUI:Notify(config)
end

function Window:Dialog(config)
    config = config or {}
    config.Window = self
    return WobsinsUI:Popup(config)
end

function Window:Popup(config)
    return self:Dialog(config)
end

function Window:Open()
    self:_show(true)
end

function Window:Close()
    self:_show(false)
    if self.OpenButton then
        self.OpenButton.Frame.Visible = true
    end
end

function Window:EditOpenButton(config)
    if self.OpenButton then
        self.OpenButton:Destroy()
    end
    self.OpenButtonConfig = config or {}
    self.OpenButton = createOpenButton(self, self.OpenButtonConfig)
    self.OpenButton.Frame.Visible = not self.Visible
end

function Window:ToggleTransparency(state)
    if state == nil then
        self.Transparency = not self.Transparency
    else
        self.Transparency = state and true or false
    end
    WobsinsUI.Transparency = self.Transparency
    self:_applyTransparency()
    return self.Transparency
end

function Window:SetTheme(name)
    if Themes[name] then
        self.Theme = name
        self:_refreshTheme()
    end
end

function Window:Destroy()
    if self._followConn then
        self._followConn:Disconnect()
    end
    if self.Main then
        self.Main:Destroy()
    end
    if self.Shadow then
        self.Shadow:Destroy()
    end
    if self.OpenButton then
        self.OpenButton:Destroy()
    end
    for index, win in ipairs(WobsinsUI.Windows) do
        if win == self then
            table.remove(WobsinsUI.Windows, index)
            break
        end
    end
    self.Destroyed = true
end

-- attach config manager in CreateWindow (patched below)
local baseCreateWindow = WobsinsUI.CreateWindow
function WobsinsUI:CreateWindow(config)
    local window = baseCreateWindow(self, config)
    window.ConfigManager = createConfigManager(window)
    return window
end

--// Exports ------------------------------------------------------------------
WobsinsUI.CreateConfigManager = createConfigManager
WobsinsUI.Themes = Themes
WobsinsUI.CreateIcon = createIcon

function WobsinsUI:Destroy()
    for _, window in ipairs(self.Windows) do
        window:Destroy()
    end
    self.Windows = {}
    if self._screenGui then
        self._screenGui:Destroy()
        self._screenGui = nil
    end
    if genv then
        genv.__WobsinsUILoaded = nil
    end
end

return WobsinsUI
