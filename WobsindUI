    -- 按钮行
    if config.Buttons and #config.Buttons > 0 then
        local row = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 26),
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.RowItem,
        }, holder)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, row)

        for index, info in ipairs(config.Buttons) do
            local primary = info.Variant == "Primary"
            -- 宽度至少塞得下自己的文字（字号是可调的，写死 72 会挤出去）
            local btnWidth = math.max(info.Width or 72, U.textWidth(info.Title or "按钮", 10) + 26)
            local btn = new("TextButton", {
                BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
                AutoButtonColor = false,
                Size = UDim2.fromOffset(math.ceil(btnWidth), 26),
                Text = "",
                LayoutOrder = index,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, row)
            U.corner(btn, 4)
            U.stroke(btn, theme.Outline, 1, primary and 1 or 0.4)

            local label = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Font = Enum.Font.GothamMedium,
                Text = info.Title or "按钮",
                TextColor3 = primary and theme.OnAccent or theme.Text,
                TextSize = 10,
                ZIndex = WobsinsUI.Layers.RowItem + 2,
            }, btn)

            btn.MouseEnter:Connect(function()
                U.tween(btn, 0.12, {
                    BackgroundColor3 = primary and U.mix(theme.Accent, theme.Text, 0.12) or theme.SurfaceHover,
                })
            end)
            btn.MouseLeave:Connect(function()
                U.tween(btn, 0.12, {
                    BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
                })
            end)
            btn.Activated:Connect(function()
                if info.Callback then
                    safeCall(info.Callback)
                end
            end)
        end
    end

    return I.finish(card, element, config)
end

--//----------------------------------------------------------------------------
--// 12.6 Code
--//----------------------------------------------------------------------------

function Build.Code(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local code = config.Code or ""
    local lines = 1
    for _ in string.gmatch(code, "\n") do
        lines = lines + 1
    end
    -- 行高要跟着全局字号走，否则字号一放大代码就被卡片裁掉。
    -- 代码开了 TextWrapped，长行会折成两三行，这里按可用宽度估一下行数。
    local textScale = WobsinsUI.TextScale or 1
    local lineHeight = 13 * textScale
    -- 可用宽度按「双列时一列的宽度」估，别按整窗算，否则长行被算成一行
    local contentW = (win.Width or 880) - (win.SidebarWidth or 168) - 1
    local avail
    if win.Layout == "Double" and (win.Width or 880) >= 560 then
        avail = math.max(140, (contentW - 8) / 2 - 42)
    else
        avail = math.max(160, contentW - 42)
    end
    local charW = 10.5 * textScale * 0.6
    local rows = 0
    for line in (code .. "\n"):gmatch("(.-)\n") do
        local w = 0
        for _, cp in utf8.codes(line) do
            w = w + ((cp >= 0x2E80) and charW * 1.8 or charW)
        end
        rows = rows + math.max(1, math.ceil(w / avail))
    end
    rows = math.max(rows, lines)
    local bodyHeight = math.min(rows * lineHeight + 12, config.MaxHeight or (150 * textScale))

    local holder = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.new(1, 0, 0, bodyHeight + 26),
        LayoutOrder = #card.Elements + 1,
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.corner(holder, 5)
    U.stroke(holder, theme.Outline, 1, 0.5)
    win:_bind(holder, "BackgroundColor3", "BackgroundAlt")

    local bar = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 26),
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = Enum.Font.Code,
        Text = config.Title or "code",
        TextColor3 = theme.Muted,
        TextSize = 9.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, bar)
    win:_bind(title, "TextColor3", "Muted")

    local copy = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(1, -28, 0, 0),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, bar)
    U.icon(copy, "copy", 12, theme.Muted, WobsinsUI.Layers.RowItem + 2)
    copy.Activated:Connect(function()
        if setclipboard then
            pcall(setclipboard, code)
            WobsinsUI:Notify({ Title = "已复制", Content = "代码已写入剪贴板。", Icon = "check", Duration = 2, Window = win })
        end
    end)
    U.tooltip(copy, "复制")

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 26),
        Size = UDim2.new(1, -22, 0, bodyHeight),
        Font = Enum.Font.Code,
        Text = code,
        TextColor3 = theme.SubText,
        TextSize = 10.5,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, holder)
    win:_bind(label, "TextColor3", "SubText")

    local element = {
        Type = "Code",
        Frame = holder,
        SetText = function(text)
            label.Text = tostring(text or "")
        end,
    }

    return I.finish(card, element, config)
end

