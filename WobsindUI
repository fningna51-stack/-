function WobsinsUI:GetThemes()
    return Themes
end

function WobsinsUI:GetCurrentTheme()
    return self.CurrentTheme
end

function WobsinsUI:AddTheme(config)
    local name = config.Name
    if not name then
        return
    end
    local base = Themes[config.BasedOn or self.CurrentTheme] or Themes.Dark
    local t = {}
    for key, value in pairs(base) do
        t[key] = value
    end
    for key, value in pairs(config) do
        if key ~= "Name" and key ~= "BasedOn" then
            if type(value) == "string" and value:sub(1, 1) == "#" then
                t[key] = C(value)
            else
                t[key] = value
            end
        end
    end
    t.Name = name
    Themes[name] = t
    if self.CurrentTheme == name then
        self:SetTheme(name)
    end
    return t
end

function WobsinsUI:SetTheme(name)
    if not Themes[name] then
        name = "Dark"
    end
    self.CurrentTheme = name
    for _, window in ipairs(self.Windows) do
        window.Theme = name
        if window._refreshTheme then
            window:_refreshTheme()
        end
    end
end

function WobsinsUI:GetTransparency()
    return self.Transparency
end

function WobsinsUI:SetTransparency(state)
    self.Transparency = state and true or false
    for _, window in ipairs(self.Windows) do
        window.Transparency = self.Transparency
        if window._applyTransparency then
            window:_applyTransparency()
        end
    end
end

