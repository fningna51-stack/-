    --//--------------------------------------------------------------------
    --// 构建行
    --//--------------------------------------------------------------------

    function self_:Rebuild()
        for _, row in ipairs(self.Rows) do
            row.Frame:Destroy()
        end
        self.Rows = {}

        local entries = win:CollectKeybinds()
        local query = string.lower(self.Query or "")
        local order = 0

        for _, entry in ipairs(entries) do
            local haystack = string.lower(entry.Title .. " " .. tostring(entry.Tab.Title or "") .. " " .. tostring(entry.Element.Value or ""))
            if query == "" or string.find(haystack, query, 1, true) then
                order = order + 1

                local row = new("Frame", {
                    BackgroundColor3 = self.Window:Color("Surface"),
                    BackgroundTransparency = 0.6,
                    Size = UDim2.new(1, 0, 0, 34),
                    LayoutOrder = order,
                    ZIndex = WobsinsUI.Layers.Overlay + 3,
                }, list)
                U.corner(row, 4)

                local name = new("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 0),
                    Size = UDim2.new(1, -110, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = entry.Title,
                    TextColor3 = self.Window:Color("Text"),
                    TextSize = 10.5,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = WobsinsUI.Layers.Overlay + 4,
                }, row)
                win:_bind(name, "TextColor3", "Text")

                local where = new("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 16),
                    Size = UDim2.new(1, -110, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = tostring(entry.Tab.Title or ""),
                    TextColor3 = self.Window:Color("Muted"),
                    TextSize = 8.5,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = WobsinsUI.Layers.Overlay + 4,
                }, row)
                win:_bind(where, "TextColor3", "Muted")

                local pill = new("TextButton", {
                    BackgroundColor3 = self.Window:Color("SurfaceAlt"),
                    AutoButtonColor = false,
                    Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.fromOffset(84, 22),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Text = "",
                    ZIndex = WobsinsUI.Layers.Overlay + 4,
                }, row)
                U.corner(pill, 4)
                U.stroke(pill, self.Window:Color("Outline"), 1, 0.4)

                local pillLabel = new("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(entry.Element.Value or "None"),
                    TextColor3 = self.Window:Color("SubText"),
                    TextSize = 9.5,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = WobsinsUI.Layers.Overlay + 5,
                }, pill)
                win:_bind(pillLabel, "TextColor3", "SubText")

                pill.Activated:Connect(function()
                    self_:Capture(entry, pillLabel, pill)
                end)

                table.insert(self.Rows, {
                    Frame = row,
                    Entry = entry,
                    Pill = pill,
                    Label = pillLabel,
                })
            end
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#self.Rows * 36, 1))

        if #self.Rows == 0 then
            local empty = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 60),
                Font = Enum.Font.Gotham,
                Text = "没有可用的快捷键",
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 10.5,
                LayoutOrder = 1,
                ZIndex = WobsinsUI.Layers.Overlay + 3,
            }, list)
            table.insert(self.Rows, { Frame = empty })
        end
    end

    --//--------------------------------------------------------------------
    --// 录制
    --//--------------------------------------------------------------------

    function self_:Capture(entry, label, pill)
        if not S.UserInputService then
            return
        end
        self.Capture = { Entry = entry, Label = label, Pill = pill }
        label.Text = "按下按键…"
        label.TextColor3 = self.Window:Color("Accent")

        local connection
        connection = S.UserInputService.InputBegan:Connect(function(input)
            if not self.Capture then
                if connection then
                    connection:Disconnect()
                end
                return
            end

            local pressed = nil
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    self.Capture = nil
                    if connection then
                        connection:Disconnect()
                    end
                    self:Rebuild()
                    return
                end
                pressed = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                pressed = "Mouse1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                pressed = "Mouse2"
            end

            if not pressed then
                return
            end

            if entry.Element.SetValue then
                entry.Element:SetValue(pressed)
            end
            self.Capture = nil
            if connection then
                connection:Disconnect()
            end
            self:Rebuild()

            if config.OnChanged then
                safeCall(config.OnChanged, entry.Element, pressed)
            end
        end)
    end

    --//--------------------------------------------------------------------
    --// 开关
    --//--------------------------------------------------------------------

    function self_:Open()
        self:Close()
        self.Query = ""
        search.Text = ""
        self:Rebuild()
        overlay.Visible = true
        self.Opened = true
        self.Window:SetHotkeyPanelOpen(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Capture = nil
        self.Opened = false
        if self.Window then
            self.Window:SetHotkeyPanelOpen(false)
        end
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self:Close()
        end
        return self_:Open()
    end

    function self_:Destroy()
        overlay:Destroy()
        self.Window._hotkeyPanel = nil
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        self_.Query = search.Text
        self_:Rebuild()
    end)

    self._hotkeyPanel = self_

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

-- 面板打开时，开关键不应该顺带把窗口关掉
function Window:SetHotkeyPanelOpen(state)
    self._hotkeyPanelOpen = state and true or false
    if S.UserInputService then
        -- 记录状态即可，CreateWindow 里的开关键逻辑会读取它
    end
    return self
end

