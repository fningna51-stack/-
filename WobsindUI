--//============================================================================
--// 16. 子页面（Tab 内部的二级页面）
--//============================================================================
--
-- 用法：
--   local page = tab:SubPage({ Title = "高级", Desc = "更多选项" })
--   page:Card({ Title = "..." }):Toggle({ ... })
--   page:Open()   -- 进入
--   page:Back()   -- 返回上一级
--
-- 子页面完全复用 Tab 的卡片/元素构建逻辑，只是换了一个滚动容器。

L.Page = {}
L.Page.__index = L.Page

local Page = L.Page

--//----------------------------------------------------------------------------
--// 16.1 通用滚动容器
--//----------------------------------------------------------------------------

-- 在 parent 里建一套「左右两个独立滚动区」，返回表。
-- 和主标签页一样：两列各滚各的，不联动。
local function buildScroller(win, parent, index, withBackBar)
    local frame = new("Frame", {
        Name = "Page_" .. index,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 2,
    }, parent)

    local topInset = 0
    local navBar = nil
    if withBackBar then
        navBar = new("Frame", {
            BackgroundColor3 = win:Color("Background"),
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 36),
            ZIndex = WobsinsUI.Layers.Content + 3,
        }, frame)
        win:_bind(navBar, "BackgroundColor3", "Background")
        topInset = 36
    end

    local function makeColumn(name)
        local scroll = new("ScrollingFrame", {
            Name = name,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, topInset),
            Size = UDim2.new(1, 0, 1, -topInset),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = win:Color("Outline"),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BorderSizePixel = 0,
            ZIndex = WobsinsUI.Layers.Content + 2,
        }, frame)

        -- 这两个属性是新版才有的，老执行器没有也不会让整页崩掉
        pcall(function()
            scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scroll.ElasticBehavior = Enum.ElasticBehavior.Never
        end)

        local holder = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = WobsinsUI.Layers.Content + 2,
        }, scroll)
        U.padding(holder, 12, 12, 12, 12)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, CARD_GAP),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, holder)

        holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, holder.AbsoluteSize.Y + 4)
        end)
        return scroll, holder
    end

    local scroll1, col1 = makeColumn("ScrollLeft")
    local scroll2, col2 = makeColumn("ScrollRight")
    scroll2.Visible = false

    return {
        Frame = frame,
        NavBar = navBar,
        Scroll = scroll1,
        Scroll2 = scroll2,
        Col1 = col1,
        Col2 = col2,
    }
end

L.Internal.buildScroller = buildScroller

--//----------------------------------------------------------------------------
--// 16.2 创建子页面
--//----------------------------------------------------------------------------

-- 注意：Tab 上已有 Page 字段（滚动页容器），所以方法名用 SubPage
-- 别名：Tab:NewPage / Tab:Subpage
function Tab:SubPage(config)
    config = config or {}

    local win = self.Window
    local index = (self._pageCount or 0) + 1
    self._pageCount = index

    local parts = buildScroller(win, self.Page, index, true)

    local page = setmetatable({
        Window = win,
        Tab = self,
        Title = config.Title or ("页面 " .. index),
        Desc = config.Desc or "",
        Icon = config.Icon,
        Cards = {},
        Elements = {},
        _cardCount = 0,
        _colFlip = false,
        Index = index,
        Opened = false,
    }, Page)

    page.Frame = parts.Frame
    page.NavBar = parts.NavBar
    page.Scroll = parts.Scroll
    page.Scroll2 = parts.Scroll2
    page.Holder = parts.Col1
    page.Col1 = parts.Col1
    page.Col2 = parts.Col2

    -- 返回栏
    if parts.NavBar then
        local back = new("TextButton", {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Size = UDim2.fromOffset(28, 34),
            Text = "",
            ZIndex = WobsinsUI.Layers.Content + 4,
        }, parts.NavBar)
        local backIcon = U.icon(back, "chevronLeft", 13, win:Color("SubText"), WobsinsUI.Layers.Content + 5)
        if backIcon then
            backIcon.AnchorPoint = Vector2.new(0.5, 0.5)
            backIcon.Position = UDim2.fromScale(0.5, 0.5)
        end
        U.hover(back, function()
            if backIcon then
                U.tint(backIcon, win:Color("Text"))
            end
        end, function()
            if backIcon then
                U.tint(backIcon, win:Color("SubText"))
            end
        end)
        back.Activated:Connect(function()
            page:Back()
        end)

        local crumb = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(30, 0),
            Size = UDim2.new(1, -120, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = self.Title .. "  ›  " .. page.Title,
            TextColor3 = win:Color("SubText"),
            TextSize = 10.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = WobsinsUI.Layers.Content + 4,
        }, parts.NavBar)
        win:_bind(crumb, "TextColor3", "SubText")
        page.Crumb = crumb
    end

    -- 页面内的空状态
    local empty = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 0, 40),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Font = Enum.Font.Gotham,
        Text = "这个页面还没有内容",
        TextColor3 = win:Color("Muted"),
        TextSize = 11.5,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Content + 3,
    }, parts.Frame)
    page.Empty = empty
    win:_bind(empty, "TextColor3", "Muted")

    function page:Refresh()
        self.Scroll.CanvasSize = UDim2.new(0, 0, 0, self.Col1.AbsoluteSize.Y + 4)
        if self.Scroll2 and self.Scroll2.Visible then
            self.Scroll2.CanvasSize = UDim2.new(0, 0, 0, self.Col2.AbsoluteSize.Y + 4)
        end
    end

    page:_applyColumns()

    page.Col1:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        page:Refresh()
    end)
    page.Col2:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        page:Refresh()
    end)

    self.Pages = self.Pages or {}
    table.insert(self.Pages, page)

    if #self.Pages == 1 then
        -- 第一个子页面不自动打开，保持标签页主页可见
        page.Frame.Visible = false
    end

    return page
end

function Page:_applyColumns()
    local double = self.Window.Layout == "Double" and self.Window.Width >= 560
    if double then
        self.Scroll.Size = UDim2.new(0.5, -4, 1, -(self.NavBar and 36 or 0))
        self.Scroll.Position = UDim2.fromOffset(0, self.NavBar and 36 or 0)
        self.Scroll2.Size = UDim2.new(0.5, -4, 1, -(self.NavBar and 36 or 0))
        self.Scroll2.Position = UDim2.new(0.5, 4, 0, self.NavBar and 36 or 0)
        self.Scroll2.Visible = true
    else
        self.Scroll.Size = UDim2.new(1, 0, 1, -(self.NavBar and 36 or 0))
        self.Scroll.Position = UDim2.fromOffset(0, self.NavBar and 36 or 0)
        self.Scroll2.Visible = false
    end
end

function Page:_targetColumn(column)
    if self.Window.Layout ~= "Double" then
        return self.Col1
    end
    if column == 2 then
        return self.Col2
    end
    if column == 1 then
        return self.Col1
    end
    self._colFlip = not self._colFlip
    return self._colFlip and self.Col1 or self.Col2
end

-- 页面上的元素直接落到隐式卡片里
function Page:_implicitCard()
    local last = self.Cards[#self.Cards]
    if last and last.Title == "" and last.Implicit then
        return last
    end
    local card = self:Card({ Title = "" })
    card.Implicit = true
    return card
end

-- 子页面也能被搜索命中
function Page:_filter(query)
    local lower = string.lower(query or "")
    local matched = 0
    for _, card in ipairs(self.Cards) do
        local cardMatch = false
        if query ~= "" and card.Title and card.Title ~= "" then
            cardMatch = string.find(string.lower(card.Title), lower, 1, true) ~= nil
        end
        local visibleInside = 0
        for _, element in ipairs(card.Elements) do
            local hit = (query == "") or cardMatch
            if not hit then
                hit = string.find(string.lower(tostring(element._search or "")), lower, 1, true) ~= nil
            end
            if element.SetVisible then
                element:SetVisible(hit)
            end
            if hit then
                visibleInside = visibleInside + 1
            end
        end
        if #card.Elements == 0 then
            card.Frame.Visible = (query == "")
        else
            card.Frame.Visible = (query == "") or visibleInside > 0
        end
        matched = matched + visibleInside
    end
    self.Empty.Visible = (query ~= "") and matched == 0
    self:Refresh()
    return matched
end

--//----------------------------------------------------------------------------
--// 16.3 导航
--//----------------------------------------------------------------------------

function Page:Open()
    local tab = self.Tab

    -- 主页内容让位（左右两列一起让）
    if tab.Scroll then
        tab.Scroll.Visible = false
    end
    if tab.Scroll2 then
        tab.Scroll2.Visible = false
    end
    if tab.Empty then
        tab.Empty.Visible = false
    end

    for _, item in ipairs(tab.Pages or {}) do
        item.Frame.Visible = (item == self)
    end

    self.Opened = true
    tab.ActivePage = self
    self:Refresh()

    if tab.Window then
        tab.Window:_emit("PageChanged", self)
    end

    return self
end

function Page:Close()
    self.Frame.Visible = false
    self.Opened = false

    local tab = self.Tab
    if tab.Scroll then
        tab.Scroll.Visible = true
    end
    if tab.Scroll2 then
        tab.Scroll2.Visible = (tab.Window.Layout == "Double" and tab.Window.Width >= 560)
    end
    tab.ActivePage = nil

    if tab.Window then
        tab.Window:_emit("PageChanged", nil)
    end

    return self
end

function Page:Back()
    return self:Close()
end

function Page:SetTitle(text)
    self.Title = tostring(text or "")
    if self.Crumb then
        self.Crumb.Text = self.Tab.Title .. "  ›  " .. self.Title
    end
    return self
end

-- 标签页回到主页
function Tab:Home()
    for _, page in ipairs(self.Pages or {}) do
        page.Frame.Visible = false
        page.Opened = false
    end
    if self.Scroll then
        self.Scroll.Visible = true
    end
    if self.Scroll2 then
        self.Scroll2.Visible = (self.Window.Layout == "Double" and self.Window.Width >= 560)
    end
    self.ActivePage = nil
    return self
end

