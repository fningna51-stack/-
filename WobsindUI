function Window:_headerButton(parent, icon, position, size, callback, colorKey)
    local btn = new("TextButton", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(size, size),
        Position = position,
        Text = "",
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, parent)
    U.corner(btn, 4)

    local ic = U.icon(btn, icon, 12, self:Color(colorKey or "SubText"), WobsinsUI.Layers.HeaderItem + 1)
    if ic then
        ic.AnchorPoint = Vector2.new(0.5, 0.5)
        ic.Position = UDim2.fromScale(0.5, 0.5)
    end

    local function paintHover(state)
        U.tween(btn, 0.12, { BackgroundTransparency = state and 0 or 1 })
        U.tween(btn, 0.12, { BackgroundColor3 = state and self:Color("SurfaceHover") or self:Color("SurfaceAlt") })
        if ic then
            U.tint(ic, state and self:Color("Text") or self:Color(colorKey or "SubText"))
        end
    end

    btn.MouseEnter:Connect(function()
        paintHover(true)
    end)
    btn.MouseLeave:Connect(function()
        paintHover(false)
    end)
    btn.Activated:Connect(function()
        if callback then
            safeCall(callback)
        end
    end)

    return btn
end

