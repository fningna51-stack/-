--//----------------------------------------------------------------------------
--// 20.1 主题编辑器
--//----------------------------------------------------------------------------
--
-- 一个可以直接改配色的窗口，改完立刻作用到所有窗口。
--   local editor = WobsinsUI:CreateThemeEditor()
--   -- 不想要了：
--   editor:Destroy()

local EDITABLE_KEYS = {
    { Key = "Background", Label = "窗口底色" },
    { Key = "Surface", Label = "卡片底色" },
    { Key = "SurfaceAlt", Label = "控件底色" },
    { Key = "Outline", Label = "描边" },
    { Key = "Text", Label = "主文字" },
    { Key = "SubText", Label = "次文字" },
    { Key = "Accent", Label = "强调色" },
    { Key = "Danger", Label = "错误色" },
}

function WobsinsUI:CreateThemeEditor(config)
    config = config or {}

    local editor = self:CreateWindow({
        Title = config.Title or "主题编辑器",
        Author = "WobsinsUI",
        Icon = "palette",
        Theme = self.CurrentTheme,
        Folder = (config.Folder or "WobsinsUI") .. "_theme",
        Size = config.Size or UDim2.fromOffset(620, 460),
        Layout = "Single",
    })

    local presetTab = editor:Tab({ Title = "预设", Icon = "grid" })
    local colorTab = editor:Tab({ Title = "颜色", Icon = "palette" })
    local exportTab = editor:Tab({ Title = "导出", Icon = "code" })

    -- 预设列表
    local presetNames = {}
    for name in pairs(self:GetThemes()) do
        table.insert(presetNames, name)
    end
    table.sort(presetNames)

    local presetCard = presetTab:Card({ Title = "内置主题", Icon = "grid" })
    for _, name in ipairs(presetNames) do
        presetCard:Button({
            Title = name,
            Icon = "palette",
            Callback = function()
                self:SetTheme(name)
                self:Notify({
                    Title = "已切换",
                    Content = "当前主题：" .. name,
                    Icon = "check",
                    Duration = 2,
                    Window = editor,
                })
            end,
        })
    end

    -- 颜色编辑
    local working = { Name = "Custom", BasedOn = self:GetCurrentTheme() }
    local colorCard = colorTab:Card({ Title = "调色", Icon = "sliders" })

    for _, info in ipairs(EDITABLE_KEYS) do
        colorCard:Colorpicker({
            Title = info.Label,
            Default = self:GetTheme()[info.Key],
            Callback = function(color)
                working[info.Key] = color
                self:AddTheme(working)
                self:SetTheme("Custom")
            end,
        })
    end

    colorTab:Card({ Title = "操作", Icon = "settings" }):Button({
        Title = "恢复当前主题",
        Variant = "Ghost",
        Icon = "refresh",
        Callback = function()
            self:RemoveTheme("Custom")
            self:SetTheme(working.BasedOn or "Graphite")
        end,
    })

    -- 导出
    local codeLines = {}
    for _, key in ipairs({ "Background", "Surface", "SurfaceAlt", "Outline", "Text", "SubText", "Accent", "Danger" }) do
        table.insert(codeLines, string.format('    %s = "%s",', key, self:GetTheme()[key]:ToHex()))
    end
    table.insert(codeLines, 1, 'WobsinsUI:AddTheme({')
    table.insert(codeLines, '    Name = "MyTheme",')
    table.insert(codeLines, '    BasedOn = "Graphite",')
    table.insert(codeLines, "})")

    exportTab:Card({ Title = "当前配色", Icon = "code" }):Code({
        Title = "theme.lua",
        Code = table.concat(codeLines, "\n"),
    })

    return editor
end

--//----------------------------------------------------------------------------
--// 20.2 视口监听（旋转屏幕 / 改变分辨率）
--//----------------------------------------------------------------------------

function Window:WatchViewport()
    if self._viewportToken then
        return self
    end
    local token = {}
    self._viewportToken = token

    U.spawn(function()
        local last = WobsinsUI:_viewport()
        while self._viewportToken == token and not self.Destroyed do
            U.wait(1)
            local vp = WobsinsUI:_viewport()
            if vp.X ~= last.X or vp.Y ~= last.Y then
                last = vp
                self:_autoFit()   -- 按新屏幕重算缩放和设计高度
            end
        end
    end)

    return self
end

