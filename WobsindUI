        svKnob.Position = UDim2.new(sat, 0, 1 - val, 0)
        hueKnob.Position = UDim2.new(hue, 0, 0.5, 0)
        local color = currentColor()
        swatch.BackgroundColor3 = color
        hexLabel.Text = string.format("#%02X%02X%02X",
            math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
        element.Value = color
    end

    local function commit(silent)
        if not silent and cfg.Callback then
            task.spawn(cfg.Callback, currentColor(), 0)
        end
    end

    local dragMode = nil
    local function updateFromInput(mode, position)
        if mode == "sv" then
            local abs = sv.AbsolutePosition
            local size = sv.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then
                return
            end
            sat = clamp((position.X - abs.X) / size.X, 0, 1)
            val = 1 - clamp((position.Y - abs.Y) / size.Y, 0, 1)
        else
            local abs = hueBar.AbsolutePosition
            local size = hueBar.AbsoluteSize
            if size.X <= 0 then
                return
            end
            local h = clamp((position.X - abs.X) / size.X, 0, 1)
            hue = math.min(h, 0.9999)
        end
        paint()
        commit(false)
    end

    sv.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragMode = "sv"
            updateFromInput("sv", input.Position)
        end
    end)

    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragMode = "hue"
            updateFromInput("hue", input.Position)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragMode then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(dragMode, input.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragMode = nil
        end
    end)

    local function setOpen(state)
        open = state
        panel.Visible = state
    end

    swatch.Activated:Connect(function()
        setOpen(not open)
    end)
    row.Activated:Connect(function()
        setOpen(not open)
    end)

    element.SetValue = function(a, b)
        local color = argValue(a, b)
        if typeof(color) == "string" then
            local ok, parsed = pcall(function()
                return Color3.fromHex(color)
            end)
            if ok then
                color = parsed
            end
        end
        if typeof(color) ~= "Color3" then
            return
        end
        hue, sat, val = color:ToHSV()
        paint()
    end

    element.GetValue = function()
        return currentColor()
    end

    element.SetOpen = setOpen

    paint()
    win:_onTheme(function()
        hexLabel.TextColor3 = win:Color("SubText")
        swatchStroke.Transparency = (win.ThemeTable.Mode == "Light") and 0.85 or 0.7
    end)

    return finish(card, element, cfg, row, "颜色 colorpicker color hex")
end

