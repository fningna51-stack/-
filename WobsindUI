--//----------------------------------------------------------------------------
--// 9.2 创建窗口
--//----------------------------------------------------------------------------

function WobsinsUI:CreateWindow(config)
    config = config or {}
    -- 字号系数要在建任何组件之前定下来（TextSize 是构造时写死的）
    if tonumber(config.TextScale) and tonumber(config.TextScale) > 0 then
        self.TextScale = U.clamp(tonumber(config.TextScale), 0.8, 1.8)
    end
    local ok, result = xpcall(function()
        return self:_createWindow(config)
    end, function(err)
        return tostring(err) .. "\n" .. tostring(debug.traceback())
    end)

    if not ok then
        logWarn("[WobsinsUI] CreateWindow 失败:\n" .. tostring(result))
        return self:_errorWindow(result)
    end
    return result
end

--//----------------------------------------------------------------------------
--// 尺寸策略：宽度优先
--//----------------------------------------------------------------------------
--
-- 参考的排版是「一块宽面板 + 左右两列卡片」，高度反而是紧的那一头。
-- 所以放大倍数先按宽度算：
--   · 宽度够（桌面 / 平板 / 手机横屏）→ 1:1，高度装不下就把设计高度压短，
--     窗口变成宽扁的一块，两列都舒展；
--   · 宽度不够（竖屏）→ 等比缩，最低 0.58，再不够就压窄设计宽度。
-- 这样手机上不会再缩成屏幕中间一小坨，两列也不会被挤成两根手指宽。
local function fitWindowSize(width, height, vp)
    -- 左右各留 16，上下各留 44：顶上要给 FPS 水印让位，底下别贴着屏幕边
    local maxW = math.max(320, vp.X - 32)
    local maxH = math.max(280, vp.Y - 88)

    -- 竖屏手机：880 的设计宽度怎么缩都塞不进去，硬缩只会把字缩成蚂蚁。
    -- 换成 420 的窄版设计（单列），按宽度铺满，字反而更大。
    if vp.X < 640 and width > 440 then
        width = 420
        height = math.min(height, 600)
    end

    local byWidth = maxW / width
    local scale = byWidth >= 1 and 1 or U.clamp(byWidth, 0.58, 1)

    if height * scale > maxH then
        height = math.max(math.floor(maxH / scale), 380)
    end
    if width * scale > maxW then
        width = math.max(math.floor(maxW / scale), 320)
    end
    return width, height, scale
end

function WobsinsUI:_createWindow(config)
    local screen = self:_screen()
    local vp = self:_viewport()

    local themeName = config.Theme or self.CurrentTheme
    if not Themes[themeName] then
        themeName = "Graphite"
    end
    local theme = Themes[themeName]

    -- 尺寸：设计尺寸固定，实际大小交给 UIScale 整体缩。
    -- 以前是「窗口直接撑到 vp-20」，在手机上一开就顶满整屏，字也大得离谱；
    -- 现在留出边距，屏幕越小缩得越多，看着像一块面板而不是整页网页。
    local width = 880
    local height = 560
    if typeof(config.Size) == "UDim2" then
        if config.Size.X.Offset > 0 then
            width = config.Size.X.Offset
        end
        if config.Size.Y.Offset > 0 then
            height = config.Size.Y.Offset
        end
    end
    width = math.max(math.floor(width), 360)
    height = math.max(math.floor(height), 300)

    local scale = tonumber(config.Scale)
    if not scale or scale <= 0 then
        width, height, scale = fitWindowSize(width, height, vp)
    end
    scale = U.clamp(scale, 0.5, 1.3)

    -- 显式指定了 Scale 的话，同样保证不跑到屏幕外
    local fitWidth = math.floor((vp.X - 16) / scale)
    local fitHeight = math.floor((vp.Y - 16) / scale)
    if width > fitWidth then
        width = math.max(320, fitWidth)
    end
    if height > fitHeight then
        height = math.max(280, fitHeight)
    end

    local sidebarWidth = config.SideBarWidth or 168
    if width < 460 then
        sidebarWidth = 112
    elseif width < 620 then
        sidebarWidth = 132
    end
    sidebarWidth = math.floor(math.min(sidebarWidth, width * 0.36))

    local win = setmetatable({
        Config = config,
        Title = config.Title or "WobsinsUI",
        Author = config.Author or "",
        Icon = config.Icon or "bolt",
        Folder = config.Folder or "WobsinsUI",
        Theme = themeName,
        -- 每个窗口一份副本，切主题时原地改，闭包里的引用才不会失效
        ThemeTable = (L.cloneTheme and L.cloneTheme(theme)) or theme,
        Bindings = {},
        RawBindings = {},
        ThemeHooks = {},
        Tabs = {},
        Sections = {},
        Elements = {},
        CloseCallbacks = {},
        Destroyed = false,
        Visible = true,
        Minimized = false,
        Locked = false,
        Width = width,
        Height = height,
        -- 原始设计尺寸：屏幕变了要按它重新装一遍，不能拿压过的尺寸再压
        BaseWidth = width,
        BaseHeight = height,
        SidebarWidth = sidebarWidth,
        HeaderHeight = HEADER_HEIGHT,
        FooterHeight = FOOTER_HEIGHT,
        Transparency = config.Transparent == true or self.Transparency,
        Glass = theme.Glass == true,
        -- 液态玻璃 + 粒子：默认全开，配置 / 全局开关都能单独关
        LiquidGlass = config.LiquidGlass ~= false
            and (WobsinsUI.LiquidGlass == nil or WobsinsUI.LiquidGlass ~= false),
        Particles = config.Particles ~= false
            and (WobsinsUI.Particles == nil or WobsinsUI.Particles ~= false),
        ParticleCount = tonumber(config.ParticleCount) or tonumber(WobsinsUI.ParticleCount),
        Radius = theme.Radius or 6,
        ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift,
        OpenButton = nil,
        ActiveTab = nil,
        ScaleValue = scale,
        AutoScale = not (tonumber(config.Scale) and tonumber(config.Scale) > 0),
        PageCount = 0,
    }, Window)

    win:_buildShell(config)
    win:_buildHeader(config)
    win:_buildSidebar(config)
    win:_buildContent(config)
    win:_buildFooter(config)
    win:_buildOpenButton(config)

    table.insert(self.Windows, win)

    -- 空窗口也必须有可见内容：给用户 1 秒时间挂标签页，仍然为空才补提示卡片
    U.delay(1, function()
        if win.Destroyed or not win.Content then
            return
        end
        if #win.Tabs == 0 and not win._placeholder then
            win._placeholder = true
            win:_buildPlaceholder()
        elseif not win.ActiveTab and #win.Tabs > 0 then
            win:SelectTab(1)
        end
    end)

    -- 开关键
    if S.UserInputService then
        S.UserInputService.InputBegan:Connect(function(input, processed)
            if processed or win.Destroyed then
                return
            end
            if input.KeyCode == win.ToggleKey then
                -- 快捷键面板打开时，开关键先收面板，不要直接把窗口关了
                if win._hotkeyPanelOpen and win._hotkeyPanel then
                    win._hotkeyPanel:Close()
                    return
                end
                -- 收起来的状态下按开关键：先展开，而不是直接藏起来
                if win.Minimized then
                    win:SetMinimized(false)
                    return
                end
                if win.Visible then
                    win:Close()
                else
                    win:Open()
                end
            end
        end)
    end

    return win
end

--//----------------------------------------------------------------------------
--// 9.3 外壳（Stage / 阴影 / 主体）
--//----------------------------------------------------------------------------

-- Stage 用左上角锚点 + 显式像素坐标：整体缩放（UIScale）之后「渲染出来的尺寸」
-- 和「Position 指的左上角」是同一个坐标系，拖拽、居中、常驻开关定位全都好算。
function Window:_stageSize()
    local s = self.ScaleValue or 1
    return Vector2.new(self.Width * s, self.Height * s)
end

-- 自动缩放：屏幕越小缩得越多，桌面上就是 1
function Window:_autoScaleValue()
    local vp = WobsinsUI:_viewport()
    return U.clamp(math.min(1, (vp.Y * 0.88) / self.Height, (vp.X * 0.82) / self.Width), 0.58, 1.3)
end

function Window:_placeStageAt(left, top)
    if not self.Stage then
        return left, top
    end
    local vp = WobsinsUI:_viewport()
    local size = self:_stageSize()
    left = U.clamp(left, 0, math.max(0, vp.X - size.X))
    top = U.clamp(top, 0, math.max(0, vp.Y - size.Y))
    self._stageLeft, self._stageTop = left, top
    self.Stage.Position = UDim2.fromOffset(math.floor(left), math.floor(top))
    -- 常驻开关贴在窗口右上角，窗口一动它跟着动
    if self._switchPinned ~= false and self._placeSwitch then
        self:_placeSwitch()
    end
    return left, top
end

function Window:_centerStage()
    local vp = WobsinsUI:_viewport()
    local size = self:_stageSize()
    local left = (vp.X - size.X) / 2
    local top = (vp.Y - size.Y) / 2
    -- 左上角挂着 FPS 水印（高度 34 + 16 边距），别让窗口标题栏被它压住
    local gui = WobsinsUI.ScreenGui
    local hasWatermark = gui and gui.FindFirstChild and gui:FindFirstChild("WobsinsWatermark")
    if hasWatermark then
        top = math.max(top, math.min(46, math.max(0, vp.Y - size.Y)))
    end
    return self:_placeStageAt(left, top)
end

function Window:_buildShell(config)
    local screen = self.Root or WobsinsUI:_screen()
    self.Root = screen

    local stage = new("Frame", {
        Name = "WobsinsStage",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(self.Width, self.Height),
        Position = UDim2.fromOffset(0, 0),
        AnchorPoint = Vector2.new(0, 0),
        ZIndex = WobsinsUI.Layers.Main,
    }, screen)
    self.Stage = stage
    -- 整体缩放：字体、圆角、间距一起缩，才是「界面变小」而不是「窗口被挤扁」
    self.Scale = new("UIScale", { Scale = self.ScaleValue or 1 }, stage)
    self:_centerStage()

    -- 阴影单独一层，比主体低 5 级，永远不会盖住内容
    local shadow = new("Frame", {
        Name = "Shadow",
        BackgroundColor3 = self:Color("Shadow"),
        BackgroundTransparency = 0.55,
        Size = UDim2.new(1, 4, 1, 10),
        Position = UDim2.fromOffset(-2, 6),
        ZIndex = WobsinsUI.Layers.Shadow,
    }, stage)
    U.corner(shadow, (self.Radius or 6) + 2)
    self.Shadow = shadow
    self:_bind(shadow, "BackgroundColor3", "Shadow")

    local main = new("Frame", {
        Name = "Main",
        BackgroundColor3 = self:Color("Background"),
        BackgroundTransparency = self.ThemeTable.Alpha or 0,
        Size = UDim2.fromScale(1, 1),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Main,
    }, stage)
    self.Main = main
    self:_bind(main, "BackgroundColor3", "Background")
    self:_onTheme(function()
        main.BackgroundTransparency = self:_baseAlpha()
    end)
    self.Corner = U.corner(main, self.Radius or 6)

    -- 描边永远是 1px 冷灰。玻璃主题稍微透一点，不用强调色描边 ——
    -- 那圈彩边正是「AI 生成 UI」最典型的痕迹。
    local outline = U.stroke(main, self:Color("Outline"), 1, self.Glass and 0.35 or 0.45)
    self.MainStroke = outline
    self:_onTheme(function()
        outline.Color = self:Color("Outline")
        outline.Transparency = self.Glass and 0.35 or 0.45
    end)

    -- 背景图（可选）：图本身只是最底一层，上面压一层同色蒙版保证文字可读
    if config.Background ~= nil and config.Background ~= "" then
        self:SetBackgroundImage(config.Background, config.BackgroundTransparency, config.BackgroundDim)
    end

    -- 液态玻璃 + 动态粒子（24 / 25 模块实现，挂在主体之上、内容之下）
    if self._buildLiquidGlass then
        self:_buildLiquidGlass(config)
    end
end

-- 主体底色透明度：没图时按主题走，有图时让开给图片
function Window:_baseAlpha()
    local alpha = (self.ThemeTable and self.ThemeTable.Alpha) or 0
    if self.BgImage then
        alpha = math.max(alpha, 0.55)
    end
    return alpha
end

-- 卡片底色透明度。有背景图时卡片也要让开，不然整块面板就是一片黑，
-- 图只在窗口边框外面露出一点点 —— 「背景图设置」形同虚设。
function Window:_cardAlpha()
    local base = (self.ThemeTable and self.ThemeTable.CardAlpha) or 0
    if self.BgImage then
        local light = self.ThemeTable and self.ThemeTable.Mode == "Light"
        return math.max(base, light and 0.5 or 0.55)
    end
    return base
end

-- 侧栏同理：平时完全透明，有图时压一层薄底，把图挡掉一半保证侧栏文字能读
function Window:_sidebarAlpha()
    if self.BgImage then
        return self.BackgroundSidebarDim or 0.45
    end
    return 1
end

-- 背景图相关的所有透明度都在这里统一刷一遍。
-- 换图 / 调蒙版 / 切主题 / 关闭背景图 都走这一条路，不会出现「改了图但卡片还是实心」。
function Window:_applyGlass()
    if not self.Main then
        return
    end
    if self.Sidebar then
        U.tween(self.Sidebar, 0.2, { BackgroundTransparency = self:_sidebarAlpha() })
    end
    if self.Veil then
        local dim = self.BackgroundDim
        if dim == nil then
            local light = self.ThemeTable and self.ThemeTable.Mode == "Light"
            dim = light and 0.34 or 0.45
        end
        U.tween(self.Veil, 0.2, { BackgroundTransparency = U.clamp(1 - dim, 0.02, 0.98) })
    end
    for _, card in ipairs(self._cards or {}) do
        if card.Frame then
            card.Frame.BackgroundTransparency = self:_cardAlpha()
        end
    end
end

function Window:_makeDraggable(handle)
    local dragging = false
    local startLeft, startTop = 0, 0
    local startPointer = nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        -- 点在输入框上时不拖动
        if S.UserInputService and S.UserInputService:GetFocusedTextBox() then
            return
        end
        dragging = true
        self._dragDistance = 0
        startLeft = self._stageLeft or 0
        startTop = self._stageTop or 0
        startPointer = input.Position
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging or not self.Stage then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - startPointer
            self._dragDistance = math.max(self._dragDistance or 0, math.abs(delta.X) + math.abs(delta.Y))
            -- 左上角坐标直接加位移，边界由 _placeStageAt 夹住，窗口永远拖不出屏幕
            self:_placeStageAt(startLeft + delta.X, startTop + delta.Y)
        end)
    end
end

