local function isImageIcon(icon)
    if type(icon) ~= "string" then
        return false
    end
    return icon:match("^rbxassetid://") ~= nil
        or icon:match("^rbxasset://") ~= nil
        or icon:match("^https?://") ~= nil
        or icon:match("^rbxthumb://") ~= nil
end

-- Creates an icon inside `parent`, sized `size` px and anchored left/centre by caller.
local function createIcon(parent, icon, size, color, transparency)
    if icon == nil or icon == "" then
        return nil
    end

    if isImageIcon(icon) then
        local img = new("ImageLabel", {
            BackgroundTransparency = 1,
            Image = icon,
            Size = UDim2.fromOffset(size, size),
            ImageColor3 = color or Color3.new(1, 1, 1),
            ImageTransparency = transparency or 0,
            ScaleType = Enum.ScaleType.Fit,
        }, parent)
        return img
    end

    local glyph = WobsinsUI.Icons[icon] or icon
    local txt = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        Font = Enum.Font.GothamBold,
        Text = glyph,
        TextColor3 = color or Color3.new(1, 1, 1),
        TextTransparency = transparency or 0,
        TextScaled = false,
        TextSize = math.floor(size * 0.92),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
    return txt
end

