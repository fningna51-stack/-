--//----------------------------------------------------------------------------
--// 22.1 注册 / 切换
--//----------------------------------------------------------------------------

function WobsinsUI:AddLocale(code, dictionary, overwrite)
    code = tostring(code or "")
    if code == "" then
        return self
    end
    local existing = self.Locales[code]
    if existing and not overwrite then
        for key, value in pairs(dictionary or {}) do
            if existing[key] == nil then
                existing[key] = value
            end
        end
    else
        self.Locales[code] = dictionary or {}
    end
    return self
end

function WobsinsUI:GetLocale()
    return self.Locale
end

function WobsinsUI:SetLocale(code)
    if not self.Locales[code] then
        logWarn("[WobsinsUI] 未知语言: " .. tostring(code))
        return self
    end
    self.Locale = code

    for _, item in ipairs(self._translated) do
        if item.Object and item.Object.Parent then
            local ok, text = pcall(self.t, self, item.Key, unpack(item.Args or {}))
            if ok and text then
                item.Object[item.Property] = text
            end
        end
    end

    return self
end

--//----------------------------------------------------------------------------
--// 22.2 取词
--//----------------------------------------------------------------------------

function WobsinsUI:t(key, ...)
    local dictionary = self.Locales[self.Locale] or self.Locales.zh or {}
    local text = dictionary[key]

    if text == nil then
        local fallback = self.Locales.zh and self.Locales.zh[key]
        text = fallback or tostring(key)
    end

    if select("#", ...) > 0 then
        local ok, formatted = pcall(string.format, text, ...)
        if ok then
            return formatted
        end
    end

    return text
end

-- 登记一个会被语言切换刷新的属性
function WobsinsUI:BindText(object, key, property, ...)
    if not object then
        return object
    end
    property = property or "Text"
    local args = { ... }
    table.insert(self._translated, {
        Object = object,
        Key = key,
        Property = property,
        Args = args,
    })
    local ok, text = pcall(self.t, self, key, unpack(args))
    if ok and text then
        object[property] = text
    end
    return object
end

-- 清掉已经销毁的引用，长时间运行时防止表变大
function WobsinsUI:CleanTranslations()
    local kept = {}
    for _, item in ipairs(self._translated) do
        if item.Object and item.Object.Parent then
            table.insert(kept, item)
        end
    end
    self._translated = kept
    return self
end

--//============================================================================
--// 23. 最小化条 / 关闭脚本
--//============================================================================
--
-- 这一节只做两件事，但都是实际用起来最容易出问题的两件：
--
--   1. 最小化。不是把窗口压扁成一条 880px 宽的黑条，而是真的缩成一粒
--      「logo + 脚本名 + 关闭」的小胶囊，高度 30px，宽度按名字长度算。
--      点条身恢复，按住条身可以拖着走。
--
--   2. 关闭脚本。右上角 × 不再只是 hide（那样用户以为关掉了，其实脚本
--      还在后台跑），而是弹一个确认框，确认后销毁整个界面、清掉单例、
--      触发 OnShutdown 回调，脚本主循环据此退出。
--
--//----------------------------------------------------------------------------
--// 23.1 常量与小工具
--//----------------------------------------------------------------------------

local MIN_BAR_HEIGHT = 30
local MIN_BAR_EDGE = 8
local MIN_BAR_MIN_WIDTH = 132

-- Roblox 没有「量一段文字多宽」的公开 API（TextService:GetTextSize 在不同
-- 执行器上行为不一致），这里按字符给一个够用的估算：CJK 算一个字号宽，
-- 拉丁字符算半个多一点。只用来定小胶囊的宽度，不需要像素级准确。
local function estimateTextWidth(text, size)
    text = tostring(text or "")
    local width = 0
    local ok = pcall(function()
        for _, code in utf8.codes(text) do
            if code >= 0x2E80 then
                width = width + size
            else
                width = width + size * 0.56
            end
        end
    end)
    if not ok then
        width = #text * size * 0.72
    end
    return width
end

local function stagePlace(stage, width, height, left, top)
    local vp = WobsinsUI:_viewport()
    left = U.clamp(left, MIN_BAR_EDGE, math.max(MIN_BAR_EDGE, vp.X - width - MIN_BAR_EDGE))
    top = U.clamp(top, MIN_BAR_EDGE, math.max(MIN_BAR_EDGE, vp.Y - height - MIN_BAR_EDGE))
    -- Stage 的 AnchorPoint 是 (0.5, 0.5)，所以位置要加上一半尺寸才是左上角
    return UDim2.fromOffset(left + width / 2, top + height / 2), left, top
end

--//----------------------------------------------------------------------------
--// 23.2 小胶囊本体
--//----------------------------------------------------------------------------

function Window:_minBarWidth()
    local title = (self.Title ~= "" and self.Title) or "WobsinsUI"
    local width = math.floor(34 + estimateTextWidth(title, 11.5) + 30)
    return U.clamp(width, MIN_BAR_MIN_WIDTH, math.max(MIN_BAR_MIN_WIDTH, math.min(self.Width, 280)))
end

