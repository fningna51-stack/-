function L.Build.Ring(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local size = config.Size or 62
    local segments = 44
    local gap = 10

    -- 自绘行：左边标题，右边固定尺寸的环
    local row = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, size + 8),
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)

    local labelCol = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 6, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(1, -size - gap - 22, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, labelCol)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 15),
        Font = Enum.Font.Gotham,
        Text = config.Title or "进度",
        TextColor3 = win:Color("Text"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, labelCol)
    win:_bind(title, "TextColor3", "Text")

    if config.Desc and config.Desc ~= "" then
        local desc = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 12),
            Font = Enum.Font.Gotham,
            Text = config.Desc,
            TextColor3 = win:Color("SubText"),
            TextSize = 9.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, labelCol)
        win:_bind(desc, "TextColor3", "SubText")
    end

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        Position = UDim2.new(1, -8, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, row)

    local radius = size / 2 - 2.5
    local marks = {}
    for index = 1, segments do
        local angle = (index - 1) / segments * math.pi * 2 - math.pi / 2
        local mark = new("Frame", {
            BackgroundColor3 = theme.Outline,
            Size = UDim2.fromOffset(2, math.max(4, size * 0.09)),
            Position = UDim2.new(
                0.5, math.cos(angle) * radius,
                0.5, math.sin(angle) * radius
            ),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Rotation = math.deg(angle) + 90,
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, holder)
        U.corner(mark, 1)
        marks[index] = mark
    end

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = "0%",
        TextColor3 = win:Color("Text"),
        TextSize = 10.5,
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, holder)
    win:_bind(valueLabel, "TextColor3", "Text")

    local element = {
        Type = "Ring",
        Frame = row,
        Value = tonumber(config.Value) or 0,
    }

    local function paint()
        local ratio = U.clamp(tonumber(element.Value) or 0, 0, 1)
        local activeColor = U.color(config.Color or theme.Accent)
        if type(config.ColorKey) == "string" then
            activeColor = win:Color(config.ColorKey)
        end
        local active = math.floor(ratio * segments + 0.5)

        for index = 1, segments do
            if index <= active then
                marks[index].BackgroundColor3 = activeColor
                marks[index].BackgroundTransparency = 0
            else
                marks[index].BackgroundColor3 = win:Color("Outline")
                marks[index].BackgroundTransparency = 0.2
            end
        end

        if type(config.Format) == "function" then
            local ok, formatted = pcall(config.Format, ratio)
            valueLabel.Text = ok and tostring(formatted) or (math.floor(ratio * 100) .. "%")
        else
            valueLabel.Text = math.floor(ratio * 100) .. "%"
        end
    end

    element.SetValue = function(self_, value)
        element.Value = tonumber(value) or 0
        paint()
    end

    element.GetValue = function()
        return element.Value
    end

    element.SetVisible = function(self_, visible)
        row.Visible = visible and true or false
    end

    win:_onTheme(paint)
    paint()

    return I.finish(card, element, config)
end

