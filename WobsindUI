            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Center,
            LayoutOrder = 2,
            ZIndex = 6,
        }, holder)
        win:_onTheme(function()
            desc.TextColor3 = win:Color("Placeholder")
        end)
    end

    local element = {
        Type = "Button",
        Value = nil,
        SetValue = function() end,
        GetValue = function()
            return nil
        end,
        SetText = function(text)
            btn:SetTitle(text)
        end,
        Click = function()
            if cfg.Callback then
                task.spawn(cfg.Callback)
            end
        end,
    }

    element.Frame = holder
    element.Title = cfg.Title
    element._search = tostring(cfg.Title or "") .. " " .. tostring(cfg.Desc or "")
    element.SetVisible = function(a, b)
        holder.Visible = argValue(a, b) and true or false
    end
    element.Destroy = function()
