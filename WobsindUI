    }, row)

    local textColor = config.Color
    if typeof(textColor) ~= "Color3" then
        textColor = win:Color(type(textColor) == "string" and textColor or "SubText")
    end

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = config.Bold and Enum.Font.GothamMedium or Enum.Font.Gotham,
        Text = config.Title or config.Text or "",
        TextColor3 = textColor,
        TextSize = config.Size or 10.5,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)

    -- 说明文字：以前直接吞掉了，现在真的画出来
    if config.Desc and config.Desc ~= "" then
        local sub = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = config.Desc,
            TextColor3 = win:Color("Muted"),
            TextSize = (config.Size or 10.5) - 0.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.RowItem,
        }, row)
        win:_bind(sub, "TextColor3", "Muted")
    end

    local element = {
        Type = "Label",
        Frame = row,
        Value = config.Title,
        SetText = function(text)
            label.Text = tostring(text or "")
        end,
    }

    return I.finish(card, element, config)
