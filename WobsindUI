function WobsinsUI:Prompt(config)
    config = config or {}
    local modal = self:_modal({
        Title = config.Title or "输入",
        Subtitle = config.Subtitle,
        Content = config.Content or "",
        Icon = config.Icon or "type",
        Window = config.Window,
        Width = config.Width or 380,
        Dismissable = config.Dismissable ~= false,
    })
    local theme = themeOf(config.Window)

    local holder = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.new(1, 0, 0, 30),
        LayoutOrder = 2,
        ZIndex = self.Layers.ModalCard + 1,
    }, modal.ContentHolder)
    U.corner(holder, 4)
    local holderStroke = U.stroke(holder, theme.Outline, 1, 0.4)

    local box = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(9, 0),
        Size = UDim2.new(1, -18, 1, 0),
        Font = Enum.Font.Gotham,
        PlaceholderText = config.Placeholder or "输入内容…",
        PlaceholderColor3 = theme.Muted,
        Text = tostring(config.Value or ""),
        TextColor3 = theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = self.Layers.ModalCard + 2,
    }, holder)

    local buttons = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = 3,
        ZIndex = self.Layers.ModalCard + 1,
    }, modal.ContentHolder)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, buttons)

    local function makeButton(title, primary, callback)
        local btn = new("TextButton", {
            BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
            AutoButtonColor = false,
            Size = UDim2.fromOffset(78, 26),
            Text = "",
            ZIndex = self.Layers.ModalCard + 2,
        }, buttons)
        U.corner(btn, 4)
        U.stroke(btn, theme.Outline, 1, primary and 1 or 0.4)

        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamMedium,
            Text = title,
            TextColor3 = primary and theme.OnAccent or theme.Text,
            TextSize = 11,
            ZIndex = self.Layers.ModalCard + 3,
        }, btn)

        btn.Activated:Connect(function()
            if callback then
                safeCall(callback)
            end
        end)
        return btn
    end

    makeButton("取消", false, function()
        modal:Close()
    end)
    makeButton("确定", true, function()
        local text = box.Text
        modal:Close()
        if config.OnConfirm then
            safeCall(config.OnConfirm, text)
        end
    end)

    box.Focused:Connect(function()
        holderStroke.Color = theme.Accent
    end)
    box.FocusLost:Connect(function(enter)
        holderStroke.Color = theme.Outline
        if enter then
            local text = box.Text
            modal:Close()
            if config.OnConfirm then
                safeCall(config.OnConfirm, text)
            end
        end
    end)

    if config.Focus ~= false then
        U.spawn(function()
            U.wait(0.1)
            pcall(function()
                box:CaptureFocus()
            end)
        end)
    end

    return modal
end

