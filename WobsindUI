    local extra = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 10),
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)

    local track = new("Frame", {
        BackgroundColor3 = theme.Outline,
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.5, -2),
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, extra)
    U.corner(track, 2)
    win:_bind(track, "BackgroundColor3", "Outline")

    local fill = new("Frame", {
        BackgroundColor3 = theme.Accent,
        Size = UDim2.new(value / 100, 0, 1, 0),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, track)
    U.corner(fill, 2)
    win:_bind(fill, "BackgroundColor3", "Accent")

    local element = {
        Type = "Progress",
        Frame = row,
        Value = value,
    }

    function element.GetValue()
