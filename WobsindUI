        ic.Position = UDim2.fromScale(0.5, 0.5)
        ic.ZIndex = 6
    end

    btn.MouseEnter:Connect(function()
        tween(btn, 0.15, { BackgroundTransparency = 0.85 })
        if ic then
            if ic:IsA("TextLabel") then
                tween(ic, 0.15, { TextColor3 = win:Color("Text") })
            else
                tween(ic, 0.15, { ImageColor3 = win:Color("Text") })
            end
        end
