        TextColor3 = theme.Muted,
        TextSize = 9,
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, clear)
    win:_bind(clearLabel, "TextColor3", "Muted")

    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 26),
        Size = UDim2.new(1, 0, 0, height),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)
    U.padding(scroll, 8, 2, 8, 6)

    local list = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, scroll)

    local count = 0

    -- 空状态提示：一条日志都没有时给点反馈，避免看起来是块空黑
    local emptyHint = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 26),
        Size = UDim2.new(1, 0, 0, height),
        Font = Enum.Font.Gotham,
        Text = "暂无日志",
        TextColor3 = win:Color("Muted"),
        TextSize = 9.5,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)
    win:_bind(emptyHint, "TextColor3", "Muted")

    local function resizeCanvas()
        scroll.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 8)
        scroll.CanvasPosition = Vector2.new(0, math.max(list.AbsoluteContentSize.Y - height, 0))
    end

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resizeCanvas)

    local element = {
        Type = "Console",
        Frame = holder,
        Value = "",
    }

    local COLORS = {
        info = "SubText",
        success = "Success",
        warn = "Warning",
        error = "Danger",
    }

    function element.Log(a, b, c)
        -- 同时支持 element.Log(text, level) 与 element:Log(text, level)
        local text, level
        if a == element then
            text, level = b, c
        else
            text, level = a, b
        end
        level = level or "info"
        count = count + 1
        emptyHint.Visible = false
        if count > maxLines then
            local first = scroll:FindFirstChildOfClass("TextLabel")
            if first then
                first:Destroy()
            end
        end

        local stamp = os.date("%H:%M:%S")
        local line = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 14),
            Font = Enum.Font.Code,
            Text = string.format("[%s] %s", stamp, tostring(text)),
            TextColor3 = win:Color(COLORS[level] or "SubText"),
            TextSize = 9.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            LayoutOrder = count,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, scroll)
        element.Value = line.Text
        resizeCanvas()
        return line
    end

    function element.Clear()
        count = 0
        emptyHint.Visible = true
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end
        count = 0
        resizeCanvas()
    end

    clear.Activated:Connect(function()
        element.Clear()
    end)

    element.SetVisible = function(_, visible)
        holder.Visible = visible and true or false
    end

    if config.Welcome then
        element.Log(config.Welcome, "success")
    end

    return I.finish(card, element, config)
end

