function Window:WatchViewport()
    if self._viewportToken then
        return self
    end
    local token = {}
    self._viewportToken = token

    U.spawn(function()
        local last = WobsinsUI:_viewport()
        while self._viewportToken == token and not self.Destroyed do
            U.wait(1)
            local vp = WobsinsUI:_viewport()
            if vp.X ~= last.X or vp.Y ~= last.Y then
                last = vp
                self:Resize(
                    math.min(self.Width, vp.X - 20),
                    math.min(self.Height, vp.Y - 20)
                )
                self:Center()
            end
        end
    end)

    return self
end

