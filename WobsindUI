function Build.Paragraph(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local avatarSize = config.ImageSize or 32

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.padding(holder, 6, 6, 6, 6)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    local top = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)

    local textX = 0

    if config.Image and config.Image ~= "" then
