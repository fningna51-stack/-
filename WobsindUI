    end

    local pageSize = tonumber(config.PageSize) or 0
    local bodyHeight = tonumber(config.Height) or 180
    local sortKey = nil
    local sortDesc = false
    local query = ""
    local page = 1
    local selected = nil
    local rendered = {}

    local paint
    local refresh

    --//--------------------------------------------------------------------
    --// 标题栏
    --//--------------------------------------------------------------------

    local countLabel = nil
    if config.Title and config.Title ~= "" then
        local headerBar = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 20),
            LayoutOrder = #card.Elements + 1,
            ZIndex = WobsinsUI.Layers.Row,
        }, card.Body)

        local title = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -60, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = config.Title,
            TextColor3 = win:Color("Text"),
            TextSize = 11.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = WobsinsUI.Layers.RowItem,
        }, headerBar)
        win:_bind(title, "TextColor3", "Text")

        countLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(56, 20),
            Position = UDim2.new(1, -56, 0, 0),
            Font = Enum.Font.Gotham,
            Text = "",
            TextColor3 = win:Color("Muted"),
            TextSize = 9.5,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = WobsinsUI.Layers.RowItem,
        }, headerBar)
        win:_bind(countLabel, "TextColor3", "Muted")
    end

    --//--------------------------------------------------------------------
    --// 表格外壳
    --//--------------------------------------------------------------------

    local footerHeight = (pageSize > 0) and 26 or 0
    local shellHeight = 27 + bodyHeight + footerHeight

    local shell = new("Frame", {
        BackgroundColor3 = theme.SurfaceAlt,
        BackgroundTransparency = 0.35,
        Size = UDim2.new(1, 0, 0, shellHeight),
        LayoutOrder = #card.Elements + 1,
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.corner(shell, 5)
    U.stroke(shell, theme.Outline, 1, 0.5)
    win:_bind(shell, "BackgroundColor3", "SurfaceAlt")

    -- 表头
    local headRow = new("Frame", {
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.15,
        Size = UDim2.new(1, 0, 0, 26),
        ZIndex = WobsinsUI.Layers.RowItem,
    }, shell)
    win:_bind(headRow, "BackgroundColor3", "Surface")

    local headCells = {}
    local cursorX = 0
    for index, col in ipairs(columns) do
        local width = widths[index]
        local button = new("TextButton", {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Position = UDim2.new(cursorX, 0, 0, 0),
            Size = UDim2.new(width, 0, 1, 0),
            Text = "",
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, headRow)
        cursorX = cursorX + width

        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = tostring(col.Title or col.Key or ""),
            TextColor3 = win:Color("Muted"),
            TextSize = 9.5,
            TextXAlignment = (col.Align == "Right") and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, button)
        win:_bind(label, "TextColor3", "Muted")

        headCells[index] = { Label = label, Column = col }

        if config.Sortable ~= false then
            button.Activated:Connect(function()
                if sortKey == col.Key then
                    sortDesc = not sortDesc
                else
                    sortKey = col.Key
                    sortDesc = false
                end
                page = 1
                refresh()
            end)
            U.hover(button, function()
                U.tween(label, 0.1, { TextColor3 = win:Color("SubText") })
            end, function()
                U.tween(label, 0.1, { TextColor3 = win:Color("Muted") })
            end)
        end
    end

    new("Frame", {
        BackgroundColor3 = theme.Outline,
        BackgroundTransparency = 0.3,
        Position = UDim2.new(0, 0, 0, 26),
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, shell)

    -- 表体
    local body = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 27),
        Size = UDim2.new(1, 0, 0, bodyHeight),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, shell)
    body.ScrollBarImageColor3 = win:Color("Outline")

    local list = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, body)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 1),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)

    local empty = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 27),
        Size = UDim2.new(1, 0, 0, bodyHeight),
        Font = Enum.Font.Gotham,
        Text = config.EmptyText or "没有数据",
        TextColor3 = win:Color("Muted"),
        TextSize = 10.5,
        Visible = false,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, shell)
    win:_bind(empty, "TextColor3", "Muted")

    -- 分页
    local pageLabel = nil
    if pageSize > 0 then
        local footer = new("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 27 + bodyHeight),
            Size = UDim2.new(1, 0, 0, 26),
            ZIndex = WobsinsUI.Layers.RowItem,
        }, shell)

        pageLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.new(1, -80, 1, 0),
            Font = Enum.Font.Gotham,
            Text = "1 / 1",
            TextColor3 = win:Color("Muted"),
            TextSize = 9.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, footer)
        win:_bind(pageLabel, "TextColor3", "Muted")

        local function navButton(icon, offsetX, delta)
            local button = new("TextButton", {
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Position = UDim2.new(1, offsetX, 0, 0),
                Size = UDim2.new(0, 24, 1, 0),
                Text = "",
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, footer)
            local glyph = U.icon(button, icon, 11, win:Color("SubText"), WobsinsUI.Layers.RowItem + 2)
            if glyph then
                glyph.AnchorPoint = Vector2.new(0.5, 0.5)
                glyph.Position = UDim2.fromScale(0.5, 0.5)
            end
            button.Activated:Connect(function()
                local pages = math.max(1, math.ceil(#rows / pageSize))
                page = U.clamp(page + delta, 1, pages)
                paint()
            end)
            return button
        end

        navButton("chevronLeft", -50, -1)
        navButton("chevronRight", -22, 1)
    end

    --//--------------------------------------------------------------------
    --// 数据整理
    --//--------------------------------------------------------------------

    local function visibleRows()
        local result = {}
        for _, row in ipairs(rows) do
            local hit = true
            if query ~= "" then
                hit = false
                for _, col in ipairs(columns) do
                    local text = string.lower(cellText(row[col.Key]))
                    if string.find(text, query, 1, true) then
                        hit = true
                        break
                    end
                end
            end
            if hit then
                table.insert(result, row)
            end
        end

        if sortKey then
            table.sort(result, function(a, b)
                local av, bv = a[sortKey], b[sortKey]
                if type(av) == "number" and type(bv) == "number" then
                    if sortDesc then
                        return av > bv
                    end
                    return av < bv
                end
                local as, bs = string.lower(cellText(av)), string.lower(cellText(bv))
                if sortDesc then
                    return as > bs
                end
                return as < bs
            end)
        end

        return result
    end

    local function paintCell(parent, col, width, x, rowData, rowIndex)
        local value = rowData[col.Key]
        local text = cellText(value)
        local color = win:Color("SubText")

        if type(col.Format) == "function" then
            local ok, formatted, formattedColor = pcall(col.Format, value, rowData, rowIndex)
            if ok then
                if formatted ~= nil then
                    text = tostring(formatted)
                end
                local parsedColor = asColor3(formattedColor)
                if parsedColor then
                    color = parsedColor
                end
            end
        end

        return new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(x, 8, 0, 0),
            Size = UDim2.new(width, -16, 1, 0),
            Font = Enum.Font.Gotham,
            Text = text,
            TextColor3 = color,
            TextSize = 10,
            TextXAlignment = (col.Align == "Right") and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, parent)
    end

    --//--------------------------------------------------------------------
    --// 绘制
    --//--------------------------------------------------------------------

    paint = function()
        for _, item in ipairs(rendered) do
            item:Destroy()
        end
        rendered = {}

        local data = visibleRows()
        local total = #data
        local startIndex, endIndex = 1, total

        if pageSize > 0 then
            local pages = math.max(1, math.ceil(total / pageSize))
            page = U.clamp(page, 1, pages)
            startIndex = (page - 1) * pageSize + 1
            endIndex = math.min(total, page * pageSize)
            if pageLabel then
                pageLabel.Text = string.format("%d / %d · 共 %d 条", page, pages, total)
            end
        end

        empty.Visible = (total == 0)
        body.Visible = (total > 0)

        for index = startIndex, endIndex do
            local rowData = data[index]
            local rowFrame = new("TextButton", {
                BackgroundColor3 = win:Color("Surface"),
                BackgroundTransparency = 0.7,
                AutoButtonColor = false,
                Size = UDim2.new(1, 0, 0, 26),
                Text = "",
                LayoutOrder = index,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, list)

            local cursor = 0
            for colIndex, col in ipairs(columns) do
                paintCell(rowFrame, col, widths[colIndex], cursor, rowData, index)
                cursor = cursor + widths[colIndex]
            end

            if selected == index then
                rowFrame.BackgroundTransparency = 0.8
            end

            if config.Selectable then
                rowFrame.Activated:Connect(function()
                    selected = index
                    paint()
                    if config.OnSelect then
                        safeCall(config.OnSelect, rowData, index)
                    end
                end)
            elseif config.OnActivate then
                rowFrame.Activated:Connect(function()
                    safeCall(config.OnActivate, rowData, index)
                end)
            end

            U.hover(rowFrame, function()
                rowFrame.BackgroundTransparency = 0.45
            end, function()
                rowFrame.BackgroundTransparency = (selected == index) and 0.8 or 0.7
            end)

            table.insert(rendered, rowFrame)
        end

        body.CanvasSize = UDim2.new(0, 0, 0, math.max(#rendered * 27, 1))

        if countLabel then
            countLabel.Text = string.format("%d 条", total)
        end

        if card.Tab and card.Tab._refreshCanvas then
            card.Tab._refreshCanvas()
        end
    end

    refresh = function()
        for index, item in ipairs(headCells) do
            local suffix = ""
            if sortKey and item.Column.Key == sortKey then
                suffix = sortDesc and "  ↓" or "  ↑"
            end
            item.Label.Text = tostring(item.Column.Title or item.Column.Key or "") .. suffix
        end
        paint()
    end

    --//--------------------------------------------------------------------
    --// 接口
    --//--------------------------------------------------------------------

    local element = {
        Type = "Table",
        Frame = shell,
        Rows = rows,
        Page = 1,
    }

    element.SetRows = function(self_, list_)
        rows = {}
        for index, row in ipairs(list_ or {}) do
            rows[index] = row
        end
        element.Rows = rows
        page = 1
        paint()
    end

    element.AddRow = function(self_, row)
        table.insert(rows, row)
        element.Rows = rows
        paint()
    end

    element.GetRows = function()
        return rows
    end

    element.SetQuery = function(self_, text)
        query = string.lower(tostring(text or ""))
        page = 1
        paint()
    end

    element.Sort = function(self_, key, desc)
        sortKey = key
        sortDesc = desc == true
        refresh()
    end

    element.Refresh = function()
        refresh()
    end

    element.Select = function(self_, index)
        selected = index
        paint()
    end

    element.GetSelected = function()
        if not selected then
            return nil, nil
        end
        return rows[selected], selected
    end

    element.SetValue = function(self_, list_)
        element.SetRows(self_, list_)
    end

    element.GetValue = function()
        return rows
    end

    element.SetVisible = function(self_, visible)
        shell.Visible = visible and true or false
    end

    refresh()

    return I.finish(card, element, config)
end

L.RegisterElement("Table")

