function L.Build.BarChart(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local data = config.Data or {}
    local height = config.Height or 84

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height + 18),
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)

    local chart = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)

    local bars = {}
    local labels = {}

    local element = {
        Type = "BarChart",
        Frame = holder,
        Data = data,
    }

    local function paint()
        local list_ = element.Data or {}
        for _, bar in ipairs(bars) do
            bar:Destroy()
        end
        for _, label in ipairs(labels) do
            label:Destroy()
        end
        bars, labels = {}, {}

        local count = math.max(#list_, 1)
        local max = 0
        for _, item in ipairs(list_) do
            max = math.max(max, tonumber(item.Value) or 0)
        end
        if max <= 0 then
            max = 1
        end

        local slot = 1 / count
        for index, item in ipairs(list_) do
            local value = tonumber(item.Value) or 0
            local ratio = U.clamp(value / max, 0.02, 1)
            local barColor = U.color(item.Color or config.Color or theme.Accent)
            if item.ColorKey then
                barColor = win:Color(item.ColorKey)
            end

            local bar = new("Frame", {
                BackgroundColor3 = barColor,
                BackgroundTransparency = 0.15,
                Size = UDim2.new(slot - 0.06, 0, 0, math.floor(ratio * height)),
                Position = UDim2.new((index - 1) * slot + 0.03, 0, 1, 0),
                AnchorPoint = Vector2.new(0, 1),
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, chart)
            U.corner(bar, 3)
            table.insert(bars, bar)

            local label = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new((index - 1) * slot, 0, 1, 2),
                Size = UDim2.new(slot, 0, 0, 14),
                Font = Enum.Font.Gotham,
                Text = tostring(item.Label or index),
                TextColor3 = win:Color("Muted"),
                TextSize = 8.5,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.RowItem + 1,
            }, holder)
            win:_bind(label, "TextColor3", "Muted")
            table.insert(labels, label)

            if item.Label then
                U.tooltip(bar, string.format("%s · %s", tostring(item.Label), tostring(item.Value)))
            end
        end
    end

    element.SetData = function(self_, list_)
        element.Data = list_ or {}
        paint()
    end

    element.SetValue = function(self_, list_)
        element.Data = list_ or {}
        paint()
    end

    element.GetValue = function()
        return element.Data
    end

    win:_onTheme(paint)
    paint()

    return I.finish(card, element, config)
end

