function Window:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true
    self.Visible = false

    if self.OpenButton and self.OpenButton.Frame then
        self.OpenButton.Frame:Destroy()
        self.OpenButton = nil
    end
    if self.Stage then
        self.Stage:Destroy()
        self.Stage = nil
    end

    for index, item in ipairs(WobsinsUI.Windows) do
        if item == self then
            table.remove(WobsinsUI.Windows, index)
            break
        end
    end
end

