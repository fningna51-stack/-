--//----------------------------------------------------------------------------
--// 23.3 展开 / 收起
--//----------------------------------------------------------------------------

function Window:SetMinimized(state)
    state = state and true or false
    if not self.Stage then
        return self
    end
    if self.Minimized == state then
        return self
    end

    if not self.MinBar then
        self:_buildMinBar(self.Config)
    end

    self.Minimized = state
    local show = not state

    for _, part in ipairs({ self.Header, self.Sidebar, self.Content, self.Footer }) do
        if part then
            part.Visible = show
        end
    end
    if self.MinBar then
        self.MinBar.Visible = state
    end

    -- 这些挂在 Main 上，不收起来会跑到胶囊角落里
    if self.ResizeGrip then
        self.ResizeGrip.Visible = show
    end

    -- 收起后不要再带青色外发光，那样深色胶囊边上会有一圈脏光
    if self.MainStroke then
        self.MainStroke.Transparency = state and 1 or (self.Glass and 0.2 or 0.55)
    end
    if self.Glow then
        self.Glow.Visible = show
    end
    if self.BgImage then
        self.BgImage.Visible = show
    end
    if self.Veil then
        self.Veil.Visible = show
    end
    if show and self._pendingBackground then
        local source = self._pendingBackground
        self._pendingBackground = nil
        self:SetBackgroundImage(source)
    end

    local abs = self.Stage.AbsolutePosition
    local targetW = show and self.Width or (self.MinBarWidth or self:_minBarWidth())
    local targetH = show and self.Height or MIN_BAR_HEIGHT
    local config = self.Config or {}

    local left, top
    if show then
        -- 展开：回到收起前的位置
        left = self._preMinLeft or abs.X
        top = self._preMinTop or abs.Y
        self._preMinLeft, self._preMinTop = nil, nil
    else
        -- 收起：记下原位置，然后固定到屏幕顶部正中（可以再拖走）
        self._preMinLeft = abs.X
        self._preMinTop = abs.Y
        if config.MinBarAnchor == false then
            left, top = abs.X, abs.Y
        elseif self._minBarLeft and self._minBarTop then
            -- 之前拖过：回到拖到的位置，不要每次都被拽回屏幕中央
            left, top = self._minBarLeft, self._minBarTop
        else
            local vp = WobsinsUI:_viewport()
            left = (vp.X - targetW) / 2
            top = config.MinBarTop or 18
        end
    end

    local position, realLeft, realTop = stagePlace(self.Stage, targetW, targetH, left, top)
    if not show then
        self._minBarLeft, self._minBarTop = realLeft, realTop
    end

    U.tween(self.Stage, 0.2, {
        Size = UDim2.fromOffset(targetW, targetH),
        Position = position,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    if self.Shadow then
        -- 玻璃主题的阴影是浅青色，缩成小黑条后会变成一圈脏光，直接收掉
        self.Shadow.Visible = show
        U.tween(self.Shadow, 0.2, {
            Size = UDim2.new(1, 4, 1, show and 10 or 3),
            Position = UDim2.fromOffset(-2, show and 6 or 2),
        })
    end

    if self.Corner then
        self.Corner.CornerRadius = UDim.new(0, show and (self.Radius or 6) or 9)
    end

    return self
end

-- 覆盖 12 里的旧实现：旧版只是把窗口压成一条 880px 的黑条
function Window:Minimize()
    if not self.Stage then
        return self
    end
    self:SetMinimized(not self.Minimized)
    return self
end

function Window:IsMinimized()
    return self.Minimized == true
end

--//----------------------------------------------------------------------------
--// 23.4 关闭脚本（带确认）
--//----------------------------------------------------------------------------

function WobsinsUI:OnShutdown(fn)
    if type(fn) ~= "function" then
        return self
    end
    self.ShutdownHooks = self.ShutdownHooks or {}
    table.insert(self.ShutdownHooks, fn)
    return self
end

function WobsinsUI:IsClosed()
    return self.Closed == true
end

-- 真正销毁：界面、单例、genv 一起清掉
function WobsinsUI:Shutdown()
    if self.ShuttingDown then
        return self
    end
    self.ShuttingDown = true
    self.Closed = true

    for _, fn in ipairs(self.ShutdownHooks or {}) do
        safeCall(fn)
    end

    pcall(function()
        self:Destroy()
    end)

    self.ShuttingDown = false
    return self
end

function Window:Shutdown()
    if self.Destroyed or self.ShutdownRequested then
        return self
    end
    self.ShutdownRequested = true

    -- 收起成小胶囊再淡出，比「啪一下全没」自然一点
    if self.Stage and not self.Minimized then
        pcall(function()
            self:SetMinimized(true)
        end)
    end

    -- 比确认框淡出（0.16 + 0.18）稍慢一点，避免「弹窗还没关、界面先没了」
    local win = self
    U.delay(0.26, function()
        if win.Destroyed then
            return
        end
        WobsinsUI:Shutdown()
    end)

    return self
end

function Window:RequestClose()
    if self.Destroyed or self.Closing then
        return self
    end

    local config = self.Config or {}

    -- 明确写 false 才跳过确认，默认一定有
    if config.ConfirmClose == false then
        return self:Shutdown()
    end

    self.Closing = true

    local title = config.CloseTitle or "关闭脚本"
    local content = config.CloseContent
        or "确定要关闭脚本并退出吗？\n\n关闭后界面会一并销毁，需要重新执行脚本才能再次打开。"

    local modal
    modal = WobsinsUI:Dialog({
        Window = self,
        Title = title,
        Subtitle = "WobsinsUI v" .. tostring(WobsinsUI.Version),
        Content = content,
        Icon = "power",
        Dismissable = true,
        Buttons = {
            {
                Title = "取消",
                Width = 88,
                Callback = function()
                    self.Closing = false
                end,
            },
            {
                Title = "关闭脚本",
                Width = 104,
                Variant = "Primary",
                Icon = "power",
                Callback = function()
                    self.Closing = false
                    self:Shutdown()
                end,
            },
        },
    })

    -- 点遮罩 / Esc 关掉弹窗时，把 Closing 解锁，否则以后再也点不开
    if modal then
        local rawClose = modal.Close
        modal.Close = function(self_, ...)
            if not self_.Closed then
                self.Closing = false
            end
            return rawClose(self_, ...)
        end
        self.CloseModal = modal
    end

    return self
end

--//----------------------------------------------------------------------------
--// 23.5 收尾：构建小胶囊
--//----------------------------------------------------------------------------

local _createWindowPrev = WobsinsUI._createWindow

function WobsinsUI:_createWindow(config)
    local win = _createWindowPrev(self, config)
    if win and not win.Destroyed then
        pcall(function()
            win:_buildMinBar(config)

            -- 标题改过之后胶囊宽度要跟着变
            local rawSetTitle = win.SetTitle
            win.SetTitle = function(self_, text)
                local result = rawSetTitle(self_, text)
                if self_.MinBarLabel then
                    self_.MinBarLabel.Text = self_.Title
                end
                self_.MinBarWidth = self_:_minBarWidth()
                return result
            end
        end)
    end
    return win
end

return WobsinsUI
