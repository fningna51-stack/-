--// Window --------------------------------------------------------------------
local Window = {}
Window.__index = Window
WobsinsUI.Window = Window

function Window:Color(key)
    local t = self.ThemeTable or Themes.Dark
    return t[key] or Color3.new(1, 1, 1)
end

function Window:_bind(inst, prop, key)
    inst[prop] = self:Color(key)
    table.insert(self.Bindings, { inst = inst, prop = prop, key = key })
end

function Window:_onTheme(fn)
    table.insert(self.ThemeHooks, fn)
    fn()
end

function Window:_refreshTheme()
    self.ThemeTable = Themes[self.Theme] or Themes.Dark
    self.Glass = self.ThemeTable.Glass == true
    self.Radius = self.ThemeTable.Radius or 5
    if self.Corner then
        self.Corner.CornerRadius = UDim.new(0, self.Radius)
    end
    for _, binding in ipairs(self.Bindings) do
        if binding.inst then
            binding.inst[binding.prop] = self:Color(binding.key)
        end
    end
    for _, hook in ipairs(self.ThemeHooks) do
        pcall(hook)
    end
end

function Window:_applyTransparency()
    if not self.Main then
        return
    end
    local base = self.Glass and 0.05 or 0.02
    local target = base
    if self.Transparency then
        target = (self.BackgroundImage and 0.5) or (self.Glass and 0.18 or 0.1)
    end
    tween(self.Main, 0.2, { BackgroundTransparency = target })
    if self.Sidebar then
        tween(self.Sidebar, 0.2, {
            BackgroundTransparency = self.Glass and (self.Transparency and 0.55 or 0.35) or 0,
        })
    end
end

function Window:SetBackgroundImage(image, transparency)
    if not self.BgImage then
        return
    end
    if image then
        self.BackgroundImage = image
        self.BgImage.Image = image
        self.BgImage.ImageTransparency = (transparency ~= nil) and transparency or 0.55
        if self.Veil then
            self.Veil.Visible = true
        end
    else
        self.BackgroundImage = nil
        self.BgImage.Image = ""
        if self.Veil then
            self.Veil.Visible = false
        end
    end
    self:_applyTransparency()
end

function Window:SetBackgroundImageTransparency(value)
    if self.BgImage then
        self.BgImage.ImageTransparency = value
    end
end

function Window:SetToggleKey(key)
    self.ToggleKey = key
end

function Window:OnClose(fn)
    table.insert(self.CloseCallbacks, fn)
end

function Window:_isOpen()
    return self.Visible
end

function Window:_show(show)
    if not self.Main then
        return
    end
    self.Visible = show
    if show then
        self.Main.Visible = true
        self.Main.Size = UDim2.fromOffset(self.Width, self.Height + 6)
        tween(self.Main, 0.24, { Size = UDim2.fromOffset(self.Width, self.Height) }, Enum.EasingStyle.Back)
        tween(self.Scale, 0.24, { Scale = 1 }, Enum.EasingStyle.Back)
        self.Root.Visible = true
    else
        tween(self.Scale, 0.18, { Scale = 0.96 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(self.Main, 0.18, { Size = UDim2.fromOffset(self.Width, math.max(self.Height - 10, 120)) })
        task.delay(0.19, function()
            if not self.Visible and self.Main then
                self.Main.Visible = false
            end
            if self.Scale then
                self.Scale.Scale = 1
            end
            if self.Main then
                self.Main.Size = UDim2.fromOffset(self.Width, self.Height)
            end
        end)
    end
    for _, fn in ipairs(self.CloseCallbacks) do
        if not show then
            task.spawn(fn)
        end
    end
end

function Window:_toggleWindow()
    if self.Locked then
        return
    end
    self:_show(not self.Visible)
end

function Window:Minimize()
    self.Minimized = not self.Minimized
    local show = not self.Minimized
    if self.Sidebar then
        self.Sidebar.Visible = show
    end
    if self.ContentPanel then
        self.ContentPanel.Visible = show
    end
    if self.Footer then
        self.Footer.Visible = show
    end
    local target = show and self.Height or (self.HeaderHeight + 2)
    tween(self.Main, 0.24, { Size = UDim2.fromOffset(self.Width, target) }, Enum.EasingStyle.Quint)
end

function Window:_drag(handle)
    local dragging, dragStart, startPos = false, nil, nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.Main.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            self.Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

function Window:SelectTab(indexOrName)
    local target = nil
    if type(indexOrName) == "number" then
        target = self.Tabs[indexOrName]
    else
        for _, tab in ipairs(self.Tabs) do
            if tab.Title == indexOrName then
                target = tab
                break
            end
        end
    end
    if not target then
        return
    end
    self.ActiveTab = target
    for _, tab in ipairs(self.Tabs) do
        tab:_setActive(tab == target)
    end
end

function Window:GetActiveTab()
    return self.ActiveTab
end

function Window:_filter(query)
    query = trim(query or "")
    self.SearchQuery = query
    local total = 0
    for _, tab in ipairs(self.Tabs) do
        total = total + tab:_filter(query)
    end
    if self.ActiveTab then
        self.ActiveTab:_updateEmptyState()
    end
    return total
end

