local function safeCall(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then
        return result
    end
    return nil
end

U.safeCall = safeCall
function U.new(class, props, parent)
    local inst = Instance.new(class)
    if props then
        local textScale = WobsinsUI.TextScale or 1
        for key, value in pairs(props) do
            if value ~= nil then
                if key == "TextSize" and textScale ~= 1 and type(value) == "number" then                  
                    value = math.floor(value * textScale * 2 + 0.5) / 2
                end
                inst[key] = value
            end
        end
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local new = U.new

function U.corner(inst, radius)
    local c = new("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, inst)
    return c
end

function U.stroke(inst, color, thickness, transparency)
    local s = new("UIStroke", {
        Color = color or Color3.new(0, 0, 0),
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
    return s
end

function U.padding(inst, left, top, right, bottom)
    local p = new("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    }, inst)
    return p
end

function U.list(inst, direction, gap, align)
    local l = new("UIListLayout", {
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }, inst)
    return l
end

function U.grid(inst, gap)
    return new("UIGridLayout", {
        CellSize = UDim2.new(0.5, -4, 0, 30),
        CellPadding = UDim2.new(0, gap or 8, 0, gap or 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, inst)
end

function U.tween(inst, time, props, style, dir)
    if not inst then
        return
    end
    local ok, tw = pcall(function()
        return S.TweenService:Create(
            inst,
            TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
            props
        )
    end)
    if ok and tw then
        pcall(function()
            tw:Play()
        end)
        return tw
    end
    -- 兜底：没有 TweenService 就立即生效
    pcall(function()
        for k, v in pairs(props) do
            inst[k] = v
        end
    end)
end

function U.spawn(fn, ...)
    local args = { ... }
    if task and task.spawn then
        task.spawn(function()
            safeCall(fn, table.unpack(args))
        end)
    else
        coroutine.wrap(function()
            safeCall(fn, table.unpack(args))
        end)()
    end
end

function U.delay(time, fn)
    if task and task.delay then
        task.delay(time, fn)
    else
        U.spawn(function()
            wait(time)
            fn()
        end)
    end
end

function U.wait(time)
    if task and task.wait then
        return task.wait(time)
    end
    return wait(time)
end

-- 颜色：字符串 / Color3 都吃
function U.color(value, fallback)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) == "string" then
        local hex = value:gsub("#", "")
        local ok, c = pcall(function()
            return Color3.fromHex(hex)
        end)
        if ok and c then
            return c
        end
    end
    return fallback or Color3.new(1, 1, 1)
end

-- 估算一段文字的宽度（CJK 按一个字号算，拉丁按 0.56 算）。
-- Roblox 没有跨执行器一致的字宽 API，这里只用来把「图标 + 文字」整体居中。
function U.textWidth(text, size)
    text = tostring(text or "")
    size = (size or 12) * (WobsinsUI.TextScale or 1)
    local width = 0
    local ok = pcall(function()
        for _, code in utf8.codes(text) do
            if code >= 0x2E80 then
                width = width + size
            else
                width = width + size * 0.56
            end
        end
    end)
    if not ok then
        width = #text * size * 0.72
    end
    return width
end

function U.clamp(value, minValue, maxValue)
    if value < minValue then
        return minValue
    end
    if value > maxValue then
        return maxValue
    end
    return value
end

function U.round(value, step)
    if not step or step <= 0 then
        return value
    end
    return math.floor(value / step + 0.5) * step
end

-- 数字显示：整数不带小数点，小数保留 step 的位数
function U.pretty(value, step)
    if type(value) ~= "number" then
        return tostring(value)
    end
    if math.abs(value - math.floor(value)) < 1e-6 then
        return tostring(math.floor(value))
    end
    local digits = 1
    if step and step > 0 then
        digits = 0
        local probe = step
        while digits < 4 and math.abs(probe - math.floor(probe)) > 1e-9 do
            probe = probe * 10
            digits = digits + 1
        end
        if digits == 0 then
            digits = 1
        end
    end
    return string.format("%." .. digits .. "f", value)
end

function U.humanize(number)
    if number >= 1e6 then
        return string.format("%.1fM", number / 1e6)
    elseif number >= 1e3 then
        return string.format("%.1fK", number / 1e3)
    end
    return tostring(number)
end

-- 判断是不是图片资源
function U.isImage(value)
    if type(value) ~= "string" or value == "" then
        return false
    end
    return value:match("^rbxassetid://") ~= nil
        or value:match("^rbxasset://") ~= nil
        or value:match("^https?://") ~= nil
        or value:match("^http://") ~= nil
end

-- 白 / 黑 反色，用于强调色上的文字
function U.contrast(color)
    local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
    if luminance > 0.55 then
        return Color3.new(0.05, 0.05, 0.06)
    end
    return Color3.new(0.96, 0.96, 0.97)
end

function U.mix(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

