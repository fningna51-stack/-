--//----------------------------------------------------------------------------
--// 19.7 轻量事件总线
--//----------------------------------------------------------------------------
--
-- 给外部留一个观察窗口内部状态的入口：
--   win:On("TabChanged", function(tab) end)
--   win:On("PageChanged", function(page) end)
--   win:On("Notify", function(payload) end)
--   win:On("Closed", function() end)

function Window:On(name, fn)
    if type(name) ~= "string" or type(fn) ~= "function" then
        return self
    end
    self._listeners = self._listeners or {}
    local list = self._listeners[name]
    if not list then
        list = {}
        self._listeners[name] = list
    end
    table.insert(list, fn)
    return self
end

function Window:Off(name, fn)
    local list = self._listeners and self._listeners[name]
    if not list then
        return self
    end
    if not fn then
        self._listeners[name] = nil
        return self
    end
    for index = #list, 1, -1 do
        if list[index] == fn then
            table.remove(list, index)
        end
    end
    return self
end

function Window:_emit(name, ...)
    local list = self._listeners and self._listeners[name]
    if not list then
        return
    end
    for _, fn in ipairs(list) do
        safeCall(fn, ...)
    end
end

