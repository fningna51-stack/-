--//============================================================================
--// 19. 快捷键面板
--//============================================================================
--
-- 把所有 Keybind 元素聚合成一个面板：
--   win:HotkeyPanel()          -- 打开（同一个窗口只会创建一次）
--   win:HotkeyPanel():Close()
--
-- 面板里可以直接改键：点右侧胶囊 → 按下新键；Esc 取消。

--//----------------------------------------------------------------------------
--// 19.1 收集
--//----------------------------------------------------------------------------

function Window:CollectKeybinds()
    local result = {}
    for _, tab in ipairs(self.Tabs) do
        for _, element in ipairs(tab.Elements) do
            if element.Type == "Keybind" then
                table.insert(result, {
                    Element = element,
                    Tab = tab,
                    Title = element.Title or "未命名",
                })
            end
        end
        for _, page in ipairs(tab.Pages or {}) do
            for _, element in ipairs(page.Elements) do
                if element.Type == "Keybind" then
                    table.insert(result, {
                        Element = element,
                        Tab = tab,
                        Page = page,
                        Title = element.Title or "未命名",
                    })
                end
            end
        end
    end
    return result
end

