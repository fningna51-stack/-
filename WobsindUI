--// Floating open button -----------------------------------------------------
local function createOpenButton(window, config)
    config = config or {}
    local t = themeOf(window)
    local hasTitle = (config.Title ~= nil)
    local width = config.Width or (hasTitle and 116 or 42)
    local height = config.Height or 42
    local radius = config.CornerRadius and config.CornerRadius.Offset or 21

    local holder = new("Frame", {
        Name = "OpenButton",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(width, height),
        Position = config.Position or UDim2.new(0, 24, 1, -110),
        ZIndex = 40,
    }, WobsinsUI:_screen())

    local btn = new("TextButton", {
        BackgroundColor3 = t.Surface,
        BackgroundTransparency = 0.05,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromScale(1, 1),
        ZIndex = 41,
    }, holder)
    corner(btn, radius)
    local btnStroke = stroke(btn, t.Outline, config.StrokeThickness or 1, 0.15)

    if config.Color then
        local g = new("UIGradient", {
            Color = config.Color,
            Rotation = 0,
        }, btn)
        g.Name = "OpenGradient"
        btn.BackgroundTransparency = 0
    end

    local row = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 42,
    }, btn)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local iconColor = t.SubText
    if isImageIcon(config.Icon) then
        iconColor = Color3.new(1, 1, 1)
    end
    local icon = createIcon(row, config.Icon or "menu", 17, iconColor)
    if icon then
        icon.ZIndex = 43
        icon.LayoutOrder = 1
    end

    local label = nil
    if hasTitle then
        label = new("TextLabel", {
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.fromOffset(0, height),
            Font = Enum.Font.GothamMedium,
            Text = config.Title,
            TextColor3 = t.Text,
            TextSize = 11.5,
            LayoutOrder = 2,
            ZIndex = 43,
        }, row)
    end

    if config.Draggable ~= false then
        local dragging, dragStart, startPos
        signal(btn, "InputBegan", function(_, input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = holder.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                holder.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
        signal(UserInputService, "InputEnded", function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    signal(btn, "MouseEnter", function()
        tween(btn, 0.16, { BackgroundTransparency = 0 })
        tween(btnStroke, 0.16, { Transparency = 0.15 })
    end)
    signal(btn, "MouseLeave", function()
        tween(btn, 0.16, { BackgroundTransparency = config.Color and 0 or 0.05 })
        tween(btnStroke, 0.16, { Transparency = 0.55 })
    end)
    signal(btn, "Activated", function()
        window:_toggleWindow()
    end)

    local api = {
        Frame = holder,
        SetTitle = function(text)
            if label then
                label.Text = text
            end
        end,
        SetIcon = function(iconName)
            if icon then
                icon:Destroy()
            end
            icon = createIcon(row, iconName, 18, themeOf(window).Accent)
        end,
        Destroy = function()
            holder:Destroy()
        end,
    }

    window:_onTheme(function()
        local nt = themeOf(window)
        if not config.Color then
            btn.BackgroundColor3 = nt.Surface
        end
        btnStroke.Color = nt.Outline
        if label then
            label.TextColor3 = nt.Text
        end
        if icon and icon:IsA("TextLabel") then
            icon.TextColor3 = nt.SubText
        end
    end)

    return api
end

