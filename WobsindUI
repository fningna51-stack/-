local tooltipFrame = nil

local function ensureTooltip()
    local screen = WobsinsUI:_screen()
    if tooltipFrame and tooltipFrame.Parent then
        return tooltipFrame
    end
    local theme = themeOf(nil)
    tooltipFrame = new("Frame", {
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Toast + 5,
    }, screen)
    U.corner(tooltipFrame, 4)
    U.stroke(tooltipFrame, theme.Outline, 1, 0.2)

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = theme.SubText,
        TextSize = 10,
        ZIndex = WobsinsUI.Layers.Toast + 6,
    }, tooltipFrame)
    U.padding(tooltipFrame, 8, 0, 8, 0)

    tooltipFrame.Label = label
    return tooltipFrame
end

function U.tooltip(inst, text)
    if not inst or not text or text == "" then
        return
    end
    local token = 0
    inst.MouseEnter:Connect(function()
        token = token + 1
        local mine = token
        U.delay(0.35, function()
            if mine ~= token then
                return
            end
            local frame = ensureTooltip()
            frame.Label.Text = text
            frame.Visible = true
            frame.BackgroundTransparency = 0
            if Mouse then
                frame.Position = UDim2.fromOffset(Mouse.X + 12, Mouse.Y + 18)
            else
                frame.Position = UDim2.fromOffset(inst.AbsolutePosition.X, inst.AbsolutePosition.Y + 26)
            end
        end)
    end)
    inst.MouseLeave:Connect(function()
        token = token + 1
        local frame = tooltipFrame
        if frame then
            frame.Visible = false
        end
    end)
end

--//----------------------------------------------------------------------------
--// 8.4 水印（FPS / Ping / 时间）
--//----------------------------------------------------------------------------

function WobsinsUI:Watermark(config)
    config = config or {}
    local screen = self:_screen()
    local theme = themeOf(nil)

    local frame = new("Frame", {
        Name = "WobsinsWatermark",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.25,
        Size = UDim2.new(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        Position = config.Position or UDim2.fromOffset(12, 12),
        ZIndex = self.Layers.Watermark,
    }, screen)
    U.corner(frame, 4)
    U.stroke(frame, theme.Outline, 1, 0.3)
    U.padding(frame, 8, 0, 8, 0)

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Code,
        Text = config.Title or "WobsinsUI",
        TextColor3 = theme.SubText,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = self.Layers.Watermark + 1,
    }, frame)

    local statService = service("Stats")
    local running = true

    local function tick()
        if not running or not frame.Parent then
            return
        end
        local fps = 0
        local ping = 0
        pcall(function()
            fps = math.floor(1 / math.max(S.RunService.RenderStepped:Wait(), 1e-3))
        end)
        pcall(function()
            if statService then
                ping = math.floor(statService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end
        end)
        local clock = os.date("%H:%M:%S")
        label.Text = string.format("%s   %d fps   %d ms   %s", config.Title or "WobsinsUI", fps, ping, clock)
    end

    U.spawn(function()
        while running and frame.Parent do
            tick()
            U.wait(1)
        end
    end)

    local watermark = {
        Frame = frame,
        SetVisible = function(_, state)
            frame.Visible = state and true or false
        end,
        Destroy = function()
            running = false
            frame:Destroy()
        end,
    }
    return watermark
end

