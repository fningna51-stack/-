            Size = UDim2.new(1, 0, 0, 0),
            Font = Enum.Font.Gotham,
            Text = config.Content,
            TextColor3 = t.SubText,
            TextSize = 10.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2,
            ZIndex = 83,
        }, body)
    end

    if config.Background and config.Background ~= "" then
        local bgImage = new("ImageLabel", {
            BackgroundTransparency = 1,
            Image = config.Background,
            Size = UDim2.fromScale(1, 1),
            ImageTransparency = 0.75,
            ScaleType = Enum.ScaleType.Crop,
            ZIndex = 80,
        }, toast)
        corner(bgImage, 5)
    end

    local progress = nil
    if duration > 0 then
        progress = new("Frame", {
            Size = UDim2.new(1, 0, 0, 2),
            Position = UDim2.new(0, 0, 1, -2),
            BackgroundColor3 = t.Accent,
            BorderSizePixel = 0,
            ZIndex = 84,
        }, toast)
    end

    if config.Window then
        config.Window:_onTheme(function()
            local nt = themeOf(config.Window)
            toast.BackgroundColor3 = nt.Surface
            tStroke.Color = nt.Outline
            trim.BackgroundColor3 = nt.Accent
            title.TextColor3 = nt.Text
            if contentLabel then
                contentLabel.TextColor3 = nt.SubText
            end
        end)
    end

    -- entrance
    toast.BackgroundTransparency = 1
    for _, child in ipairs(toast:GetDescendants()) do
        if child:IsA("TextLabel") then
            child.TextTransparency = 1
        end
    end
    task.spawn(function()
        tween(toast, 0.26, { BackgroundTransparency = 0.02 }, Enum.EasingStyle.Quint)
        for _, child in ipairs(toast:GetDescendants()) do
            if child:IsA("TextLabel") then
                tween(child, 0.2, { TextTransparency = 0 })
            end
        end
    end)

    local closed = false
    local function close()
        if closed then
            return
        end
        closed = true
        tween(toast, 0.22, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        for _, child in ipairs(toast:GetDescendants()) do
            if child:IsA("TextLabel") then
                tween(child, 0.18, { TextTransparency = 1 })
            elseif child:IsA("ImageLabel") then
                tween(child, 0.18, { ImageTransparency = 1 })
            end
        end
        task.delay(0.24, function()
            if toast and toast.Parent then
                toast:Destroy()
            end
        end)
    end

    signal(toast, "InputBegan", function(_, input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            close()
        end
    end)

    if progress and duration > 0 then
        progress.Size = UDim2.new(1, 0, 0, 2)
        tween(progress, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    end

    if duration > 0 then
        task.delay(duration, close)
    end

    return { Close = close, Frame = toast }
end

