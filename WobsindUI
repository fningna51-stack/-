local NotifyCenter = {}
NotifyCenter.__index = NotifyCenter

local function relativeTime(stamp)
    local now = os.time()
    local delta = math.max(0, now - (stamp or now))
    if delta < 60 then
        return "刚刚"
    elseif delta < 3600 then
        return string.format("%d 分钟前", math.floor(delta / 60))
    elseif delta < 86400 then
        return string.format("%d 小时前", math.floor(delta / 3600))
    end
    return string.format("%d 天前", math.floor(delta / 86400))
end

