-- 同一个执行器里重复执行脚本时复用已有实例，避免出现两个 ScreenGui 叠在一起。
-- 但如果拿到的是旧构建（比如上次跑的是坏掉的版本），先把旧界面清掉再重建，
-- 否则会出现“重新执行了还是空白的”这种情况。
local genv = (getgenv and getgenv()) or _G
if genv.__WobsinsUIV2 then
    local existing = genv.__WobsinsUIV2
    local sameBuild = existing.Build == WobsinsUI.Build and existing.Version == WobsinsUI.Version
    if sameBuild then
        return existing
    end
    pcall(function()
        if existing.DestroyAll then
            existing:DestroyAll()
        end
    end)
    pcall(function()
        if existing.ScreenGui then
            existing.ScreenGui:Destroy()
        end
    end)
end
genv.__WobsinsUIV2 = WobsinsUI

