--// Shared screen + layers ----------------------------------------------------
function WobsinsUI:_screen()
    if self._screenGui and self._screenGui.Parent then
        return self._screenGui
    end

    local parent = CoreGui
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then
            parent = hui
        end
    end

    local screen = new("ScreenGui", {
        Name = "WobsinsUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 9999,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
    }, parent)

    if protectgui then
        pcall(protectgui, screen)
    end

    self._screenGui = screen

    self._notifyLayer = new("Frame", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 340, 1, -24),
        Position = UDim2.new(1, -16, 0, 12),
        AnchorPoint = Vector2.new(1, 0),
        ZIndex = 80,
    }, screen)
    list(self._notifyLayer, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right)

    self._overlayLayer = new("Frame", {
        Name = "Overlays",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 60,
    }, screen)

    return screen
end

local function themeOf(win)
    if win and win.ThemeTable then
        return win.ThemeTable
    end
    return Themes[WobsinsUI.CurrentTheme] or Themes.Dark
end

--// Buttons ------------------------------------------------------------------
-- cfg: Title, Icon, Desc, Variant (Primary|Secondary|Tertiary), Height, Callback,
--      Locked, Full, Width, Radius, Align
local function makeButton(parent, cfg, win)
    local t = themeOf(win)
    local variant = cfg.Variant or "Secondary"
    local height = cfg.Height or 26
    local radius = cfg.Radius or 4
    local locked = cfg.Locked and true or false

    local btn = new("TextButton", {
        Name = "Button",
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(cfg.Width and 0 or 1, cfg.Width or 0, 0, height),
        ClipsDescendants = false,
        ZIndex = 2,
    }, parent)
    corner(btn, radius)

    local bg = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = t.SurfaceAlt,
        BackgroundTransparency = 1,
        ZIndex = 1,
    }, btn)
    corner(bg, radius)

    local strokeObj = stroke(bg, t.Outline, 1, 0.35)

    -- both variants are flat fills; Primary simply sits one step lighter
    if variant == "Primary" then
        bg.BackgroundTransparency = 0
        bg.BackgroundColor3 = t.SurfaceAlt
    elseif variant == "Secondary" then
        bg.BackgroundTransparency = 0
        bg.BackgroundColor3 = t.Background
    else
        bg.BackgroundTransparency = 1
    end

    local textColor = (variant == "Tertiary") and t.SubText or t.Text
    if locked then
        textColor = t.Placeholder
    end

    local content = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 3,
    }, btn)
    local row = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = cfg.Align or Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, content)
    padding(content, 0, 10, 0, 10)

    local iconObj = nil
    if cfg.Icon and cfg.Icon ~= "" then
        iconObj = createIcon(content, cfg.Icon, 15, textColor)
        if iconObj then
            iconObj.LayoutOrder = 1
            iconObj.ZIndex = 4
        end
    end

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, height),
        Font = Enum.Font.GothamMedium,
        Text = cfg.Title or "按钮",
        TextColor3 = textColor,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 2,
        ZIndex = 4,
    }, content)

    if locked then
        local lockIcon = createIcon(content, "lock", 12, t.Placeholder)
        if lockIcon then
            lockIcon.LayoutOrder = 3
            lockIcon.ZIndex = 4
        end
    end

    local overlay = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        ZIndex = 4,
    }, btn)
    corner(overlay, radius)

    local api = {
        Frame = btn,
        Title = cfg.Title,
        Locked = locked,
    }

    function api:SetTitle(text)
        api.Title = text
        titleLabel.Text = text
    end

    function api:Destroy()
        btn:Destroy()
    end

    if not locked then
        signal(btn, "MouseEnter", function()
            if variant == "Tertiary" then
                tween(bg, 0.14, { BackgroundTransparency = 0.94 })
            end
            tween(overlay, 0.14, { BackgroundTransparency = 0.94 })
            tween(titleLabel, 0.14, { TextColor3 = themeOf(win).Text })
        end)
        signal(btn, "MouseLeave", function()
            tween(bg, 0.16, { BackgroundTransparency = (variant == "Tertiary") and 1 or 0 })
            tween(overlay, 0.16, { BackgroundTransparency = 1 })
            tween(titleLabel, 0.16, { TextColor3 = themeOf(win).SubText })
        end)
        signal(btn, "MouseButton1Down", function()
            tween(overlay, 0.08, { BackgroundTransparency = 0.82 })
        end)
        signal(btn, "MouseButton1Up", function()
            tween(overlay, 0.14, { BackgroundTransparency = 0.92 })
        end)
        signal(btn, "Activated", function()
            if cfg.Callback then
                local ok, err = pcall(cfg.Callback)
                if not ok then
                    warn("[WobsinsUI] button callback error: " .. tostring(err))
                end
            end
        end)
    else
        strokeObj.Transparency = 0.7
    end

    if win and win._onTheme then
        win:_onTheme(function()
            local nt = themeOf(win)
            bg.BackgroundColor3 = (variant == "Primary") and nt.SurfaceAlt or nt.Background
            strokeObj.Color = nt.Outline
            titleLabel.TextColor3 = locked and nt.Placeholder or ((variant == "Tertiary") and nt.SubText or nt.Text)
            overlay.BackgroundColor3 = (nt.Mode == "Light") and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
        end)
    end

    return api
end

