function Tab:Card(config)
    config = config or {}

    local win = self.Window
    local parent = self:_targetColumn(config.Column)

    local card = setmetatable({
        Window = win,
        Tab = self,
        Title = config.Title or "",
        Icon = config.Icon,
        Opened = config.Opened ~= false,
        Elements = {},
        Column = config.Column or 0,
        Index = self._cardCount + 1,
    }, Card)
    self._cardCount = self._cardCount + 1

    local frame = new("Frame", {
        BackgroundColor3 = win:Color("Surface"),
        BackgroundTransparency = win:_cardAlpha(),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = card.Index,
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Card,
    }, parent)
    card.Frame = frame
    win:_bind(frame, "BackgroundColor3", "Surface")

    U.corner(frame, math.min(win.Radius or 6, 10))
    local cardStroke = U.stroke(frame, win:Color("Outline"), 1, win.Glass and 0.4 or 0.55)
    card.Stroke = cardStroke

    win:_onTheme(function()
        card.Frame.BackgroundColor3 = win:Color("Surface")
        card.Frame.BackgroundTransparency = win:_cardAlpha()
        cardStroke.Transparency = win.Glass and 0.4 or 0.55
    end)

    -- 登记到窗口，换背景图 / 调蒙版时统一刷透明度
    win._cards = win._cards or {}
    table.insert(win._cards, card)

    -- 卡片头
    local bodyTop = 0
    if card.Title ~= "" then
        local head = new("TextButton", {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Text = "",
            Size = UDim2.new(1, 0, 0, 34),
            ZIndex = WobsinsUI.Layers.Card + 1,
        }, frame)
        card.Head = head

        local titleX = 8
        if card.Icon then
            local icon = U.icon(head, card.Icon, 13, win:Color("SubText"), WobsinsUI.Layers.Card + 2)
            if icon then
                icon.Position = UDim2.fromOffset(10, 11)
            end
            card.HeadIcon = icon
            titleX = 27
        end

        local title = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(titleX, 0),
            Size = UDim2.new(1, -titleX - 30, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = card.Title,
            TextColor3 = win:Color("Text"),
            TextSize = 12.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = WobsinsUI.Layers.Card + 2,
        }, head)
        card.TitleLabel = title
        win:_bind(title, "TextColor3", "Text")

        local chevron = U.icon(head, "chevronDown", 12, win:Color("Muted"), WobsinsUI.Layers.Card + 2)
        if chevron then
            chevron.AnchorPoint = Vector2.new(0.5, 0.5)
            chevron.Position = UDim2.new(1, -14, 0.5, 0)
        end
        card.Chevron = chevron

        head.Activated:Connect(function()
            card:SetOpened(not card.Opened)
        end)

        U.hover(head, function()
            U.tween(title, 0.12, { TextColor3 = win:Color("SubText") })
        end, function()
            U.tween(title, 0.12, { TextColor3 = win:Color("Text") })
        end)

        bodyTop = 34
    end

    -- 卡片内容
    local body = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromOffset(0, bodyTop),
        ZIndex = WobsinsUI.Layers.Card + 1,
    }, frame)
    card.Body = body

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, body)

    U.padding(body, 8, card.Title ~= "" and 2 or 8, 8, 8)

    function card:SetOpened(state)
        self.Opened = state and true or false
        self.Body.Visible = self.Opened
        if self.Chevron then
            U.tween(self.Chevron, 0.16, { Rotation = self.Opened and 0 or -90 })
        end
    end

    if card.Opened == false then
        card:SetOpened(false)
    end

    if self.EmptyHint then
        self.EmptyHint.Visible = false
    end

    table.insert(self.Cards, card)
    return card
end

--//----------------------------------------------------------------------------
--// 11.1 行布局
--//----------------------------------------------------------------------------
--
-- 结构：
--   row  (自动高度, 纵向 list)
--     top (自动高度)
--       labelCol (标题 + 描述, 自动高度)
--       control  (右侧控件, 垂直居中)
--     extra (轨道 / 输入框 / 展开面板, 可选)
--
-- 这样标题换行、描述多行都不会和右侧控件打架。

function I.row(card, config, controlWidth)
    local win = card.Window
    local body = card.Body

    local row = new("Frame", {
        BackgroundColor3 = win:Color("Surface"),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #card.Elements + 1,
        ZIndex = WobsinsUI.Layers.Row,
    }, body)
    U.corner(row, 4)
    U.padding(row, 8, 6, 8, 6)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local top = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)

    local labelWidth = (controlWidth and controlWidth > 0) and -(controlWidth + 8) or 0
    local labelCol = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, labelWidth, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, top)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 1),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, labelCol)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        Font = Enum.Font.Gotham,
        Text = config.Title or "选项",
        TextColor3 = win:Color("Text"),
        TextSize = 12.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, labelCol)
    win:_bind(title, "TextColor3", "Text")

    local desc = nil
    if config.Desc and config.Desc ~= "" then
        desc = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = config.Desc,
            TextColor3 = win:Color("SubText"),
            TextSize = 10.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, labelCol)
        win:_bind(desc, "TextColor3", "SubText")
    end

    local control = nil
    if controlWidth and controlWidth > 0 then
        control = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(controlWidth, 16),
            Position = UDim2.new(1, 0, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, top)
    end

    U.hover(row, function()
        if not config.NoHover then
            U.tween(row, 0.12, { BackgroundTransparency = 0.94 })
        end
    end, function()
        U.tween(row, 0.12, { BackgroundTransparency = 1 })
    end)

    return row, top, title, desc, control
end

-- 同时支持 el.SetValue(v) 与 el:SetValue(v)
function I.arg(a, b)
    if b ~= nil then
        return b
    end
    return a
end

function I.setter(element, fn)
    element.SetValue = function(a, b)
        fn(I.arg(a, b))
    end
end

-- 元素通用字段
function I.finish(card, element, config)
    local win = card.Window
    element.Window = win
    element.Card = card
    element.Tab = card.Tab
    element.Type = element.Type or "Element"
    element.Title = config.Title
    element._search = table.concat({
        tostring(config.Title or ""),
        tostring(config.Desc or ""),
        tostring(config.Search or ""),
    }, " ")

    local function applyVisible(value)
        if element.Frame then
            element.Frame.Visible = value and true or false
        end
    end

    function element:SetVisible(value)
        applyVisible(value)
    end
    element.SetVisible = element.SetVisible or function(self_, value)
        applyVisible(value)
    end

    function element:Set(value)
        if self.SetValue then
            self.SetValue(value)
        end
    end

    function element.Lock(_, state)
        element.Locked = state ~= false
        if element.Frame then
            element.Frame.Active = not element.Locked
        end
    end

    function element:Destroy()
        if element.Frame then
            element.Frame:Destroy()
        end
    end

    table.insert(card.Elements, element)
    table.insert(card.Tab.Elements, element)

    return element
end

