        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Font = Enum.Font.Gotham,
        Text = config.Content or "",
        TextColor3 = t.SubText,
        TextSize = 12.5,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 1,
        ZIndex = 64,
    }, contentHolder)

    local api = {
        Frame = card,
        Backdrop = backdrop,
        ContentHolder = contentHolder,
        Close = nil,
        SetContent = function(text)
            contentLabel.Text = text
        end,
    }

    local closed = false
    local close
    function close()
        if closed then
            return
        end
        closed = true
        tween(cardScale, 0.16, { Scale = 0.94 })
        tween(backdrop, 0.18, { BackgroundTransparency = 1 })
        for _, child in ipairs(card:GetDescendants()) do
            if child:IsA("TextLabel") then
                tween(child, 0.14, { TextTransparency = 1 })
            elseif child:IsA("ImageLabel") then
                tween(child, 0.14, { ImageTransparency = 1 })
            elseif child:IsA("Frame") then
                if child.BackgroundTransparency and child.BackgroundTransparency < 1 then
                    tween(child, 0.14, { BackgroundTransparency = 1 })
                end
            elseif child:IsA("UIStroke") then
                tween(child, 0.14, { Transparency = 1 })
            end
        end
        task.delay(0.22, function()
            if backdrop.Parent then
                backdrop:Destroy()
            end
            if config.OnClose then
                task.spawn(config.OnClose)
            end
        end)
    end
    api.Close = close

    if config.Buttons and #config.Buttons > 0 then
        local btnRow = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 36),
            LayoutOrder = 3,
            ZIndex = 63,
        }, holder)
        local rowLayout = new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, btnRow)

        for index, btnCfg in ipairs(config.Buttons) do
            local holderBtn = new("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1 / #config.Buttons, -((#config.Buttons - 1) * 8) / #config.Buttons, 0, 36),
                LayoutOrder = index,
                ZIndex = 63,
            }, btnRow)
            local b = makeButton(holderBtn, {
                Title = btnCfg.Title,
                Icon = btnCfg.Icon,
                Variant = btnCfg.Variant,
                Height = 36,
                Callback = function()
                    if btnCfg.Callback then
                        task.spawn(btnCfg.Callback)
                    end
                    if btnCfg.KeepOpen ~= true then
                        close()
                    end
                end,
            }, win)
            b.Frame.Size = UDim2.fromScale(1, 1)
        end
    else
        holder.Size = UDim2.new(1, 0, 0, 0)
    end

    if config.Dismissable ~= false then
        signal(backdrop, "InputBegan", function(_, input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                close()
            end
        end)
    end

    -- entrance
    tween(backdrop, 0.2, { BackgroundTransparency = 0.45 })
    tween(card, 0.2, { BackgroundTransparency = 0.02 })
    tween(cardScale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)

    if win and win._onTheme then
        win:_onTheme(function()
            local nt = themeOf(win)
            card.BackgroundColor3 = nt.Surface
            cardStroke.Color = nt.Outline
            trim.BackgroundColor3 = nt.Outline
            title.TextColor3 = nt.Text
            subtitle.TextColor3 = nt.SubText
            contentLabel.TextColor3 = nt.SubText
        end)
    end

    return api
end

