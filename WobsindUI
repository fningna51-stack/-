Tab.__index = Tab
WobsinsUI.Tab = Tab

local function tabIcon(tab, active)
    local win = tab.Window
    local t = win.ThemeTable
    local icon = tab.Parts.Icon
    if not icon then
        return
    end
    local color = active and t.Accent or t.Placeholder
    if icon:IsA("TextLabel") then
        icon.TextColor3 = color
    else
        icon.ImageColor3 = color
    end
end

function Tab:_styleButton(active)
    local win = self.Window
    local t = win.ThemeTable
    local parts = self.Parts
    if not parts then
        return
    end
    self.Active = active
    tween(parts.Bg, 0.14, {
        BackgroundTransparency = active and 0 or 1,
        BackgroundColor3 = t.SurfaceAlt,
    })
    tween(parts.Bar, 0.18, {
        BackgroundTransparency = active and 0 or 1,
        BackgroundColor3 = t.Accent,
    })
    tween(parts.Label, 0.16, { TextColor3 = active and t.Text or t.SubText })
    tabIcon(self, active)
end

function Tab:_setActive(active)
    self:_styleButton(active)
    if not self.Page then
        return
    end
    if active then
        self.Page.Visible = true
        self.Page.Position = UDim2.fromOffset(0, 6)
        tween(self.Page, 0.2, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
    else
        self.Page.Visible = false
    end
end

function Tab:_updateCount()
    if self.CountLabel then
        local total = #self.Elements
        self.CountLabel.Text = tostring(total) .. " 项"
    end
end

function Tab:_layoutColumns()
    if not self.Col1 then
        return
    end
    local hasSecond = self.Col2 and countFrames(self.Col2) > 0
    if hasSecond then
        self.Col1.Size = UDim2.new(0.5, -4, 0, 0)
        self.Col1.Position = UDim2.fromOffset(0, 0)
        self.Col2.Visible = true
        self.Col2.Size = UDim2.new(0.5, -4, 0, 0)
        self.Col2.Position = UDim2.new(0.5, 4, 0, 0)
    else
        self.Col1.Size = UDim2.new(1, 0, 0, 0)
        self.Col1.Position = UDim2.fromOffset(0, 0)
        if self.Col2 then
            self.Col2.Visible = false
        end
    end
end

function Tab:_column(index)
    if index == 2 then
        if not self.Col2 then
            self.Col2 = new("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0.5, -4, 0, 0),
                Position = UDim2.new(0.5, 4, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 4,
            }, self.Scroll)
            list(self.Col2, Enum.FillDirection.Vertical, 6)
        end
        self:_layoutColumns()
        return self.Col2
    end
    self:_layoutColumns()
    return self.Col1
end

function Tab:_implicitCard()
    if self._implicit then
        return self._implicit
    end
    local card = self:Card({ _implicit = true })
    self._implicit = card
    return card
end

function Tab:_filter(query)
    local total = 0
    for _, card in ipairs(self.Cards) do
        local cardMatch = query ~= "" and card.Title ~= nil and matches(card.Title, query)
        local any = false
        for _, element in ipairs(card.Elements) do
            local ok = (query == "") or cardMatch or matches(element._search, query)
            element:SetVisible(ok)
            if ok then
                any = true
                total = total + 1
            end
        end
        if query == "" then
            card.Frame.Visible = true
        else
            card.Frame.Visible = any
        end
    end
    self.MatchCount = total
    self:_layoutColumns()
    return total
end

function Tab:_updateEmptyState()
    if self.Empty then
        self.Empty.Visible = (self.Window.SearchQuery or "") ~= "" and (self.MatchCount or 0) == 0
    end
end

function Tab:Select()
    self.Window:SelectTab(self.Index)
    return self
end

function Tab:Card(config)
    config = config or {}
    local win = self.Window
    local column = config.Column
    if not column then
        if win.Config.Layout == "Double" then
            self._lastColumn = (self._lastColumn == 1) and 2 or 1
            column = self._lastColumn
        else
            column = 1
        end
    end

    local parent = self:_column(column)
    local card = setmetatable({
        Window = win,
        Tab = self,
        Title = config.Title,
        Column = column,
        Elements = {},
        _order = 0,
        Opened = config.Opened ~= false,
    }, Card)

    self._cardCount = (self._cardCount or 0) + 1

    card.Frame = new("Frame", {
        Name = "Card",
        BackgroundColor3 = win:Color("SurfaceAlt"),
        BackgroundTransparency = config.Transparent or 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self._cardCount,
        ClipsDescendants = true,
        ZIndex = 3,
    }, parent)
    corner(card.Frame, win.Radius <= 6 and win.Radius or 10)
    local cardStroke = stroke(card.Frame, win:Color("Outline"), 1, 0.35)
    if card.Title and card.Title ~= "" then
        padding(card.Frame, 3, 4, 3, 4)
    else
        padding(card.Frame, 2, 2, 2, 2)
    end
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, card.Frame)

    -- header
    local chevron
    if card.Title and card.Title ~= "" then
        local head = new("TextButton", {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Text = "",
            Size = UDim2.new(1, 0, 0, 30),
            LayoutOrder = 0,
            ZIndex = 5,
        }, card.Frame)

        local headIcon
        if config.Icon then
            headIcon = createIcon(head, config.Icon, 13, win:Color("SubText"))
            if headIcon then
                headIcon.Position = UDim2.fromOffset(4, 0)
                headIcon.Size = UDim2.fromOffset(13, 30)
                headIcon.ZIndex = 6
            end
        end

        local titleX = config.Icon and 23 or 5
        local titleLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(titleX, 0),
            Size = UDim2.new(1, -titleX - 22, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = card.Title,
            TextColor3 = win:Color("Text"),
            TextSize = 11.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 6,
        }, head)

        chevron = createIcon(head, "chevron-down", 12, win:Color("SubText"))
        if chevron then
            chevron.AnchorPoint = Vector2.new(1, 0.5)
            chevron.Position = UDim2.new(1, -5, 0.5, 0)
            chevron.ZIndex = 6
        end

        card.Head = head
        card.HeadLabel = titleLabel

        head.Activated:Connect(function()
            card:SetOpened(not card.Opened)
        end)

        win:_onTheme(function()
            titleLabel.TextColor3 = win:Color("Text")
        end)
    else
        card.Frame.BackgroundTransparency = config.Transparent or 0.55
    end

    win:_onTheme(function()
        card.Frame.BackgroundColor3 = win:Color("SurfaceAlt")
        cardStroke.Color = win:Color("Outline")
    end)

    card.Body = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        ZIndex = 4,
    }, card.Frame)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, card.Body)

    card.Chevron = chevron

    function card:SetOpened(state)
        self.Opened = state and true or false
        self.Body.Visible = self.Opened
        if self.Chevron then
            tween(self.Chevron, 0.2, { Rotation = self.Opened and 0 or -90 })
        end
    end

    function card:_nextOrder()
        self._order = self._order + 1
        return self._order
    end

    function card:_register(element)
        table.insert(self.Elements, element)
        table.insert(self.Tab.Elements, element)
        self.Tab:_updateCount()
        self.Tab:_layoutColumns()
        if self.Tab.Window.SearchQuery and self.Tab.Window.SearchQuery ~= "" then
            self.Tab.Window:_filter(self.Tab.Window.SearchQuery)
        end
        return element
    end

    table.insert(self.Cards, card)

    if card.Opened == false then
        card:SetOpened(false)
    end

    return card
end

