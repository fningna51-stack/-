        TextSize = 11.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 6,
    }, btn)

    tab.Parts = { Bg = btn, Bar = bar, Icon = iconObj, Label = label }
    tab.ButtonFrame = btn

    if tab.Locked then
        local lockIcon = createIcon(btn, "lock", 11, self:Color("Placeholder"))
        if lockIcon then
            lockIcon.AnchorPoint = Vector2.new(1, 0.5)
            lockIcon.Position = UDim2.new(1, -10, 0.5, 0)
            lockIcon.ZIndex = 7
        end
    end

    btn.MouseEnter:Connect(function()
        if not tab.Active then
            tween(btn, 0.15, { BackgroundTransparency = 0.94 })
        end
    end)
    btn.MouseLeave:Connect(function()
        if not tab.Active then
            tween(btn, 0.15, { BackgroundTransparency = 1 })
        end
    end)
    btn.Activated:Connect(function()
        if tab.Locked then
            WobsinsUI:Notify({
                Title = "已锁定",
                Content = "该分类当前不可用。",
                Icon = "lock",
                Duration = 3,
                Window = self,
            })
            return
        end
        self:SelectTab(tab.Index)
    end)

    tab:_styleButton(false)

    if not self.ActiveTab then
        self:SelectTab(tab.Index)
    end

    return tab
end

function Window:_styleTabParts(tab)
    if not tab.Parts then
        return
    end
    local active = tab.Active
    tab.Parts.Bg.BackgroundColor3 = self:Color("SurfaceAlt")
    tab.Parts.Bar.BackgroundColor3 = self:Color("Accent")
    tab.Parts.Label.TextColor3 = active and self:Color("Text") or self:Color("SubText")
    if tab.Parts.Icon then
        if tab.Parts.Icon:IsA("TextLabel") then
            tab.Parts.Icon.TextColor3 = active and self:Color("Accent") or self:Color("Placeholder")
        else
            tab.Parts.Icon.ImageColor3 = active and self:Color("Accent") or self:Color("Placeholder")
        end
    end
end

function Window:Tab(config)
    return self:_createTab(config, nil)
end

function Section:Tab(config)
    return self.Window:_createTab(config, self)
end

