--//----------------------------------------------------------------------------
--// 18.1 Checkbox
--//----------------------------------------------------------------------------

function Build.Checkbox(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local state = config.Value == true

    local row, top, title, desc, control = I.row(card, config, 20)

    local box = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    U.corner(box, 4)
    local boxStroke = U.stroke(box, theme.Outline, 1, 0.5)
    win:_bind(box, "BackgroundColor3", "BackgroundAlt")

    local tick = U.icon(box, "check", 10, theme.OnAccent, WobsinsUI.Layers.RowItem + 3)
    if tick then
        tick.AnchorPoint = Vector2.new(0.5, 0.5)
        tick.Position = UDim2.fromScale(0.5, 0.5)
        tick.Visible = state
    end

    local element = {
        Type = "Checkbox",
        Frame = row,
        Value = state,
        Callback = config.Callback,
    }

    local function render(animate, silent)
        if tick then
            tick.Visible = state
        end
        if animate then
            U.tween(box, 0.14, { BackgroundColor3 = state and win:Color("Accent") or win:Color("BackgroundAlt") })
            U.tween(boxStroke, 0.14, { Transparency = state and 1 or 0.5 })
        else
            box.BackgroundColor3 = state and win:Color("Accent") or win:Color("BackgroundAlt")
            boxStroke.Transparency = state and 1 or 0.5
        end
        if silent ~= true and config.Callback then
            safeCall(config.Callback, state)
        end
    end

    function element.GetValue()
        return state
    end

    I.setter(element, function(value)
        state = value == true
        element.Value = state
        render(true)
    end)

    function element.SetSilent(a, b)
        state = I.arg(a, b) == true
        element.Value = state
        render(true, true)
    end

    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if element.Locked then
                return
            end
            state = not state
            element.Value = state
            render(true)
        end
    end)

    win:_onTheme(function()
        render(false, true)
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    return I.finish(card, element, config)
end

--//----------------------------------------------------------------------------
--// 18.2 Radio（单选组）
--//----------------------------------------------------------------------------
--
-- config.Options = { "A", "B", "C" }
-- config.Value   = 默认选中项

function Build.Radio(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local options = config.Options or config.Values or {}
    local selected = config.Value

    local row, top, title, desc, control = I.row(card, config, 0)

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    local element = {
        Type = "Radio",
        Frame = row,
        Value = selected,
        Callback = config.Callback,
    }

    local items = {}

    local function paint()
        for _, item in ipairs(items) do
            local active = item.Value == selected
            item.Dot.Visible = active
            item.Ring.BackgroundColor3 = active and theme.Accent or theme.BackgroundAlt
            item.Ring.BackgroundTransparency = active and 0 or 0.2
            item.Label.TextColor3 = active and theme.Text or theme.SubText
        end
    end

    for index, option in ipairs(options) do
        local optionRow = new("TextButton", {
            BackgroundColor3 = theme.SurfaceAlt,
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Size = UDim2.new(1, 0, 0, 26),
            Text = "",
            LayoutOrder = index,
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, holder)
        U.corner(optionRow, 4)

        local ring = new("Frame", {
            BackgroundColor3 = theme.BackgroundAlt,
            Size = UDim2.fromOffset(14, 14),
            Position = UDim2.fromOffset(8, 6),
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, optionRow)
        U.corner(ring, 7)
        U.stroke(ring, theme.Outline, 1, 0.4)

        local dot = new("Frame", {
            BackgroundColor3 = theme.OnAccent,
            Size = UDim2.fromOffset(6, 6),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Visible = false,
            ZIndex = WobsinsUI.Layers.RowItem + 3,
        }, ring)
        U.corner(dot, 3)

        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(30, 0),
            Size = UDim2.new(1, -38, 1, 0),
            Font = Enum.Font.Gotham,
            Text = tostring(option),
            TextColor3 = theme.SubText,
            TextSize = 10.5,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, optionRow)

        table.insert(items, { Value = tostring(option), Dot = dot, Ring = ring, Label = label })

        U.hover(optionRow, function()
            U.tween(optionRow, 0.1, { BackgroundTransparency = 0.94 })
        end, function()
            U.tween(optionRow, 0.1, { BackgroundTransparency = 1 })
        end)

        optionRow.Activated:Connect(function()
            if element.Locked then
                return
            end
            selected = tostring(option)
            element.Value = selected
            paint()
            if config.Callback then
                safeCall(config.Callback, selected)
            end
        end)
    end

    paint()

    function element.GetValue()
        return selected
    end

    I.setter(element, function(value)
        selected = tostring(value)
        element.Value = selected
        paint()
    end)

    win:_onTheme(paint)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    return I.finish(card, element, config)
end

