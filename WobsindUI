function Window:_applyTransparency()
    if not self.Main then
        return
    end
    -- 底色透明度以主题的 Alpha 为基准；Transparent=true 时再透一点
    local base = self:_baseAlpha()
    local target = base
    if self.Transparency then
        target = math.min(0.94, base + (self.Glass and 0.1 or 0.16))
    end
    U.tween(self.Main, 0.2, { BackgroundTransparency = target })

    -- 侧栏本来就是透明的，别在这里把它刷成实心白块
    if self.Sidebar then
        U.tween(self.Sidebar, 0.2, { BackgroundTransparency = 1 })
    end
end

function Window:ToggleTransparency(state)
    if state == nil then
        self.Transparency = not self.Transparency
    else
        self.Transparency = state and true or false
    end
    WobsinsUI.Transparency = self.Transparency
    self:_applyTransparency()
    return self.Transparency
end

function Window:SetTheme(name)
    if not Themes[name] then
        return
    end
    self.Theme = name
    self:_applyTheme(true)
    self:_applyTransparency()
end

function Window:SetScale(scale)
    if self.Scale and self.Scale:IsA("UIScale") then
        self.Scale.Scale = scale
    end
end

-- 重新计算窗口尺寸（屏幕旋转 / 设备变化时用）
function Window:Resize(width, height)
    local vp = WobsinsUI:_viewport()
    self.Width = math.max(360, math.min(width or self.Width, vp.X - 20))
    self.Height = math.max(300, math.min(height or self.Height, vp.Y - 20))
    if self.Stage then
        self.Stage.Size = UDim2.fromOffset(self.Width, self.Height)
    end
    if self.Sidebar then
        self.Sidebar.Size = UDim2.fromOffset(self.SidebarWidth, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self.Content then
        self.Content.Size = UDim2.new(1, -(self.SidebarWidth + 1), 0, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self._relayoutColumns then
        self:_relayoutColumns()
    end
    return self
end

