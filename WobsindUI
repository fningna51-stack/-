local SCREEN_GUI = nil

function WobsinsUI:_screen()
    if SCREEN_GUI and SCREEN_GUI.Parent then
        return SCREEN_GUI
    end

    local gui = new("ScreenGui", {
        Name = "WobsinsUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
    })

    -- CoreGui 里更稳，部分执行器禁止写入 PlayerGui 时退回去
    local ok = pcall(function()
        gui.Parent = cloneref(S.CoreGui)
    end)
    if not ok or not gui.Parent then
        local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            pcall(function()
                gui.Parent = playerGui
            end)
        end
    end

    SCREEN_GUI = gui
    WobsinsUI.ScreenGui = gui
    return gui
end

-- 可视区域尺寸
function WobsinsUI:_viewport()
    local camera = S.Workspace and S.Workspace.CurrentCamera
    if camera then
        local ok, size = pcall(function()
            return camera.ViewportSize
        end)
        if ok and size and size.X > 0 then
            return size
        end
    end
    return Vector2.new(1280, 720)
end

