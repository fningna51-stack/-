function Window:_keySystem(cfg)
    cfg = cfg or {}
    local keys = cfg.Key or {}
    if type(keys) == "string" then
        keys = { keys }
    end

    local function valid(text)
        for _, key in ipairs(keys) do
            if tostring(key):lower() == tostring(text):lower() then
                return true
            end
        end
        return false
    end

    local savePath = self.Folder .. "/key.json"
    if cfg.SaveKey then
        local ok, data = pcall(function()
            if isfile and isfile(savePath) then
                return readfile(savePath)
            end
        end)
        if ok and data and data ~= "" and valid(data) then
            return
        end
    end

    self.Locked = true
    self.Visible = false
    if self.Main then
        self.Main.Visible = false
    end
    local modal

    local function unlock(text)
        if cfg.SaveKey then
            pcall(function()
                if makefolder and writefile then
                    if isfolder and not isfolder(self.Folder) then
                        makefolder(self.Folder)
                    end
                    writefile(savePath, text)
                end
            end)
        end
        self.Locked = false
        if modal then
            modal.Close()
        end
        self:_show(true)
        WobsinsUI:Notify({
            Title = "验证成功",
            Content = "欢迎使用 " .. self.Title,
            Icon = "check",
            Duration = 3,
            Window = self,
        })
    end

    modal = WobsinsUI:_modal({
        Window = self,
        Title = cfg.Title or "密钥验证",
        Subtitle = "WobsinsUI · Key System",
        Content = cfg.Note or "请输入密钥以继续。",
        Icon = "lock",
        Width = 400,
        Dismissable = false,
    })

    local boxHolder = new("Frame", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        BackgroundTransparency = 0.2,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = 2,
        ZIndex = 64,
    }, modal.ContentHolder)
    corner(boxHolder, 9)
