function WobsinsUI:CreateWindow(config)
    config = config or {}
    self:_screen()

    local themeName = config.Theme or self.CurrentTheme
    if not Themes[themeName] then
        themeName = "Dark"
    end

    local vp = viewport()
    local w, h
    if typeof(config.Size) == "UDim2" then
        w = config.Size.X.Offset > 0 and config.Size.X.Offset or 860
        h = config.Size.Y.Offset > 0 and config.Size.Y.Offset or 540
    else
        if vp.X < 780 then
            w = math.floor(vp.X - 20)
            h = math.floor(vp.Y - 20)
        else
            w = 860
            h = 540
        end
    end

    local scaleValue = math.min(1, (vp.X - 12) / w, (vp.Y - 12) / h)
    scaleValue = math.max(scaleValue, 0.45)

    local win = setmetatable({
        Config = config,
        Title = config.Title or "WobsinsUI",
        Author = config.Author or "",
        Icon = config.Icon or "sparkles",
        Theme = themeName,
        ThemeTable = Themes[themeName],
        Bindings = {},
        ThemeHooks = {},
        Tabs = {},
        Sections = {},
        Elements = {},
        CloseCallbacks = {},
        Folder = config.Folder or "WobsinsUI",
        Transparency = config.Transparent ~= false,
        Glass = Themes[themeName].Glass == true,
        Radius = Themes[themeName].Radius or 5,
        HeaderHeight = 44,
        Visible = true,
        Locked = false,
        Minimized = false,
        Width = w,
        Height = h,
        ScaleValue = scaleValue,
        SidebarWidth = config.SideBarWidth or (w < 620 and 122 or (Themes[themeName].Glass and 132 or 150)),
        ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift,
        BackgroundImage = config.Background,
    }, Window)

    win:_buildMain(config)

    if config.OpenButton ~= false then
        win.OpenButton = createOpenButton(win, config.OpenButtonConfig or {})
        win.OpenButton.Frame.Visible = false
    end

    table.insert(self.Windows, win)

    if config.User and config.User.Enabled then
        -- already rendered inside sidebar
    end

    if config.KeySystem then
        win:_keySystem(config.KeySystem)
    end

    -- toggle key
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or win.Destroyed then
            return
        end
        if draggingGuard() then
            return
        end
        if input.KeyCode == win.ToggleKey and not win.Locked then
            win:_toggleWindow()
            if not win.Visible and win.OpenButton then
                win.OpenButton.Frame.Visible = true
            end
        end
    end)

    -- default tab
    task.defer(function()
        if #win.Tabs > 0 and not win.ActiveTab then
            win:SelectTab(1)
        end
    end)

    return win
end

