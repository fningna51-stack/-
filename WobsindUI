--// 10.3 搜索
--//----------------------------------------------------------------------------

function Window:_search(query)
    query = (query or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local tab = self.ActiveTab
    if not tab then
        return
    end
    tab:_filter(query)
end

function Tab:_filter(query)
    query = query or ""
    local lower = string.lower(query)
    local matched = 0

    for _, card in ipairs(self.Cards) do
        local cardMatch = false
        if query ~= "" and card.Title and card.Title ~= "" then
            cardMatch = string.find(string.lower(card.Title), lower, 1, true) ~= nil
        end

        local visibleInside = 0
        for _, element in ipairs(card.Elements) do
            local hit = (query == "") or cardMatch
            if not hit then
                local haystack = string.lower(tostring(element._search or ""))
                hit = string.find(haystack, lower, 1, true) ~= nil
            end
            element:SetVisible(hit)
            if hit then
                visibleInside = visibleInside + 1
            end
        end

        if #card.Elements == 0 then
            card.Frame.Visible = (query == "")
        else
            card.Frame.Visible = (query == "") or visibleInside > 0
        end
        matched = matched + visibleInside
    end

    self.MatchCount = matched
    self.Empty.Visible = (query ~= "") and matched == 0
    if query ~= "" then
        self.Empty.Text = string.format("没有找到 “%s”", query)
    end

    if self._refreshCanvas then
        self._refreshCanvas()
    end

    return matched
end

function Tab:SetSearch(text)
    if self.Window.SearchBox then
        self.Window.SearchBox.Text = text
    end
end

