-- 把 Frame 变成可点击区域（保持外观不变）
function U.clickable(inst)
    if inst:IsA("TextButton") or inst:IsA("ImageButton") then
        inst.AutoButtonColor = false
        inst.Text = ""
        return inst
    end
    return inst
end

-- 鼠标悬停：enter / leave 回调，内部做 0.12s 防抖过渡
function U.hover(inst, onEnter, onLeave)
    inst.MouseEnter:Connect(function()
        if onEnter then
            safeCall(onEnter)
        end
    end)
    inst.MouseLeave:Connect(function()
        if onLeave then
            safeCall(onLeave)
        end
    end)
end

-- 点击波纹：按钮按下时扩散一个圆
function U.ripple(inst, color)
    inst.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local dot = new("Frame", {
            BackgroundColor3 = color or Color3.new(1, 1, 1),
            BackgroundTransparency = 0.72,
            Size = UDim2.fromOffset(8, 8),
            Position = UDim2.new(0, input.Position.X - inst.AbsolutePosition.X, 0, input.Position.Y - inst.AbsolutePosition.Y),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = (inst.ZIndex or 1) + 1,
        }, inst)
        U.corner(dot, 99)
        local tw = U.tween(dot, 0.35, {
            Size = UDim2.fromOffset(math.max(inst.AbsoluteSize.X, inst.AbsoluteSize.Y) * 1.6, math.max(inst.AbsoluteSize.X, inst.AbsoluteSize.Y) * 1.6),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        U.delay(0.36, function()
            if dot then
                dot:Destroy()
            end
        end)
    end)
end

-- 滚动条：给 ScrollingFrame 配一根细滚动条（Roblox 原生滚动条在全平台表现不一致）
function U.scrollBar(scrollFrame, color)
    scrollFrame.ScrollBarThickness = 0
    scrollFrame.ScrollingDirection = Enum.ScrollingDirection.Y
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)

    local bar = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 4, 1, -8),
        Position = UDim2.new(1, -6, 0, 4),
        ZIndex = (scrollFrame.ZIndex or 1) + 2,
    }, scrollFrame.Parent and scrollFrame.Parent or scrollFrame)

    local thumb = new("Frame", {
        BackgroundColor3 = color or Color3.new(0.55, 0.55, 0.6),
        BackgroundTransparency = 0.55,
        Size = UDim2.new(1, 0, 0, 40),
        ZIndex = (scrollFrame.ZIndex or 1) + 3,
    }, bar)
    U.corner(thumb, 2)

    local function refresh()
        local canvas = scrollFrame.AbsoluteCanvasSize.Y
        local view = scrollFrame.AbsoluteSize.Y
        if canvas <= view + 1 then
            bar.Visible = false
            return
        end
        bar.Visible = true
        local ratio = view / canvas
        thumb.Size = UDim2.new(1, 0, ratio, 0)
        local maxScroll = math.max(canvas - view, 1)
        thumb.Position = UDim2.new(0, 0, (scrollFrame.CanvasPosition.Y / maxScroll) * (1 - ratio), 0)
    end

    scrollFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(refresh)
    scrollFrame:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(refresh)
    scrollFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
    refresh()

    return bar, refresh
end

