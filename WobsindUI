--//----------------------------------------------------------------------------

function Window:_applyTransparency()
    if not self.Main then
        return
    end
    -- 底色透明度以主题的 Alpha 为基准；Transparent=true 时再透一点
    local base = self:_baseAlpha()
    local target = base
    if self.Transparency then
        target = math.min(0.94, base + (self.Glass and 0.1 or 0.16))
    end
    U.tween(self.Main, 0.2, { BackgroundTransparency = target })

    -- 侧栏平时是透明的，有背景图时压一层薄底
    if self.Sidebar then
        U.tween(self.Sidebar, 0.2, { BackgroundTransparency = self:_sidebarAlpha() })
    end
    if self._applyGlass then
        self:_applyGlass()
    end
end

function Window:ToggleTransparency(state)
    if state == nil then
        self.Transparency = not self.Transparency
    else
        self.Transparency = state and true or false
    end
    WobsinsUI.Transparency = self.Transparency
    self:_applyTransparency()
    return self.Transparency
end

function Window:SetTheme(name)
    if not Themes[name] then
        return
    end
    self.Theme = name
    self:_applyTheme(true)
    self:_applyTransparency()
end

-- 整体缩放：窗口、字体、间距一起缩，1 = 原始大小，nil = 重新按屏幕自动算
function Window:SetUIScale(scale)
    if scale == nil then
        self.AutoScale = true
        scale = self:_autoScaleValue()
    else
        self.AutoScale = false
        scale = U.clamp(tonumber(scale) or 1, 0.5, 1.6)
    end
    if math.abs(scale - (self.ScaleValue or 1)) < 0.001 then
        self:_centerStage()
        return self
    end
    self.ScaleValue = scale
    if self.Scale and self.Scale:IsA("UIScale") then
        self.Scale.Scale = scale
    end
    -- 缩完尺寸变了，重新居中（原来贴着屏幕边缘的话会露出半截）
    self:_centerStage()
    -- 收起状态时小条也要跟着换大小
    if self.Minimized and self._placeMinBar then
        self:_placeMinBar()
    end
    return self
end

-- 旧名字
function Window:SetScale(scale)
    return self:SetUIScale(scale)
end

function Window:GetUIScale()
    return self.ScaleValue or 1
end

-- 屏幕尺寸变了（旋转 / 改分辨率）：按新视口重新装一遍。
-- 设计高度是跟着屏幕算出来的，所以这里不能只改 UIScale。
function Window:_autoFit()
    if not self.AutoScale then
        self:_centerStage()
        return self
    end
    local vp = WobsinsUI:_viewport()
    local w, h, s = fitWindowSize(self.BaseWidth or self.Width, self.BaseHeight or self.Height, vp)
    self.ScaleValue = s
    if self.Scale and self.Scale:IsA("UIScale") then
        self.Scale.Scale = s
    end
    if w ~= self.Width or h ~= self.Height then
        self:Resize(w, h)
    else
        self:_centerStage()
    end
    if self.Minimized and self._placeMinBar then
        self:_placeMinBar()
    end
    return self
end

-- 重新计算窗口尺寸（屏幕旋转 / 设备变化时用）
function Window:Resize(width, height)
    self.Width = math.max(360, math.floor(width or self.Width))
    self.Height = math.max(300, math.floor(height or self.Height))
    if self.Stage then
        self.Stage.Size = UDim2.fromOffset(self.Width, self.Height)
    end
    if self.Sidebar then
        self.Sidebar.Size = UDim2.fromOffset(self.SidebarWidth, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self.Content then
        self.Content.Size = UDim2.new(1, -(self.SidebarWidth + 1), 0, self.Height - HEADER_HEIGHT - FOOTER_HEIGHT)
    end
    if self._relayoutColumns then
        self:_relayoutColumns()
    end
    if self._layoutGlass then
        self:_layoutGlass()
    end
    self:_centerStage()
    return self
end

