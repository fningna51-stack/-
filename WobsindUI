--// 18. 图表：折线 / 柱状 / 环形 / 数据块
--//============================================================================
--
-- 全部用 Frame 拼，不依赖任何图片资源，换主题时能跟着变色。
--   card:Sparkline({ Title = "帧率", Values = {...}, Height = 46 })
--   card:BarChart({ Title = "分布", Data = { {Label="A", Value=12}, ... } })
--   card:Ring({ Title = "完成度", Value = 0.72 })
--   card:Stat({ Title = "在线", Value = "128", Delta = "+12%" })

local function normalize(values)
    local min, max = math.huge, -math.huge
    for _, value in ipairs(values) do
        if value < min then
            min = value
        end
        if value > max then
            max = value
        end
    end
    if min == math.huge then
        min, max = 0, 1
    end
    if max - min < 0.0001 then
        max = min + 1
    end
    return min, max
end

--//----------------------------------------------------------------------------
--// 18.1 Sparkline
--//----------------------------------------------------------------------------

function L.Build.Sparkline(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local values = config.Values or {}
    local height = config.Height or 46

    local row, top, title, desc, control = I.row(card, config, 60)

    local current = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = "",
        TextColor3 = win:Color("Text"),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    win:_bind(current, "TextColor3", "Text")

    local chart = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = 2,
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)
    U.corner(chart, 4)
    U.stroke(chart, theme.Outline, 1, 0.55)
    win:_bind(chart, "BackgroundColor3", "BackgroundAlt")

    local treads = {}
    local risers = {}
    local areas = {}
    local columns = 32
    for index = 1, columns do
        local area = new("Frame", {
            BackgroundColor3 = win:Color("Accent"),
            BackgroundTransparency = 0.88,
            Size = UDim2.new(1 / columns, 0.5, 0, 0),
            Position = UDim2.new((index - 1) / columns, 0, 1, 0),
            AnchorPoint = Vector2.new(0, 1),
            ZIndex = WobsinsUI.Layers.RowItem + 1,
        }, chart)
        areas[index] = area

        local riser = new("Frame", {
            BackgroundColor3 = win:Color("Accent"),
            Size = UDim2.new(0, 1.6, 0, 0),
            Position = UDim2.new((index - 1) / columns, 0, 0, 0),
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, chart)
        risers[index] = riser

        local tread = new("Frame", {
            BackgroundColor3 = win:Color("Accent"),
            Size = UDim2.new(1 / columns, 0.6, 0, 1.6),
            Position = UDim2.new((index - 1) / columns, 0, 0, 0),
            ZIndex = WobsinsUI.Layers.RowItem + 2,
        }, chart)
        treads[index] = tread
    end

    local element = {
        Type = "Sparkline",
        Frame = row,
        Values = values,
    }

    local function paint()
        local data = element.Values or {}
        if #data == 0 then
            for index = 1, columns do
                treads[index].Visible = false
                risers[index].Visible = false
                areas[index].Visible = false
            end
            current.Text = "—"
            return
        end

        local min, max = normalize(data)
        local color = U.color(config.Color or theme.Accent)
        if type(config.ColorKey) == "string" then
            color = win:Color(config.ColorKey)
        end

        local function ratioAt(sampleIndex)
            local value = data[sampleIndex]
            local ratio = (value - min) / (max - min)
            return U.clamp(ratio, 0, 1)
        end

        -- 采样到固定列数，画成阶梯折线：横向踏板 + 纵向连接段
        local count = math.min(#data, columns)
        local step = math.max(1, math.floor(#data / columns))
        local previousRatio = ratioAt(1)

        for index = 1, columns do
            local sampleIndex = math.min(#data, (index - 1) * step + 1)
            local ratio = ratioAt(sampleIndex)
            local x = (index - 1) / columns
            local visible = index <= count

            areas[index].Visible = visible
            areas[index].BackgroundColor3 = color
            areas[index].Size = UDim2.new(1 / columns, 0.5, 0, math.max(1, ratio * height))

            treads[index].Visible = visible
            treads[index].BackgroundColor3 = color
            treads[index].Position = UDim2.new(x, 0, 1 - ratio, 0)

            risers[index].Visible = visible and index > 1
            risers[index].BackgroundColor3 = color
            local top = math.min(previousRatio, ratio)
            local bottom = math.max(previousRatio, ratio)
            risers[index].Position = UDim2.new(x, 0, 1 - bottom, 0)
            risers[index].Size = UDim2.new(0, 1.6, 0, math.max(1.5, (bottom - top) * height))

            previousRatio = ratio
        end

        local last = data[#data]
        if type(config.Format) == "function" then
            local ok, formatted = pcall(config.Format, last)
            if ok and formatted ~= nil then
                current.Text = tostring(formatted)
                return
            end
        end
        current.Text = string.format("%.1f", last)
    end

    element.SetValues = function(self_, list_)
        element.Values = list_ or {}
        paint()
    end

    element.Push = function(self_, value)
        local list_ = element.Values or {}
        table.insert(list_, value)
        local limit = config.Limit or 40
        while #list_ > limit do
            table.remove(list_, 1)
        end
        element.Values = list_
        paint()
    end

    element.GetValue = function()
        local list_ = element.Values or {}
        return list_[#list_]
    end

    element.SetValue = function(self_, value)
        element.Push(self_, value)
    end

    win:_onTheme(paint)
    paint()

    return I.finish(card, element, config)
end

