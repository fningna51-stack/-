function Build.Input(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local isArea = config.Type == "Textarea" or config.Multiline == true

    local row, top, title, desc, control = I.row(card, config, 0)

    local boxHeight = isArea and 62 or 26

    local boxHolder = new("Frame", {
        BackgroundColor3 = theme.SurfaceAlt,
        Size = UDim2.new(1, 0, 0, boxHeight),
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)
    U.corner(boxHolder, 4)
    local boxStroke = U.stroke(boxHolder, theme.Outline, 1, 0.25)
    win:_bind(boxHolder, "BackgroundColor3", "SurfaceAlt")

    local box = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(9, 0),
        Size = UDim2.new(1, -18, 1, 0),
        Font = Enum.Font.Gotham,
        PlaceholderText = config.Placeholder or "",
        PlaceholderColor3 = theme.Muted,
        Text = tostring(config.Value or ""),
        TextColor3 = theme.Text,
        TextSize = 10.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = isArea and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        TextWrapped = isArea,
        MultiLine = isArea,
        ClearTextOnFocus = false,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, boxHolder)
    win:_bind(box, "TextColor3", "Text")
    win:_bind(box, "PlaceholderColor3", "Muted")

    if isArea then
        U.padding(box, 0, 7, 0, 7)
    end

    local element = {
        Type = "Input",
        Frame = row,
        Value = box.Text,
        Callback = config.Callback,
    }

    local function fire()
        element.Value = box.Text
        if config.Callback then
            safeCall(config.Callback, box.Text)
        end
    end

    box.Focused:Connect(function()
        U.tween(boxStroke, 0.14, { Color = win:Color("Accent"), Transparency = 0.2 })
    end)
    box.FocusLost:Connect(function(enter)
        U.tween(boxStroke, 0.14, { Color = win:Color("Outline"), Transparency = 0.45 })
        if enter or config.FireOnEveryChange then
            fire()
        end
    end)

    if config.FireOnEveryChange then
        box:GetPropertyChangedSignal("Text"):Connect(fire)
    end

    function element.GetValue()
        return box.Text
    end

    I.setter(element, function(value)
        box.Text = tostring(value or "")
        element.Value = box.Text
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    return I.finish(card, element, config)
end

