local function finish(card, element, cfg, row, extra)
    element.Frame = row
    element.Title = cfg.Title
    element._search = tostring(cfg.Title or "") .. " " .. tostring(cfg.Desc or "") .. " " .. tostring(extra or "")
    element.SetVisible = function(a, b)
        row.Visible = argValue(a, b) and true or false
    end
    element.Destroy = function()
        if row and row.Parent then
            row:Destroy()
        end
    end
    element.SetTitle = function(text)
        element.Title = text
        local label = row:FindFirstChild("Title", true)
        if label and label:IsA("TextLabel") then
            label.Text = text
        end
    end
    card:_register(element)
    return element
end

