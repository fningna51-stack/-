function Window:AddCommand(config)
    self._commands = self._commands or {}
    table.insert(self._commands, {
        Name = config.Name or "未命名命令",
        Hint = config.Hint or "命令",
        Run = config.Run,
    })
    return self
end

--//----------------------------------------------------------------------------
--// 20.2 滚动定位 + 高亮
--//----------------------------------------------------------------------------

function Tab:ScrollTo(element)
    if not element or not element.Frame then
        return self
    end
    local scroll = (self.ActivePage and self.ActivePage.Scroll) or self.Scroll
    if not scroll then
        return self
    end

    local frame = element.Frame
    local delta = frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y
    local target = scroll.CanvasPosition.Y + delta - 40
    if target < 0 then
        target = 0
    end
    scroll.CanvasPosition = Vector2.new(0, target)
    return self
end

function Tab:Flash(element, tabHint)
    if not element or not element.Frame then
        return self
    end
    local win = self.Window
    local frame = element.Frame

    local originalColor = frame.BackgroundColor3
    local originalTransparency = frame.BackgroundTransparency

    frame.BackgroundColor3 = win:Color("Accent")
    U.tween(frame, 0.18, { BackgroundTransparency = 0.78 })
    U.delay(0.7, function()
        if not frame or not frame.Parent then
            return
        end
        U.tween(frame, 0.3, { BackgroundTransparency = originalTransparency })
        U.delay(0.32, function()
            if frame and frame.Parent then
                frame.BackgroundColor3 = originalColor
            end
        end)
    end)

    if tabHint then
        win:Notify({
            Title = "已定位",
            Content = tabHint,
            Icon = "target",
            Duration = 1.6,
            Window = win,
        })
    end

    return self
end

--//----------------------------------------------------------------------------
--// 20.3 面板
--//----------------------------------------------------------------------------

local Palette = {}
Palette.__index = Palette

local function paletteEntries(win)
    local entries = {}

    for _, command in ipairs(win._commands or {}) do
        table.insert(entries, {
            Kind = "Command",
            Title = command.Name,
            Where = command.Hint,
            Run = command.Run,
        })
    end

    for _, tab in ipairs(win.Tabs) do
        table.insert(entries, {
            Kind = "Tab",
            Title = tab.Title,
            Where = "标签页",
            Tab = tab,
            Run = function()
                win:SelectTab(tab)
            end,
        })

        for _, element in ipairs(tab.Elements) do
            if element.Type ~= "Divider" and element.Type ~= "Space" then
                table.insert(entries, {
                    Kind = "Element",
                    Title = element.Title or element.Type,
                    Where = tostring(tab.Title or "") .. " · " .. tostring(element.Type),
                    Tab = tab,
                    Element = element,
                })
            end
        end

        for _, page in ipairs(tab.Pages or {}) do
            table.insert(entries, {
                Kind = "Page",
                Title = page.Title,
                Where = "子页面 · " .. tostring(tab.Title or ""),
                Tab = tab,
                Page = page,
                Run = function()
                    win:SelectTab(tab)
                    page:Open()
                end,
            })
            for _, element in ipairs(page.Elements) do
                if element.Type ~= "Divider" and element.Type ~= "Space" then
                    table.insert(entries, {
                        Kind = "Element",
                        Title = element.Title or element.Type,
                        Where = tostring(tab.Title or "") .. " › " .. tostring(page.Title) .. " · " .. tostring(element.Type),
                        Tab = tab,
                        Page = page,
                        Element = element,
                    })
                end
            end
        end
    end

    return entries
end

function Window:Palette(config)
    config = config or {}
    if self._palette then
        self._palette:Toggle()
        return self._palette
    end

    local win = self

    local overlay = new("TextButton", {
        Name = "PaletteOverlay",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Modal,
    }, self.Root or WobsinsUI:_screen())

    local panel = new("Frame", {
        BackgroundColor3 = self:Color("Background"),
        Size = UDim2.fromOffset(440, 340),
        Position = UDim2.fromScale(0.5, 0.42),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Modal + 1,
    }, overlay)
    U.corner(panel, 8)
    U.stroke(panel, self:Color("Outline"), 1, 0.3)
    self:_bind(panel, "BackgroundColor3", "Background")

    local self_ = setmetatable({
        Window = win,
        Overlay = overlay,
        Panel = panel,
        Entries = {},
        Filtered = {},
        Index = 1,
        Opened = false,
    }, Palette)

    -- 输入框
    local inputBg = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 44),
        ZIndex = WobsinsUI.Layers.Modal + 2,
    }, panel)

    local searchIcon = U.icon(inputBg, "search", 13, self:Color("Muted"), WobsinsUI.Layers.Modal + 3)
    if searchIcon then
        searchIcon.Position = UDim2.fromOffset(14, 15)
    end

    local input = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(38, 0),
        Size = UDim2.new(1, -52, 1, 0),
        Font = Enum.Font.Gotham,
        PlaceholderText = config.Placeholder or "搜索设置项、页面或命令…",
        PlaceholderColor3 = self:Color("Muted"),
        Text = "",
        TextColor3 = self:Color("Text"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = WobsinsUI.Layers.Modal + 3,
    }, inputBg)
    self:_bind(input, "TextColor3", "Text")

    new("Frame", {
        BackgroundColor3 = self:Color("Outline"),
        BackgroundTransparency = 0.4,
        Position = UDim2.new(0, 0, 0, 44),
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = WobsinsUI.Layers.Modal + 2,
    }, panel)

    -- 结果列表
    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 45),
        Size = UDim2.new(1, 0, 1, -45),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        ZIndex = WobsinsUI.Layers.Modal + 2,
    }, panel)

    local list = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.Modal + 2,
    }, scroll)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 1),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)

    --//--------------------------------------------------------------------
    --// 列表
    --//--------------------------------------------------------------------

    function self_:Paint()
        local stale = {}
        for _, child in ipairs(list._children) do
            if child.ClassName ~= "UIListLayout" then
                table.insert(stale, child)
            end
        end
        for _, child in ipairs(stale) do
            child:Destroy()
        end

        local count = 0
        for _, entry in ipairs(self.Filtered) do
            count = count + 1
            local active = (count == self.Index)

            local row = new("TextButton", {
                BackgroundColor3 = active and self.Window:Color("SurfaceAlt") or self.Window:Color("Surface"),
                BackgroundTransparency = active and 0.1 or 1,
                AutoButtonColor = false,
                Text = "",
                Size = UDim2.new(1, 0, 0, 36),
                LayoutOrder = count,
                ZIndex = WobsinsUI.Layers.Modal + 3,
            }, list)

            local badge = new("TextLabel", {
                BackgroundColor3 = self.Window:Color("SurfaceAlt"),
                BackgroundTransparency = 0.2,
                Position = UDim2.fromOffset(10, 9),
                Size = UDim2.fromOffset(18, 18),
                Font = Enum.Font.GothamBold,
                Text = string.upper(string.sub(tostring(entry.Kind or "?"), 1, 1)),
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 8.5,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)
            U.corner(badge, 4)

            local name = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(36, 3),
                Size = UDim2.new(1, -110, 0, 16),
                Font = Enum.Font.Gotham,
                Text = tostring(entry.Title),
                TextColor3 = active and self.Window:Color("Text") or self.Window:Color("SubText"),
                TextSize = 10.5,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)

            local where = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(36, 18),
                Size = UDim2.new(1, -60, 0, 14),
                Font = Enum.Font.Gotham,
                Text = tostring(entry.Where or ""),
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 8.5,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Modal + 4,
            }, row)

            row.Activated:Connect(function()
                self.Index = count
                self_:Commit()
            end)

            if active then
                self._activeRow = row
            end
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(count * 37, 1))

        if count == 0 then
            local empty = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 60),
                Font = Enum.Font.Gotham,
                Text = "没有匹配项",
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 10.5,
                ZIndex = WobsinsUI.Layers.Modal + 3,
            }, list)
        end
    end

    function self_:Filter(text)
        local query = string.lower(tostring(text or ""))
        self.Filtered = {}
        for _, entry in ipairs(self.Entries) do
            local haystack = string.lower(tostring(entry.Title) .. " " .. tostring(entry.Where))
            if query == "" or string.find(haystack, query, 1, true) then
                table.insert(self.Filtered, entry)
            end
        end
        self.Index = math.min(self.Index, math.max(#self.Filtered, 1))
        self_:Paint()
    end

    function self_:Move(delta)
        if #self.Filtered == 0 then
            return
        end
        self.Index = self.Index + delta
        if self.Index < 1 then
            self.Index = 1
        end
        if self.Index > #self.Filtered then
            self.Index = #self.Filtered
        end
        self_:Paint()

        local row = self._activeRow
        if row and scroll then
            local offset = (self.Index - 1) * 37
            local height = scroll.AbsoluteSize.Y
            if offset < scroll.CanvasPosition.Y then
                scroll.CanvasPosition = Vector2.new(0, offset)
            elseif offset + 37 > scroll.CanvasPosition.Y + height then
                scroll.CanvasPosition = Vector2.new(0, offset + 37 - height)
            end
        end
    end

    function self_:Commit()
        local entry = self.Filtered[self.Index]
        if not entry then
            return
        end

        self:Close()

        if entry.Run then
            safeCall(entry.Run)
            return
        end

        if entry.Tab then
            win:SelectTab(entry.Tab)
        end
        if entry.Page and entry.Page.Open then
            entry.Page:Open()
        end
        if entry.Tab and entry.Element then
            U.delay(0.05, function()
                entry.Tab:ScrollTo(entry.Element)
                entry.Tab:Flash(entry.Element, entry.Title)
            end)
        end
    end

    function self_:Open()
        self.Entries = paletteEntries(win)
        self.Index = 1
        input.Text = ""
        self.Filtered = self.Entries
        self_:Paint()
        overlay.Visible = true
        self.Opened = true
        win:FocusPalette(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Opened = false
        win:FocusPalette(false)
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self_:Close()
        end
        return self_:Open()
    end

    input:GetPropertyChangedSignal("Text"):Connect(function()
        if not self_.Opened then
            return
        end
        self_.Index = 1
        self_:Filter(input.Text)
    end)

    overlay.Activated:Connect(function()
        self_:Close()
    end)

    if S.UserInputService then
        S.UserInputService.InputBegan:Connect(function(inputObject, processed)
            if processed then
                return
            end

            if not self_.Opened then
                return
            end

            local key = inputObject.KeyCode
            if key == Enum.KeyCode.Down or key == Enum.KeyCode.Tab then
                self_:Move(1)
            elseif key == Enum.KeyCode.Up then
                self_:Move(-1)
            elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.KeypadEnter then
                self_:Commit()
            elseif key == Enum.KeyCode.Escape then
                self_:Close()
            end
        end)
    end

    self._palette = self_

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

function Window:FocusPalette(state)
    self._paletteOpen = state and true or false
    return self
end

--//============================================================================
--// 21. 通知中心
--//============================================================================
--
--   win:NotifyCenter()          -- 打开历史通知列表
--   UI:GetNotifications()       -- 读取历史
--   UI:ClearNotifications()     -- 清空
--   UI:MarkNotificationsRead()  -- 全部已读
--
-- 通知历史在 UI:Notify 时自动记录，最多保留 60 条。

local NotifyCenter = {}
NotifyCenter.__index = NotifyCenter

local function relativeTime(stamp)
    local now = os.time()
    local delta = math.max(0, now - (stamp or now))
    if delta < 60 then
        return "刚刚"
    elseif delta < 3600 then
        return string.format("%d 分钟前", math.floor(delta / 60))
    elseif delta < 86400 then
        return string.format("%d 小时前", math.floor(delta / 3600))
    end
    return string.format("%d 天前", math.floor(delta / 86400))
end

function Window:NotifyCenter(config)
    if self._notifyCenter then
        self._notifyCenter:Toggle()
        return self._notifyCenter
    end

    config = config or {}
    local win = self

    local overlay = new("TextButton", {
        Name = "NotifyCenterOverlay",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Overlay,
    }, self.Root or WobsinsUI:_screen())

    local panel = new("Frame", {
        BackgroundColor3 = self:Color("Background"),
        Size = UDim2.fromOffset(392, 380),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Overlay + 1,
    }, overlay)
    U.corner(panel, 8)
    U.stroke(panel, self:Color("Outline"), 1, 0.3)
    self:_bind(panel, "BackgroundColor3", "Background")

    local self_ = setmetatable({
        Window = win,
        Overlay = overlay,
        Panel = panel,
        Opened = false,
    }, NotifyCenter)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 12),
        Size = UDim2.new(1, -110, 0, 18),
        Font = Enum.Font.GothamMedium,
        Text = config.Title or "通知",
        TextColor3 = self:Color("Text"),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
    self:_bind(title, "TextColor3", "Text")

    local countLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 30),
        Size = UDim2.new(1, -110, 0, 14),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = self:Color("Muted"),
        TextSize = 9.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
    self:_bind(countLabel, "TextColor3", "Muted")

    local clear = new("TextButton", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        AutoButtonColor = false,
        Position = UDim2.new(1, -78, 0, 12),
        Size = UDim2.fromOffset(62, 24),
        Text = "",
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
    U.corner(clear, 4)
    U.stroke(clear, self:Color("Outline"), 1, 0.5)
    self:_bind(clear, "BackgroundColor3", "SurfaceAlt")

    local clearLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.Gotham,
        Text = "清空",
        TextColor3 = self:Color("SubText"),
        TextSize = 9.5,
        ZIndex = WobsinsUI.Layers.Overlay + 3,
    }, clear)
    self:_bind(clearLabel, "TextColor3", "SubText")

    local close = new("TextButton", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -38, 0, 8),
        Size = UDim2.fromOffset(28, 28),
        Text = "",
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
    local closeIcon = U.icon(close, "close", 12, self:Color("SubText"), WobsinsUI.Layers.Overlay + 3)
    if closeIcon then
        closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        closeIcon.Position = UDim2.fromScale(0.5, 0.5)
    end

    new("Frame", {
        BackgroundColor3 = self:Color("Outline"),
        BackgroundTransparency = 0.4,
        Position = UDim2.new(0, 0, 0, 50),
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)

    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 51),
        Size = UDim2.new(1, 0, 1, -51),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
    scroll.ScrollBarImageColor3 = self:Color("Outline")

    local list = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, scroll)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 1),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)

    function self_:Paint()
        local stale = {}
        for _, child in ipairs(list._children) do
            if child.ClassName ~= "UIListLayout" then
                table.insert(stale, child)
            end
        end
        for _, child in ipairs(stale) do
            child:Destroy()
        end

        local history = WobsinsUI:GetNotifications()
        local unread = 0
        for _, item in ipairs(history) do
            if not item.Read then
                unread = unread + 1
            end
        end

        countLabel.Text = string.format("%d 条 · %d 条未读", #history, unread)

        if #history == 0 then
            local empty = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 90),
                Font = Enum.Font.Gotham,
                Text = "还没有通知",
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 10.5,
                ZIndex = WobsinsUI.Layers.Overlay + 3,
            }, list)
            scroll.CanvasSize = UDim2.new(0, 0, 0, 100)
            return empty
        end

        for index, item in ipairs(history) do
            local row = new("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 48),
                LayoutOrder = #history - index + 1,
                ZIndex = WobsinsUI.Layers.Overlay + 3,
            }, list)

            local accentBar = new("Frame", {
                BackgroundColor3 = self.Window:Color(item.Read and "Outline" or "Accent"),
                BackgroundTransparency = item.Read and 0.4 or 0,
                Position = UDim2.fromOffset(12, 12),
                Size = UDim2.fromOffset(2, 24),
                ZIndex = WobsinsUI.Layers.Overlay + 4,
            }, row)
            U.corner(accentBar, 1)

            local rowTitle = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(22, 8),
                Size = UDim2.new(1, -100, 0, 15),
                Font = Enum.Font.GothamMedium,
                Text = item.Title,
                TextColor3 = self.Window:Color(item.Read and "SubText" or "Text"),
                TextSize = 10.5,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Overlay + 4,
            }, row)

            local rowContent = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(22, 23),
                Size = UDim2.new(1, -70, 0, 14),
                Font = Enum.Font.Gotham,
                Text = item.Content,
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 9,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = WobsinsUI.Layers.Overlay + 4,
            }, row)

            local timeLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -66, 0, 9),
                Size = UDim2.fromOffset(56, 14),
                Font = Enum.Font.Gotham,
                Text = relativeTime(item.Time),
                TextColor3 = self.Window:Color("Muted"),
                TextSize = 8.5,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = WobsinsUI.Layers.Overlay + 4,
            }, row)

            local divider = new("Frame", {
                BackgroundColor3 = self.Window:Color("OutlineSoft"),
                BackgroundTransparency = 0.3,
                Position = UDim2.new(0, 12, 1, -1),
                Size = UDim2.new(1, -24, 0, 1),
                ZIndex = WobsinsUI.Layers.Overlay + 3,
            }, row)

            item.Read = true
        end

        WobsinsUI.UnreadNotify = 0
        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#history * 49, 1))
        return nil
    end

    function self_:Open()
        self_:Paint()
        overlay.Visible = true
        self.Opened = true
        win:FocusNotifyCenter(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Opened = false
        win:FocusNotifyCenter(false)
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self_:Close()
        end
        return self_:Open()
    end

    function self_:Refresh()
        if self.Opened then
            self_:Paint()
        end
        return self
    end

    overlay.Activated:Connect(function()
        self_:Close()
    end)
    close.Activated:Connect(function()
        self_:Close()
    end)
    clear.Activated:Connect(function()
        WobsinsUI:ClearNotifications()
        self_:Paint()
    end)

    self._notifyCenter = self_
    WobsinsUI:OnNotify(function()
        if self.Opened then
            self_:Paint()
        end
    end)

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

function Window:FocusNotifyCenter(state)
    self._notifyCenterOpen = state and true or false
    return self
end

-- 一个现成的铃铛按钮，用户想放哪就放哪
function Window:BellButton(parent, size)
    size = size or 26
    local win = self
    local btn = new("TextButton", {
        BackgroundColor3 = self:Color("SurfaceAlt"),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(size, size),
        Text = "",
        ZIndex = WobsinsUI.Layers.HeaderItem,
    }, parent or self.Header)
    U.corner(btn, 4)

    local icon = U.icon(btn, "bell", 12, self:Color("SubText"), WobsinsUI.Layers.HeaderItem + 1)
    if icon then
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.Position = UDim2.fromScale(0.5, 0.5)
    end

    local dot = new("Frame", {
        BackgroundColor3 = self:Color("Danger"),
        Size = UDim2.fromOffset(6, 6),
        Position = UDim2.new(1, -10, 0, 6),
        AnchorPoint = Vector2.new(1, 0),
        Visible = (WobsinsUI.UnreadNotify or 0) > 0,
        ZIndex = WobsinsUI.Layers.HeaderItem + 2,
    }, btn)
    U.corner(dot, 3)

    U.hover(btn, function()
        U.tween(btn, 0.12, { BackgroundTransparency = 0 })
    end, function()
        U.tween(btn, 0.12, { BackgroundTransparency = 1 })
    end)

    btn.Activated:Connect(function()
        win:NotifyCenter()
    end)

    WobsinsUI:OnNotify(function()
        dot.Visible = true
    end)

    return btn
end

