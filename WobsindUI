                TextSize = 10.5,
                LayoutOrder = 1,
                ZIndex = WobsinsUI.Layers.Overlay + 3,
            }, list)
            table.insert(self.Rows, { Frame = empty })
        end
    end

    --//--------------------------------------------------------------------
    --// 录制
    --//--------------------------------------------------------------------

    function self_:Capture(entry, label, pill)
        if not S.UserInputService then
            return
        end
        self.Capture = { Entry = entry, Label = label, Pill = pill }
        label.Text = "按下按键…"
        label.TextColor3 = self.Window:Color("Accent")

        local connection
        connection = S.UserInputService.InputBegan:Connect(function(input)
            if not self.Capture then
                if connection then
                    connection:Disconnect()
                end
                return
            end

            local pressed = nil
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    self.Capture = nil
                    if connection then
                        connection:Disconnect()
                    end
                    self:Rebuild()
                    return
                end
                pressed = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                pressed = "Mouse1"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                pressed = "Mouse2"
            end

            if not pressed then
                return
            end

            if entry.Element.SetValue then
                entry.Element:SetValue(pressed)
            end
            self.Capture = nil
            if connection then
                connection:Disconnect()
            end
            self:Rebuild()

            if config.OnChanged then
                safeCall(config.OnChanged, entry.Element, pressed)
            end
        end)
    end

    --//--------------------------------------------------------------------
    --// 开关
    --//--------------------------------------------------------------------

    function self_:Open()
        self:Close()
        self.Query = ""
        search.Text = ""
        self:Rebuild()
        overlay.Visible = true
        self.Opened = true
        self.Window:SetHotkeyPanelOpen(true)
        return self
    end

    function self_:Close()
        overlay.Visible = false
        self.Capture = nil
        self.Opened = false
        if self.Window then
            self.Window:SetHotkeyPanelOpen(false)
        end
        return self
    end

    function self_:Toggle()
        if self.Opened then
            return self:Close()
        end
        return self_:Open()
    end

    function self_:Destroy()
        overlay:Destroy()
        self.Window._hotkeyPanel = nil
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        self_.Query = search.Text
        self_:Rebuild()
    end)

    self._hotkeyPanel = self_

    if config.Open ~= false then
        self_:Open()
    end

    return self_
end

-- 面板打开时，开关键不应该顺带把窗口关掉
function Window:SetHotkeyPanelOpen(state)
    self._hotkeyPanelOpen = state and true or false
    if S.UserInputService then
        -- 记录状态即可，CreateWindow 里的开关键逻辑会读取它
    end
    return self
end

