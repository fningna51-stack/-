--//----------------------------------------------------------------------------
--// 9.1 错误兜底窗口
--//----------------------------------------------------------------------------
--
-- 真出异常时不能只 print —— 用户在执行器里看不到控制台。
-- 这里直接在屏幕中间放一张可读的错误卡片，把 traceback 前几行显示出来。

function WobsinsUI:_errorWindow(message)
    local screen = self:_screen()
    local theme = Themes.Graphite

    local panel = new("Frame", {
        BackgroundColor3 = theme.Surface,
        Size = UDim2.fromOffset(520, 260),
