        Font = Enum.Font.GothamMedium,
        PlaceholderText = "输入密钥…",
        PlaceholderColor3 = self:Color("Placeholder"),
        Text = "",
        TextColor3 = self:Color("Text"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = 65,
    }, boxHolder)

    local errorLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 14),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = C("#FF6B81"),
        TextSize = 10.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 3,
        ZIndex = 64,
    }, modal.ContentHolder)

    local row = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = 4,
        ZIndex = 64,
    }, modal.ContentHolder)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, row)

    local exitHolder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0.36, -4, 0, 36),
        LayoutOrder = 1,
        ZIndex = 64,
    }, row)

    local exitBtn = makeButton(exitHolder, {
        Title = "退出",
        Variant = "Tertiary",
        Height = 36,
        Callback = function()
            modal.Close()
            if self.OpenButton then
                self.OpenButton.Frame.Visible = false
            end
        end,
    }, self)
    exitBtn.Frame.Size = UDim2.fromScale(1, 1)

    local confirmHolder = new("Frame", {
