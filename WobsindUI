--//----------------------------------------------------------------------------
--// 22.1 注册 / 切换
--//----------------------------------------------------------------------------

function WobsinsUI:AddLocale(code, dictionary, overwrite)
    code = tostring(code or "")
    if code == "" then
        return self
    end
    local existing = self.Locales[code]
    if existing and not overwrite then
        for key, value in pairs(dictionary or {}) do
            if existing[key] == nil then
                existing[key] = value
            end
        end
    else
        self.Locales[code] = dictionary or {}
    end
    return self
end

function WobsinsUI:GetLocale()
    return self.Locale
end

function WobsinsUI:SetLocale(code)
    if not self.Locales[code] then
        logWarn("[WobsinsUI] 未知语言: " .. tostring(code))
        return self
    end
    self.Locale = code

    for _, item in ipairs(self._translated) do
        if item.Object and item.Object.Parent then
            local ok, text = pcall(self.t, self, item.Key, unpack(item.Args or {}))
            if ok and text then
                item.Object[item.Property] = text
            end
        end
    end

    return self
end

--//----------------------------------------------------------------------------
--// 22.2 取词
--//----------------------------------------------------------------------------

function WobsinsUI:t(key, ...)
    local dictionary = self.Locales[self.Locale] or self.Locales.zh or {}
    local text = dictionary[key]

    if text == nil then
        local fallback = self.Locales.zh and self.Locales.zh[key]
        text = fallback or tostring(key)
    end

    if select("#", ...) > 0 then
        local ok, formatted = pcall(string.format, text, ...)
        if ok then
            return formatted
        end
    end

    return text
end

-- 登记一个会被语言切换刷新的属性
function WobsinsUI:BindText(object, key, property, ...)
    if not object then
        return object
    end
    property = property or "Text"
    local args = { ... }
    table.insert(self._translated, {
        Object = object,
        Key = key,
        Property = property,
        Args = args,
    })
    local ok, text = pcall(self.t, self, key, unpack(args))
    if ok and text then
        object[property] = text
    end
    return object
end

-- 清掉已经销毁的引用，长时间运行时防止表变大
function WobsinsUI:CleanTranslations()
    local kept = {}
    for _, item in ipairs(self._translated) do
        if item.Object and item.Object.Parent then
            table.insert(kept, item)
        end
    end
    self._translated = kept
    return self
end

--//============================================================================
--// 23. 常驻开关 / 关闭脚本
--//============================================================================
--
-- 这一节做两件事：
--
--   1. 最小化小条（默认）。点标题栏的「—」收起后，整窗缩成一颗 236x38 的
--      小胶囊钉在屏幕上：左边图标、中间脚本名、右边 ×，和 v2.3 那版一样。
--      · 点条身 → 展开回完整窗口；
--      · 按住条身可以拖到任意位置，位置会记住；
--      · 点 × → 走关闭确认，不会一点就没。
--
--   1b. 常驻药丸开关（可选，FloatSwitch = true）。不用小条、想在屏幕上留一颗
--      可拖动的开关时用，见 23.2。
--
--   2. 关闭脚本。右上角 × 弹确认，确认后销毁整个界面、清掉单例、
--      触发 OnShutdown 回调，脚本主循环据此退出。
--
--//----------------------------------------------------------------------------
--// 23.1 常量
--//----------------------------------------------------------------------------

local SWITCH_WIDTH = 46      -- 药丸开关（可选）设计尺寸
local SWITCH_HEIGHT = 26
local SWITCH_GAP = 8
local SWITCH_MARGIN = 16
local TAP_SLOP = 12          -- 手指抖动容忍：位移超过这个数才算拖动

local MINBAR_WIDTH = 236     -- 最小化小条设计尺寸
local MINBAR_HEIGHT = 38
local MINBAR_TAP = 9         -- 小条上点一下展开的容忍位移

-- 药丸开关在标题栏里占的槽位（设计坐标，右上角起算）
function Window:_switchSlot()
    -- 关闭按钮占 14 + 26，再往左空 8px 就是开关
    return 14 + 26 + SWITCH_GAP
end

--//----------------------------------------------------------------------------
--// 23.2 常驻药丸开关（可选，FloatSwitch = true 才建）
--//----------------------------------------------------------------------------

function Window:_switchText()
    return self.SwitchText or "显示界面"
end

function Window:_buildFloatSwitch(config)
    if self.FloatSwitch or not self.Root then
        return self
    end
    config = config or self.Config or {}
    if config.FloatSwitch ~= true then
        return self
    end

    local btn = new("TextButton", {
        Name = "FloatSwitch",
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromOffset(SWITCH_WIDTH, SWITCH_HEIGHT),
        Position = UDim2.new(1, -SWITCH_MARGIN - SWITCH_WIDTH, 0, SWITCH_MARGIN),
        ClipsDescendants = false,
        ZIndex = WobsinsUI.Layers.Modal - 1,
    }, self.Root)
    self.FloatSwitch = btn

    -- 和窗口一起缩放，尺寸才对得上标题栏
    self.SwitchScale = new("UIScale", { Scale = self.ScaleValue or 1 }, btn)

    -- 轨道跟着主题走：开 = 反色轨道 + 底色滑块，暗色主题上是「白底深点」，
    -- 浅色主题上自动变成「深底白点」，不会在浅色面板上糊成一片。
    local trackColor, knobColor = self:_switchColors(true)
    local track = new("Frame", {
        Name = "Track",
        BackgroundColor3 = trackColor,
        Size = UDim2.fromOffset(SWITCH_WIDTH, SWITCH_HEIGHT),
        ZIndex = WobsinsUI.Layers.Modal - 1,
    }, btn)
    U.corner(track, SWITCH_HEIGHT / 2)
    local trackStroke = U.stroke(track, self:Color("Outline"), 1, 0.5)
    self.SwitchStroke = trackStroke
    btn.Track = track

    local knob = new("Frame", {
        Name = "Knob",
        BackgroundColor3 = knobColor,
        Size = UDim2.fromOffset(SWITCH_HEIGHT - 6, SWITCH_HEIGHT - 6),
        Position = UDim2.fromOffset(3, 3),
        ZIndex = WobsinsUI.Layers.Modal,
    }, track)
    U.corner(knob, (SWITCH_HEIGHT - 6) / 2)
    btn.Knob = knob

    local knobIcon = U.icon(knob, "bolt", 11, self:Color("Text"), WobsinsUI.Layers.Modal + 1)
    if knobIcon then
        knobIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        knobIcon.Position = UDim2.fromScale(0.5, 0.5)
        btn.KnobIcon = knobIcon
    end

    -- 位置：默认贴窗口右上角，跟着窗口走
    self._switchPinned = true
    if typeof(config.SwitchPosition) == "UDim2" then
        btn.Position = config.SwitchPosition
        self._switchPinned = false
    end
    self:_placeSwitch()

    --//-- 交互 ----------------------------------------------------------------
    local dragging, moved = false, 0
    local startPointer, startLeft, startTop = nil, 0, 0
    local lastFire = 0

    local function fire()
        -- 触屏上 InputEnded 和 Activated 会各来一发，别切两次；
        -- 每次新的按压（InputBegan）都把闸门重置，连点不受影响。
        local now = os.clock()
        if now - lastFire < 0.12 then
            return
        end
        lastFire = now
        self:ToggleSwitch()
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        moved = 0
        lastFire = -1
        startPointer = input.Position
        startLeft = btn.AbsolutePosition.X
        startTop = btn.AbsolutePosition.Y
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if not dragging then
            return
        end
        dragging = false
        if moved <= TAP_SLOP then
            fire()
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - startPointer
            moved = math.max(moved, math.abs(delta.X) + math.abs(delta.Y))
            if moved <= TAP_SLOP then
                return
            end
            -- 拖动就脱离窗口：以后窗口怎么动它都不跟着跑了
            self._switchPinned = false
            local vp = WobsinsUI:_viewport()
            local size = btn.AbsoluteSize
            local left = U.clamp(startLeft + delta.X, 4, math.max(4, vp.X - size.X - 4))
            local top = U.clamp(startTop + delta.Y, 4, math.max(4, vp.Y - size.Y - 4))
            btn.Position = UDim2.fromOffset(left, top)
        end)
    end

    btn.Activated:Connect(function()
        -- 有些执行器在触屏上只发 Activated，不发 InputEnded
        if dragging then
            return
        end
        if moved <= TAP_SLOP then
            fire()
        end
    end)

    btn.MouseEnter:Connect(function()
        trackStroke.Transparency = 0.25
    end)
    btn.MouseLeave:Connect(function()
        trackStroke.Transparency = 0.5
    end)

    -- 切主题时重新上色（开关挂在 ScreenGui 上，不继承窗口的绑定）
    self:_onTheme(function()
        self:_paintSwitch()
        if self.SwitchStroke then
            self.SwitchStroke.Color = self:Color("Outline")
        end
    end)

    U.tooltip(btn, "点一下收起 / 展开界面，按住可拖动")

    self:_paintSwitch()
    return self
end

-- 返回 轨道色, 滑块色。开 = 前景色底 + 背景色滑块（暗色反白、浅色反黑）
function Window:_switchColors(on)
    if on then
        return self:Color("Text"), self:Color("Background")
    end
    return self:Color("SurfaceHover"), self:Color("Muted")
end

-- 把开关摆到窗口右上角（跟着缩放和拖动走）
function Window:_placeSwitch()
    local sw = self.FloatSwitch
    if not sw or not self._switchPinned then
        return
    end
    local s = self.ScaleValue or 1
    local left = (self._stageLeft or 0) + (self.Width - self:_switchSlot() - SWITCH_WIDTH) * s
    local top = (self._stageTop or 0) + 9 * s        -- 标题栏 44 高，(44-26)/2 = 9
    sw.Position = UDim2.fromOffset(math.floor(left), math.floor(top))
    if self.SwitchScale then
        self.SwitchScale.Scale = s
    end
end

-- 开关的视觉状态：窗口开着滑块在右（白底深点），关着在左（灰底浅点）
function Window:_paintSwitch()
    local sw = self.FloatSwitch
    if not sw then
        return
    end
    local shown = self:IsShown()
    local travel = SWITCH_WIDTH - SWITCH_HEIGHT
    local trackColor, knobColor = self:_switchColors(shown)

    U.tween(sw.Track, 0.18, {
        BackgroundColor3 = trackColor,
    }, Enum.EasingStyle.Quad)
    U.tween(sw.Knob, 0.18, {
        Position = UDim2.fromOffset(shown and (3 + travel) or 3, 3),
        BackgroundColor3 = knobColor,
    }, Enum.EasingStyle.Quad)
    if sw.KnobIcon then
        -- 图标压在滑块上，取和滑块相反的颜色
        U.tint(sw.KnobIcon, shown and self:Color("Text") or self:Color("Background"))
    end
end

--//----------------------------------------------------------------------------
--// 23.3 最小化小条（默认）
--//----------------------------------------------------------------------------
--
-- 收起后屏幕上只留这一条：图标 + 脚本名 + ×。位置默认贴在窗口左上角，
-- 拖过之后记住新位置；点条身展开，点 × 走关闭确认。

function Window:_buildMinBar(config)
    config = config or self.Config or {}
    if self.MinBar or not self.Root then
        return self
    end
    -- 用了常驻药丸就不再建小条，两个入口会打架
    if config.FloatSwitch == true or config.MinBar == false then
        return self
    end

    local bar = new("Frame", {
        Name = "MinBar",
        -- Active：点击不要穿透到后面的游戏画面，按住拖动才稳
        Active = true,
        BackgroundColor3 = self:Color("Surface"),
        Size = UDim2.fromOffset(MINBAR_WIDTH, MINBAR_HEIGHT),
        Visible = false,
        ClipsDescendants = false,
        ZIndex = WobsinsUI.Layers.Header,
    }, self.Root)
    U.corner(bar, 10)
    local stroke = U.stroke(bar, self:Color("Outline"), 1, 0.35)
    self.MinBar = bar
    self.MinBarStroke = stroke
    self.MinBarScale = new("UIScale", { Scale = self.ScaleValue or 1 }, bar)

    -- 左边的图标方块，和标题栏那个 logo 一个路子
    local logo = new("Frame", {
        Name = "Logo",
        BackgroundColor3 = self:Color("SurfaceAlt"),
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.fromOffset(7, 7),
        ZIndex = WobsinsUI.Layers.Header + 1,
    }, bar)
    U.corner(logo, 6)
    self.MinBarLogo = logo
    local logoIcon = U.icon(logo, self.Icon, 13, self:Color("Text"), WobsinsUI.Layers.Header + 2)
    if logoIcon then
        logoIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        logoIcon.Position = UDim2.fromScale(0.5, 0.5)
        self.MinBarIcon = logoIcon
    end

    -- 脚本名（只留一行，长了截断）
    local label = new("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(39, 0),
        Size = UDim2.new(1, -(39 + 34 + 8), 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = self.Title,
        TextColor3 = self:Color("Text"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.Header + 1,
    }, bar)
    self.MinBarTitle = label
    self:_bind(label, "TextColor3", "Text")

    -- 右边那颗 ×：红底白叉，一看看得出是「关掉脚本」，不是在拖动区域里的装饰
    local close = new("TextButton", {
        Name = "Close",
        BackgroundColor3 = self:Color("Danger"),
        BackgroundTransparency = 0.12,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(1, -33, 0, 6),
        ZIndex = WobsinsUI.Layers.Header + 1,
    }, bar)
    U.corner(close, 6)
    self.MinBarClose = close

    U.icon(close, "close", 12, Color3.new(1, 1, 1), WobsinsUI.Layers.Header + 2)
    U.hover(close, function()
        U.tween(close, 0.12, { BackgroundTransparency = 0 })
    end, function()
        U.tween(close, 0.12, { BackgroundTransparency = 0.12 })
    end)

    --//-- 交互 ----------------------------------------------------------------
    local dragging, moved = false, 0
    local startPointer, startLeft, startTop = nil, 0, 0

    local function stageIn()
        -- 收起状态下点条身 / 按快捷键，都回到完整窗口
        self:SetMinimized(false)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        moved = 0
        startPointer = input.Position
        startLeft = bar.AbsolutePosition.X
        startTop = bar.AbsolutePosition.Y
    end)

    bar.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if not dragging then
            return
        end
        dragging = false
        -- 手指抖几像素仍然算「点」，超过阈值就只是挪位置
        if moved <= MINBAR_TAP then
            stageIn()
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local delta = input.Position - startPointer
            moved = math.max(moved, math.abs(delta.X) + math.abs(delta.Y))
            if moved <= MINBAR_TAP then
                return
            end
            local vp = WobsinsUI:_viewport()
            local size = bar.AbsoluteSize
            local left = U.clamp(startLeft + delta.X, 4, math.max(4, vp.X - size.X - 4))
            local top = U.clamp(startTop + delta.Y, 4, math.max(4, vp.Y - size.Y - 4))
            -- 手动拖过之后就不再跟着窗口走
            self._minBarPinned = true
            self._minBarPos = { x = left, y = top }
            bar.Position = UDim2.fromOffset(math.floor(left), math.floor(top))
        end)
    end

    close.Activated:Connect(function()
        self:RequestClose()
    end)
    U.tooltip(close, "关闭脚本")

    U.tooltip(bar, "点一下展开界面，按住可拖动")

    -- 主题切换时重新上色（挂在 ScreenGui 上，不继承窗口绑定）
    self:_onTheme(function()
        self:_paintMinBar()
    end)

    return self
end

function Window:_paintMinBar()
    local bar = self.MinBar
    if not bar then
        return
    end
    bar.BackgroundColor3 = self:Color("Surface")
    if self.MinBarLogo then
        self.MinBarLogo.BackgroundColor3 = self:Color("SurfaceAlt")
    end
    if self.MinBarClose then
        self.MinBarClose.BackgroundColor3 = self:Color("Danger")
    end
    if self.MinBarStroke then
        self.MinBarStroke.Color = self:Color("Outline")
    end
end

-- 摆位置：第一次贴在窗口左上角，之后跟着上次拖到的地方走
function Window:_placeMinBar()
    local bar = self.MinBar
    if not bar then
        return
    end
    local s = self.ScaleValue or 1
    if self.MinBarScale then
        self.MinBarScale.Scale = s
    end

    local vp = WobsinsUI:_viewport()
    local w, h = MINBAR_WIDTH * s, MINBAR_HEIGHT * s
    local pos = self._minBarPos
    -- 没被手动拖过时，每次收起都贴到窗口当前所在的位置
    if not pos or not self._minBarPinned then
        pos = {
            x = self._stageLeft or (vp.X - w) / 2,
            y = self._stageTop or 16,
        }
    end
    pos.x = U.clamp(pos.x, 4, math.max(4, vp.X - w - 4))
    pos.y = U.clamp(pos.y, 4, math.max(4, vp.Y - h - 4))
    self._minBarPos = pos
    bar.Position = UDim2.fromOffset(math.floor(pos.x), math.floor(pos.y))
end

function Window:_showMinBar(show)
    local bar = self.MinBar
    if not bar then
        return
    end
    if show then
        self:_placeMinBar()
        bar.Visible = true
    else
        bar.Visible = false
    end
end

--//----------------------------------------------------------------------------
--// 23.3b 开 / 关
--//----------------------------------------------------------------------------

function Window:IsShown()
    if self.Destroyed then
        return false
    end
    return self.Visible ~= false and self.Minimized ~= true
end

function Window:SetMinimized(state)
    state = state and true or false
    if self.Destroyed or not self.Stage then
        return self
    end
    if self.Minimized == state and self.Stage.Visible == (not state) then
        if self.FloatSwitch then
            self:_paintSwitch()
        end
        return self
    end

    self.Minimized = state

    if state then
        -- 关：整窗藏起来，屏幕上只留小条（或药丸开关）
        self.Visible = false
        self:_showMinBar(true)
        self.Stage.Visible = false
    else
        self.Visible = true
        self:_showMinBar(false)
        self.Stage.Visible = true
        -- 收起期间被设置 / 换过的背景图，这时候补建
        if self._hasPendingBg then
            local source = self._pendingBackground
            self._pendingBackground = nil
            self._hasPendingBg = false
            self:SetBackgroundImage(source)
        end
        if self.Scale then
            local base = self.ScaleValue or 1
            self.Scale.Scale = base * 0.97
            U.tween(self.Scale, 0.18, { Scale = base }, Enum.EasingStyle.Quad)
        end
    end

    -- 只有显式开了悬浮按钮兜底时才管它
    if not self.MinBar and not self.FloatSwitch and self.OpenButton and self.OpenButton.Frame then
        self.OpenButton.Frame.Visible = state
    end

    -- 收起时暂停粒子 / 光斑动画，展开时恢复（省帧）
    if self._setFxActive then
        self:_setFxActive(not state)
    end

    if self.FloatSwitch then
        self:_paintSwitch()
    end
    return self
end

function Window:ToggleSwitch()
    if self:IsShown() then
        self:SetMinimized(true)
    else
        self:SetMinimized(false)
    end
    return self
end

function Window:Minimize()
    return self:ToggleSwitch()
end

function Window:IsMinimized()
    return self.Minimized == true
end

function Window:SetSwitchText(text)
    self.SwitchText = tostring(text or "显示界面")
    return self
end

function Window:SetSwitchVisible(state)
    if self.FloatSwitch then
        self.FloatSwitch.Visible = state ~= false
    end
    if self.MinBar then
        -- 小条是收起后的唯一入口，不允许藏（藏了就找不回来了）
        self.MinBar.Visible = (state ~= false) and self.Minimized == true
    end
    return self
end

-- 把开关 / 小条挪回窗口右上角（被拖走之后想复位就调这个）
function Window:ResetSwitchPosition()
    self._switchPinned = true
    self._minBarPos = nil
    self._minBarPinned = false
    self:_placeSwitch()
    if self.Minimized then
        self:_placeMinBar()
    end
    return self
end

--//----------------------------------------------------------------------------
--// 23.4 关闭脚本（带确认）
--//----------------------------------------------------------------------------

function WobsinsUI:OnShutdown(fn)
    if type(fn) ~= "function" then
        return self
    end
    self.ShutdownHooks = self.ShutdownHooks or {}
    table.insert(self.ShutdownHooks, fn)
    return self
end

function WobsinsUI:IsClosed()
    return self.Closed == true
end

-- 真正销毁：界面、单例、genv 一起清掉
function WobsinsUI:Shutdown()
    if self.ShuttingDown then
        return self
    end
    self.ShuttingDown = true
    self.Closed = true

    for _, fn in ipairs(self.ShutdownHooks or {}) do
        safeCall(fn)
    end

    pcall(function()
        self:Destroy()
    end)

    self.ShuttingDown = false
    return self
end

function Window:Shutdown()
    if self.Destroyed or self.ShutdownRequested then
        return self
    end
    self.ShutdownRequested = true

    -- 先收起再销毁，别「啪一下全没」
    if self.Stage and not self.Minimized then
        pcall(function()
            self:SetMinimized(true)
        end)
    end

    local win = self
    U.delay(0.16, function()
        if win.Destroyed then
            return
        end
        WobsinsUI:Shutdown()
    end)

    return self
end

function Window:RequestClose()
    if self.Destroyed or self.Closing then
        return self
    end

    local config = self.Config or {}

    -- 明确写 false 才跳过确认，默认一定有
    if config.ConfirmClose == false then
        return self:Shutdown()
    end

    self.Closing = true

    local title = config.CloseTitle or "关闭脚本"
    local content = config.CloseContent
        or "确定要关闭脚本并退出吗？\n\n关闭后界面会一并销毁，需要重新执行脚本才能再次打开。"

    local modal
    modal = WobsinsUI:Dialog({
        Window = self,
        Title = title,
        Subtitle = "WobsinsUI v" .. tostring(WobsinsUI.Version),
        Content = content,
        Icon = "power",
        Dismissable = true,
        Buttons = {
            {
                Title = "取消",
                Width = 88,
                Callback = function()
                    self.Closing = false
                end,
            },
            {
                Title = "关闭脚本",
                Width = 104,
                Variant = "Primary",
                Icon = "power",
                Callback = function()
                    self.Closing = false
                    self:Shutdown()
                end,
            },
        },
    })

    -- 点遮罩 / Esc 关掉弹窗时，把 Closing 解锁，否则以后再也点不开
    if modal then
        local rawClose = modal.Close
        modal.Close = function(self_, ...)
            if not self_.Closed then
                self.Closing = false
            end
            return rawClose(self_, ...)
        end
        self.CloseModal = modal
    end

    return self
end

--//----------------------------------------------------------------------------
--// 23.5 收尾：构建最小化小条 / 常驻开关
--//----------------------------------------------------------------------------

local _createWindowPrev = WobsinsUI._createWindow

function WobsinsUI:_createWindow(config)
    local win = _createWindowPrev(self, config)
    if win and not win.Destroyed then
        pcall(function()
            win:_buildMinBar(config)
        end)
        pcall(function()
            win:_buildFloatSwitch(config)
        end)
    end
    return win
end

--//============================================================================
--// 24. 液态玻璃
--//============================================================================
--
-- Roblox 没有真正的实时背景模糊，所以「液态玻璃」用几层叠出来的：
--   1. 底部渐变底色    —— 上浅下深，让面板有厚度
--   2. 边缘高光描边    —— 左上亮、右下隐，模拟玻璃「吃光」的棱边
--   3. 顶部光泽        —— 一层极淡的白色渐变，像灯打在一整块玻璃上
--   4. 斜向光条        —— 对角划过的一抹反光，最出「玻璃味」的一层
--   5. 漂浮光斑        —— 两三团柔光在玻璃内部缓慢漂移（动态）
--   6. 鼠标光斑        —— 跟着鼠标走的一团微光（动态，浅色更明显）
-- 全部都是普通 Frame + UIGradient，不挡点击、不吃帧数。
--
-- 开关：CreateWindow({ LiquidGlass = false })，或全局 WobsinsUI.LiquidGlass = false。

local white = Color3.new(1, 1, 1)

local function colorSeq(c0, c1)
    return ColorSequence.new(
        ColorSequenceKeypoint.new(0, c0),
        ColorSequenceKeypoint.new(1, c1 or c0)
    )
end

local function numSeq(a0, a1)
    return NumberSequence.new(
        NumberSequenceKeypoint.new(0, a0),
        NumberSequenceKeypoint.new(1, a1 or a0)
    )
end

-- 给一个透明 Frame 挂上线性渐变。透明度全部编码在渐变里（元素底色全透明），
-- 这样主题切换 / 深浅色切换时只需原地换渐变，不用重建节点。
local function addGradient(inst, rotation, c0, a0, c1, a1)
    return new("UIGradient", {
        Rotation = rotation,
        Color = colorSeq(c0, c1),
        Transparency = numSeq(a0, a1),
    }, inst)
end

-- 深浅色两套参数。数值全是「透明度」：越小越实、越大越透。
function Window:_glassPalette()
    local mode = self.ThemeTable and self.ThemeTable.Mode or "Dark"
    if mode == "Light" then
        return {
            backdropTop = Color3.new(1, 1, 1), backdropTopA = 0.50,
            backdropBottom = self:Color("SurfaceAlt"), backdropBottomA = 0.72,
            edgeC = white, edgeC1 = self:Color("SubText"), edgeA0 = 0.15, edgeA1 = 0.45,
            sheenA0 = 0.62, sheenA1 = 1.0,
            streakA0 = 0.78, streakA1 = 1.0,
            blobC = white, blobA = 0.86,
            accentA = 0.87,
            frontA0 = 0.74, frontA1 = 1.0,
            cursorC = white, cursorA = 0.91,
        }
    end
    return {
        backdropTop = self:Color("SurfaceAlt"), backdropTopA = 0.62,
        backdropBottom = self:Color("Background"), backdropBottomA = 0.82,
        edgeC = white, edgeC1 = white, edgeA0 = 0.40, edgeA1 = 0.97,
        sheenA0 = 0.84, sheenA1 = 1.0,
        streakA0 = 0.93, streakA1 = 1.0,
        blobC = white, blobA = 0.965,
        accentA = 0.96,
        frontA0 = 0.92, frontA1 = 1.0,
        cursorC = white, cursorA = 0.975,
    }
end

function Window:_buildLiquidGlass(config)
    if not self.LiquidGlass or not self.Main then
        return
    end
    local radius = self.Radius or 6
    local main = self.Main

    -- 光效容器：夹在主体与内容之间，圆角裁掉溢出
    local glass = new("Frame", {
        Name = "LiquidGlass",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Glass,
    }, main)
    U.corner(glass, radius)
    self.GlassLayer = glass

    -- 1) 底部渐变底色
    local backdrop = new("Frame", {
        Name = "GlassBackdrop",
        BackgroundColor3 = self:Color("Background"),
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = WobsinsUI.Layers.Glass,
    }, glass)
    U.corner(backdrop, radius)
    self.GlassBackdrop = backdrop
    self.GlassBackdropGrad = addGradient(backdrop, 90, white, 0, white, 0)

    -- 2) 边缘高光：一条带渐变的白描边，左上亮、右下隐
    local edge = new("Frame", {
        Name = "GlassEdge",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = WobsinsUI.Layers.Glass,
    }, glass)
    U.corner(edge, radius)
    self.GlassEdge = edge
    self.GlassEdgeStroke = U.stroke(edge, white, 1.5, 0)
    pcall(function()
        -- 老执行器不支持给 UIStroke 挂渐变时，退回一条纯描边，不影响使用
        self.GlassEdgeGrad = addGradient(self.GlassEdgeStroke, -45, white, 0.1, white, 0.9)
    end)

    -- 3) 顶部光泽
    local sheen = new("Frame", {
        Name = "GlassSheen",
        BackgroundColor3 = white,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0.44, 0),
        Position = UDim2.fromScale(0, 0),
        ZIndex = WobsinsUI.Layers.Glass,
    }, glass)
    U.corner(sheen, radius)
    self.GlassSheen = sheen
    self.GlassSheenGrad = addGradient(sheen, 90, white, 0.9, white, 1)

    -- 4) 斜向光条（对角反光）
    local streak = new("Frame", {
        Name = "GlassStreak",
        BackgroundColor3 = white,
        BackgroundTransparency = 1,
        Size = UDim2.new(1.1, 0, 0, 64),
        Position = UDim2.fromOffset(-40, -16),
        Rotation = -16,
        ZIndex = WobsinsUI.Layers.Glass,
    }, glass)
    self.GlassStreak = streak
    self.GlassStreakGrad = addGradient(streak, 90, white, 0.94, white, 1)

    -- 5) 漂浮光斑（动态）
    self._glassBlobs = {}
    self:_spawnGlassBlob("BlobA", 90, "blob", false)
    self:_spawnGlassBlob("BlobB", 60, "blob", false)
    self:_spawnGlassBlob("BlobC", 44, "accent", true)

    -- 6) 鼠标光斑（浮在内容之上、跟着鼠标走）。用一块极淡的扁平柔盘而不是
    --    渐变月牙：渐变在圆上会呈现明显的「半边亮」，静止截图里像一枚戒指。
    local cursor = new("Frame", {
        Name = "GlassCursor",
        BackgroundColor3 = white,
        BackgroundTransparency = 0.97,
        Size = UDim2.fromOffset(120, 120),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        ZIndex = WobsinsUI.Layers.Sheen,
    }, main)
    U.corner(cursor, 90)
    self.GlassCursor = cursor
    self._cursorTarget = Vector2.new(self.Width / 2, self.Height / 2)

    -- 前景光泽：压在内容上面、又比弹窗低的极淡高光，让整块面板连成一体
    local front = new("Frame", {
        Name = "FrontSheen",
        BackgroundColor3 = white,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0.38, 0),
        Position = UDim2.fromScale(0, 0),
        ZIndex = WobsinsUI.Layers.Sheen,
    }, main)
    U.corner(front, radius)
    self.FrontSheen = front
    self.FrontSheenGrad = addGradient(front, 90, white, 0.96, white, 1)

    -- 用鼠标移动更新目标点（不做逐帧 tween，靠下面的 chase 循环慢慢追上）
    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if self.Destroyed or not self._fxActive or not self.Main then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local abs = self.Main.AbsolutePosition
                local scale = self.ScaleValue or 1
                if scale <= 0 then
                    scale = 1
                end
                self._cursorTarget = Vector2.new(
                    (input.Position.X - abs.X) / scale,
                    (input.Position.Y - abs.Y) / scale
                )
            end
        end)
    end

    self:_refreshGlassTint()
    self._fxActive = true

    -- 粒子场（25 模块）：要在 _fxActive 生效之后再建，粒子才会开始漂
    if self._buildParticles then
        self:_buildParticles(config)
    end

    self:_chaseCursor()
end

-- 强调色光斑要按深浅色取不同色调：深色主题直接用强调色，浅色主题把强调色
-- 往白里掺，得到一抹柔和的粉彩，避免在浅底上变成一块「脏灰」。
function Window:_glassAccent()
    local accent = self:Color("Accent")
    local mode = self.ThemeTable and self.ThemeTable.Mode or "Dark"
    if mode == "Light" then
        return U.mix(accent, white, 0.6)
    end
    return U.mix(accent, white, 0.25)
end

-- 生成一团柔光，然后进入漂移循环
function Window:_spawnGlassBlob(name, size, kind, accent)
    local glass = self.GlassLayer
    if not glass then
        return
    end
    local color = accent and self:_glassAccent() or white
    -- 扁平柔盘：透明底 + 极低不透明度的实心圆。不挂渐变 ——
    -- 线性渐变落在圆上会变成「半边亮」的月牙，截图里像一枚戒指。
    local blob = new("Frame", {
        Name = name,
        BackgroundColor3 = color,
        BackgroundTransparency = 0.96,
        Size = UDim2.fromOffset(size, size),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(math.random() * self.Width, math.random() * self.Height),
        ZIndex = WobsinsUI.Layers.Glass,
    }, glass)
    U.corner(blob, size / 2)
    blob._size = size
    blob._accent = accent
    table.insert(self._glassBlobs, blob)
    self:_driftBlob(blob)
    return blob
end

-- 光斑漂移：一段 tween 结束后再随机下一个目标。用 Completed 回调续命，
-- 不用 wait 循环（老执行器 / 无头测试里 wait 会直接空转）。
function Window:_driftBlob(blob)
    if self.Destroyed or not self._fxActive or not blob or not blob.Parent then
        return
    end
    local margin = (blob._size or 150) * 0.3
    local tx = U.clamp(math.random() * self.Width, margin, math.max(margin, self.Width - margin))
    local ty = U.clamp(math.random() * self.Height, margin, math.max(margin, self.Height - margin))
    local dur = 5 + math.random() * 6
    local tw = U.tween(blob, dur, {
        Position = UDim2.fromOffset(tx, ty),
    }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    if tw and tw.Completed then
        tw.Completed:Once(function()
            self:_driftBlob(blob)
        end)
    end
end

-- 鼠标光斑慢慢追上目标点（同样用 Completed 续命）
function Window:_chaseCursor()
    if self.Destroyed or not self._fxActive or not self.GlassCursor then
        return
    end
    local target = self._cursorTarget
    if target then
        local tw = U.tween(self.GlassCursor, 0.6, {
            Position = UDim2.fromOffset(target.X, target.Y),
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        if tw and tw.Completed then
            tw.Completed:Once(function()
                self:_chaseCursor()
            end)
            return
        end
    end
    -- 没有 tween 可续（目标丢失）时也不空转，等下一次调用
end

-- 主题 / 深浅色切换时原地重刷所有渐变的颜色与透明度
function Window:_refreshGlassTint()
    if not self.LiquidGlass or not self.GlassLayer then
        return
    end
    local p = self:_glassPalette()

    local function set(grad, c0, a0, c1, a1)
        if not grad then
            return
        end
        pcall(function()
            grad.Color = colorSeq(c0, c1)
            grad.Transparency = numSeq(a0, a1)
        end)
    end

    set(self.GlassBackdropGrad, p.backdropTop, p.backdropTopA, p.backdropBottom, p.backdropBottomA)
    set(self.GlassSheenGrad, white, p.sheenA0, white, p.sheenA1)
    set(self.GlassStreakGrad, white, p.streakA0, white, p.streakA1)
    set(self.FrontSheenGrad, white, p.frontA0, white, p.frontA1)
    if self.GlassCursor then
        self.GlassCursor.BackgroundColor3 = p.cursorC
        self.GlassCursor.BackgroundTransparency = p.cursorA
    end

    if self.GlassEdgeStroke then
        self.GlassEdgeStroke.Color = p.edgeC
    end
    if self.GlassEdgeGrad then
        set(self.GlassEdgeGrad, p.edgeC, p.edgeA0, p.edgeC1 or p.edgeC, p.edgeA1)
    end

    for _, blob in ipairs(self._glassBlobs or {}) do
        local c = blob._accent and self:_glassAccent() or p.blobC
        local a = blob._accent and p.accentA or p.blobA
        blob.BackgroundColor3 = c
        blob.BackgroundTransparency = a
    end
    if self.GlassEdgeStroke and (self.ThemeTable and self.ThemeTable.Mode == "Light") then
        self.GlassEdgeStroke.Thickness = 2
    end
end

-- 窗口尺寸变化后：夹住鼠标光斑目标，避免它跑到面板外
function Window:_layoutGlass()
    if not self.LiquidGlass then
        return
    end
    if self._cursorTarget then
        self._cursorTarget = Vector2.new(
            U.clamp(self._cursorTarget.X, 0, self.Width),
            U.clamp(self._cursorTarget.Y, 0, self.Height)
        )
    end
end

-- 暂停 / 恢复所有动态光效（最小化时省帧）
function Window:_setFxActive(state)
    self._fxActive = state and true or false
    if state then
        -- 恢复时把漂移循环重新拉起来
        for _, blob in ipairs(self._glassBlobs or {}) do
            self:_driftBlob(blob)
        end
        self:_chaseCursor()
    end
    -- 粒子场在 25 模块里定义，这里只做转发
    if self._resumeParticles then
        self:_resumeParticles(state)
    end
end

-- 运行时开关
function Window:SetLiquidGlass(state)
    self.LiquidGlass = state ~= false
    if not self.LiquidGlass then
        if self.GlassLayer then
            self.GlassLayer.Visible = false
        end
        if self.GlassCursor then
            self.GlassCursor.Visible = false
        end
        if self.FrontSheen then
            self.FrontSheen.Visible = false
        end
        return self
    end
    if not self.GlassLayer then
        self:_buildLiquidGlass(self.Config or {})
        return self
    end
    self.GlassLayer.Visible = true
    if self.GlassCursor then
        self.GlassCursor.Visible = true
    end
    if self.FrontSheen then
        self.FrontSheen.Visible = true
    end
    self:_setFxActive(true)
    return self
end

--//============================================================================
--// 25. 动态粒子
--//============================================================================
--
-- 在窗口内部撒一层缓慢漂浮的微光粒子：大多数是柔光圆点，少数是星形闪光，
-- 颜色以白为主、掺一两颗强调色，像悬浮在玻璃里的尘埃 / 星屑。
--
-- 性能：桌面 16 颗、小屏 10 颗，每颗只是一个小 Frame + 一个渐变 + 一段
-- tween，帧开销可忽略。最小化时会整体暂停。
--
-- 开关：CreateWindow({ Particles = false })、CreateWindow({ ParticleCount = 24 })，
-- 或全局 WobsinsUI.Particles = false / WobsinsUI.ParticleCount = 16。

local white = Color3.new(1, 1, 1)
local SPARKLES = { "✦", "✧", "·", "⋆" }

local function numSeq(a0, a1)
    return NumberSequence.new(
        NumberSequenceKeypoint.new(0, a0),
        NumberSequenceKeypoint.new(1, a1 or a0)
    )
end

function Window:_buildParticles(config)
    if not self.Particles or not self.Main then
        return
    end

    local main = self.Main
    local field = new("Frame", {
        Name = "ParticleField",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Particle,
    }, main)
    U.corner(field, self.Radius or 6)
    self.ParticleField = field

    local count = self.ParticleCount
    if not count or count <= 0 then
        count = (self.Width >= 620) and 16 or 10
    end
    count = U.clamp(math.floor(count), 0, 40)

    -- 粒子颜色按深浅色取：深色用白、偶尔掺强调色；浅色用强调色的粉彩版，
    -- 白色粒子落在白底上等于隐形。
    local mode = self.ThemeTable and self.ThemeTable.Mode or "Dark"
    local accent = self:Color("Accent")
    local base = white
    if mode == "Light" then
        base = U.mix(accent, white, 0.5)
    end

    self._particles = {}
    for i = 1, count do
        self:_spawnParticle(field, accent, base, i)
    end
end

function Window:_spawnParticle(field, accent, base, index)
    local isSparkle = (index % 4 == 0)
    local size = 3 + math.random() * 4
    local color = base
    if index % 7 == 0 then
        color = accent
    end

    local p
    if isSparkle then
        p = new("TextLabel", {
            BackgroundTransparency = 1,
            Text = SPARKLES[(index % #SPARKLES) + 1],
            TextColor3 = color,
            TextTransparency = 0.55,
            Font = Enum.Font.GothamBold,
            TextSize = math.max(8, math.floor(size * 2.4)),
            Size = UDim2.fromOffset(size * 2.4, size * 2.4),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(math.random() * self.Width, math.random() * self.Height),
            ZIndex = WobsinsUI.Layers.Particle,
        }, field)
    else
        p = new("Frame", {
            BackgroundColor3 = color,
            BackgroundTransparency = 0.55,
            Size = UDim2.fromOffset(size, size),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(math.random() * self.Width, math.random() * self.Height),
            ZIndex = WobsinsUI.Layers.Particle,
        }, field)
        U.corner(p, size / 2)
        -- 渐变只做「柔边」，透明度交给 BackgroundTransparency 控制呼吸
        pcall(function()
            p._soft = new("UIGradient", {
                Rotation = 135,
                Color = ColorSequence.new(
                    ColorSequenceKeypoint.new(0, color),
                    ColorSequenceKeypoint.new(1, color)
                ),
                Transparency = numSeq(0.15, 1),
            }, p)
        end)
    end

    p._particle = true
    p._size = size
    p._sparkle = isSparkle
    table.insert(self._particles, p)
    self:_driftParticle(p)
    return p
end

-- 粒子动画：位置漂移 + 透明度呼吸，全部用 Completed 回调续命（同 24 的
-- 光斑，避免 wait 空转）。每一段随机方向、随机时长，看起来没有机械感。
function Window:_driftParticle(p)
    if self.Destroyed or not self._fxActive or not p or not p.Parent then
        return
    end
    local range = 60 + math.random() * 90
    local px = p.Position.X.Offset
    local py = p.Position.Y.Offset
    local tx = U.clamp(px + (math.random() - 0.5) * 2 * range, 4, math.max(4, self.Width - 4))
    local ty = U.clamp(py + (math.random() - 0.5) * 2 * range, 4, math.max(4, self.Height - 4))
    local dur = 2.5 + math.random() * 3.5

    local props = { Position = UDim2.fromOffset(tx, ty) }
    if p._sparkle then
        props.TextTransparency = 0.35 + math.random() * 0.45
        props.Rotation = (math.random() - 0.5) * 120
    else
        props.BackgroundTransparency = 0.35 + math.random() * 0.45
    end

    local tw = U.tween(p, dur, props, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    if tw and tw.Completed then
        tw.Completed:Once(function()
            self:_driftParticle(p)
        end)
    end
end

function Window:_resumeParticles(state)
    if not self.Particles then
        return
    end
    if state then
        for _, p in ipairs(self._particles or {}) do
            self:_driftParticle(p)
        end
    end
end

function Window:SetParticles(state)
    self.Particles = state ~= false
    if self.ParticleField then
        self.ParticleField.Visible = self.Particles
    end
    if self.Particles then
        if not self.ParticleField then
            self:_buildParticles(self.Config or {})
        else
            self:_resumeParticles(true)
        end
    end
    return self
end

return WobsinsUI
