function Build.Toggle(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local state = config.Value == true

    local row, top, title, desc, control = I.row(card, config, 38)

    local track = new("Frame", {
        BackgroundColor3 = theme.SurfaceHover,
        Size = UDim2.fromOffset(34, 19),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    U.corner(track, 10)
    local trackStroke = U.stroke(track, theme.Outline, 1, 0.5)

    local knob = new("Frame", {
        BackgroundColor3 = theme.Muted,
        Size = UDim2.fromOffset(15, 15),
        Position = UDim2.fromOffset(2, 2),
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, track)
    U.corner(knob, 8)

    local element = {
        Type = "Toggle",
        Frame = row,
        Value = state,
        Callback = config.Callback,
    }

    local lightMode = theme.Mode == "Light"

    local function render(animate, silent)
        local onColor = win:Color("Accent")
        -- 关闭态不要用 Outline：浅色主题里它本身就是青色，会和开启态撞色
        local offColor = lightMode
            and U.mix(win:Color("Outline"), win:Color("Background"), 0.55)
            or win:Color("Outline")
        local knobOn = lightMode and Color3.fromRGB(255, 255, 255) or win:Color("OnAccent")
        local knobOff = lightMode and Color3.fromRGB(255, 255, 255) or win:Color("SubText")
        local targetX = state and 17 or 2

        if animate then
            U.tween(knob, 0.16, { Position = UDim2.fromOffset(targetX, 2) }, Enum.EasingStyle.Quad)
            U.tween(track, 0.16, { BackgroundColor3 = state and onColor or offColor })
            U.tween(knob, 0.16, { BackgroundColor3 = state and knobOn or knobOff })
            U.tween(trackStroke, 0.16, { Transparency = state and 0.9 or 0.15 })
        else
            knob.Position = UDim2.fromOffset(targetX, 2)
            track.BackgroundColor3 = state and onColor or offColor
            knob.BackgroundColor3 = state and knobOn or knobOff
            trackStroke.Transparency = state and 0.9 or 0.15
        end

        if silent ~= true and config.Callback then
            safeCall(config.Callback, state)
        end
    end

    function element.GetValue()
        return state
    end

    I.setter(element, function(value)
        local nextState = value == true
        if nextState == state then
            return
        end
        state = nextState
        element.Value = state
        render(true)
    end)

    function element.SetSilent(a, b)
        local value = I.arg(a, b)
        state = value == true
        element.Value = state
        render(true, true)
    end

    local function toggle()
        if element.Locked then
            return
        end
        state = not state
        element.Value = state
        render(true)
    end

    -- 只挂一次：行级点击即可切换，避免 track 和 row 同时触发导致切两次
    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            toggle()
        end
    end)

    U.hover(track, function()
        U.tween(trackStroke, 0.12, { Transparency = 0.15 })
    end, function()
        U.tween(trackStroke, 0.12, { Transparency = state and 0.9 or 0.5 })
    end)

    win:_onTheme(function()
        render(false, true)
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    return I.finish(card, element, config)
end

