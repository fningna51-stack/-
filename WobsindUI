    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 14)
    end)

    -- 切主题后重新刷一遍选中态（图标是 tint 上去的，不走颜色绑定）
    self:_onTheme(function()
        if self.ActiveTab then
            for _, item in ipairs(self.Tabs or {}) do
                self:_paintTab(item, item == self.ActiveTab)
            end
        end
    end)

    -- 用户卡片
    if userHeight > 0 then
        self:_buildUserCard(config)
    end
end

