        PlaceholderText = config.Placeholder or "输入内容…",
        PlaceholderColor3 = theme.Muted,
        Text = tostring(config.Value or ""),
        TextColor3 = theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = self.Layers.ModalCard + 2,
    }, holder)

    local buttons = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = 3,
        ZIndex = self.Layers.ModalCard + 1,
    }, modal.ContentHolder)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, buttons)

    local function makeButton(title, primary, callback)
        local btn = new("TextButton", {
            BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
            AutoButtonColor = false,
            Size = UDim2.fromOffset(78, 26),
            Text = "",
            ZIndex = self.Layers.ModalCard + 2,
        }, buttons)
        U.corner(btn, 4)
        U.stroke(btn, theme.Outline, 1, primary and 1 or 0.4)

        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamMedium,
            Text = title,
            TextColor3 = primary and theme.OnAccent or theme.Text,
            TextSize = 11,
            ZIndex = self.Layers.ModalCard + 3,
        }, btn)

        btn.Activated:Connect(function()
            if callback then
                safeCall(callback)
            end
        end)
        return btn
    end

    makeButton("取消", false, function()
        modal:Close()
    end)
    makeButton("确定", true, function()
        local text = box.Text
        modal:Close()
        if config.OnConfirm then
            safeCall(config.OnConfirm, text)
        end
    end)

    box.Focused:Connect(function()
        holderStroke.Color = theme.Accent
    end)
    box.FocusLost:Connect(function(enter)
        holderStroke.Color = theme.Outline
        if enter then
            local text = box.Text
            modal:Close()
            if config.OnConfirm then
                safeCall(config.OnConfirm, text)
            end
        end
    end)

    if config.Focus ~= false then
        U.spawn(function()
            U.wait(0.1)
            pcall(function()
                box:CaptureFocus()
            end)
        end)
    end

    return modal
end

--//----------------------------------------------------------------------------
--// 19.5 配置自动保存
--//----------------------------------------------------------------------------

function ConfigManager:SaveAll()
    local saved = 0
    for _, config in pairs(self.Configs) do
        if config:Save() then
            saved = saved + 1
        end
    end
    return saved
end

function ConfigManager:LoadAll()
    local loaded = 0
    for _, config in pairs(self.Configs) do
        if config:Load() then
            loaded = loaded + 1
        end
    end
    return loaded
end

-- 每隔 interval 秒把所有配置写盘；返回一个可以 Stop 的句柄
function ConfigManager:StartAutoSave(interval)
    if self._autoSaveToken then
        return self
    end
    local token = {}
    self._autoSaveToken = token

    U.spawn(function()
        while self._autoSaveToken == token and self.Window and not self.Window.Destroyed do
            U.wait(interval or 30)
            if self._autoSaveToken ~= token then
                break
            end
            self:SaveAll()
        end
    end)

    return self
end

function ConfigManager:StopAutoSave()
    self._autoSaveToken = nil
    return self
end

