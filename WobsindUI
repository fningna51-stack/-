local notifyStack = nil
local notifyCount = 0
WobsinsUI.NotifyLimit = 4

local function ensureNotifyStack()
    local screen = WobsinsUI:_screen()
    if notifyStack and notifyStack.Parent then
        return notifyStack
    end

    notifyStack = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 300, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(1, -16, 0, 16),
        AnchorPoint = Vector2.new(1, 0),
        ZIndex = WobsinsUI.Layers.Toast,
    }, screen)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, notifyStack)

    return notifyStack
end

-- config:
--   Title / Content / Icon / Duration / Window / Accent / Actions
-- 通知历史：面板 / 外部读取都从这里拿
WobsinsUI.NotifyHistory = {}

function WobsinsUI:_recordNotify(config)
    local history = self.NotifyHistory
    table.insert(history, 1, {
        Title = tostring(config.Title or "通知"),
        Content = tostring(config.Content or ""),
        Icon = config.Icon or "bell",
        Time = os.time(),
        Read = false,
    })
    local limit = self.NotifyHistoryLimit or 60
    while #history > limit do
        table.remove(history)
    end
    self.UnreadNotify = (self.UnreadNotify or 0) + 1
    if self._notifyHooks then
        for _, fn in ipairs(self._notifyHooks) do
            safeCall(fn, history[1])
        end
    end
end

function WobsinsUI:OnNotify(fn)
    if type(fn) ~= "function" then
        return self
    end
    self._notifyHooks = self._notifyHooks or {}
    table.insert(self._notifyHooks, fn)
    return self
end

function WobsinsUI:GetNotifications()
    return self.NotifyHistory
end

function WobsinsUI:ClearNotifications()
    self.NotifyHistory = {}
    self.UnreadNotify = 0
    return self
end

function WobsinsUI:MarkNotificationsRead()
    for _, item in ipairs(self.NotifyHistory) do
        item.Read = true
    end
    self.UnreadNotify = 0
    return self
end

function WobsinsUI:Notify(config)
    config = config or {}
    pcall(function()
        self:_recordNotify(config)
    end)
    if notifyCount >= (self.NotifyLimit or 4) then
        -- 超过上限时移除最旧的一条
        local stack = ensureNotifyStack()
        local first = stack:FindFirstChildOfClass("Frame")
        if first then
            first:Destroy()
        end
        notifyCount = math.max(notifyCount - 1, 0)
    end

    local stack = ensureNotifyStack()
    local theme = themeOf(config.Window)
    local duration = config.Duration
    if duration == nil then
        duration = 4
    end

    local card = new("Frame", {
        Name = "Toast",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
        LayoutOrder = notifyCount,
        ZIndex = WobsinsUI.Layers.Toast,
    }, stack)
    U.corner(card, 6)

    local cardStroke = U.stroke(card, theme.Outline, 1, 1)
    cardStroke.Transparency = 1

    -- 左侧强调条
    local bar = new("Frame", {
        BackgroundColor3 = config.Accent and U.color(config.Accent) or theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 2, 1, -16),
        Position = UDim2.fromOffset(0, 8),
        ZIndex = WobsinsUI.Layers.Toast + 1,
    }, card)
    U.corner(bar, 1)

    local pad = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.Toast + 1,
    }, card)
    U.padding(pad, 10, 9, 10, 9)

    local row = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = WobsinsUI.Layers.Toast + 1,
    }, pad)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }, row)

    local iconColor = config.Accent and U.color(config.Accent) or theme.Accent
    local iconObj = nil
    if config.Icon and config.Icon ~= "" then
        iconObj = U.icon(row, config.Icon, 15, iconColor, WobsinsUI.Layers.Toast + 2)
        if iconObj then
            iconObj.LayoutOrder = 1
            iconObj.Position = UDim2.fromOffset(0, 1)
        end
    end

    local textCol = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, config.Icon and -23 or 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.Toast + 1,
    }, row)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, textCol)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = config.Title or "提示",
        TextColor3 = theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        LayoutOrder = 1,
        ZIndex = WobsinsUI.Layers.Toast + 2,
    }, textCol)

    local contentLabel = nil
    if config.Content and config.Content ~= "" then
        contentLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = config.Content,
            TextColor3 = theme.SubText,
            TextSize = 10.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2,
            ZIndex = WobsinsUI.Layers.Toast + 2,
        }, textCol)
    end

    local close

    -- 操作按钮（可选）
    if config.Actions and #config.Actions > 0 then
        local actionRow = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 24),
            LayoutOrder = 3,
            ZIndex = WobsinsUI.Layers.Toast + 2,
        }, textCol)
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, actionRow)

        for index, action in ipairs(config.Actions) do
            local primary = action.Variant == "Primary"
            local actionBtn = new("TextButton", {
                BackgroundColor3 = primary and theme.Accent or theme.SurfaceAlt,
                AutoButtonColor = false,
                Size = UDim2.new(0, 0, 1, 0),
                AutomaticSize = Enum.AutomaticSize.X,
                Text = "",
                LayoutOrder = index,
                ZIndex = WobsinsUI.Layers.Toast + 3,
            }, actionRow)
            U.corner(actionBtn, 3)
            U.padding(actionBtn, 10, 0, 10, 0)

            local actionLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Font = Enum.Font.GothamMedium,
                Text = action.Title or "操作",
                TextColor3 = primary and theme.OnAccent or theme.Text,
                TextSize = 9.5,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = WobsinsUI.Layers.Toast + 4,
            }, actionBtn)

            actionBtn.Activated:Connect(function()
                if action.Callback then
                    safeCall(action.Callback)
                end
                if action.Close ~= false then
                    close()
                end
            end)
        end
    end

    -- 进度条
    local progress = nil
    if duration and duration > 0 then
        progress = new("Frame", {
            BackgroundColor3 = theme.Accent,
            BackgroundTransparency = 0.65,
            Size = UDim2.new(1, 0, 0, 1),
            Position = UDim2.new(0, 0, 1, -1),
            ZIndex = WobsinsUI.Layers.Toast + 2,
        }, card)
    end

    notifyCount = notifyCount + 1

    -- 入场
    U.tween(card, 0.22, {
        BackgroundTransparency = 0.02,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    U.tween(cardStroke, 0.22, { Transparency = 0.35 })
    U.tween(bar, 0.22, { BackgroundTransparency = 0 })
    U.tween(title, 0.2, { TextTransparency = 0 })
    if contentLabel then
        U.tween(contentLabel, 0.2, { TextTransparency = 0 })
    end

    local closed = false
    local lifetime = nil

    close = function()
        if closed then
            return
        end
        closed = true
        if lifetime and lifetime.Cancel then
            lifetime:Cancel()
        end
        notifyCount = math.max(notifyCount - 1, 0)
        U.tween(card, 0.18, {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(card.Position.X.Offset + 12, card.Position.Y.Offset),
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        U.tween(cardStroke, 0.18, { Transparency = 1 })
        U.tween(bar, 0.18, { BackgroundTransparency = 1 })
        U.tween(title, 0.16, { TextTransparency = 1 })
        if contentLabel then
            U.tween(contentLabel, 0.16, { TextTransparency = 1 })
        end
        U.delay(0.2, function()
            if card and card.Parent then
                card:Destroy()
            end
        end)
    end

    if progress then
        progress.Size = UDim2.new(1, 0, 0, 1)
        U.tween(progress, duration, {
            Size = UDim2.new(0, 0, 0, 1),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Linear)
        lifetime = U.delay(duration, close)
    end

    -- 点击关闭
    local clickArea = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = WobsinsUI.Layers.Toast + 3,
    }, card)
    clickArea.Activated:Connect(close)

    local toast = { Frame = card, Close = close }
    return toast
end

--//----------------------------------------------------------------------------
--// 8.2 模态窗（Dialog / Popup / 自定义）
--//----------------------------------------------------------------------------

function WobsinsUI:_modal(config)
    config = config or {}
    local screen = self:_screen()
    local theme = themeOf(config.Window)

    local overlay = new("Frame", {
        Name = "WobsinsModal",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = self.Layers.Modal,
        Visible = true,
    }, screen)

    -- 用 TextButton 当卡片，点空白处不会穿透到后面的遮罩（Frame 不吞输入）
    local card = new("TextButton", {
        AutoButtonColor = false,
        Text = "",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        -- 显式高度是「最小高度」：AutomaticSize 负责撑开，算不出来时也能兜底
        Size = UDim2.fromOffset(config.Width or 400, config.MinHeight or 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = true,
        ZIndex = self.Layers.ModalCard,
    }, overlay)
    U.corner(card, 8)
    U.stroke(card, theme.Outline, 1, 1)
    U.padding(card, 16, 16, 16, 14)

    -- 顶部强调细线
    local trim = new("Frame", {
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 0.4,
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.fromOffset(0, 0),
        ZIndex = self.Layers.ModalCard + 1,
    }, card)

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = self.Layers.ModalCard + 1,
    }, card)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    -- 标题行
    local head = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = 1,
        ZIndex = self.Layers.ModalCard + 1,
    }, holder)

    local titleX = 0
    if config.Icon and config.Icon ~= "" then
        local ic = U.icon(head, config.Icon, 16, theme.Accent, self.Layers.ModalCard + 2)
        if ic then
            ic.Position = UDim2.fromOffset(0, 2)
        end
        titleX = 24
    end

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(titleX, 0),
        Size = UDim2.new(1, -titleX, 0, 17),
        Font = Enum.Font.GothamMedium,
        Text = config.Title or "提示",
        TextColor3 = theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = self.Layers.ModalCard + 2,
    }, head)

    local subtitle = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(titleX, 18),
        Size = UDim2.new(1, -titleX, 0, 15),
        Font = Enum.Font.Gotham,
        Text = config.Subtitle or ("WobsinsUI v" .. WobsinsUI.Version),
        TextColor3 = theme.Muted,
        TextSize = 9.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = self.Layers.ModalCard + 2,
    }, head)

    -- 内容区
    local contentHolder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        ZIndex = self.Layers.ModalCard + 1,
    }, holder)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, contentHolder)

    -- 正文高度直接算出来：三层 AutomaticSize 套在一起时，部分执行器
    -- 会把卡片高度算成 0，按钮就被挤到卡片外面去了。
    local contentText = config.Content or ""
    local wrapWidth = math.max(120, (config.Width or 400) - 32)
    local bodyHeight = 0
    if contentText ~= "" then
        local textService = service("TextService")
        local ok, bounds = false, nil
        if textService and textService.GetTextSize then
            ok, bounds = pcall(function()
                return textService:GetTextSize(contentText, 11, Enum.Font.Gotham, Vector2.new(wrapWidth, 2000))
            end)
        end
        if ok and bounds and (bounds.Y or 0) > 0 then
            bodyHeight = math.ceil(bounds.Y)
        else
            -- 兜底：按每行大约能塞多少字估算
            local lines = 0
            for line in tostring(contentText):gmatch("[^\n]*") do
                local width = 0
                for _, code in utf8.codes(line) do
                    width = width + (code >= 0x2E80 and 11 or 6.2)
                end
                lines = lines + math.max(1, math.ceil(width / wrapWidth))
            end
            bodyHeight = math.max(14, lines * 15)
        end
    end

    local body = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, bodyHeight),
        Font = Enum.Font.Gotham,
        Text = contentText,
        TextColor3 = theme.SubText,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 1,
        Visible = (contentText ~= ""),
        ZIndex = self.Layers.ModalCard + 2,
    }, contentHolder)

    -- 按钮区
    local buttonRow = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = 3,
        Visible = false,
        ZIndex = self.Layers.ModalCard + 1,
    }, holder)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, buttonRow)

    local modal = {
        Frame = overlay,
        Card = card,
        ContentHolder = contentHolder,
        ButtonRow = buttonRow,
        BodyHeight = bodyHeight,
        Closed = false,
    }

    function modal:Close()
        if self.Closed then
            return
        end
        self.Closed = true
        U.tween(overlay, 0.16, { BackgroundTransparency = 1 })
        U.tween(card, 0.16, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 6) })
        U.tween(trim, 0.16, { BackgroundTransparency = 1 })
        U.delay(0.18, function()
            if overlay and overlay.Parent then
                overlay:Destroy()
            end
        end)
    end

    -- 点遮罩关闭
    local backdrop = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = self.Layers.Modal,
    }, overlay)
    backdrop.MouseButton1Click:Connect(function()
        if config.Dismissable ~= false then
            modal:Close()
        end
    end)

    -- 入场
    U.tween(overlay, 0.18, { BackgroundTransparency = 0.45 })
    U.tween(card, 0.2, { BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })

    return modal
end

-- 对话框：标题 + 正文 + 一排按钮
-- config.Buttons = { { Title, Variant, Icon, Callback }, ... }
function WobsinsUI:Dialog(config)
    config = config or {}
    local modal = self:_modal(config)
    local theme = themeOf(config.Window)
    local buttons = config.Buttons or { { Title = "确定", Variant = "Primary" } }

    modal.ButtonRow.Visible = #buttons > 0

    -- 兜底高度：内边距 + 标题 + 正文 + 按钮行（各段间距 10）
    local minHeight = 16 + 14 + 36
    if (modal.BodyHeight or 0) > 0 then
        minHeight = minHeight + 10 + modal.BodyHeight
    end
    if #buttons > 0 then
        minHeight = minHeight + 10 + 28
    end
    modal.Card.Size = UDim2.fromOffset(config.Width or 400, minHeight)

    for index, info in ipairs(buttons) do
        local height = 26
        local btn = new("TextButton", {
            BackgroundColor3 = (info.Variant == "Primary") and theme.Accent or theme.SurfaceAlt,
            AutoButtonColor = false,
            Size = UDim2.fromOffset(info.Width or 84, height),
            Text = "",
            LayoutOrder = index,
            ZIndex = self.Layers.ModalCard + 2,
        }, modal.ButtonRow)
        U.corner(btn, 4)
        U.stroke(btn, theme.Outline, 1, (info.Variant == "Primary") and 1 or 0.4)

        local iconColor = (info.Variant == "Primary") and theme.OnAccent or theme.Text
        local iconObj = U.icon(btn, info.Icon, 12, iconColor, self.Layers.ModalCard + 3)
        if iconObj then
            iconObj.AnchorPoint = Vector2.new(0, 0.5)
            iconObj.Position = UDim2.new(0, 10, 0.5, 0)
        end

        local label = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamMedium,
            Text = info.Title or "按钮",
            TextColor3 = (info.Variant == "Primary") and theme.OnAccent or theme.Text,
            TextSize = 11,
            ZIndex = self.Layers.ModalCard + 3,
        }, btn)

        if info.Icon and iconObj then
            label.Position = UDim2.fromOffset(26, 0)
            label.Size = UDim2.new(1, -34, 1, 0)
        end

        btn.MouseEnter:Connect(function()
            U.tween(btn, 0.12, {
                BackgroundColor3 = (info.Variant == "Primary") and U.mix(theme.Accent, theme.Text, 0.12) or theme.SurfaceHover,
            })
        end)
        btn.MouseLeave:Connect(function()
            U.tween(btn, 0.12, {
                BackgroundColor3 = (info.Variant == "Primary") and theme.Accent or theme.SurfaceAlt,
            })
        end)
        btn.Activated:Connect(function()
            if info.Callback then
                safeCall(info.Callback)
            end
            if info.Close ~= false then
                modal:Close()
            end
        end)
    end

    return modal
end

function WobsinsUI:Popup(config)
    return self:Dialog(config)
end

