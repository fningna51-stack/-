local tooltipFrame = nil

local function ensureTooltip()
    local screen = WobsinsUI:_screen()
    if tooltipFrame and tooltipFrame.Parent then
        return tooltipFrame
    end
    local theme = themeOf(nil)
    tooltipFrame = new("Frame", {
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Toast + 5,
    }, screen)
    U.corner(tooltipFrame, 4)
    U.stroke(tooltipFrame, theme.Outline, 1, 0.2)

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = theme.SubText,
        TextSize = 10,
        ZIndex = WobsinsUI.Layers.Toast + 6,
    }, tooltipFrame)
    U.padding(tooltipFrame, 8, 0, 8, 0)

    tooltipFrame.Label = label
    return tooltipFrame
end

function U.tooltip(inst, text)
    if not inst or not text or text == "" then
        return
    end
    local token = 0
    inst.MouseEnter:Connect(function()
        token = token + 1
        local mine = token
        U.delay(0.35, function()
            if mine ~= token then
                return
            end
            local frame = ensureTooltip()
            frame.Label.Text = text
            frame.Visible = true
            frame.BackgroundTransparency = 0
            if Mouse then
                frame.Position = UDim2.fromOffset(Mouse.X + 12, Mouse.Y + 18)
            else
                frame.Position = UDim2.fromOffset(inst.AbsolutePosition.X, inst.AbsolutePosition.Y + 26)
            end
        end)
    end)
    inst.MouseLeave:Connect(function()
        token = token + 1
        local frame = tooltipFrame
        if frame then
            frame.Visible = false
        end
    end)
end

