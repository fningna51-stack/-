function Window:_buildHeader(config)
    local main = self.Main
    local theme = self.ThemeTable

    local header = new("Frame", {
        Name = "Header",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
        ZIndex = WobsinsUI.Layers.Header,
    }, main)
