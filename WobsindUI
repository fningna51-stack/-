--//============================================================================
--// 17. 数据表格（DataTable）
--//============================================================================
--
-- card:Table({
--     Title = "玩家列表",
--     Columns = {
--         { Key = "name",  Title = "名称", Width = 0.42 },
--         { Key = "level", Title = "等级", Width = 0.18, Align = "Right" },
--         { Key = "state", Title = "状态", Width = 0.40, Format = function(v) return v end },
--     },
--     Rows = { { name = "A", level = 12, state = "在线" } },
--     Height = 200, PageSize = 8, Sortable = true, Selectable = true,
--     OnSelect = function(row, index) end,
-- })
--
-- 方法：SetRows / AddRow / GetRows / SetQuery / Sort / Select / GetSelected / Refresh

local function colWidths(columns)

    local total = 0
    for _, col in ipairs(columns) do
        total = total + (col.Width or 1)
    end
    if total <= 0 then
        total = #columns
    end

    local widths = {}
    for index, col in ipairs(columns) do
        local weight = col.Width or 1
        if weight <= 1 then
            widths[index] = weight
        else
            widths[index] = weight / total
        end
    end
    return widths
end

local function cellText(value)
    if value == nil then
        return "—"
    end
    if type(value) == "table" then
        return tostring(value.Text or value.Value or "—")
    end
    return tostring(value)
end

local function asColor3(value)
    if type(value) == "table" and value.R and value.G and value.B then
        return value
    end
    if typeof and typeof(value) == "Color3" then
        return value
    end
    return nil
end

function L.Build.Table(card, config)
    local win = card.Window
    local theme = win.ThemeTable

    local columns = config.Columns or {
        { Key = "1", Title = "列 1", Width = 0.5 },
        { Key = "2", Title = "列 2", Width = 0.5 },
