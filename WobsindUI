--// 13.2 Slider
--//----------------------------------------------------------------------------

function Build.Slider(card, config)
    local win = card.Window
    local theme = win.ThemeTable

    local valueConfig = config.Value
    local minValue, maxValue, default = 0, 100, 0
    if type(valueConfig) == "table" then
        minValue = valueConfig.Min or 0
        maxValue = valueConfig.Max or 100
        default = valueConfig.Default or minValue
    elseif type(valueConfig) == "number" then
        maxValue = valueConfig
        default = valueConfig / 2
    end
    if maxValue <= minValue then
        maxValue = minValue + 1
    end

    local step = config.Step or 0
    local value = U.clamp(default, minValue, maxValue)
    if step > 0 then
        value = U.round(value, step)
    end

    local row, top, title, desc, control = I.row(card, config, 46)

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        Text = U.pretty(value, step),
        TextColor3 = theme.SubText,
        TextSize = 10.5,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    win:_bind(valueLabel, "TextColor3", "SubText")

    -- 轨道
    local extra = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        LayoutOrder = 2,
        ZIndex = WobsinsUI.Layers.RowItem,
    }, row)

    local rail = new("TextButton", {
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Size = UDim2.new(1, 0, 0, 16),
        ZIndex = WobsinsUI.Layers.RowItem,
    }, extra)

    local track = new("Frame", {
        BackgroundColor3 = theme.Outline,
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 0.5, -1.5),
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, rail)
    U.corner(track, 2)
    win:_bind(track, "BackgroundColor3", "Outline")

    local fill = new("Frame", {
        BackgroundColor3 = theme.Accent,
        Size = UDim2.new(0, 0, 0, 3),
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, track)
    U.corner(fill, 2)
    win:_bind(fill, "BackgroundColor3", "Accent")

    local knob = new("Frame", {
        BackgroundColor3 = theme.Mode == "Light" and Color3.fromRGB(255, 255, 255) or theme.Text,
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, rail)
    U.corner(knob, 6)
    local knobStroke = U.stroke(knob, theme.Background, 1, 0.25)
    win:_onTheme(function()
        knob.BackgroundColor3 = theme.Mode == "Light" and Color3.fromRGB(255, 255, 255) or win:Color("Text")
        knobStroke.Color = win:Color("Background")
    end)

    local element = {
        Type = "Slider",
        Frame = row,
        Value = value,
        Min = minValue,
        Max = maxValue,
        Step = step,
        Callback = config.Callback,
    }

    local function percent()
        if maxValue == minValue then
            return 0
        end
        return (value - minValue) / (maxValue - minValue)
    end

    local function paint()
        local pct = U.clamp(percent(), 0, 1)
        fill.Size = UDim2.new(pct, 0, 0, 3)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valueLabel.Text = U.pretty(value, step)
    end

    function element.GetValue()
        return value
    end

    I.setter(element, function(nextValue)
        nextValue = tonumber(nextValue) or value
        nextValue = U.clamp(nextValue, minValue, maxValue)
        if step > 0 then
            nextValue = U.round(nextValue, step)
        end
        if nextValue == value then
            return
        end
        value = nextValue
        element.Value = value
        paint()
        if config.Callback then
            safeCall(config.Callback, value)
        end
    end)

    local dragging = false

    local function updateFromPointer(input)
        local absX = rail.AbsolutePosition.X
        local width = rail.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local pct = U.clamp((input.Position.X - absX) / width, 0, 1)
        local nextValue = minValue + (maxValue - minValue) * pct
        if step > 0 then
            nextValue = U.round(nextValue, step)
        end
        if nextValue ~= value then
            value = nextValue
            element.Value = value
            paint()
            if config.Callback then
                safeCall(config.Callback, value)
            end
        end
    end

    rail.InputBegan:Connect(function(input)
        if element.Locked then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromPointer(input)
        end
    end)

    rail.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if S.UserInputService then
        S.UserInputService.InputChanged:Connect(function(input)
            if not dragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                updateFromPointer(input)
            end
        end)
    end

    U.hover(rail, function()
        U.tween(knob, 0.12, { Size = UDim2.fromOffset(13, 13) })
    end, function()
        U.tween(knob, 0.12, { Size = UDim2.fromOffset(11, 11) })
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
    end

    paint()
    return I.finish(card, element, config)
end

