function Build.Code(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local code = config.Code or ""
    local lines = 1
    for _ in string.gmatch(code, "\n") do
        lines = lines + 1
    end
    local bodyHeight = math.min(lines * 13 + 12, config.MaxHeight or 150)

    local holder = new("Frame", {
        BackgroundColor3 = theme.BackgroundAlt,
        Size = UDim2.new(1, 0, 0, bodyHeight + 26),
        LayoutOrder = #card.Elements + 1,
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Row,
    }, card.Body)
    U.corner(holder, 5)
    U.stroke(holder, theme.Outline, 1, 0.5)
    win:_bind(holder, "BackgroundColor3", "BackgroundAlt")

    local bar = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 26),
        ZIndex = WobsinsUI.Layers.RowItem,
    }, holder)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = Enum.Font.Code,
        Text = config.Title or "code",
        TextColor3 = theme.Muted,
        TextSize = 9.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, bar)
    win:_bind(title, "TextColor3", "Muted")

    local copy = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(1, -28, 0, 0),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, bar)
    U.icon(copy, "copy", 12, theme.Muted, WobsinsUI.Layers.RowItem + 2)
    copy.Activated:Connect(function()
        if setclipboard then
            pcall(setclipboard, code)
            WobsinsUI:Notify({ Title = "已复制", Content = "代码已写入剪贴板。", Icon = "check", Duration = 2, Window = win })
        end
    end)
    U.tooltip(copy, "复制")

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 26),
        Size = UDim2.new(1, -22, 0, bodyHeight),
        Font = Enum.Font.Code,
        Text = code,
        TextColor3 = theme.SubText,
        TextSize = 10.5,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = WobsinsUI.Layers.RowItem + 1,
    }, holder)
    win:_bind(label, "TextColor3", "SubText")

    local element = {
        Type = "Code",
        Frame = holder,
        SetText = function(text)
            label.Text = tostring(text or "")
        end,
    }

    return I.finish(card, element, config)
end

