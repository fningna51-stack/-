--//----------------------------------------------------------------------------
--// 14.1 Dropdown
--//----------------------------------------------------------------------------
--
-- 面板不放在卡片里 —— 卡片有 ClipsDescendants，展开会被裁掉。
-- 这里把面板挂到 ScreenGui 上，用行的绝对坐标定位，并处理贴边翻转。

local function closeAllDropdowns(except)
    for _, item in ipairs(WobsinsUI._dropdowns or {}) do
        if item ~= except and item.Close then
            item:Close()
        end
    end
end

WobsinsUI._dropdowns = WobsinsUI._dropdowns or {}

function Build.Dropdown(card, config)
    local win = card.Window
    local theme = win.ThemeTable
    local multi = config.Multi == true
    local values = {}
    for index, value in ipairs(config.Values or {}) do
        values[index] = tostring(value)
    end

    local selected = {}
    local singleValue = nil

    if multi then
        local initial = config.Value
        if type(initial) == "table" then
            for _, value in ipairs(initial) do
                selected[tostring(value)] = true
            end
        elseif initial ~= nil then
            selected[tostring(initial)] = true
        end
        if not config.AllowNone and next(selected) == nil and values[1] then
            selected[values[1]] = true
        end
    else
        singleValue = config.Value and tostring(config.Value) or values[1]
    end

    local row, top, title, desc, control = I.row(card, config, 128)

    local pill = new("TextButton", {
        BackgroundColor3 = theme.SurfaceAlt,
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        Text = "",
        ZIndex = WobsinsUI.Layers.RowItem + 2,
    }, control)
    U.corner(pill, 4)
    local pillStroke = U.stroke(pill, theme.Outline, 1, 0.5)
    win:_bind(pill, "BackgroundColor3", "SurfaceAlt")

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -28, 1, 0),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = theme.Text,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = WobsinsUI.Layers.RowItem + 3,
    }, pill)
    win:_bind(valueLabel, "TextColor3", "Text")

    local chevron = U.icon(pill, "chevronDown", 10, theme.Muted, WobsinsUI.Layers.RowItem + 3)
    if chevron then
        chevron.AnchorPoint = Vector2.new(0.5, 0.5)
        chevron.Position = UDim2.new(1, -11, 0.5, 0)
    end

    local element = {
        Type = "Dropdown",
        Frame = row,
        Values = values,
        Multi = multi,
        Callback = config.Callback,
    }

    local panel = nil
    local backdrop = nil
    local open = false

    local function selectedList()
        local list = {}
        for _, value in ipairs(values) do
            if selected[value] then
                table.insert(list, value)
            end
        end
        return list
    end

    local function summary()
        if multi then
            local list = selectedList()
            if #list == 0 then
                return config.Placeholder or "未选择"
            end
            return table.concat(list, ", ")
        end
        return singleValue or config.Placeholder or "请选择"
    end

    local function paint()
        valueLabel.Text = summary()
        valueLabel.TextColor3 = (multi and #selectedList() == 0) and win:Color("Muted") or win:Color("Text")
    end

    local function fire()
        if not config.Callback then
            return
        end
        if multi then
            safeCall(config.Callback, selectedList())
        else
            safeCall(config.Callback, singleValue)
        end
    end

    function element.GetValue()
        if multi then
            return selectedList()
        end
        return singleValue
    end

    local function destroyPanel()
        if backdrop then
            backdrop:Destroy()
            backdrop = nil
        end
        if panel then
            panel:Destroy()
            panel = nil
        end
    end

    local function close()
        if not open then
            return
        end
        open = false
        destroyPanel()
        if chevron then
            U.tween(chevron, 0.14, { Rotation = 0 })
        end
    end

    element.Close = close

    local function buildPanel()
        local screen = WobsinsUI:_screen()
        local vp = WobsinsUI:_viewport()

        local hasSearch = #values > 7
        local rowHeight = 26
        local visibleRows = math.min(#values, 7)
        local panelHeight = visibleRows * rowHeight + 8 + (hasSearch and 30 or 0)
        local panelWidth = math.max(pill.AbsoluteSize.X, 150)

        local x = pill.AbsolutePosition.X
        local y = pill.AbsolutePosition.Y + pill.AbsoluteSize.Y + 4
        if x + panelWidth > vp.X - 8 then
            x = vp.X - panelWidth - 8
        end
        if y + panelHeight > vp.Y - 8 then
            y = pill.AbsolutePosition.Y - panelHeight - 4
        end
        if x < 8 then
            x = 8
        end
        if y < 8 then
            y = 8
        end

        backdrop = new("TextButton", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = "",
            ZIndex = WobsinsUI.Layers.Overlay - 1,
        }, screen)
        backdrop.Activated:Connect(close)

        panel = new("Frame", {
            Name = "DropdownPanel",
            BackgroundColor3 = theme.SurfaceAlt,
            Size = UDim2.fromOffset(panelWidth, panelHeight),
            Position = UDim2.fromOffset(x, y),
            ClipsDescendants = true,
            ZIndex = WobsinsUI.Layers.Overlay,
        }, screen)
        U.corner(panel, 5)
        U.stroke(panel, theme.Outline, 1, 0.25)

        local searchBox = nil
        if hasSearch then
            local searchHolder = new("Frame", {
                BackgroundColor3 = theme.BackgroundAlt,
                Size = UDim2.new(1, -8, 0, 24),
                Position = UDim2.fromOffset(4, 4),
                ZIndex = WobsinsUI.Layers.Overlay + 1,
            }, panel)
            U.corner(searchHolder, 4)

            searchBox = new("TextBox", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -16, 1, 0),
                Font = Enum.Font.Gotham,
                PlaceholderText = "筛选…",
                PlaceholderColor3 = theme.Muted,
                Text = "",
                TextColor3 = theme.Text,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                ZIndex = WobsinsUI.Layers.Overlay + 2,
            }, searchHolder)
        end

        local listTop = hasSearch and 32 or 4
        local listHeight = panelHeight - listTop - 4

        local listScroll = new("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -8, 0, listHeight),
            Position = UDim2.fromOffset(4, listTop),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            BorderSizePixel = 0,
            ZIndex = WobsinsUI.Layers.Overlay + 1,
        }, panel)
        U.padding(listScroll, 2, 0, 2, 0)

        local listLayout = new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, 1),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, listScroll)

        local itemButtons = {}

        local function refreshItems(filter)
            filter = string.lower(filter or "")
            for _, btn in ipairs(itemButtons) do
                btn:Destroy()
            end
            itemButtons = {}

            local order = 0
            for _, value in ipairs(values) do
                if filter == "" or string.find(string.lower(value), filter, 1, true) then
                    order = order + 1
                    local isSelected = multi and selected[value] or (not multi and value == singleValue)

                    local item = new("TextButton", {
                        BackgroundColor3 = theme.Accent,
                        BackgroundTransparency = isSelected and 0.93 or 1,
                        AutoButtonColor = false,
                        Size = UDim2.new(1, 0, 0, 25),
                        Text = "",
                        LayoutOrder = order,
                        ZIndex = WobsinsUI.Layers.Overlay + 2,
                    }, listScroll)
                    U.corner(item, 4)
                    table.insert(itemButtons, item)

                    local label = new("TextLabel", {
                        BackgroundTransparency = 1,
                        Position = UDim2.fromOffset(7, 0),
                        Size = UDim2.new(1, -30, 1, 0),
                        Font = Enum.Font.Gotham,
                        Text = value,
                        TextColor3 = isSelected and theme.Text or theme.SubText,
                        TextSize = 10,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        ZIndex = WobsinsUI.Layers.Overlay + 3,
                    }, item)

                    if isSelected then
                        local tick = U.icon(item, "check", 10, theme.Accent, WobsinsUI.Layers.Overlay + 3)
                        if tick then
                            tick.Position = UDim2.new(1, -16, 0.5, -5)
                        end
                    end

                    item.MouseEnter:Connect(function()
                        U.tween(item, 0.1, { BackgroundTransparency = isSelected and 0.85 or 0.94 })
                    end)
                    item.MouseLeave:Connect(function()
                        U.tween(item, 0.1, { BackgroundTransparency = isSelected and 0.93 or 1 })
                    end)

                    item.Activated:Connect(function()
                        if multi then
                            if selected[value] then
                                selected[value] = nil
                            else
                                selected[value] = true
                            end
                            if not config.AllowNone and selectedList()[1] == nil then
                                selected[value] = true
                            end
                            paint()
                            fire()
                            refreshItems(searchBox and searchBox.Text or "")
                        else
                            singleValue = value
                            paint()
                            fire()
                            close()
                        end
                    end)
                end
            end

            listScroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
        end

        refreshItems("")

        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                refreshItems(searchBox.Text)
            end)
        end
    end

    function element.Open()
        if open or element.Locked then
            return
        end
        closeAllDropdowns(element)
        open = true
        buildPanel()
        if chevron then
            U.tween(chevron, 0.14, { Rotation = 180 })
        end
    end

    pill.Activated:Connect(function()
        if open then
            close()
        else
            element.Open()
        end
    end)

    U.hover(pill, function()
        U.tween(pillStroke, 0.12, { Transparency = 0.15 })
    end, function()
        U.tween(pillStroke, 0.12, { Transparency = 0.5 })
    end)

    -- 面板跟着滚动条关闭，避免错位
    if card.Tab and card.Tab.Scroll then
        card.Tab.Scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(close)
    end

    function element.Select(a, b)
        local value = tostring(I.arg(a, b))
        if multi then
            selected[value] = true
            paint()
            fire()
        else
            singleValue = value
            paint()
            fire()
        end
    end

    function element.Refresh(a, b)
        local newValues = I.arg(a, b)
        values = {}
        for index, value in ipairs(newValues or {}) do
            values[index] = tostring(value)
        end
        element.Values = values
        paint()
        if open then
            close()
            element.Open()
        end
    end

    I.setter(element, function(value)
        if multi then
            selected = {}
            if type(value) == "table" then
                for _, item in ipairs(value) do
                    selected[tostring(item)] = true
                end
            elseif value ~= nil then
                selected[tostring(value)] = true
            end
        else
            singleValue = tostring(value)
        end
        paint()
    end)

    element.SetVisible = function(_, visible)
        row.Visible = visible and true or false
        if not visible then
            close()
        end
    end

    table.insert(WobsinsUI._dropdowns, element)

    paint()
    return I.finish(card, element, config)
end

