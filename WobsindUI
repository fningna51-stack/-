local HotkeyPanel = {}
HotkeyPanel.__index = HotkeyPanel

function Window:HotkeyPanel(config)
    if self._hotkeyPanel then
        self._hotkeyPanel:Toggle()
        return self._hotkeyPanel
    end

    config = config or {}
    local win = self
    local theme = self.ThemeTable

    local overlay = new("TextButton", {
        Name = "HotkeyOverlay",
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.45,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        AutoButtonColor = false,
        Visible = false,
        ZIndex = WobsinsUI.Layers.Overlay,
    }, self.Root or WobsinsUI:_screen())

    local panel = new("Frame", {
        BackgroundColor3 = self:Color("Background"),
        Size = UDim2.fromOffset(400, 372),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = true,
        ZIndex = WobsinsUI.Layers.Overlay + 1,
    }, overlay)
    U.corner(panel, 8)
    U.stroke(panel, self:Color("Outline"), 1, 0.35)
    self:_bind(panel, "BackgroundColor3", "Background")

    local self_ = setmetatable({
        Window = win,
        Overlay = overlay,
        Panel = panel,
        Rows = {},
        Query = "",
        Capture = nil,
    }, HotkeyPanel)

    overlay.Activated:Connect(function()
        self_:Close()
    end)
    panel.InputBegan:Connect(function(input)
        -- 拦住点击，避免穿透到遮罩
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            return
        end
    end)

    -- 标题
    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 14),
        Size = UDim2.new(1, -60, 0, 18),
        Font = Enum.Font.GothamMedium,
        Text = config.Title or "快捷键",
        TextColor3 = self:Color("Text"),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = WobsinsUI.Layers.Overlay + 2,
    }, panel)
