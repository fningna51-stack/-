    🌙 MoonLib v1.0 - 完整 UI 库
    特性：标签页 / 搜索 / 通知 / 动画 / 颜色选择器 / 快捷键 ...
]]

local MoonLib = {}
MoonLib.__index = MoonLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local THEME = {
    Background = Color3.fromRGB(22, 22, 28),
    Background2 = Color3.fromRGB(30, 30, 38),
    Element = Color3.fromRGB(38, 38, 48),
    ElementHover = Color3.fromRGB(48, 48, 60),
    Text = Color3.fromRGB(235, 235, 245),
    SubText = Color3.fromRGB(150, 150, 165),
    Accent = Color3.fromRGB(88, 101, 242),     -- Discord 紫
    Accent2 = Color3.fromRGB(56, 66, 170),
    ToggleOn = Color3.fromRGB(67, 181, 129),
    ToggleOff = Color3.fromRGB(60, 60, 72),
    Danger = Color3.fromRGB(237, 66, 69),
    Transparent = Color3.new(0,0,0)
}

local function tween(obj, t, props)
    local tw = TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function round(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = parent
    return c
end

local function stroke(parent, color, tr)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(60,60,75)
    s.Transparency = tr or 0.5
    s.Thickness = 1
    s.Parent = parent
    return s
end

local function shadow(parent)
    local sh = Instance.new("ImageLabel")
    sh.Name = "Shadow"
    sh.AnchorPoint = Vector2.new(0.5, 0.5)
    sh.Position = UDim.new(0.5, 0, 0.5, 6)
    sh.Size = UDim.new(1, 70, 1, 70)
    sh.BackgroundTransparency = 1
    sh.Image = "rbxassetid://5554236805"
    sh.ImageColor3 = Color3.new(0,0,0)
    sh.ImageTransparency = 0.45
    sh.ScaleType = Enum.ScaleType.Slice
    sh.SliceCenter = Rect.new(23, 23, 277, 277)
    sh.ZIndex = parent.ZIndex - 1
    sh.Parent = parent
end

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    return inst
end

-- ════════════════════════════════════════════
-- 通知系统
-- ════════════════════════════════════════════
local NotifGui = new("ScreenGui", {Name="MoonNotifs", ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
NotifGui.Parent = Player:WaitForChild("PlayerGui")

local notifCount = 0

function MoonLib:Notify(title, text, dur, icon)
    dur = dur or 3
    local holder = NotifGui:FindFirstChild("Holder")
    if not holder then
        holder = new("Frame", {
            Name="Holder", AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-15,0,15),
            Size=UDim2.new(0,300,1,-30), BackgroundTransparency=1,
            Parent=NotifGui
        })
        new("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder,
            VerticalAlignment=Enum.VerticalAlignment.Top, Parent=holder})
    end

    notifCount += 1
    local notif = new("Frame", {
        Size=UDim2.new(1,0,0,64), BackgroundColor3=THEME.Background2,
        BackgroundTransparency=1, LayoutOrder=notifCount,
        Parent=holder
    })
    round(notif, 10); stroke(notif); shadow(notif)
    local bar = new("Frame", {Size=UDim2.new(0,4,1,0), BackgroundColor3=THEME.Accent, BackgroundTransparency=1, Parent=notif})
    round(bar, 4)
    local img = new("ImageLabel", {Size=UDim2.new(0,34,0,34), Position=UDim2.new(0,14,0.5,-17),
        BackgroundTransparency=1, Image=icon or "rbxassetid://7733964719", ImageColor3=THEME.Accent, ImageTransparency=1, Parent=notif})
    local t = new("TextLabel", {Size=UDim2.new(1,-64,0,20), Position=UDim2.new(0,56,0,8),
        BackgroundTransparency=1, Text=title or "通知", TextColor3=THEME.Text, Font=Enum.Font.GothamBold,
        TextSize=14, TextXAlignment=Enum.TextXAlignment.Left, TextTransparency=1, Parent=notif})
    local d = new("TextLabel", {Size=UDim2.new(1,-64,0,30), Position=UDim2.new(0,56,0,28),
        BackgroundTransparency=1, Text=text or "", TextColor3=THEME.SubText, Font=Enum.Font.Gotham,
        TextSize=12, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        TextTransparency=1, Parent=notif})
    local closeBtn = new("TextButton", {Size=UDim2.new(0,22,0,22), Position=UDim2.new(1,-26,0,6),
        BackgroundTransparency=1, Text="✕", TextColor3=THEME.SubText, Font=Enum.Font.GothamBold, TextSize=13, Parent=notif})

    -- 展开动画
    notif.Size = UDim2.new(1,80,0,64)
    tween(notif, 0.35, {Size=UDim2.new(1,0,0,64), BackgroundTransparency=0})
    task.delay(0.1, function()
        tween(bar, 0.3, {BackgroundTransparency=0})
        tween(img, 0.3, {ImageTransparency=0})
        tween(t, 0.3, {TextTransparency=0})
        tween(d, 0.3, {TextTransparency=0})
    end)

    local killed = false
    local function dismiss()
        if killed then return end killed = true
        tween(notif, 0.3, {Size=UDim2.new(1,80,0,64), BackgroundTransparency=1})
        tween(bar, 0.25, {BackgroundTransparency=1}); tween(img, 0.25, {ImageTransparency=1})
        tween(t, 0.25, {TextTransparency=1}); tween(d, 0.25, {TextTransparency=1})
        task.wait(0.32)
        notif:Destroy()
    end
    closeBtn.MouseButton1Click:Connect(dismiss)
    task.delay(dur, dismiss)
end

