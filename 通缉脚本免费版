-- 创建主窗口
-- ════════════════════════════════════════════
function MoonLib:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, MoonLib)
    self.Name = config.Name or "MoonLib"
    self.Icon = config.Icon or "rbxassetid://7733964719"
    self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    self.Tabs = {}
    self.CurrentTab = nil
    self.Minimized = false
    self.Destroyed = false

    -- 防重复
    for _, v in ipairs(Player.PlayerGui:GetChildren()) do
        if v.Name == "MoonLibGui" then v:Destroy() end
    end

    local gui = new("ScreenGui", {Name="MoonLibGui", ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true})
    gui.Parent = Player:WaitForChild("PlayerGui")
    self.Gui = gui

    -- 背景（可点击关闭下拉）
    local clickBg = new("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text="", Visible=false, ZIndex=4, Parent=gui})

    -- 主窗口（横屏居中）
    local main = new("Frame", {
        Name="Main", AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,0.5,0),
        Size=UDim2.new(0,640,0,420), BackgroundColor3=THEME.Background, ClipsDescendants=true, Parent=gui
    })
    round(main, 12); stroke(main, Color3.fromRGB(55,55,70), 0.4); shadow(main)
    self.Main = main

    -- 背景渐变
    new("UIGradient", {
        Color=ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(28,28,36)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(18,18,24))
        },
        Rotation=45, Parent=main
    })

    -- ── 标题栏 ──
    local topbar = new("Frame", {Size=UDim2.new(1,0,0,38), BackgroundColor3=THEME.Background2, Parent=main})
    round(topbar, 12)
    new("Frame", {Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,1,-12), BackgroundColor3=THEME.Background2, Parent=topbar})
    stroke(topbar, Color3.fromRGB(55,55,70), 0.5)

    new("ImageLabel", {Size=UDim2.new(0,22,0,22), Position=UDim2.new(0,12,0.5,-11),
        BackgroundTransparency=1, Image=self.Icon, Parent=topbar})
    new("TextLabel", {Size=UDim2.new(0,400,1,0), Position=UDim2.new(0,42,0,0),
        BackgroundTransparency=1, Text=self.Name, TextColor3=THEME.Text, Font=Enum.Font.GothamBold, TextSize=15,
        TextXAlignment=Enum.TextXAlignment.Left, Parent=topbar})

    local minBtn = new("TextButton", {Size=UDim2.new(0,32,0,26), Position=UDim2.new(1,-74,0.5,-13),
        BackgroundColor3=THEME.Element, Text="—", TextColor3=THEME.SubText, Font=Enum.Font.GothamBold, TextSize=14, Parent=topbar})
    round(minBtn, 6)
    minBtn.MouseEnter:Connect(function() tween(minBtn,0.15,{BackgroundColor3=THEME.ElementHover}) end)
    minBtn.MouseLeave:Connect(function() tween(minBtn,0.15,{BackgroundColor3=THEME.Element}) end)

    local closeBtn = new("TextButton", {Size=UDim2.new(0,32,0,26), Position=UDim2.new(1,-38,0.5,-13),
        BackgroundColor3=THEME.Element, Text="✕", TextColor3=THEME.Danger, Font=Enum.Font.GothamBold, TextSize=14, Parent=topbar})
    round(closeBtn, 6)
    closeBtn.MouseEnter:Connect(function() tween(closeBtn,0.15,{BackgroundColor3=Color3.fromRGB(80,40,45)}) end)
    closeBtn.MouseLeave:Connect(function() tween(closeBtn,0.15,{BackgroundColor3=THEME.Element}) end)

    -- 标题栏拖动
    local dragging, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- ── 搜索栏（顶部） ──
    local searchBox = new("Frame", {Size=UDim2.new(1,-24,0,30), Position=UDim2.new(0,12,0,48), BackgroundColor3=THEME.Element, Parent=main})
    round(searchBox, 8)
    new("ImageLabel", {Size=UDim2.new(0,16,0,16), Position=UDim2.new(0,10,0.5,-8), BackgroundTransparency=1,
        Image="rbxassetid://7734053495", ImageColor3=THEME.SubText, Parent=searchBox})
    local searchInput = new("TextBox", {Size=UDim2.new(1,-44,1,0), Position=UDim2.new(0,32,0,0),
        BackgroundTransparency=1, Text="", PlaceholderText="🔍 搜索功能...", PlaceholderColor3=THEME.SubText,
        TextColor3=THEME.Text, Font=Enum.Font.Gotham, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, ClearTextOnFocus=false, Parent=searchBox})

    -- ── 标签栏（左侧） ──
    local tabBar = new("Frame", {Size=UDim2.new(0,140,1,-128), Position=UDim2.new(0,12,0,86), BackgroundColor3=THEME.Background2, Parent=main})
    round(tabBar, 10)
    new("UIListLayout", {Padding=UDim.new(0,4), HorizontalAlignment=Enum.HorizontalAlignment.Center,
        SortOrder=Enum.SortOrder.LayoutOrder, Parent=tabBar})
    new("UIPadding", {PaddingTop=UDim.new(0,6), Parent=tabBar})

    -- ── 内容区 ──
    local container = new("Frame", {Size=UDim2.new(1,-172,1,-128), Position=UDim2.new(0,160,0,86),
        BackgroundTransparency=1, ClipsDescendants=true, Parent=main})

    -- ── 底部信息栏 ──
    local bottombar = new("Frame", {Size=UDim2.new(1,-24,0,26), Position=UDim2.new(0,12,1,-36), BackgroundColor3=THEME.Background2, Parent=main})
    round(bottombar, 8)
    local fpsLabel = new("TextLabel", {Size=UDim2.new(0.4,0,1,0), Position=UDim2.new(0,10,0,0), BackgroundTransparency=1,
        Text="⚡ FPS: 60", TextColor3=THEME.SubText, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=bottombar})
    new("TextLabel", {Size=UDim2.new(0.55,0,1,0), Position=UDim2.new(0.45,0,0,0), BackgroundTransparency=1,
        Text="按键 ["..self.ToggleKey.Name.."] 隐藏/显示", TextColor3=THEME.SubText, Font=Enum.Font.Gotham, TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Right, Parent=bottombar})
    local accDot = new("Frame", {Size=UDim2.new(0,6,0,6), Position=UDim2.new(1,-14,0.5,-3), BackgroundColor3=THEME.ToggleOn, Parent=bottombar})
    round(accDot, 3)

    -- FPS 统计
    local frames, last = 0, tick()
    RunService.RenderStepped:Connect(function()
        frames += 1
        if tick() - last >= 1 and not self.Destroyed then
            fpsLabel.Text = "⚡ FPS: "..frames
            frames = 0; last = tick()
        end
    end)

    -- ── 开启动画 ──
    main.Size = UDim2.new(0,0,0,0)
    main.BackgroundTransparency = 1
    tween(main, 0.5, {Size=UDim2.new(0,640,0,420), BackgroundTransparency=0})
    self:Notify("🌙 "..self.Name, "UI 已加载完成！", 3)

    -- ══════════ 搜索过滤 ══════════
    searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(searchInput.Text)
        for _, tab in ipairs(self.Tabs) do
            local any = false
            for _, el in ipairs(tab.Elements) do
                local show = q == "" or string.find(string.lower(el.SearchText), q, 1, true) ~= nil
                el.Frame.Visible = show
                if show then any = true end
            end
            if any and q ~= "" then self:SelectTab(tab) end
        end
    end)

    -- ══════════ 快捷键 ══════════
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self.ToggleKey and not self.Destroyed then
            if self.Minimized then
                self:Unminimize()
            elseif main.Visible then
                main.Visible = false
            else
                main.Visible = true
                main.Size = UDim2.new(0,640,0,0)
                tween(main, 0.35, {Size=UDim2.new(0,640,0,420)})
            end
        end
    end)

    -- ══════════ 最小化 ══════════
    minBtn.MouseButton1Click:Connect(function()
        if self.Minimized then self:Unminimize() else self:Minimize() end
    end)
    function self:Minimize()
        self.Minimized = true
        tween(main, 0.35, {Size=UDim2.new(0,640,0,38)})
    end
    function self:Unminimize()
        self.Minimized = false
        tween(main, 0.4, {Size=UDim2.new(0,640,0,420)})
    end

    -- ══════════ 关闭（带确认框 + 动画） ══════════
    closeBtn.MouseButton1Click:Connect(function()
        if config.CloseConfirm == false then self:Destroy(); return end
        local confirm = new("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,0.5,0),
            Size=UDim2.new(0,320,0,150), BackgroundColor3=THEME.Background2, ZIndex=10, Parent=gui})
        round(confirm, 12); stroke(confirm); shadow(confirm)
        new("TextLabel", {Size=UDim2.new(1,-20,0,24), Position=UDim2.new(0,10,0,14), ZIndex=11,
            BackgroundTransparency=1, Text="⚠️ 确认关闭", TextColor3=THEME.Text, Font=Enum.Font.GothamBold, TextSize=16, Parent=confirm})
        new("TextLabel", {Size=UDim2.new(1,-20,0,40), Position=UDim2.new(0,10,0,44), ZIndex=11,
            BackgroundTransparency=1, Text="确定要关闭脚本吗？此操作不可撤销。", TextColor3=THEME.SubText,
            Font=Enum.Font.Gotham, TextSize=13, TextWrapped=true, Parent=confirm})
        local yesBtn = new("TextButton", {Size=UDim2.new(0.45,-16,0,32), Position=UDim2.new(0,10,1,-44), ZIndex=11,
            BackgroundColor3=THEME.Danger, Text="关闭脚本", TextColor3=Color3.new(1,1,1), Font=Enum.Font.GothamBold, TextSize=13, Parent=confirm})
        round(yesBtn, 8)
        local noBtn = new("TextButton", {Size=UDim2.new(0.45,-16,0,32), Position=UDim2.new(0.55,6,1,-44), ZIndex=11,
            BackgroundColor3=THEME.Element, Text="取消", TextColor3=THEME.Text, Font=Enum.Font.GothamBold, TextSize=13, Parent=confirm})
        round(noBtn, 8)
        confirm.Size = UDim2.new(0,320,0,0); confirm.BackgroundTransparency = 1
        tween(confirm, 0.3, {Size=UDim2.new(0,320,0,150), BackgroundTransparency=0})

        yesBtn.MouseButton1Click:Connect(function()
            tween(confirm, 0.25, {Size=UDim2.new(0,320,0,0), BackgroundTransparency=1})
            task.wait(0.26); confirm:Destroy(); self:Destroy()
        end)
        noBtn.MouseButton1Click:Connect(function()
            tween(confirm, 0.25, {Size=UDim2.new(0,320,0,0), BackgroundTransparency=1})
            task.wait(0.26); confirm:Destroy()
        end)
    end)

    -- ══════════ 关闭动画 + 销毁 ══════════
    function self:Destroy()
        self.Destroyed = true
        self:Notify("👋 "..self.Name, "脚本已关闭，感谢使用！", 2.5)
        tween(main, 0.4, {Size=UDim2.new(0,640,0,0), BackgroundTransparency=1, Position=UDim2.new(0.5,0,1.5,0)})
        task.wait(0.45)
        gui:Destroy()
    end

    -- ══════════ 标签页 ══════════
    function self:CreateTab(tabConfig)
        local tab = {Name=tabConfig.Name, Icon=tabConfig.Icon or "rbxassetid://7733964719", Elements={}}
        local order = #self.Tabs + 1

        local btn = new("TextButton", {Size=UDim2.new(1,-12,0,32), BackgroundColor3=THEME.Element,
            Text="", LayoutOrder=order, AutoButtonColor=false, Parent=tabBar})
        round(btn, 8)
        local tIcon = new("ImageLabel", {Size=UDim2.new(0,18,0,18), Position=UDim2.new(0,10,0.5,-9),
            BackgroundTransparency=1, Image=tab.Icon, ImageColor3=THEME.SubText, Parent=btn})
        local tLabel = new("TextLabel", {Size=UDim2.new(1,-36,1,0), Position=UDim2.new(0,34,0,0),
            BackgroundTransparency=1, Text=tab.Name, TextColor3=THEME.SubText, Font=Enum.Font.GothamSemibold,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Parent=btn})

        local page = new("ScrollingFrame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            ScrollBarThickness=3, ScrollBarImageColor3=THEME.Accent, CanvasSize=UDim2.new(0,0,0,0),
            Visible=false, Parent=container})
        local pLayout = new("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=page})
        new("UIPadding", {PaddingTop=UDim.new(0,2), Parent=page})
        pLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0,0,0,pLayout.AbsoluteContentSize.Y + 4)
        end)

        tab.Page = page; tab.Button = btn
        function tab:RegisterElement(frame, searchText)
            table.insert(tab.Elements, {Frame=frame, SearchText=searchText or ""})
        end

        btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

        table.insert(self.Tabs, tab)
        if order == 1 then self:SelectTab(tab) end
        return tab
    end

    function self:SelectTab(tab)
        for _, t in ipairs(self.Tabs) do
            local active = t == tab
            t.Page.Visible = active
            tween(t.Button, 0.2, {BackgroundColor3 = active and THEME.Accent2 or THEME.Element})
            t.Button.ImageLabel.ImageColor3 = active and Color3.new(1,1,1) or THEME.SubText
            t.Button.TextLabel.TextColor3 = active and Color3.new(1,1,1) or THEME.SubText
        end
        self.CurrentTab = tab
        tab.Page.Position = UDim2.new(0,0,0,14)
        tween(tab.Page, 0.3, {Position=UDim2.new(0,0,0,0)})
    end

    -- ══════════ 元素创建辅助 ══════════
    local function makeElement(tab, titleText, height, icon)
        local el = new("Frame", {Size=UDim2.new(1,0,0,height), BackgroundColor3=THEME.Element,
            LayoutOrder=#tab.Elements + 1, Parent=tab.Page})
        round(el, 8)
        if icon then
            new("ImageLabel", {Size=UDim2.new(0,18,0,18), Position=UDim2.new(0,10,0,10),
                BackgroundTransparency=1, Image=icon, ImageColor3=THEME.Accent, Parent=el})
        end
        new("TextLabel", {Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0, icon and 34 or 10, 0, 8),
            BackgroundTransparency=1, Text=titleText, TextColor3=THEME.Text, Font=Enum.Font.GothamSemibold,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Parent=el})
        return el
    end

    -- ── 按钮 ──
    function tab:AddButton(cfg)
        local el = makeElement(tab, cfg.Title, 52, cfg.Icon)
        local btn = new("TextButton", {Size=UDim2.new(1,-20,0,24), Position=UDim2.new(0,10,1,-32),
            BackgroundColor3=THEME.Accent, Text=cfg.Text or "点击", TextColor3=Color3.new(1,1,1),
            Font=Enum.Font.GothamSemibold, TextSize=12, Parent=el})
        round(btn, 6)
        btn.MouseEnter:Connect(function() tween(btn,0.15,{BackgroundColor3=THEME.Accent2}) end)
        btn.MouseLeave:Connect(function() tween(btn,0.15,{BackgroundColor3=THEME.Accent}) end)
        btn.MouseButton1Click:Connect(function()
            tween(btn, 0.08, {Size=UDim2.new(1,-28,0,22)})
            tween(btn, 0.2, {Size=UDim2.new(1,-20,0,24)})
            if cfg.Callback then cfg.Callback() end
        end)
        tab:RegisterElement(el, cfg.Title.." "..(cfg.Text or "按钮"))
        return el
    end

    -- ── 禁用按钮 ──
    function tab:AddDisabledButton(cfg)
        local el = makeElement(tab, cfg.Title, 52, cfg.Icon)
        local btn = new("TextButton", {Size=UDim2.new(1,-20,0,24), Position=UDim2.new(0,10,1,-32),
            BackgroundColor3=Color3.fromRGB(50,50,58), Text=cfg.Text or "不可用 🔒", TextColor3=THEME.SubText,
            Font=Enum.Font.GothamSemibold, TextSize=12, AutoButtonColor=false, Parent=el})
        round(btn, 6)
        btn.MouseButton1Click:Connect(function()
            for i=1,3 do
                tween(btn, 0.05, {Position=UDim2.new(0,12,1,-32)})
                tween(btn, 0.05, {Position=UDim2.new(0,8,1,-32)})
            end
            tween(btn, 0.05, {Position=UDim2.new(0,10,1,-32)})
            if cfg.Callback then cfg.Callback() end
        end)
        tab:RegisterElement(el, cfg.Title)
        return el
    end

    -- ── 开关 ──
    function tab:AddToggle(cfg)
        local state = cfg.Default or false
        local el = makeElement(tab, cfg.Title, 40, cfg.Icon)
        local sw = new("TextButton", {Size=UDim2.new(0,44,0,22), Position=UDim2.new(1,-54,0.5,-11),
            BackgroundColor3=state and THEME.ToggleOn or THEME.ToggleOff, Text="", AutoButtonColor=false, Parent=el})
        round(sw, 11)
        local knob = new("Frame", {Size=UDim2.new(0,16,0,16), Position=state and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8),
            BackgroundColor3=Color3.new(1,1,1), Parent=sw})
        round(knob, 8)
        local function set(v)
            state = v
            tween(sw, 0.2, {BackgroundColor3 = v and THEME.ToggleOn or THEME.ToggleOff})
            tween(knob, 0.2, {Position = v and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)})
            if cfg.Callback then cfg.Callback(v) end
        end
        sw.MouseButton1Click:Connect(function() set(not state) end)
        tab:RegisterElement(el, cfg.Title.." 开关")
        return {Set=set, Get=function() return state end}
    end

    -- ── 滑块 ──
    function tab:AddSlider(cfg)
        cfg.Min = cfg.Min or 0; cfg.Max = cfg.Max or 100
        local value = cfg.Default or cfg.Min
        local el = makeElement(tab, cfg.Title, 54, cfg.Icon)
        local valLabel = new("TextLabel", {Size=UDim2.new(0,50,0,18), Position=UDim2.new(1,-58,0,8),
            BackgroundTransparency=1, Text=tostring(value), TextColor3=THEME.Accent, Font=Enum.Font.GothamBold,
            TextSize=12, TextXAlignment=Enum.TextXAlignment.Right, Parent=el})
        local track = new("Frame", {Size=UDim2.new(1,-20,0,6), Position=UDim2.new(0,10,1,-18),
            BackgroundColor3=THEME.ToggleOff, Parent=el})
        round(track, 3)
        local fill = new("Frame", {Size=UDim2.new((value-cfg.Min)/(cfg.Max-cfg.Min),0,1,0),
            BackgroundColor3=THEME.Accent, Parent=track})
        round(fill, 3)
        local knob = new("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Size=UDim2.new(0,14,0,14),
            Position=UDim2.new((value-cfg.Min)/(cfg.Max-cfg.Min),0,0.5,0), BackgroundColor3=Color3.new(1,1,1), Parent=track})
        round(knob, 7); stroke(knob, THEME.Accent, 0)

        local sliding = false
        local function update(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(cfg.Min + rel * (cfg.Max - cfg.Min) + 0.5)
            valLabel.Text = tostring(value)
            tween(fill, 0.05, {Size=UDim2.new(rel,0,1,0)})
            tween(knob, 0.05, {Position=UDim2.new(rel,0,0.5,0)})
            if cfg.Callback then cfg.Callback(value) end
        end
        track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true update(i.Position.X) end end)
        UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then update(i.Position.X) end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end end)
        tab:RegisterElement(el, cfg.Title.." 滑块")
        return {Set=function(v) value=math.clamp(v,cfg.Min,cfg.Max) valLabel.Text=tostring(value)
            local r=(value-cfg.Min)/(cfg.Max-cfg.Min) tween(fill,0.1,{Size=UDim2.new(r,0,1,0)}) tween(knob,0.1,{Position=UDim2.new(r,0,0.5,0)}) end,
            Get=function() return value end}
    end

    -- ── 输入框 ──
    function tab:AddTextbox(cfg)
        local el = makeElement(tab, cfg.Title, 66, cfg.Icon)
        local box = new("TextBox", {Size=UDim2.new(1,-20,0,28), Position=UDim2.new(0,10,1,-36),
            BackgroundColor3=THEME.Background, Text=cfg.Default or "", PlaceholderText=cfg.Placeholder or "输入...",
            PlaceholderColor3=THEME.SubText, TextColor3=THEME.Text, Font=Enum.Font.Gotham, TextSize=12,
            ClearTextOnFocus=false, Parent=el})
        round(box, 6); stroke(box)
        box.FocusLost:Connect(function(enter) if cfg.Callback then cfg.Callback(box.Text, enter) end end)
        tab:RegisterElement(el, cfg.Title.." 输入")
        return {Get=function() return box.Text end, Set=function(t) box.Text=t end}
    end

    -- ── 下拉选项 ──
    function tab:AddDropdown(cfg)
        cfg.Options = cfg.Options or {}
        local selected = cfg.Default or (cfg.Options[1] or "无")
        local open = false
        local el = makeElement(tab, cfg.Title, 62, cfg.Icon)
        local btn = new("TextButton", {Size=UDim2.new(1,-20,0,26), Position=UDim2.new(0,10,1,-32),
            BackgroundColor3=THEME.Background, Text="  "..tostring(selected), TextColor3=THEME.Text, Font=Enum.Font.Gotham,
            TextSize=12, TextXAlignment=Enum.TextXAlignment.Left, Parent=el})
        round(btn, 6); stroke(btn)
        local arrow = new("TextLabel", {Size=UDim2.new(0,20,0,20), Position=UDim2.new(1,-24,0.5,-10),
            BackgroundTransparency=1, Text="▼", TextColor3=THEME.SubText, Font=Enum.Font.GothamBold, TextSize=10, Parent=btn})

        local drop = new("Frame", {Size=UDim2.new(1,-20,0,0), Position=UDim2.new(0,10,1,-34),
            BackgroundColor3=THEME.Background2, ClipsDescendants=true, Visible=false, ZIndex=8, Parent=el})
        round(drop, 8); stroke(drop)
        new("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,4), Parent=drop})
        new("UIPadding", {PaddingTop=UDim.new(0,4), Parent=drop})

        local function close()
            open = false; clickBg.Visible = false
            tween(arrow, 0.2, {Rotation=0})
            tween(drop, 0.25, {Size=UDim2.new(1,-20,0,0)})
            task.delay(0.26, function() drop.Visible=false end)
        end

        local function addOption(opt, i)
            local ob = new("TextButton", {Size=UDim2.new(1,0,0,26), BackgroundTransparency=1,
                BackgroundColor3=THEME.ElementHover, Text="  "..tostring(opt), TextColor3=THEME.Text, Font=Enum.Font.Gotham,
                TextSize=12, TextXAlignment=Enum.TextXAlignment.Left, LayoutOrder=i, ZIndex=9, Parent=drop})
            ob.MouseEnter:Connect(function() tween(ob,0.1,{BackgroundTransparency=0.5}) end)
            ob.MouseLeave:Connect(function() tween(ob,0.1,{BackgroundTransparency=1}) end)
            ob.MouseButton1Click:Connect(function()
                selected = opt; btn.Text = "  "..tostring(opt)
                if cfg.Callback then cfg.Callback(opt) end
                close()
            end)
        end

        for i, opt in ipairs(cfg.Options) do addOption(opt, i) end

        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                drop.Visible = true; clickBg.Visible = true
                tween(arrow, 0.2, {Rotation=180})
                tween(drop, 0.28, {Size=UDim2.new(1,-20,0,#cfg.Options*30 + 8)})
            else close() end
        end)
        clickBg.MouseButton1Click:Connect(function() if open then close() end end)

        tab:RegisterElement(el, cfg.Title.." 下拉 "..table.concat(cfg.Options, " "))
        return {Get=function() return selected end,
            Refresh=function(opts)
                cfg.Options = opts
                for _, c in ipairs(drop:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                for i, opt in ipairs(opts) do addOption(opt, i) end
            end}
    end

    -- ── 快捷键绑定 ──
    function tab:AddKeybind(cfg)
        local key = cfg.Default or Enum.KeyCode.E
        local listening = false
        local el = makeElement(tab, cfg.Title, 40, cfg.Icon)
        local kbtn = new("TextButton", {Size=UDim2.new(0,90,0,24), Position=UDim2.new(1,-100,0.5,-12),
            BackgroundColor3=THEME.Background, Text=key.Name, TextColor3=THEME.Accent, Font=Enum.Font.GothamBold,
            TextSize=12, Parent=el})
        round(kbtn, 6); stroke(kbtn)
        kbtn.MouseButton1Click:Connect(function()
            listening = true; kbtn.Text = "..."
            tween(kbtn, 0.15, {BackgroundColor3=THEME.Accent2})
        end)
        UserInputService.InputBegan:Connect(function(input, gpe)
            if listening then
                if input.KeyCode ~= Enum.KeyCode.Unknown then
                    key = input.KeyCode; listening = false
                    kbtn.Text = key.Name
                    tween(kbtn, 0.15, {BackgroundColor3=THEME.Background})
                    if cfg.Callback then cfg.Callback(key) end
                end
            elseif input.KeyCode == key and not gpe then
                if cfg.Callback then cfg.Callback(key) end
            end
        end)
        tab:RegisterElement(el, cfg.Title.." 快捷键")
        return {Get=function() return key end}
    end

    -- ── 颜色选择器 ──
    function tab:AddColorPicker(cfg)
        local color = cfg.Default or Color3.fromRGB(255, 80, 80)
        local open = false
        local el = makeElement(tab, cfg.Title, 44, cfg.Icon)
        local preview = new("TextButton", {Size=UDim2.new(0,60,0,24), Position=UDim2.new(1,-70,0.5,-12),
            BackgroundColor3=color, Text="", Parent=el})
        round(preview, 6); stroke(preview, Color3.new(1,1,1), 0.6)

        local picker = new("Frame", {Size=UDim2.new(1,-20,0,0), Position=UDim2.new(0,10,1,-4),
            BackgroundColor3=THEME.Background2, ClipsDescendants=true, Visible=false, ZIndex=8, Parent=el})
        round(picker, 10); stroke(picker)

        local svMap = new("ImageButton", {Size=UDim2.new(0,170,0,120), Position=UDim2.new(0,10,0,10),
            BackgroundColor3=Color3.new(1,1,1), Image="rbxassetid://480426628", ZIndex=9, Parent=picker})
        local svCursor = new("Frame", {Size=UDim2.new(0,10,0,10), AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0.5,0), BackgroundColor3=Color3.new(1,1,1), ZIndex=10, Parent=svMap})
        round(svCursor, 5); stroke(svCursor, Color3.new(0,0,0), 0)

        local hueBar = new("ImageButton", {Size=UDim2.new(0,14,0,120), Position=UDim2.new(0,188,0,10),
            BackgroundColor3=Color3.new(1,1,1), Image="rbxassetid://480433960", ZIndex=9, Parent=picker})
        local hueCursor = new("Frame", {Size=UDim2.new(1,4,0,6), AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0,0), BackgroundColor3=Color3.new(1,1,1), ZIndex=10, Parent=hueBar})
        round(hueCursor, 3)

        local rBox = new("TextBox", {Size=UDim2.new(0,50,0,24), Position=UDim2.new(0,212,0,10), ZIndex=9,
            BackgroundColor3=THEME.Background, Text=tostring(math.floor(color.R*255)), TextColor3=Color3.fromRGB(255,120,120),
            Font=Enum.Font.GothamBold, TextSize=12, Parent=picker}); round(rBox,4)
        local gBox = new("TextBox", {Size=UDim2.new(0,50,0,24), Position=UDim2.new(0,212,0,42), ZIndex=9,
            BackgroundColor3=THEME.Background, Text=tostring(math.floor(color.G*255)), TextColor3=Color3.fromRGB(120,255,120),
            Font=Enum.Font.GothamBold, TextSize=12, Parent=picker}); round(gBox,4)
        local bBox = new("TextBox", {Size=UDim2.new(0,50,0,24), Position=UDim2.new(0,212,0,74), ZIndex=9,
            BackgroundColor3=THEME.Background, Text=tostring(math.floor(color.B*255)), TextColor3=Color3.fromRGB(120,160,255),
            Font=Enum.Font.GothamBold, TextSize=12, Parent=picker}); round(bBox,4)

        local h, s, v = 0, 0, 1
        local function fromRGB(c) h, s, v = Color3.toHSV(c) end
        local function update(emit)
            color = Color3.fromHSV(h, s, v)
            preview.BackgroundColor3 = color
            svMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            rBox.Text = tostring(math.floor(color.R*255 + 0.5))
            gBox.Text = tostring(math.floor(color.G*255 + 0.5))
            bBox.Text = tostring(math.floor(color.B*255 + 0.5))
            svCursor.Position = UDim2.new(s, 0, 1-v, 0)
            hueCursor.Position = UDim2.new(0.5, 0, h, 0)
            if emit and cfg.Callback then cfg.Callback(color) end
        end
        fromRGB(color); update(false)

        local pickingSV, pickingHue = false, false
        svMap.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then pickingSV=true
            s = math.clamp((i.Position.X-svMap.AbsolutePosition.X)/svMap.AbsoluteSize.X,0,1)
            v = 1-math.clamp((i.Position.Y-svMap.AbsolutePosition.Y)/svMap.AbsoluteSize.Y,0,1)
            update(true) end end)
        hueBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then pickingHue=true
            h = math.clamp((i.Position.Y-hueBar.AbsolutePosition.Y)/hueBar.AbsoluteSize.Y,0,1)
            update(true) end end)
        UserInputService.InputChanged:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if pickingSV then
                s = math.clamp((i.Position.X-svMap.AbsolutePosition.X)/svMap.AbsoluteSize.X,0,1)
                v = 1-math.clamp((i.Position.Y-svMap.AbsolutePosition.Y)/svMap.AbsoluteSize.Y,0,1)
                update(true)
            elseif pickingHue then
                h = math.clamp((i.Position.Y-hueBar.AbsolutePosition.Y)/hueBar.AbsoluteSize.Y,0,1)
                update(true)
            end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then pickingSV=false pickingHue=false end end)

        for _, pair in ipairs({{rBox,"R"},{gBox,"G"},{bBox,"B"}}) do
            pair[1].FocusLost:Connect(function()
                local n = tonumber(pair[1].Text)
                if n then
                    n = math.clamp(math.floor(n), 0, 255)
                    local c = color
                    if pair[2]=="R" then c = Color3.fromRGB(n, math.floor(c.G*255), math.floor(c.B*255))
                    elseif pair[2]=="G" then c = Color3.fromRGB(math.floor(c.R*255), n, math.floor(c.B*255))
                    else c = Color3.fromRGB(math.floor(c.R*255), math.floor(c.G*255), n) end
                    fromRGB(c); update(true)
                end
            end)
        end

        local function togglePicker()
            open = not open
            if open then
                picker.Visible = true; clickBg.Visible = true
                tween(picker, 0.3, {Size=UDim2.new(1,-20,0,140)})
            else
                clickBg.Visible = false
                tween(picker, 0.25, {Size=UDim2.new(1,-20,0,0)})
                task.delay(0.26, function() picker.Visible=false end)
            end
        end
        preview.MouseButton1Click:Connect(togglePicker)
        clickBg.MouseButton1Click:Connect(function() if open then togglePicker() end end)

        tab:RegisterElement(el, cfg.Title.." 颜色")
        return {Set=function(c) fromRGB(c); update(false) end, Get=function() return color end}
    end

    -- ── 图片 ──
    function tab:AddImage(cfg)
        local el = makeElement(tab, cfg.Title, (cfg.Height or 120) + 36, cfg.Icon)
        local img = new("ImageLabel", {Size=UDim2.new(1,-20,0,cfg.Height or 120), Position=UDim2.new(0,10,1,-(cfg.Height or 120)-8),
            BackgroundColor3=THEME.Background, Image=cfg.Image or "", ScaleType=Enum.ScaleType.Fit, Parent=el})
        round(img, 8)
        if cfg.Description then
            new("TextLabel", {Size=UDim2.new(1,-20,0,16), Position=UDim2.new(0,10,1,-18),
                BackgroundTransparency=1, Text=cfg.Description, TextColor3=THEME.SubText, Font=Enum.Font.Gotham,
                TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, Parent=el})
        end
        tab:RegisterElement(el, cfg.Title.." 图片")
        return {Set=function(id) img.Image=id end}
    end

    -- ── 文本标签 ──
    function tab:AddLabel(cfg)
        cfg = type(cfg)=="string" and {Text=cfg} or cfg
        local el = new("TextLabel", {Size=UDim2.new(1,0,0,26), BackgroundTransparency=1,
            Text=cfg.Text or "", TextColor3=cfg.Color or THEME.SubText, Font=Enum.Font.Gotham, TextSize=12,
            TextWrapped=true, LayoutOrder=#tab.Elements+1, Parent=tab.Page})
        tab:RegisterElement(el, cfg.Text or "标签")
        return {Set=function(t) el.Text=t end}
    end

    return self
end

return MoonLib
