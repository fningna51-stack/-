                local gb = workspace:FindFirstChild("GlassBridge")
                local gholder = gb and gb:FindFirstChild("GlassHolder")
                if gholder then
                    for _, c in ipairs(gholder:GetChildren()) do
                        for _, c2 in ipairs(c:GetChildren()) do process(c2) end
                    end
                end
                task.wait(2)
            end
            thread = nil
        end)
    end
