local function setupSilentAim()
    if tbl._silentAimHooked then return end
    tbl._silentAimHooked = true
    pcall(function()
        local GunFunctions = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GunFunctions"))
        local orig = GunFunctions.FiredGun
        GunFunctions.FiredGun = function(ch, pos, data, ...)
            if not tbl.silentAimEnabled or ch ~= localPlayer.Character then
                return orig(ch, pos, data, ...)
            end
            data = data or {}
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return orig(ch, pos, data, ...) end
            local origin = hrp.Position
            pcall(function()
                local wep = ch:GetAttribute("HoldingWeapon")
                if wep then
                    local t = ch:FindFirstChild(wep)
                    if t then
                        local ff = t:FindFirstChild("FireFrom")
                        if ff then origin = ff.Position end
                    end
                end
            end)
            local isGuard = localPlayer:GetAttribute("IsGuard")
            local live = workspace:FindFirstChild("Live")
            local best, bd = nil, math.huge
            if live then
                for _, c in pairs(live:GetChildren()) do
                    if c ~= ch and not c:FindFirstChild("Dead") and not c:FindFirstChild("IFrame") then
                        local hu = c:FindFirstChild("Humanoid")
                        if not (hu and hu.Health <= 0) then
                            local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChildWhichIsA("BasePart", true)
                            if head then
                                local cHrp = c:FindFirstChild("HumanoidRootPart")
                                local valid
                                if c:FindFirstChild("Enemy") or string.match(string.lower(c.Name), "peabert") then
                                    valid = true
                                elseif isGuard then
                                    valid = c:FindFirstChild("GuardCanKill") or (cHrp and cHrp:FindFirstChild("GuardCanKillLockOn")) or false
                                else
                                    local p = Players:GetPlayerFromCharacter(c)
                                    valid = (p and p ~= localPlayer and p:GetAttribute("IsGuard")) or c.Name:match("Rebel") or c.Name:match("Guard") or c:FindFirstChild("PlayerCanKill") or c:FindFirstChild("TypeOfGuard") or false
                                end
                                local togu = isGuard and c:FindFirstChild("TypeOfGuard")
                                if togu then
                                    togu = not (cHrp and cHrp:FindFirstChild("GuardCanKillLockOn"))
                                end
                                if togu and not c:FindFirstChild("GuardCanKill") then valid = false end
                                if valid then
                                    local d = (head.Position - origin).Magnitude
                                    if d < bd and d < 1000 then bd = d; best = head end
                                end
                            end
                        end
                    end
                end
            end
            if best then
                pos = best.Position
                data.CustomFireFrom = true
                data.spread = 0
            end
            return orig(ch, pos, data, ...)
        end
    end)
end
