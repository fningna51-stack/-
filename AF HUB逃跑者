local Settings = {
    KillAuraEnabled = false,
    KillDelay = 0.1,
    KillRange = 50,
    KillDamage = 13,
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local lastKillTime = 0
local killAuraConnection = nil

local function getAllNPCs()
    local npcs = {}
    local playerChars = {}
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            playerChars[plr.Character] = true
        end
    end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") then
            if not playerChars[obj] then
                table.insert(npcs, obj)
            end
        end
    end
    return npcs
end

local function getNearestNPC()
    local nearestNPC = nil
    local nearestDistance = Settings.KillRange
    local myPosition = nil
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        myPosition = LocalPlayer.Character.HumanoidRootPart.Position
    else
        return nil
    end
    
    for _, npc in pairs(getAllNPCs()) do
        local humanoid = npc:FindFirstChild("Humanoid")
        local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
        if humanoid and humanoid.Health > 0 and rootPart then
            local distance = (myPosition - rootPart.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearestNPC = npc
            end
        end
    end
    return nearestNPC
end

local function killAura()
    local nearestNPC = getNearestNPC()
    if nearestNPC then
        local humanoid = nearestNPC:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 then
            local Event = ReplicatedStorage:FindFirstChild("FlowClient") 
                and ReplicatedStorage.FlowClient:FindFirstChild("ClientRunner") 
                and ReplicatedStorage.FlowClient.ClientRunner:FindFirstChild("Event")
            if Event then
                Event:FireServer("NPCs", "Damage", humanoid, Settings.KillDamage)
                return true
            end
        end
    end
    return false
end

local function StartKillAura()
    if killAuraConnection then 
        return false, "杀戮光环已在运行"
    end
    
    if not Settings.KillAuraEnabled then
        return false, "杀戮光环未启用"
    end
    
    killAuraConnection = RunService.Heartbeat:Connect(function()
        if Settings.KillAuraEnabled then
            local currentTime = tick()
            if currentTime - lastKillTime >= Settings.KillDelay then
                killAura()
                lastKillTime = currentTime
            end
        end
    end)
    
    return true, "杀戮光环已启动"
end

local function StopKillAura()
    if killAuraConnection then
        killAuraConnection:Disconnect()
        killAuraConnection = nil
        return true, "杀戮光环已停止"
    end
    return false, "杀戮光环未在运行"
end

local function SetKillAuraEnabled(enabled)
    Settings.KillAuraEnabled = enabled
    if enabled then
        return StartKillAura()
    else
        return StopKillAura()
    end
end

local function GetStatus()
    return {
        Enabled = Settings.KillAuraEnabled,
        Running = killAuraConnection ~= nil,
        Delay = Settings.KillDelay,
        Range = Settings.KillRange,
        Damage = Settings.KillDamage,
    }
end

local function SetDelay(delay)
    Settings.KillDelay = math.max(0.01, math.min(1, delay))
end

local function SetRange(range)
    Settings.KillRange = math.max(10, math.min(10000, range))
end

local function SetDamage(damage)
    Settings.KillDamage = math.max(13, math.min(10000, damage))
end

local function AttackOnce()
    return killAura()
end

