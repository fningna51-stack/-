local function GetLootPart(Config)
    if not LootFolder then return nil end
    if Config.Path then
        local Object = LootFolder
        for _, Name in ipairs(Config.Path) do
            Object = Object:FindFirstChild(Name)
            if not Object then return nil end
        end
        if Object:IsA("BasePart") then
            return Object
        end
        if Object:IsA("Model") then
            if Object.PrimaryPart then
                return Object.PrimaryPart
            end
            return Object:FindFirstChildWhichIsA("BasePart", true)
        end
        return nil
    end
    if Config.Index then
        local Children = LootFolder:GetChildren()
        local Object = Children[Config.Index]
        if not Object then return nil end
        if Config.Child then
            Object = Object:FindFirstChild(Config.Child)
        end
        if Object and Object:IsA("BasePart") then
            return Object
        end
        if Object and Object:IsA("Model") then
            if Object.PrimaryPart then
                return Object.PrimaryPart
            end
            return Object:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    return nil
end

local function CreateNameESP(Part, DisplayName)
    if not Part or not Part:IsA("BasePart") then return end
    local Existing = Part:FindFirstChild("AF_LootName")
    if Existing then Existing:Destroy() end
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "AF_LootName"
    Billboard.Adornee = Part
    Billboard.Size = UDim2.new(0, 180, 0, 35)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.MaxDistance = 1000
    Billboard.Enabled = LootESPEnabled
    Billboard.Parent = Part
    local Text = Instance.new("TextLabel")
    Text.Name = "Name"
    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1
    Text.Text = DisplayName
    Text.TextColor3 = LootESPColor
    Text.TextSize = 14
    Text.Font = Enum.Font.GothamBold
    Text.TextStrokeTransparency = 0
    Text.TextStrokeColor3 = Color3.new(0, 0, 0)
    Text.Parent = Billboard
    CreatedNames[Part] = {
        Billboard = Billboard,
