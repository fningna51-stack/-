local AutoReplay = {
    Enabled = false,
    LoopConnection = nil,
    Interval = 3,
    Count = 0,
}

local function ExecuteReplay()
    local args = {
        "GameManager",
        "Replay"
    }
    local success = pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("FlowClient"):WaitForChild("ClientRunner"):WaitForChild("Event"):FireServer(unpack(args))
        return true
    end)
    return success
end

local function AutoReplayLoop()
    if not AutoReplay.Enabled then return end
    
    AutoReplay.Count = AutoReplay.Count + 1
    local success = ExecuteReplay()
    
    if success then
        print(string.format("自动重玩第 %d 次执行成功", AutoReplay.Count))
    else
        print(string.format("自动重玩第 %d 次执行失败", AutoReplay.Count))
    end
end

local function StartAutoReplay()
    if AutoReplay.LoopConnection then return end
    
    AutoReplay.Enabled = true
    local lastTime = tick()
    
    AutoReplay.LoopConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not AutoReplay.Enabled then return end
        
        local currentTime = tick()
        if currentTime - lastTime >= AutoReplay.Interval then
            lastTime = currentTime
            AutoReplayLoop()
        end
    end)
    
    print("自动重玩已开启")
end

local function StopAutoReplay()
    AutoReplay.Enabled = false
    
    if AutoReplay.LoopConnection then
        AutoReplay.LoopConnection:Disconnect()
        AutoReplay.LoopConnection = nil
    end
    
    print("自动重玩已关闭")
end

