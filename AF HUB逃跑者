local function updateStatus()
    local status = GetStatus()
    local desc = ""
    if status.Enabled and status.Running then
        desc = "运行中\n"
    elseif status.Enabled and not status.Running then
        desc = "已启用但未运行\n"
    else
        desc = "已禁用\n"
    end
    desc = desc .. "伤害: " .. status.Damage .. "\n范围: " .. status.Range .. "\n延迟: " .. status.Delay .. "秒"
    if status.Running then
        desc = desc .. "\n攻击中..."
    end
    statusPara:SetDesc(desc)
end

