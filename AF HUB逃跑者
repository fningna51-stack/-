    }
end

local function CreateHighlight(Part)
    if not Part then return end
    local Existing = Part:FindFirstChild("AF_LootHighlight")
    if Existing then Existing:Destroy() end
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "AF_LootHighlight"
    Highlight.Adornee = Part
    Highlight.FillColor = LootESPColor
    Highlight.OutlineColor = LootESPColor
    Highlight.FillTransparency = 0.45
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Enabled = LootESPEnabled
    Highlight.Parent = Part
    CreatedHighlights[Part] = Highlight
end

local function RefreshLootESP()
    for Part, _ in pairs(CreatedHighlights) do
        if not Part or not Part.Parent then
            CreatedHighlights[Part] = nil
        end
    end
    for Part, _ in pairs(CreatedNames) do
        if not Part or not Part.Parent then
            CreatedNames[Part] = nil
        end
    end
    for _, Config in ipairs(LootConfig) do
        local Part = GetLootPart(Config)
        if Part then
            CreateHighlight(Part)
            CreateNameESP(Part, Config.Name)
        end
    end
end

local function UpdateLootESPEnabled(Value)
    LootESPEnabled = Value
    for Part, Highlight in pairs(CreatedHighlights) do
        if Highlight and Highlight.Parent then
            Highlight.Enabled = Value
        end
    end
    for Part, Data in pairs(CreatedNames) do
        if Data and Data.Billboard and Data.Billboard.Parent then
            Data.Billboard.Enabled = Value
        end
    end
end

local function UpdateLootESPColor(Value)
    LootESPColor = Value
    for Part, Highlight in pairs(CreatedHighlights) do
        if Highlight and Highlight.Parent then
            Highlight.FillColor = Value
            Highlight.OutlineColor = Value
        end
    end
    for Part, Data in pairs(CreatedNames) do
        if Data and Data.Text and Data.Text.Parent then
            Data.Text.TextColor3 = Value
        end
    end
end

