-- ===================== 自动杀戮 =====================
local function GetKillableEntities()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return {} end
    local rootPart = character:FindFirstChild("PrimaryPart") or character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    local entities = {}
    local killRadius = KillFeature.KillRadius
    local descendants = workspace:GetDescendants()
    for i = 1, #descendants do
        local model = descendants[i]
        if model:IsA("Model") then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local isPlayer = game:GetService("Players"):GetPlayerFromCharacter(model)
                if isPlayer and not KillFeature.Targets.Players then
                else
                    local primaryPart = model:FindFirstChild("PrimaryPart") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChild("Torso")
                    if primaryPart then
                        local distance = (primaryPart.Position - rootPart.Position).Magnitude
                        if distance <= killRadius then
                            local entityType = "Unknown"
                            local modelName = model.Name:lower()
                            local modelFullName = model.Name
                            if string.find(modelName, "police") or string.find(modelName, "cop") or string.find(modelName, "sheriff") or string.find(modelName, "officer") or string.find(modelFullName, "警察") or string.find(modelFullName, "警员") or string.find(modelFullName, "警") then
                                entityType = "Police"
                            elseif string.find(modelName, "enemy") or string.find(modelName, "bandit") or string.find(modelName, "thief") or string.find(modelName, "criminal") or string.find(modelName, "robber") or string.find(modelName, "gang") or string.find(modelFullName, "敌人") or string.find(modelFullName, "强盗") or string.find(modelFullName, "罪犯") then
                                entityType = "Enemy"
                            elseif string.find(modelName, "npc") or string.find(modelName, "character") or string.find(modelName, "civilian") or string.find(modelName, "pedestrian") or string.find(modelName, "person") or string.find(modelFullName, "NPC") or string.find(modelFullName, "角色") or string.find(modelFullName, "人物") then
                                entityType = "NPC"
                            elseif string.find(modelName, "civilian") or string.find(modelName, "ped") or string.find(modelName, "citizen") or string.find(modelFullName, "平民") or string.find(modelFullName, "市民") then
                                entityType = "Civilian"
                            end
                            local shouldAdd = false
                            if entityType == "Police" and KillFeature.Targets.Police then
                                shouldAdd = true
                            elseif entityType == "NPC" and KillFeature.Targets.NPCs then
                                shouldAdd = true
                            elseif entityType == "Enemy" and KillFeature.Targets.Enemies then
                                shouldAdd = true
                            elseif entityType == "Civilian" and KillFeature.Targets.Civilians then
                                shouldAdd = true
                            elseif entityType == "Unknown" and not isPlayer then
                                shouldAdd = true
                            end
                            if shouldAdd then
                                table.insert(entities, {
                                    model = model,
                                    humanoid = humanoid,
                                    part = primaryPart,
                                    type = entityType,
                                    isPlayer = (isPlayer ~= nil),
                                    displayName = model.Name,
                                    health = humanoid.Health
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    return entities
end

local function KillEntity(entity)
    if not entity or not entity.humanoid then return false end
    local success = false
    pcall(function()
        if entity.humanoid.Health > 0 then
            entity.humanoid.Health = 0
            success = true
        end
        if entity.humanoid.Health > 0 then
            entity.humanoid:TakeDamage(entity.humanoid.Health)
            success = true
        end
        if entity.humanoid.Health > 0 and entity.model then
            entity.model:BreakJoints()
            success = true
        end
    end)
    return success
end

local function AutoKillLoop()
    if not KillFeature.Enabled then return end
    local entities = GetKillableEntities()
    local count = 0
    for i = 1, #entities do
        local entity = entities[i]
        if entity.humanoid and entity.humanoid.Health > 0 then
            local killed = KillEntity(entity)
            if killed then
                count = count + 1
                KillFeature.KillCount = KillFeature.KillCount + 1
            end
        end
    end
    if count > 0 then
        WindUI:Notify({ Title = string.format("已击杀 %d 个生物！", count), Duration = 1 })
    end
end

local function StartAutoKill()
    if KillFeature.LoopConnection then return end
    KillFeature.Enabled = true
    KillFeature.LoopConnection = game:GetService("RunService").Stepped:Connect(function()
        AutoKillLoop()
    end)
    WindUI:Notify({ Title = "自动杀戮已开启！", Duration = 2 })
end

local function StopAutoKill()
    KillFeature.Enabled = false
    if KillFeature.LoopConnection then
        KillFeature.LoopConnection:Disconnect()
        KillFeature.LoopConnection = nil
    end
    WindUI:Notify({ Title = "自动杀戮已关闭！", Duration = 2 })
end

local function ManualKill()
    local entities = GetKillableEntities()
    local count = 0
    if #entities == 0 then
        WindUI:Notify({ Title = "没有找到可击杀的生物！", Duration = 2 })
        return 0
    end
    for i = 1, #entities do
        local entity = entities[i]
        if entity.humanoid and entity.humanoid.Health > 0 then
            local killed = KillEntity(entity)
            if killed then
                count = count + 1
                KillFeature.KillCount = KillFeature.KillCount + 1
            end
        end
    end
    WindUI:Notify({ Title = string.format("已手动击杀 %d 个生物！", count), Duration = 2 })
    return count
end

local function ResetKillCount()
    KillFeature.KillCount = 0
end

