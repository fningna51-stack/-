-- ===================== 自动通关 =====================
local function EnableNoclipFly()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
        humanoid.WalkSpeed = AutoComplete.Speed
    end
end

local function DisableNoclipFly()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function MoveToPositionSmooth(targetPos, speed)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then
        WindUI:Notify({ Title = "找不到角色！", Duration = 3 })
        return false
    end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        WindUI:Notify({ Title = "找不到HumanoidRootPart！", Duration = 3 })
        return false
    end
    EnableNoclipFly()
    local startPos = humanoidRootPart.Position
    local distance = (targetPos - startPos).Magnitude
    if distance < AutoComplete.Tolerance then
        WindUI:Notify({ Title = "已经在目标位置附近！", Duration = 2 })
        return true
    end
    local moveTime = distance / speed
    moveTime = math.max(moveTime, 0.5)
    WindUI:Notify({ Title = string.format("开始高速平移 (速度: %.0f, 距离: %.0f)", speed, distance), Duration = 2 })
    local tweenService = game:GetService("TweenService")
    local tweenInfo = TweenInfo.new(moveTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = tweenService:Create(humanoidRootPart, tweenInfo, { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()
    wait(0.3)
    local finalPos = humanoidRootPart.Position
    local finalDistance = (finalPos - targetPos).Magnitude
    if finalDistance < AutoComplete.Tolerance then
        WindUI:Notify({ Title = string.format("已到达目标点！(%.1f, %.1f, %.1f)", targetPos.X, targetPos.Y, targetPos.Z), Duration = 3 })
        return true
    else
        WindUI:Notify({ Title = string.format("移动完成，剩余距离: %.1f", finalDistance), Duration = 2 })
        return true
    end
end

local function AutoCompleteLoop()
    if not AutoComplete.Enabled then return end
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then
        AutoComplete.Status = "等待角色加载..."
        if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
        return
    end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        AutoComplete.Status = "等待RootPart加载..."
        if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
        return
    end
    local currentPos = humanoidRootPart.Position
    local targetPos = AutoComplete.EndPosition
    local distance = (currentPos - targetPos).Magnitude
    if distance > AutoComplete.Tolerance then
        AutoComplete.Status = string.format("移动中... 距离: %.1f", distance)
        if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
        EnableNoclipFly()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = AutoComplete.Speed
            local direction = (targetPos - currentPos).Unit
            local step = math.min(AutoComplete.Speed * 0.05, distance)
            local newPos = currentPos + direction * step
            humanoidRootPart.CFrame = CFrame.new(newPos)
        end
    else
        if AutoComplete.Status ~= "已到达通关点！" then
            AutoComplete.Status = "已到达通关点！"
            if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
            WindUI:Notify({ Title = "自动通关完成！", Duration = 3 })
            DisableNoclipFly()
            WindUI:Notify({ Title = "已关闭穿墙和飞天模式", Duration = 2 })
        end
    end
end

local function StartAutoComplete()
    if AutoComplete.LoopConnection then return end
    AutoComplete.Enabled = true
    AutoComplete.Status = "启动中..."
    if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
    WindUI:Notify({ Title = "传送到起点...", Duration = 2 })
    local success = MoveToPositionSmooth(AutoComplete.StartPosition, AutoComplete.Speed)
    if success then
        WindUI:Notify({ Title = "开始自动通关路径...", Duration = 2 })
        wait(0.5)
        success = MoveToPositionSmooth(AutoComplete.EndPosition, AutoComplete.Speed)
    end
    if success then
        AutoComplete.Status = "已到达通关点！"
        if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
        WindUI:Notify({ Title = "自动通关完成！", Duration = 3 })
        DisableNoclipFly()
        WindUI:Notify({ Title = "已关闭穿墙和飞天模式", Duration = 2 })
    else
        AutoComplete.Status = "移动失败"
        if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
        WindUI:Notify({ Title = "自动通关失败，请重试！", Duration = 3 })
    end
end

local function StopAutoComplete()
    AutoComplete.Enabled = false
    if AutoComplete.LoopConnection then
        AutoComplete.LoopConnection:Disconnect()
        AutoComplete.LoopConnection = nil
    end
    AutoComplete.Status = "已停止"
    if AutoComplete.StatusLabel then AutoComplete.StatusLabel:SetText("状态: " .. AutoComplete.Status) end
    WindUI:Notify({ Title = "自动通关已停止", Duration = 2 })
    DisableNoclipFly()
    WindUI:Notify({ Title = "已关闭穿墙和飞天模式", Duration = 2 })
end

-- ===================== 门删除功能 =====================
local function GetObjectByPath(pathString)
    local success, obj = pcall(function()
        return loadstring("return " .. pathString)()
    end)
    if success and obj then
        return obj
    end
    return nil
end

local function SafeDestroy(obj)
    if obj and obj:IsA("BasePart") then
        pcall(function()
            obj:Destroy()
            return true
        end)
        return true
    end
    return false
end

local function FindAndDeleteByName(parent, name)
    local count = 0
    if not parent then return count end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("BasePart") and child.Name:lower():find(name:lower()) then
            if SafeDestroy(child) then
                count = count + 1
            end
        end
        count = count + FindAndDeleteByName(child, name)
    end
    return count
end

local function RemoveAllWoodenDoors()
    local count = 0
    local specificDoors = {
        "workspace.Map.StartArea.Decorations.House.House1.House1.Door",
        "workspace.Map.StartArea.Decorations.House.House2.House2.Door",
        "workspace.Map.StartArea.Decorations.House.House3.House3.Door",
    }
    for _, path in ipairs(specificDoors) do
        local obj = GetObjectByPath(path)
        if obj then
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("BasePart") and (child.Name:lower():find("door") or child.Name:lower():find("wood")) then
                    if SafeDestroy(child) then
                        count = count + 1
                    end
                end
            end
        end
    end
    local map = Workspace:FindFirstChild("Map")
    if map then
        count = count + FindAndDeleteByName(map, "door")
        count = count + FindAndDeleteByName(map, "wood")
    end
    return count
end

local function RemoveAllDoubleDoors()
    local count = 0
    local doubleDoorPaths = {
        "workspace.Map.Buildings.PawnShop.PawnShop.Door.DoubleDoor.DoorA",
        "workspace.Map.Buildings.PawnShop.PawnShop.Door.DoubleDoor.DoorB",
        "workspace.Map.Buildings.Store.Store.Door.DoubleDoor.DoorA",
        "workspace.Map.Buildings.Store.Store.Door.DoubleDoor.DoorB",
        "workspace.Map.Buildings.Bank.Bank.Door.DoubleDoor.DoorA",
        "workspace.Map.Buildings.Bank.Bank.Door.DoubleDoor.DoorB",
    }
    for _, path in ipairs(doubleDoorPaths) do
        local obj = GetObjectByPath(path)
        if obj and obj:IsA("BasePart") then
            if SafeDestroy(obj) then
                count = count + 1
            end
        end
    end
    return count
end

local function RemoveCustomDoors(customPaths)
    local count = 0
    for _, path in ipairs(customPaths) do
        local obj = GetObjectByPath(path)
        if obj then
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("BasePart") then
                    if SafeDestroy(child) then
                        count = count + 1
                    end
                end
            end
        end
    end
    return count
end

local function ExecuteDoorRemoval(config)
    local count = 0
    if config.RemoveAllDoors then
        count = RemoveAllWoodenDoors()
        count = count + RemoveAllDoubleDoors()
        count = count + RemoveCustomDoors(config.CustomDoorPaths or {})
    else
        if config.RemoveHouseDoors then
            count = count + RemoveAllWoodenDoors()
        end
        if config.RemovePawnShopDoors then
            count = count + RemoveAllDoubleDoors()
        end
        if config.RemoveCustomDoors then
            count = count + RemoveCustomDoors(config.CustomDoorPaths or {})
        end
    end
    return count
end

