local function ToggleNightVision(enable)
    local lighting = game:GetService("Lighting")
    if enable then
        NightVision.OriginalBrightness = lighting.Brightness
        NightVision.OriginalAmbient = lighting.Ambient
        NightVision.OriginalOutdoor = lighting.OutdoorAmbient
        lighting.Brightness = 2
        lighting.Ambient = Color3.new(1, 1, 1)
        lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        lighting.FogEnd = 1000
        lighting.GlobalShadows = false
        local colorCorrection = Instance.new("ColorCorrectionEffect")
        colorCorrection.Name = "NightVisionEffect"
        colorCorrection.Brightness = 0.1
        colorCorrection.Contrast = 0.3
        colorCorrection.Saturation = -0.5
        colorCorrection.TintColor = Color3.new(0, 1, 0)
        colorCorrection.Parent = lighting
        NightVision.Enabled = true
        WindUI:Notify({ Title = "夜视已开启", Duration = 2 })
    else
        if NightVision.OriginalBrightness then
            lighting.Brightness = NightVision.OriginalBrightness
        end
        if NightVision.OriginalAmbient then
            lighting.Ambient = NightVision.OriginalAmbient
        end
        if NightVision.OriginalOutdoor then
            lighting.OutdoorAmbient = NightVision.OriginalOutdoor
        end
        lighting.FogEnd = 100000
        lighting.GlobalShadows = true
        local effect = lighting:FindFirstChild("NightVisionEffect")
        if effect then effect:Destroy() end
        NightVision.Enabled = false
        WindUI:Notify({ Title = "夜视已关闭", Duration = 2 })
    end
end

