-- 检查是否在摇杆区域
local function IsInJoyZone(pos)
    if not CarFly.JoyMode then return false end
    local vp = Camera.ViewportSize
    return pos.X <= vp.X * 0.5 and pos.Y >= vp.Y * 0.55
end

-- 更新摇杆
local function UpdateJoystickFromTouch(touchPos)
    local delta = touchPos - CarFly.JoyBasePos
    local mag = delta.Magnitude
    if mag > CarFly.MAX_RADIUS then
        delta = delta.Unit * CarFly.MAX_RADIUS
        mag = CarFly.MAX_RADIUS
    end
    if CarFly.JoyKnob then
        CarFly.JoyKnob.Position = UDim2.new(0.5, delta.X - 30, 0.5, delta.Y - 30)
    end
    local norm = (mag > 1 and delta / CarFly.MAX_RADIUS or delta / CarFly.MAX_RADIUS)
    CarFly.JoystickVector = Vector3.new(norm.X, 0, norm.Y)
end

-- 设置摇杆模式
local function SetJoyMode(mode)
    CarFly.JoyMode = mode
    if CarFly.JoyBase then CarFly.JoyBase.Visible = false end
    if CarFly.JoyButton then
        CarFly.JoyButton.Text = mode and "ON" or "摇"
        CarFly.JoyButton.BackgroundColor3 = mode and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(70, 70, 70)
    end
    if not mode then
        CarFly.JoystickActive = false
        CarFly.JoystickVector = Vector3.new()
    end
end

