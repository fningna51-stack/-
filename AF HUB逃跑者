local function GetPlayerHumanoid()
    local player = game:GetService("Players").LocalPlayer
    if not player then return nil end
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

local function ApplyPlayerMods()
    local humanoid = GetPlayerHumanoid()
    if not humanoid then return end
    pcall(function()
        if PlayerMod.Values.WalkSpeed then humanoid.WalkSpeed = PlayerMod.Values.WalkSpeed end
        if PlayerMod.Values.JumpPower then humanoid.JumpPower = PlayerMod.Values.JumpPower end
        if PlayerMod.Values.Health then humanoid.Health = PlayerMod.Values.Health end
        if PlayerMod.Values.MaxHealth then humanoid.MaxHealth = PlayerMod.Values.MaxHealth end
        if PlayerMod.Values.HipHeight ~= nil then humanoid.HipHeight = PlayerMod.Values.HipHeight end
        if humanoid:FindFirstChild("JumpHeight") then
            humanoid.JumpHeight = PlayerMod.Values.JumpHeight
        end
        if humanoid:FindFirstChild("UseJumpPower") then
            humanoid.UseJumpPower = true
        end
        if humanoid:FindFirstChild("AutomaticScalingEnabled") then
            humanoid.AutomaticScalingEnabled = false
        end
    end)
end

local function LockPlayerAttributes()
    local humanoid = GetPlayerHumanoid()
    if not humanoid then return end
    pcall(function()
        local function CreateLock(property, targetValue)
            local connection
            connection = humanoid:GetPropertyChangedSignal(property):Connect(function()
                if PlayerMod.Locked and humanoid and humanoid[property] ~= targetValue then
                    pcall(function()
                        humanoid[property] = targetValue
                    end)
                end
            end)
            return connection
        end
        if PlayerMod.LockConnection then
            PlayerMod.LockConnection:Disconnect()
            PlayerMod.LockConnection = nil
        end
        local connections = {}
        table.insert(connections, CreateLock("WalkSpeed", PlayerMod.Values.WalkSpeed))
        table.insert(connections, CreateLock("JumpPower", PlayerMod.Values.JumpPower))
        table.insert(connections, CreateLock("Health", PlayerMod.Values.Health))
        table.insert(connections, CreateLock("MaxHealth", PlayerMod.Values.MaxHealth))
        table.insert(connections, CreateLock("HipHeight", PlayerMod.Values.HipHeight))
        if humanoid:FindFirstChild("JumpHeight") then
            table.insert(connections, CreateLock("JumpHeight", PlayerMod.Values.JumpHeight))
        end
        PlayerMod.LockConnection = {
            Disconnect = function()
                for i = 1, #connections do
                    pcall(function()
                        connections[i]:Disconnect()
                    end)
                end
            end
        }
    end)
end

local function AutoModLoop()
    if not PlayerMod.Enabled then return end
    local humanoid = GetPlayerHumanoid()
    if not humanoid then return end
    local needsUpdate = false
    if humanoid.WalkSpeed ~= PlayerMod.Values.WalkSpeed then needsUpdate = true end
    if humanoid.JumpPower ~= PlayerMod.Values.JumpPower then needsUpdate = true end
    if humanoid.Health ~= PlayerMod.Values.Health then needsUpdate = true end
    if humanoid.MaxHealth ~= PlayerMod.Values.MaxHealth then needsUpdate = true end
    if needsUpdate then
        ApplyPlayerMods()
    end
end

local function StartPlayerMod()
    if PlayerMod.LoopConnection then return end
    PlayerMod.Enabled = true
    ApplyPlayerMods()
    if PlayerMod.Locked then
