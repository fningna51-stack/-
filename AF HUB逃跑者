-- 开始飞行
local function StartCarFly()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    local animate = char:FindFirstChild("Animate")

    if animate then
        CarFly.AnimCache = animate
        animate.Parent = nil
    end
    hum.AutoRotate = false

    if CarFly.FlightConnection then
        CarFly.FlightConnection:Disconnect()
        CarFly.FlightConnection = nil
    end

    CarFly.LastUpdateTime = tick()
    CarFly.FlightConnection = RunService.Heartbeat:Connect(function()
        if not CarFly.IsFlying or not char.Parent then
            if CarFly.FlightConnection then
                CarFly.FlightConnection:Disconnect()
                CarFly.FlightConnection = nil
            end
            return
        end

        local now = tick()
        local dt = now - CarFly.LastUpdateTime
        CarFly.LastUpdateTime = now

        local moveVec
        if CarFly.JoystickActive and CarFly.JoyMode then
            moveVec = CarFly.JoystickVector
        else
            local control = GetControlModule()
            if control then
                moveVec = control:GetMoveVector()
            else
                moveVec = Vector3.new()
            end
        end

        local camCF = Camera.CFrame
        local moveDir = (camCF.LookVector * -moveVec.Z) + (camCF.RightVector * moveVec.X) + (Vector3.new(0, moveVec.Y, 0))

        if moveVec.Magnitude > 0 then
            local newPos = hrp.Position + moveDir.Unit * (CarFly.Speed * dt)
            hrp.CFrame = CFrame.new(newPos, newPos + camCF.LookVector)
        else
            hrp.CFrame = CFrame.lookAlong(hrp.Position, Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z))
        end

        hrp.AssemblyLinearVelocity = Vector3.new()
    end)
end

-- 停止飞行
local function StopCarFly()
    if CarFly.FlightConnection then
        CarFly.FlightConnection:Disconnect()
        CarFly.FlightConnection = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.AutoRotate = true end
        local animate = char:FindFirstChild("Animate")
        if CarFly.AnimCache and not animate then
            CarFly.AnimCache.Parent = char
            CarFly.AnimCache = nil
        end
    end
end

