local function TeleportToMexico()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then
        WindUI:Notify({ Title = "找不到角色！", Duration = 3 })
        return false
    end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        WindUI:Notify({ Title = "找不到HumanoidRootPart！", Duration = 3 })
        return false
    end
    local targetPosition = Vector3.new(359.0, 1038.8, 83526.1)
    pcall(function()
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
        if (humanoidRootPart.Position - targetPosition).Magnitude > 10 then
            local tweenService = game:GetService("TweenService")
            local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
            local tween = tweenService:Create(humanoidRootPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})
            tween:Play()
            tween.Completed:Wait()
        end
    end)
    wait(0.5)
    if (humanoidRootPart.Position - targetPosition).Magnitude < 50 then
        WindUI:Notify({ Title = string.format("已传送到墨西哥！(%.1f, %.1f, %.1f)", targetPosition.X, targetPosition.Y, targetPosition.Z), Duration = 3 })
        return true
    else
        WindUI:Notify({ Title = "传送失败，请重试！", Duration = 3 })
        return false
    end
end

