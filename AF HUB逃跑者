local function GetLootableItems()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return {} end
    local rootPart = character:FindFirstChild("PrimaryPart") or character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    local items = {}
    local lootFolder = workspace:FindFirstChild("Loot") or workspace
    local descendants = lootFolder:GetDescendants()
    for i = 1, #descendants do
        local item = descendants[i]
        if item:IsA("BasePart") and item.Parent and item.Parent:FindFirstChild("Handle") then
            local distance = (item.Position - rootPart.Position).Magnitude
            if distance <= AutoLoot.LootRadius then
                table.insert(items, item.Parent)
            end
        end
    end
    return items
end

local function LootItem(item)
    local args = { "Loot", "LootEquip", item:WaitForChild("Handle") }
    local replicatedStorage = game:GetService("ReplicatedStorage")
    if replicatedStorage then
        local flowClient = replicatedStorage:FindFirstChild("FlowClient")
        if flowClient then
            local clientRunner = flowClient:FindFirstChild("ClientRunner")
            if clientRunner then
                local func = clientRunner:FindFirstChild("Function")
                if func then
                    func:InvokeServer(unpack(args))
                end
            end
        end
    end
end

